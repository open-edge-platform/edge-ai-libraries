     INPUT0_TYPE in0 = (input[input0_offset / 2] >> input0_idx*4) & 0x0F;
     INPUT0_TYPE in1 = (input[input1_offset / 2] >> input1_idx*4) & 0x0F;
 
+    OUTPUT_TYPE out = in0 | (in1 << 4);
