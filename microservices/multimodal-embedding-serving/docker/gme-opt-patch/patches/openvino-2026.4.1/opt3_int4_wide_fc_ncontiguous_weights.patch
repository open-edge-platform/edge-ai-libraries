+    // Compressed 4-bit weights arrive as a plain row-major [N, K] constant, which the matmul
+    // below describes as K-contiguous (`acb`).  When N is much larger than K the jit:gemm
+    // kernel is measurably faster with N-contiguous weights instead, so those are described as
+    // `abc` and transposed once by get_weights_reorder().
+    //
+    // The N >> K restriction is not cosmetic - the change is a clear loss outside it.  Measured
+    // per-matmul on a Qwen2-VL-2B INT4 prefill of 1024 tokens (Panther Lake iGPU, oneDNN
+    // verbose timings, cab -> abc):
+    //
+    //     wei 1536x8960   N/K 5.83    2.293 -> 1.798 ms   and   1.747 -> 1.293 ms
+    //     wei 1536x2048   N/K 1.33    0.474 -> 1.141 ms
+    //     wei 1536x1536   N/K 1.00    0.419 -> 0.486 ms
+    //
+    // The 4x threshold sits in the gap between the fastest measured win and the slowest
+    // measured loss; shapes below it keep the layout they arrive in.
+    //
+    // The same end-to-end sweep also shows the win is conditional on the row count, which is
+    // why the row check below exists (wall time, same model, layout on vs off):
+    //
+    //     32 rows 0.84x   64 rows 0.85x   128 rows 1.08x   256 rows 1.16x   1024 rows 1.11x
+    //
+    // The decision deliberately does not look at the weights *format*: get_weights_reorder()
+    // changes that format, and the primitive descriptor built afterwards has to agree with the
+    // one built before, or the matmul would read the reordered buffer with the old strides.
+    static bool use_n_contiguous_weights(const kernel_impl_params& impl_params,
+                                         size_t prim_input_size,
+                                         bool weights_transposed) {
+        if (prim_input_size != 3 || !weights_transposed)
+            return false;
+
+        const auto& weights_layout = impl_params.get_input_layout(1);
+        if (weights_layout.data_type != data_types::i4 && weights_layout.data_type != data_types::u4)
+            return false;
+        if (weights_layout.data_padding)
+            return false;
+
+        const auto& pshape = weights_layout.get_partial_shape();
+        if (pshape.size() != 2 || pshape.is_dynamic())
+            return false;
+
+        const auto N = pshape[0].get_length();
+        const auto K = pshape[1].get_length();
+        if (N < 4 * K)
+            return false;
+
+        // The layout only pays off once there are enough rows to amortize it; below that the
+        // original layout wins and the reorder is skipped entirely, so no second copy of the
+        // weights is allocated either.  The row count is taken as count()/K because the same
+        // projection is dispatched both as `1 x M x K` and as `M x 1 x K` depending on the
+        // node, and both mean M rows.
+        const auto& input_layout = impl_params.get_input_layout(0);
+        if (input_layout.is_dynamic())
+            return false;
+        constexpr int64_t min_rows = 128;
+        return static_cast<int64_t>(input_layout.count()) / K >= min_rows;
+    }
+
+    static std::shared_ptr<WeightsReorderParams> get_weights_reorder(const kernel_impl_params& impl_params) {
+        const auto& source_layout = impl_params.get_input_layout(1);
+        // Same logical [N, K] shape, only the physical order of the two axes changes:
+        // oiyx is K-innermost (what the constant already is), ioyx is N-innermost.
+        auto in_layout = layout(source_layout.get_partial_shape(), source_layout.data_type, format::oiyx);
+        auto out_layout = layout(source_layout.get_partial_shape(), source_layout.data_type, format::ioyx);
+        return std::make_shared<WeightsReorderParams>(in_layout, out_layout);
+    }
+
     static std::shared_ptr<dnnl::matmul::primitive_desc>
         get_matmul_primitive_descriptor(const kernel_impl_params& impl_params,
                                         cldnn::engine& engine,
@@ -162,7 +228,16 @@ protected:
         }
 
         dnnl::memory::desc weights_md;
-        if (weights_layout.data_padding
+        if (use_n_contiguous_weights(impl_params, prim_input_size, weights_transposed)) {
+            // get_weights_reorder() transposes the [N, K] constant to be N-innermost, which is
+            // exactly a dense `abc` descriptor over the (batch, K, N) matmul weights dims.
+            const auto& pshape = impl_params.get_input_layout(1).get_partial_shape();
+            const dnnl::memory::dim N = pshape[0].get_length();
+            const dnnl::memory::dim K = pshape[1].get_length();
+            weights_md = dnnl::memory::desc({1, K, N},
+                                            onednn::convert_data_type(weights_layout.data_type),
+                                            dnnl::memory::format_tag::abc);
+        } else if (weights_layout.data_padding
             && format::is_default_format(weights_layout.format)
             && (weights_layout.data_type == data_types::i4 || weights_layout.data_type == data_types::u4)) {
             weights_md = onednn::layout_to_memory_desc_strides(weights_layout, weights_fmt);
@@ -358,6 +433,10 @@ public:
         dnnl::memory::data_type dzp_data_type = dnnl::memory::data_type::undef;
         int idx = !arg.bias_term() ? 1 : 2;
 
+        std::shared_ptr<WeightsReorderParams> weights_reorder = nullptr;
+        if (use_n_contiguous_weights(impl_params, prim->input_size, prim->weights_transposed))
+            weights_reorder = get_weights_reorder(impl_params);
+
         if (prim->compressed_weights) {
             const auto input_dt = impl_params.get_input_layout(0).data_type;
             const bool is_dyn_quan_input = cldnn::one_of(input_dt, {data_types::i8, data_types::u8, data_types::f4e2m1, data_types::f8e4m3, data_types::f8e5m2});
@@ -451,7 +530,7 @@ public:
             auto prim_desc = get_matmul_primitive_descriptor(impl_params, impl_params.prog->get_engine(),
                                                              prim->input_size, prim->weights_rank, prim->bias.is_valid(), *attr);
 
-            auto prim_onednn = std::make_unique<fully_connected_onednn>(engine, config, attr, *prim_desc);
+            auto prim_onednn = std::make_unique<fully_connected_onednn>(engine, config, attr, *prim_desc, weights_reorder);
             prim_onednn->_ds_group_size = group_size;
             prim_onednn->_ds_data_type = ds_data_type;
             prim_onednn->_dzp_data_type = dzp_data_type;
@@ -460,7 +539,7 @@ public:
         auto prim_desc =
             get_matmul_primitive_descriptor(impl_params, impl_params.prog->get_engine(), prim->input_size, prim->weights_rank, prim->bias.is_valid(), *attr);
 
-        return std::make_unique<fully_connected_onednn>(engine, config, attr, *prim_desc);
+            return std::make_unique<fully_connected_onednn>(engine, config, attr, *prim_desc, weights_reorder);
     }
 };
 
