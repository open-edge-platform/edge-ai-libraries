+
+class PermuteKernelQKVHeadfirst : public PermuteKernelBase {
+public:
+    using Parent = PermuteKernelBase;
+
+    PermuteKernelQKVHeadfirst() : PermuteKernelBase("permute_qkv_headfirst") {}
+
+    ParamsKey GetSupportedKey() const override;
+    CommonDispatchData SetDefault(const permute_params& params) const override;
+    KernelsPriority GetKernelsPriority(const Params& params) const override;
+
+protected:
+    bool Validate(const Params& params) const override;
+};
+
+}  // namespace kernel_selector
