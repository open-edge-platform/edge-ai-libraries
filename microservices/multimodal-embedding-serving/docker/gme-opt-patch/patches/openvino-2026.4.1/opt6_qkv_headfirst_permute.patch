+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#define VEC_SIZE 8
+#define X_BLOCKS 10
+
+__attribute__((reqd_work_group_size(16, 1, 1)))
+KERNEL(permute_qkv_headfirst)(
+    OPTIONAL_SHAPE_INFO_ARG
+    const __global INPUT0_TYPE* input,
+    __global OUTPUT_TYPE* output)
+{
+    const uint x_block = (uint)get_global_id(0);
+    if (x_block >= X_BLOCKS)
+        return;
+
+    const uint out_y = (uint)get_global_id(1);
+    const uint out_bf = (uint)get_global_id(2);
+    const uint out_b = out_bf / OUTPUT_FEATURE_NUM;
+    const uint out_f = out_bf % OUTPUT_FEATURE_NUM;
+    const uint x = x_block * VEC_SIZE;
+
+    const uint input_offset = INPUT0_GET_INDEX(out_y, out_b, out_f, x);
+    const uint output_offset = OUTPUT_GET_INDEX(out_b, out_f, out_y, x);
+    const half8 value = vload8(0, input + input_offset);
+    vstore8(value, 0, output + output_offset);
+}
