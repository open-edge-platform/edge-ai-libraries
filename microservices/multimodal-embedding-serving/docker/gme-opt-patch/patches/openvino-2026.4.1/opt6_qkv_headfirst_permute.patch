+// Copyright (C) 2018-2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#include "permute_kernel_qkv_headfirst.h"
+
+namespace kernel_selector {
+
+namespace {
+constexpr size_t kVectorSize = 8;
+constexpr size_t kHeadSize = 80;
+constexpr size_t kHeads = 16;
+constexpr size_t kQKV = 3;
+
+bool IsQKVHeadfirstOrder(const std::vector<uint16_t>& order) {
+    return order == std::vector<uint16_t>({1, 3, 2, 0});
+}
+}  // namespace
+
+ParamsKey PermuteKernelQKVHeadfirst::GetSupportedKey() const {
+    ParamsKey key;
+    key.EnableInputDataType(Datatype::F16);
+    key.EnableOutputDataType(Datatype::F16);
+    key.EnableInputLayout(DataLayout::bfyx);
+    key.EnableOutputLayout(DataLayout::bfyx);
+    key.EnableTensorOffset();
+    key.EnableTensorPitches();
+    key.EnableBatching();
+    key.EnableDynamicShapesSupport();
+    return key;
+}
+
+CommonDispatchData PermuteKernelQKVHeadfirst::SetDefault(const permute_params& params) const {
+    CommonDispatchData dispatch;
+    const auto sequence = params.outputs[0].Y().v;
+    dispatch.gws = {16, sequence, kQKV * kHeads};
+    dispatch.lws = {16, 1, 1};
+    return dispatch;
+}
+
+bool PermuteKernelQKVHeadfirst::Validate(const Params& params) const {
+    if (!Parent::Validate(params))
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+
+    const auto& permute_params = static_cast<const kernel_selector::permute_params&>(params);
+    const auto& input = permute_params.inputs[0];
+    const auto& output = permute_params.outputs[0];
+    if (!IsQKVHeadfirstOrder(permute_params.order) || !permute_params.fused_ops.empty())
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    if (input.GetLayout() != DataLayout::bfyx || output.GetLayout() != DataLayout::bfyx ||
+        input.GetDType() != Datatype::F16 || output.GetDType() != Datatype::F16)
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    if (input.PitchesDifferFromLogicalDims() || output.PitchesDifferFromLogicalDims() ||
+        input.GetPaddedVal() != 0 || output.GetPaddedVal() != 0)
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    if (input.Feature().is_dynamic || input.Y().is_dynamic || input.X().is_dynamic ||
+        output.Batch().is_dynamic || output.Feature().is_dynamic || output.X().is_dynamic)
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+    if (input.Feature().v != kQKV || input.Y().v != kHeads || input.X().v != kHeadSize ||
+        output.Batch().v != kQKV || output.Feature().v != kHeads || output.X().v != kHeadSize ||
+        kHeadSize % kVectorSize != 0)
+        DO_NOT_USE_THIS_KERNEL(params.layerID);
+
+    return true;
+}
+
+KernelsPriority PermuteKernelQKVHeadfirst::GetKernelsPriority(const Params&) const {
+    return FORCE_PRIORITY_1;
+}
+
+}  // namespace kernel_selector
