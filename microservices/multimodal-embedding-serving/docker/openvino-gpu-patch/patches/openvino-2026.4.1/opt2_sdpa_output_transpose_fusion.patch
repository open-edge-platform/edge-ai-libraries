+    auto input_q_m = any_input(not_transpose);
+    auto input_k_m = any_input(not_transpose);
+    auto input_v_m = any_input(not_transpose);
+    auto input_attn_mask = any_input(not_transpose);
+    auto input_scale = any_input(not_transpose);
