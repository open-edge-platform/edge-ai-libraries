# Audio Analyzer - environment overrides for docker compose.
#
# Copy this file to .env and adjust as needed:
#
#   cp .env.example .env
#
# LOCAL_UID / LOCAL_GID select the UID/GID the container runs as. The
# image and docker-compose.yml both default to 1000:1000. Override these
# only if you want the container user to match a non-1000 host user (for
# example, when poking at named-volume contents from inside the
# container). Model files and runtime data live in named Docker volumes,
# so this is no longer required for permission correctness.
#
# REGISTRY selects the Docker Hub namespace for the prebuilt image. The
# default `intel` matches the published images on Docker Hub. Override
# only if you push the image to a different namespace.
#
# RELEASE_TAG selects the image tag for both pull and build flows. On
# `docker compose build`, the locally built image is tagged with the
# same `${REGISTRY}/audio-analyzer:${RELEASE_TAG}`, so the pull and
# build paths share one image reference.

LOCAL_UID=1000
LOCAL_GID=1000
REGISTRY=intel
RELEASE_TAG=latest
