dbrp "datain"."autogen"

var data0 = stream
        |from()
                .database('datain')
                .retentionPolicy('autogen')
                .measurement('wind-turbine-data')
        @windturbine_anomaly_detector()
data0
        |influxDBOut()
                .buffer(0)
                .database('datain')
                .measurement('wind-turbine-anomaly-data')
                .retentionPolicy('autogen')
