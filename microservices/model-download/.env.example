# ==============================================================================
# Model Download — Application Configuration (.env)
# ==============================================================================
#
# This file holds the non-secret defaults for the Model Download microservice
# in one place. Secrets (e.g. GETI_TOKEN, HUGGINGFACEHUB_API_TOKEN) are listed
# at the bottom with EMPTY values so they are never accidentally committed —
# supply them via:
#
#   Local dev:
#       export GETI_TOKEN=<value>   # in your shell before running make/up
#
#   GitHub Actions:
#       env:
#         GETI_TOKEN: ${{ secrets.GETI_TOKEN }}
#
# Usage:
#   cp .env.example .env      # done automatically by `make build`/`make up`
#   make build                # build the Docker image
#   make up                   # start the service
#
# Env vars already exported in your shell ALWAYS override values here.
# ==============================================================================


# ==============================================================================
# Registry & Image Tag  (used by make build / make up)
# ==============================================================================

# Leave REGISTRY empty for local-only builds. Set it (with trailing slash) to
# push/pull from a registry, e.g. REGISTRY=myregistry.io/
REGISTRY=intel/
TAG=latest


# ==============================================================================
# Docker / Filesystem Settings
# ==============================================================================

# Host directory mounted into the container at /opt/models.
MODEL_PATH=~/models/


# ==============================================================================
# Plugin Activation
# ==============================================================================

# Comma-separated list of plugins to enable (e.g. huggingface,ollama,ultralytics,
# geti,hls,openvino,pipeline-zoo-models), or leave empty/"all" to enable all.
ENABLED_PLUGINS=all



# ==============================================================================
# API Upload Limits
# ==============================================================================

MAX_UPLOAD_SIZE_MB=500
UPLOAD_CHUNK_SIZE_KB=8


# ==============================================================================
# Geti Plugin
# ==============================================================================

GETI_HOST=
GETI_WORKSPACE_ID=
GETI_SERVER_API_VERSION=v1
GETI_SERVER_SSL_VERIFY=False


# ==============================================================================
# SECRETS — leave blank here; supply via shell export or CI environment
# ==============================================================================
#
# Local dev:
#   export GETI_TOKEN=<your-token>
#   export HUGGINGFACEHUB_API_TOKEN=<your-token>
#   ... then: make up
#
# GitHub Actions — add these as repository secrets and inject via `env:`:
#   GETI_TOKEN, HUGGINGFACEHUB_API_TOKEN
# ==============================================================================

GETI_TOKEN=
HUGGINGFACEHUB_API_TOKEN=
