# Release
RELEASE_TAG=2026.2.0-rc1

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT MODE
# ─────────────────────────────────────────────────────────────────────────────
# Options:
#   seaweedfs+mqtt    - Traditional mode with frame storage and async MQTT processing
#   standalone+api    - Direct API mode without SeaweedFS/MQTT (recommended for testing)
DEPLOYMENT_MODE=standalone+api
LOG_LEVEL=DEBUG

# SEAWEEDFS (required only for seaweedfs+mqtt mode)
SEAWEEDFS_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_BUCKET=behavioral-frames

# VLM
OVMS_IMAGE_TAG=2026.1-gpu
VLM_ENDPOINT=http://ovms-vlm:8001

# MQTT
MQTT_HOST=broker.scenescape.intel.com
MQTT_PORT=1883

# ---- Behavioral Analysis service ----
BA_SERVICE_PORT=8085
BA_MIN_FRAMES=3      # minimum frames before running pose/VLM analysis
BA_MAX_FRAMES=30      # maximum frames fetched per BA request
BA_POSE_FRAMES=20     # number of frames used for pose scoring
BA_CONFIDENCE=0.5      # keypoint confidence threshold
BA_GST_DEVICE=CPU      # inference device for GStreamer pipeline (CPU / GPU / NPU)
VLM_ENABLED=true
BA_REQUEST_TOPIC=ba/requests 
BA_RESULT_TOPIC=ba/results
DOWNLOADED_MODEL_PATH=./models