      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "powerstat_package_current_power_consumption_watts{host=~\"$host\"}",
          "legendFormat": "pkg {{package_id}}",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "powerstat_package_current_dram_power_consumption_watts{host=~\"$host\"}",
          "legendFormat": "dram {{package_id}}",
          "refId": "D"
