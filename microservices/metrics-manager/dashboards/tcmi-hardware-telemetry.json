{
  "title": "Intel TCMI Hardware Telemetry (Metrics Manager)",
  "description": "Unified T/C/M/I + R hardware telemetry for robotics / Edge AI / physical AI on Intel platforms, served by the Metrics Manager microservice.",
  "uid": "tcmi-mm-unified-v1",
  "tags": [
    "tcmi",
    "metrics-manager",
    "intel",
    "hardware-telemetry"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "definition": "label_values(mem_used_percent, host)",
        "query": {
          "query": "label_values(mem_used_percent, host)",
          "refId": "hostVar"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "T \u2014 Thermal & Power",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "title": "CPU Package + DRAM Power (RAPL)",
      "description": "CPU package + DRAM RAPL power via intel_powerstat.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
