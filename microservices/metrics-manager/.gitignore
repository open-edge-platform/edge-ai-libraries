# Environment variables (keep locally, never commit)
.env

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/

# Test artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.tox/

# Virtual environments
.venv/
venv/

# uv lock file (generated automatically by uv sync, not committed)
uv.lock

# Go build output (native/ collector plugins and TUI)
native/bin/

# Staging tree and .deb produced by native/build.sh
native/packaging/dist/

# Misc
*.log
.DS_Store
