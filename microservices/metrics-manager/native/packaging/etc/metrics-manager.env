# Environment for every Metrics Manager service.
#
# This file is read by the Telegraf service and by each privileged collector,
# so a value set here reaches all of them and the `host` tag stays consistent
# across every metric.
#
# Changes take effect after `systemctl try-restart 'metrics-manager-*.service'`.

# Value of the `host` tag on every metric.
#
# Empty means "use the kernel hostname". Set it explicitly when the machine is
# renamed by DHCP, or when several machines should appear under stable names in
# a shared dashboard. The variable must stay defined even when empty, because
# the Telegraf configuration refers to it.
METRICS_MANAGER_HOSTNAME=

# Optional Turbostat input: positive integer sampling cadence in seconds.
TURBOSTAT_INTERVAL=5
# Host executable, normally the distribution's kernel-selecting wrapper.
# Set an absolute kernel-matched path if the wrapper is unavailable.
TURBOSTAT_BIN=/usr/bin/turbostat

# How often qmassa samples the GPU, in milliseconds.
#
# Telegraf collects at one second, so sampling faster than that only adds
# overhead. Raise it to reduce the cost of GPU telemetry on a busy machine.
QMASSA_INTERVAL_MS=1000

# How many processes the process collector reports.
#
# The limit applies to each ranking separately, and the two are combined, so a
# value of 10 publishes up to twenty rows: the ten using the most CPU and the
# ten holding the most memory. Both matter, and a process leaking memory while
# using no CPU never appears in a CPU ranking.
#
# Each reported process is a time series tagged with its process id, and those
# ids are not reused predictably, so raising this raises how fast a Prometheus
# scrape accumulates series. 0 reports every process on the machine.
PROCESS_LIMIT=10
