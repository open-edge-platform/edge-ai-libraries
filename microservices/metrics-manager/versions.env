# =============================================================================
# Third-party component versions - SINGLE SOURCE OF TRUTH
# =============================================================================
#
# Every artefact that the Metrics Manager pulls from a third party is pinned
# here. Both delivery vehicles consume this file:
#
#   * the container image  -> Makefile passes these as --build-arg to Dockerfile
#   * the bare-metal .deb  -> native/build.sh sources this file
#
# To move to a new upstream version, edit ONLY this file and then run:
#
#     make sync-versions
#
# which mirrors the values into the Dockerfile ARG defaults (the defaults exist
# so that a plain `docker build .` without the Makefile still works). The
# mirrors are enforced by tests/test_versions.py, so a forgotten sync fails CI
# rather than silently shipping two different versions.
#
# This file is intentionally restricted to `KEY=value` lines with no spaces and
# no shell expansion, so it can be `include`d by make, `source`d by sh and
# parsed by Python with the same trivial rules.
# =============================================================================

# -----------------------------------------------------------------------------
# Telegraf - the metrics collection engine.
# -----------------------------------------------------------------------------
# The official upstream release archive is used. The archive is verified
# against TELEGRAF_SHA256 before extraction, so a tampered, truncated or
# man-in-the-middled download fails the build instead of being installed.
#
# When bumping TELEGRAF_VERSION, refresh the digest with:
#
#   curl -sSfL -o /tmp/t.tgz \
#     https://dl.influxdata.com/telegraf/releases/telegraf-<VER>_linux_amd64.tar.gz
#   sha256sum /tmp/t.tgz
#
# NOTE: the official binary bundles Go dependencies that may carry known CVEs
# which upstream has not yet released a fix for. This is a deliberate,
# documented trade-off in favour of shipping one identical, reproducible
# Telegraf binary in both the container image and the .deb package. Revisit on
# every version bump.
# The 1.40.3 official binary was built with Go 1.27.3. GO_IMAGE below
# controls our native plugins/TUI only; it does not rebuild Telegraf.
TELEGRAF_VERSION=1.40.3
TELEGRAF_SHA256=cbb95c43303db6e75e129a4eb8888ab1468009e61f6615e64a1cb82f50b0f4ce

# Python build/runtime base: Debian 13 (trixie), not a moving distro alias.
# Refresh the digest deliberately and rescan both image variants.
PYTHON_IMAGE=docker.io/library/python:3.12-slim-trixie@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54

# -----------------------------------------------------------------------------
# qmassa / qmmd - Intel GPU telemetry (Rust).
# -----------------------------------------------------------------------------
# Both binaries live in the same Cargo workspace but are tagged independently
# as `qmassa-vX.Y.Z` and `qmmd-vX.Y.Z` at https://github.com/ulissesf/qmassa.
QMASSA_VERSION=2.1.0
QMMD_VERSION=0.2.0

# Toolchain image used to build qmassa/qmmd from source.
RUST_IMAGE=docker.io/library/rust:1.88

# -----------------------------------------------------------------------------
# Go - toolchain for the collector plugins and the bare-metal TUI (native/).
# -----------------------------------------------------------------------------
GO_IMAGE=docker.io/library/golang:1.27@sha256:0c050feb47802ae436b9030833694a0b80160d08e3b3049ad30bf7c9e724e09d

# -----------------------------------------------------------------------------
# nfpm - builds the bare-metal .deb from native/packaging/nfpm.yaml.
# -----------------------------------------------------------------------------
# Only ever runs on a build host; nothing from this image is shipped in the
# package.
NFPM_IMAGE=docker.io/goreleaser/nfpm:v2.43.0

# Extended image only: official Intel userspace GPU/NPU binaries.
# docker_accelerators.py reads these pins directly; no Docker ARG mirrors.
# Ubuntu-targeted vendor binaries are compatibility-tested on Debian 13.
# System dependencies still come exclusively from Debian; no host firmware or
# kernel drivers are installed. Update digests from the official release assets.
INTEL_COMPUTE_RUNTIME_VERSION=26.40.40196.8
INTEL_IGC_VERSION=2.42.6
INTEL_IGC_BUILD=23070
INTEL_GMMLIB_VERSION=22.10.2
INTEL_NPU_DRIVER_VERSION=1.38.0
INTEL_NPU_DRIVER_BUILD=20260910-34487311128
INTEL_OPENCL_SHA256=96046069e94680b761df6e83ddc64244721178b826e3e1f8af3ca104cfd0c7c2
INTEL_OCLOC_SHA256=b2868d6d7958cc5ca28fa9b48a7d39961760ee39ef07673d5b58894dd53d6b4e
INTEL_LEVEL_ZERO_GPU_SHA256=d9c86b2bb195baea6936c2708846cd1fceeadc39bc5e167f728858a5ca6fb86e
INTEL_GMMLIB_SHA256=053fceadb84a1d2f9a30a0d1bc9b16424b3f1a90cc49900fcd80aadcf25c8a4d
INTEL_IGC_CORE_SHA256=e20539632f2d99875d8f8b225d5da58b31f98baa54bb47c6328aa98ec473ab9d
INTEL_IGC_OPENCL_SHA256=7f5593cf828503ffb8450967768bde9209e22753bc576296e846b5a751011fa3
INTEL_NPU_DRIVER_SHA256=1efcd4b60c22abee751d8f2705962cbcc2a569de45c7e0e670cf08afbfcdc1d2
