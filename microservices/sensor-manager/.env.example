# Sensor Manager configuration used by `make build` / `make run` (docker/compose.yaml).
# Variables exported in the shell override the values below.

# Leave REGISTRY empty for local builds, or set it with a trailing slash (e.g. myregistry.io/).
REGISTRY=intel/
TAG=latest

# The service runs with host networking (required by ONVIF WS-Discovery), so it listens
# directly on the host interfaces. Restrict with a firewall or set a specific bind address.
SENSOR_MANAGER_HOST=0.0.0.0
SENSOR_MANAGER_PORT=8090

ONVIF_DISCOVERY_ENABLED=true
ONVIF_DISCOVERY_INTERVAL_S=20

# Host GID of the `video` group (getent group video), required to open /dev/video* devices.
VIDEO_GID=44

LOG_LEVEL=INFO
