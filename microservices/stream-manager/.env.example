# Optional Docker Compose overrides for local development.
STREAM_MANAGER_HOST_PORT=18080
# Keep this URL's port in sync with STREAM_MANAGER_HOST_PORT.
STREAM_MANAGER_PUBLIC_BASE_URL=http://localhost:18080

# Development-only value. Replace with a unique secret outside local testing.
STREAM_MANAGER_MEDIA_TOKEN_SECRET=local-development-only-change-me

# Optional tuning values.
STREAM_MANAGER_DEV_BEST_EFFORT_TIMESTAMPS=false
STREAM_MANAGER_BUFFER_TMPFS_SIZE=256m