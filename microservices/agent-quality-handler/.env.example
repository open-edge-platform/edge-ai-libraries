# Required external detection API
STORAGE_SERVICE_URL=http://host.docker.internal:5001
STORAGE_CONNECT_TIMEOUT_SECONDS=3
STORAGE_READ_TIMEOUT_SECONDS=10
STORAGE_READ_MAX_ATTEMPTS=3
STORAGE_RETRY_BACKOFF_SECONDS=0.25

# Fallback mode starts without OVMS or a GPU
LLM_MODE=fallback
LLM_MODEL_NAME=Phi-4-mini-instruct
LLM_DEVICE=GPU
LLM_PRECISION=int8
MODEL_DOWNLOAD_TIMEOUT_SECONDS=3600

# Detection Service batch-complete events
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_BATCH_TOPIC=apm/batch-complete
MQTT_QOS=1
MQTT_KEEPALIVE=60
MQTT_MAX_PAYLOAD_BYTES=1048576
# Set a unique stable ID for each Agent Quality Handler replica
MQTT_BATCH_CLIENT_ID=agent-quality-handler-batch

# For a secured external broker, set these as needed
# MQTT_HOST=mqtt.example.com
# MQTT_PORT=8883
# MQTT_USERNAME=agent
# MQTT_PASSWORD=change-me

# Optional custom use-case assets
# USE_CASE_CONFIGS_DIR=./my-use-case/config
# USE_CASE_PROMPTS_DIR=./my-use-case/prompts

# Completed agent results are retained in memory for one day, up to 1000 runs
# RUN_RETENTION_SECONDS=86400
# MAX_RETAINED_RUNS=1000
# Per-agent JSON history (mounted as a named volume in Compose)
# OUTPUT_DIR=/app/output
