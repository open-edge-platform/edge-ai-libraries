# ---------------------------------------------------------------------------
# Image / build
# ---------------------------------------------------------------------------
DLSTREAMER_PIPELINE_SERVER_IMAGE=dlsps2.0-7
BASE_IMAGE=intel/dlstreamer:2026.1.0-ubuntu24

# Non-root user baked into the image
UID=1999
PIPELINE_SERVER_USER=pipeline-server

# render group ID on the host (for GPU/NPU access). Find it with:
#   getent group render | cut -d: -f3
RENDER_GID=993

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
REST_SERVER_PORT=8080
APP_LOG_LEVEL=INFO
WEB_SERVER_LOG_LEVEL=WARNING

# ---------------------------------------------------------------------------
# Publisher sink connection settings (only needed for the sinks you use)
# ---------------------------------------------------------------------------
# MQTT (mqttsinkpy)
MQTT_HOST=mqtt
MQTT_PORT=1883

# OPC-UA (opcuasinkpy)
OPCUA_SERVER_IP=
OPCUA_SERVER_PORT=4840
OPCUA_SERVER_USERNAME=
OPCUA_SERVER_PASSWORD=

# InfluxDB (influxsinkpy)
INFLUXDB_HOST=
INFLUXDB_PORT=8086
INFLUXDB_USER=
INFLUXDB_PASS=

# S3 / MinIO (s3sinkpy)
S3_STORAGE_HOST=
S3_STORAGE_PORT=9000
S3_STORAGE_USER=
S3_STORAGE_PASS=

# Proxies (leave empty if not behind a proxy)
http_proxy=
https_proxy=
no_proxy=
