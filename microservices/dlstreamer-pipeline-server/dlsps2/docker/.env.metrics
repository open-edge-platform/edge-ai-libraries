#
# Environment Configuration for DL Streamer Pipeline Server 2.0 + Metrics Manager Stack
#
# Copy this file to .env and customize for your deployment
#

# ===========================================================================
# Project and Image Names
# ===========================================================================
PROJECT_NAME=dlsps2-metrics-stack

# DL Streamer Pipeline Server image (local build or Docker Hub)
DLSTREAMER_PIPELINE_SERVER_IMAGE=dlsps2.0-7
BASE_IMAGE=intel/dlstreamer:2026.2.0-ubuntu24

# Metrics Manager image registry and tag
REGISTRY=
METRICS_MANAGER_TAG=2026.2.0

# ===========================================================================
# Port Configuration
# ===========================================================================
# REST API port for DL Streamer Pipeline Server
REST_SERVER_PORT=8080

# Metrics Manager API port
HOST_METRICS_PORT=9090

# Telegraf Prometheus metrics endpoint port
HOST_TELEGRAF_PORT=9273

# Telegraf HTTP listener port (internal metrics ingestion)
HOST_TELEGRAF_HTTP_PORT=8186

# MQTT Broker port
MQTT_PORT=1883

# ===========================================================================
# Logging Configuration
# ===========================================================================
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# DL Streamer specific log levels
APP_LOG_LEVEL=INFO
WEB_SERVER_LOG_LEVEL=WARNING

# GStreamer debug level (0=none, 1=errors, 2=warnings, 3=info, 4+=debug)
GST_DEBUG=1

# ===========================================================================
# Metrics Manager Configuration
# ===========================================================================
# Stable hostname for metrics (e.g., an asset tag or machine ID)
# Leave empty to use kernel hostname
METRICS_MANAGER_HOSTNAME=

# Custom metrics retention time in seconds (min: 10, max: 86400)
METRICS_RETENTION_SECONDS=300

# Maximum metrics to accept in a single batch
MAX_METRICS_BATCH_SIZE=1000

# Maximum custom metrics to hold in memory
MAX_METRICS_IN_MEMORY=100000

# Enable hardware telemetry collection (CPU, GPU, NPU, temperature)
HARDWARE_TELEMETRY_ENABLED=true

# CORS origins (allow all by default; restrict as needed)
CORS_ORIGINS=*

# ===========================================================================
# Security Configuration
# ===========================================================================
# Run containers as root (required for hardware access; set to false with proper capabilities)
PRIVILEGED=true

# Container user IDs (root by default)
METRICS_MANAGER_USER=0:0
PIPELINE_SERVER_USER=pipeline-server

# Linux render group ID (for GPU access; find with: getent group render)
GPU_RENDER_GID=992
RENDER_GID=992

# ===========================================================================
# Proxy Configuration
# ===========================================================================
# Uncomment and set if you're behind a proxy
# http_proxy=http://example-proxy:911
# https_proxy=http://example-proxy:912
# no_proxy=localhost,127.0.0.1,10.0.0.0/8,mqtt-broker,metrics-manager,dlstreamer-pipeline-server

# ===========================================================================
# DL Streamer Pipeline Server Configuration
# ===========================================================================
# Optional: Additional GStreamer plugin search paths
# ADDITIONAL_GST_PLUGIN_PATH=/home/pipeline-server/extra_plugins

# MQTT Broker settings (local or external)
MQTT_HOST=broker
# MQTT_PORT is set above

# NPU Support (Intel)
# ZE_ENABLE_ALT_DRIVERS=libze_intel_npu.so

# ===========================================================================
# OpenTelemetry Configuration (Optional)
# ===========================================================================
# Uncomment to enable metrics export to OpenTelemetry Collector
# ENABLE_OPEN_TELEMETRY=false
# OTEL_COLLECTOR_HOST=otel-collector
# OTEL_COLLECTOR_PORT=4318
# OTEL_EXPORT_INTERVAL_MILLIS=10000

# ===========================================================================
# External Service Integration (Optional)
# ===========================================================================
# OPC-UA Server (for edge control/monitoring)
# OPCUA_SERVER_IP=
# OPCUA_SERVER_PORT=4840
# OPCUA_SERVER_USERNAME=
# OPCUA_SERVER_PASSWORD=

# InfluxDB (time-series database)
# INFLUXDB_HOST=
# INFLUXDB_PORT=8086
# INFLUXDB_USER=
# INFLUXDB_PASS=

# S3-Compatible Storage (e.g., MinIO)
# S3_STORAGE_HOST=
# S3_STORAGE_PORT=9000
# S3_STORAGE_USER=
# S3_STORAGE_PASS=

# ===========================================================================
# Container Setup
# ===========================================================================
# Container user ID/GID (use with non-root deployments)
UID=1000

# Telegraf configuration file path (override default)
# TELEGRAF_CONFIG=../../metrics-manager/telegraf.conf

# ===========================================================================
# Optional: Install OpenVINO in Metrics Manager
# ===========================================================================
# Set to true to include OpenVINO runtime in metrics-manager container
# INSTALL_OPENVINO=false
