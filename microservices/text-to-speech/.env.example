# Text To Speech - environment overrides for docker compose.
#
# Copy this file to .env and adjust as needed:
#
#   cp .env.example .env
#
# LOCAL_UID / LOCAL_GID select the UID/GID the container runs as. The
# image and docker-compose.yml both default to 1000:1000. Model files
# and runtime data live in named Docker volumes, so this is no longer
# required for permission correctness; override only if you want the
# container user to match a non-1000 host user.
#
# RENDER_GID must match the host render node group so the non-root container
# can open /dev/dri/renderD* for GPU access.
#
# REGISTRY selects the Docker Hub namespace for the prebuilt image. The
# default `intel` matches the published images on Docker Hub.
#
# RELEASE_TAG selects the image tag for both pull and build flows.

LOCAL_UID=1000
LOCAL_GID=1000
RENDER_GID=992
REGISTRY=intel
RELEASE_TAG=latest