# Text To Speech - environment overrides for docker compose.
#
# Copy this file to .env and adjust as needed:
#
#   cp .env.example .env
#
# To make the container run as your host user (recommended so that
# models/, storage/, and .cache/huggingface/ stay writable from both
# Docker and standalone runs), set:
#
#   LOCAL_UID=$(id -u)  # e.g. 1000
#   LOCAL_GID=$(id -g)  # e.g. 1000
#
# If unset, docker-compose.yml falls back to 1000:1000, which also matches
# the image's default runtime user.
#
# RENDER_GID must match the host render node group so the non-root container
# can open /dev/dri/renderD* for GPU access.
#
# REGISTRY selects the Docker Hub namespace for the prebuilt image. The
# default `intel` matches the published images on Docker Hub.
#
# RELEASE_TAG selects the image tag for both pull and build flows.

LOCAL_UID=1000
LOCAL_GID=1000
RENDER_GID=992
REGISTRY=intel
RELEASE_TAG=latest