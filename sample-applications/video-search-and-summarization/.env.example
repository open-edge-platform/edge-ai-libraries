# ==============================================================================
# VSS — Application Configuration (.env)
# ==============================================================================
#
# This file holds ALL non-secret defaults for the Video Search & Summarization
# application in one place.  Secrets are listed at the bottom with EMPTY values
# so they are never accidentally committed — supply them via:
#
#   Local dev:
#       export POSTGRES_PASSWORD=<value>   # in your shell before sourcing setup.sh
#
#   GitHub Actions:
#       env:
#         POSTGRES_PASSWORD: ${{ secrets.POSTGRES_PASSWORD }}
#
# Usage (local):
#   # Load config into shell, then deploy:
#   set -a; source .env; set +a
#   source setup.sh --summary       # or --search / --summary --search / --summary-and-search
#
# Usage (Makefile):
#   make deploy-summary             # build + deploy (for local dev)
#   Secrets are intentionally not stored in this file; export them in your shell
#   (or inject via GitHub Actions `env:`) before running deploy targets.
#
# Env vars already exported in your shell ALWAYS override values here.
# ==============================================================================


# ==============================================================================
# Registry & Image Tag  (used by make build / make push)
# ==============================================================================

# Leave REGISTRY_URL and PROJECT_NAME empty for local-only builds.
# Set both to push to a registry: REGISTRY_URL=myregistry.io  PROJECT_NAME=myproject
REGISTRY_URL=intel/
PROJECT_NAME=
TAG=latest


# ==============================================================================
# Application Gateway
# ==============================================================================

# External host port exposed by nginx (all UIs and /manager API live here).
APP_HOST_PORT=12345

# HOST_IP is auto-detected by setup.sh via `ip route get 1`.
# HOST_IP=


# ==============================================================================
# Summary Stack — VLM / LLM Models
# (required for --summary, --dual, --unified modes)
# ==============================================================================

# Vision-Language Model used for frame captioning and summarization.
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct
VLM_TARGET_DEVICE=CPU
VLM_COMPRESSION_WEIGHT_FORMAT=int8

# Whisper models loaded by the audio-analyzer service (comma-separated).
ENABLED_WHISPER_MODELS=tiny.en,small.en,medium.en

# Object-detection model used during ingestion.
OD_MODEL_NAME=yolov8l

# LLM inference backend: CONFIG_OFF = use built-in OVMS path; set to vllm to
# use the vLLM container instead.
USE_VLLM=CONFIG_OFF
ENABLE_VLLM=false

# vLLM container image and tuning knobs (only relevant when USE_VLLM=vllm).
VLLM_IMAGE=public.ecr.aws/q9t5s3a7/vllm-cpu-release-repo:v0.17.1
VLLM_HOST_PORT=8200
VLLM_MAX_MODEL_LEN=32000
VLLM_MAX_NUM_BATCHED_TOKENS=2048
VLLM_MAX_NUM_SEQS=256
VLLM_CPU_KVCACHE_SPACE=48
VLLM_CPU_NUM_OF_RESERVED_CPU=0
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_BLOCK_SIZE=128
VLLM_DTYPE=bfloat16
VLLM_LOGGING_LEVEL=INFO
VLLM_ENGINE_ITERATION_TIMEOUT_S=120
VLLM_RPC_TIMEOUT=100000
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

# OVMS LLM model (used when USE_VLLM=CONFIG_OFF and OVMS path is active).
# OVMS_LLM_MODEL_NAME=Intel/neural-chat-7b-v3-3
LLM_TARGET_DEVICE=CPU
LLM_COMPRESSION_WEIGHT_FORMAT=

# Pipeline-Manager summarization tuning.
PM_SUMMARIZATION_MAX_COMPLETION_TOKENS=4000
PM_CAPTIONING_MAX_COMPLETION_TOKENS=1024
PM_LLM_MAX_CONTEXT_LENGTH=90000
PM_LLM_CONCURRENT=2
PM_VLM_CONCURRENT=4
PM_MULTI_FRAME_COUNT=12
PM_AUDIO_USE_FULL_TRANSCRIPT_SUMMARY=true
PM_PRODUCE_FINAL_SUMMARY=true
PM_MINIO_BUCKET=video-summary


# ==============================================================================
# Search / Embedding Stack
# (required for --search, --dual, --unified modes)
# ==============================================================================

SDK_USE_OPENVINO=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=CPU

# Frame-embedding model (used in --search and --dual modes).
MULTIMODAL_EMBEDDING_MODEL=CLIP/clip-vit-b-32
VCLIP_MODEL=openai/clip-vit-base-patch32
SDK_MODEL_ID=CLIP/clip-vit-b-32

# Text-embedding model (used in --unified mode — searches over summary text).
TEXT_EMBEDDING_MODEL=QwenText/qwen3-embedding-0.6b
TEXT_EMBEDDING_MODEL_NAME=QwenText/qwen3-embedding-0.6b

# OpenVINO model cache directories.
OV_MODELS_DIR=/app/ov_models
EMBEDDING_OV_MODELS_DIR=/app/ov_models
OV_PERFORMANCE_MODE=THROUGHPUT

# Search service settings.
VS_HOST_PORT=7890
VS_INDEX_NAME=video_frame_embeddings
VS_WATCHER_DIR=
VS_DELETE_PROCESSED_FILES=false
VS_INITIAL_DUMP=false
VS_WATCH_DIRECTORY_RECURSIVE=false
VS_DEBOUNCE_TIME=10
VS_WATCH_BATCH_SIZE=10
VS_BATCH_JOB_POLL_INTERVAL_SECONDS=2
VS_BATCH_JOB_TIMEOUT_SECONDS=3600

# Result aggregation (clips grouping).
AGGREGATION_ENABLED=true
AGGREGATION_SEGMENT_DURATION=8
AGGREGATION_MIN_GAP=0
AGGREGATION_MAX_RESULTS=20
AGGREGATION_INITIAL_K=1000
AGGREGATION_CONTEXT_SEEK_OFFSET_SECONDS=0
# Prefer a full frame over a near-equal object crop as the seek/thumbnail anchor.
# When true, if a full frame scores within AGGREGATION_FULL_FRAME_SEEK_BAND (fraction of
# the segment peak) it is chosen as the anchor (nearest in time to the peak). This only
# changes the displayed/seek frame; result ranking is unaffected. Default: on. It is a
# no-op when object detection is disabled (results are already all full frames).
AGGREGATION_PREFER_FULL_FRAME_SEEK=true
AGGREGATION_FULL_FRAME_SEEK_BAND=0.06

# Timeout waiting for the Multimodal DataPrep service to be ready (ms).
SEARCH_DATAPREP_TIMEOUT_MS=600000


# ==============================================================================
# Ingestion & Object Detection
# ==============================================================================

FRAME_INTERVAL=15
DEFAULT_NUM_FRAMES=64
DEFAULT_START_OFFSET_SEC=0
DEFAULT_CLIP_DURATION=-1
DEFAULT_BUCKET_NAME=video-summary

ENABLE_OBJECT_DETECTION=true
DETECTION_CONFIDENCE=0.85

ROI_CONSOLIDATION_ENABLED=false
ROI_CONSOLIDATION_IOU_THRESHOLD=0.2
ROI_CONSOLIDATION_CLASS_AWARE=false
ROI_CONSOLIDATION_CONTEXT_SCALE=0.2

FRAMES_TEMP_DIR=/tmp/dataprep
MAX_PARALLEL_WORKERS=

# USB camera device node (used for live-camera ingestion pipelines).
USB_CAMERA_DEVICE=/dev/video2

# Multimodal DataPrep settings.
DATAPREP_EMBEDDING_DEVICE=CPU
DATAPREP_DETECTION_DEVICE=CPU
MM_DATAPREP_LOG_LEVEL=INFO
# Keep historical behavior (accept duplicate content uploads). Set to false to
# reject content-identical re-uploads with HTTP 409.
MM_DATAPREP_ALLOW_DUPLICATE_UPLOADS=true
YOLOX_MODELS_VOLUME_NAME=dataprep-yolox-models
YOLOX_MODELS_MOUNT_PATH=/app/models/yolox

# Storage backend for uploaded assets (minio is the default).
STORAGE_BACKEND=minio

# Inference device for the video-ingestion (EVAM) pipeline.
EVAM_DEVICE=CPU

# ==============================================================================
# CORS / API Gateway
# ==============================================================================
ALLOW_ORIGINS=*
ALLOW_METHODS=*
ALLOW_HEADERS=*

# ==============================================================================
# Telemetry
# ==============================================================================

# Set to true to enable live system and DataPrep metrics.
ENABLE_METRICS_MANAGER=false
METRICS_MANAGER_HOST_PORT=9090
METRICS_MANAGER_PROMETHEUS_HOST_PORT=9273
MM_DATAPREP_METRICS_MANAGER_TIMEOUT_SECONDS=2
# OTLP_TRACE_URL=http://otelcol:4317    # uncomment to send traces externally
# When OTLP_TRACE_URL is unset, pipeline-manager exports no traces (clean logs).
# Set OTEL_CONSOLE_EXPORTER=true to print spans to stdout for local debugging
# (very verbose).
# OTEL_CONSOLE_EXPORTER=false

# ==============================================================================
# Internal Service Hostnames & Ports
# (these match docker-compose service names — change only if you remap ports)
# ==============================================================================

PM_HOST_PORT=3001

POSTGRES_HOST=postgres-service
POSTGRES_HOST_PORT=5432
POSTGRES_DB=video_summary_db

MINIO_HOST=minio-service
MINIO_PORT=80
MINIO_API_HOST_PORT=4001
MINIO_CONSOLE_HOST_PORT=4002

RABBITMQ_HOST=rabbitmq-service
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_UI_HOST_PORT=15672
RABBITMQ_MQTT_HOST_PORT=1883

AUDIO_HOST=audio-analyzer
AUDIO_HOST_PORT=8999
AUDIO_MAX_FILE=314572800

OVMS_HOST=ovms-service
OVMS_HTTP_HOST_PORT=8300
OVMS_GRPC_HOST_PORT=9300

MM_DATAPREP_HOST=multimodal-dataprep
MM_DATAPREP_HOST_PORT=6016
VDMS_VDB_HOST=vdms-vector-db
VDMS_VDB_HOST_PORT=55555

MULTIMODAL_EMBEDDING_HOST=multimodal-embedding-serving
EMBEDDING_SERVER_PORT=9777

EVAM_HOST=video-ingestion
EVAM_PIPELINE_PORT=8080
EVAM_PIPELINE_HOST_PORT=8090

VS_HOST=video-search


# ==============================================================================
# SECRETS — leave blank here; supply via shell export or CI environment
# ==============================================================================
#
# Local dev:
#   export POSTGRES_PASSWORD=<your-password>
#   export MINIO_ROOT_PASSWORD=<your-password>
#   ... then: set -a; source .env; set +a; source setup.sh --summary
#
# GitHub Actions — add these as repository secrets and inject via `env:`:
#   POSTGRES_USER, POSTGRES_PASSWORD
#   MINIO_ROOT_USER, MINIO_ROOT_PASSWORD
#   RABBITMQ_USER, RABBITMQ_PASSWORD
#   HUGGINGFACE_TOKEN  (only needed for gated HuggingFace models)
# ==============================================================================

POSTGRES_USER=
POSTGRES_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

RABBITMQ_USER=
RABBITMQ_PASSWORD=

MQTT_USER=
MQTT_PASSWORD=

# Required only for gated HuggingFace models (e.g. Llama).
# Never commit a real token — export it in your shell or use a CI secret.
GATED_MODEL=false
HUGGINGFACE_TOKEN=
