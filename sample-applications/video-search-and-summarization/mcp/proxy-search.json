{
  "enabled": true,
  "server_name": "vss_search_proxy_mcp",
  "tool_prefix": "vss",
  "resource_scheme": "vss",
  "apis": {
    "GET /health": {
      "expose": "resource"
    },
    "GET /app/features": {
      "expose": "resource"
    },
    "GET /tags": {
      "expose": "resource"
    },
    "DELETE /tags/{tagId}": {
      "expose": "tool",
      "tool_name": "delete_tag"
    },
    "GET /videos": {
      "expose": "resource"
    },
    "GET /videos/{videoId}": {
      "expose": "resource"
    },
    "POST /videos/search-embeddings/{videoId}": {
      "expose": "tool",
      "tool_name": "create_video_search_embeddings"
    },
    "POST /search/query": {
      "expose": "tool",
      "tool_name": "run_search_query"
    },
    "GET /search/{queryId}": {
      "expose": "resource"
    }
  }
}
