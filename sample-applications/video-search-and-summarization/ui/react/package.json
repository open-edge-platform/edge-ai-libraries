{
  "name": "Pipeline Manager UI",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx,json,html,css,scss,yml,yaml,md}\"",
    "prettier:write": "prettier --write \"**/*.{js,jsx,ts,tsx,json,html,css,scss,yml,yaml,md}\" --ignore-unknown",
    "prepare": "husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,html,css,scss,yml,yaml,md}": [
      "npm run prettier:write"
    ]
  },
  "dependencies": {
    "@carbon/react": "^1.89.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.16.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "i18next": "^26.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "reselect": "^5.1.1",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/types": "^30.0.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-i18next": "^8.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "flatted": "^3.4.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.3",
    "sass": "^1.90.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
