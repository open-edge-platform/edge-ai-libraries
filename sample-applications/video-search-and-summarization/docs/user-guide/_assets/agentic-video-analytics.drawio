        <mxCell id="skills" value="&lt;b&gt;VSS skills&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;deploy · troubleshoot ·&lt;br&gt;upload · workflows&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
