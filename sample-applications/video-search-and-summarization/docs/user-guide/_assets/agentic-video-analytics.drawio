        <mxCell id="e-user-agent" value="asks" style="verticalAlign=bottom;spacingBottom=4;labelBackgroundColor=none;endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34495E;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="agent">
