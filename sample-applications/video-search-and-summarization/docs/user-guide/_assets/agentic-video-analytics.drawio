<mxfile host="drawio" agent="drawio-skill">
  <diagram id="agentic-vss" name="Agentic Video Analytics with VSS">
    <mxGraphModel dx="1200" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="380" math="0" shadow="0">
