        <mxCell id="capabilities" value="search · summary · live cameras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;dashed=1;fontSize=11;fontColor=#5B3F6E;" vertex="1" parent="vss-stack">
