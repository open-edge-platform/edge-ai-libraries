    "schemaVersion": "1.0",
    "description": "Harness-neutral discovery catalog for Chat Question-and-Answer Core workflow skills. Paths are relative to the repository root.",
    "skillsRoot": ".github/skills",
    "skills": [
        {
            "name": "chatqna-build",
            "path": ".github/skills/chatqna-build/SKILL.md",
            "description": "Build ChatQnA backend and UI Docker images from source using Docker or Docker Compose build workflows.",
            "triggers": [
                "build chatqna",
                "rebuild images",
                "build from source",
                "build backend image",
                "build ui image",
                "prepare images for deployment"
            ],
            "requires": [
                "docker/Dockerfile",
                "docker/Dockerfile.ollama",
                "ui/Dockerfile",
                "docker/compose.yaml",
                "docker"
            ]
        },
        {
            "name": "chatqna-docker-deploy",
            "path": ".github/skills/chatqna-docker-deploy/SKILL.md",
            "description": "Deploy, verify, and stop ChatQnA with Docker Compose for OpenVINO CPU or GPU and Ollama CPU runtime paths.",
            "triggers": [
                "deploy chatqna core",
                "start chatqna containers",
                "run docker compose",
                "openvino gpu deploy",
                "ollama deploy",
                "stop chatqna"
            ],
            "requires": [
                "scripts/setup_env.sh",
                "docker/compose.yaml",
                "docker compose",
                "curl"
            ]
        },
        {
            "name": "chatqna-helm-deploy",
            "path": ".github/skills/chatqna-helm-deploy/SKILL.md",
            "description": "Deploy ChatQnA to Kubernetes using Helm with runtime-specific values files, override mapping, verification, and uninstall workflows.",
            "triggers": [
                "deploy chatqna to kubernetes",
                "helm install chatqna-core",
                "helm upgrade chatqna-core",
