                "translate setup_env to helm",
                "uninstall helm release"
            ],
            "requires": [
                "chart/",
                "chart/values.yaml",
                "chart/values-openvino.yaml",
                "chart/values-ollama.yaml",
                "helm",
                "kubectl"
            ]
        },
        {
            "name": "chatqna-run-unit-tests",
            "path": ".github/skills/chatqna-run-unit-tests/SKILL.md",
            "description": "Run backend and UI unit tests with runtime-aware backend options, optional coverage, and concise pass or fail evidence.",
            "triggers": [
                "run unit tests",
                "run backend tests",
                "run ui tests",
                "run pytest",
                "run vitest",
                "run test coverage"
            ],
            "requires": [
                "tests/",
                "ui/src/tests/",
                "pyproject.toml",
                "ui/package.json",
                "uv",
                "npm"
            ]
        },
        {
            "name": "chatqna-api-smoke-test",
            "path": ".github/skills/chatqna-api-smoke-test/SKILL.md",
            "description": "Run curl-based smoke validation for ChatQnA REST APIs including health, chat, documents, and runtime-specific endpoints.",
            "triggers": [
                "smoke test api",
                "validate endpoints",
                "check chat endpoint",
                "verify docs endpoint",
                "check openapi json",
                "api health check"
            ],
            "requires": [
                "docs/user-guide/api-reference.md",
                "docs/user-guide/_assets/chatqna-api.yml",
                "docker/compose.yaml",
                "curl"
            ]
        }
