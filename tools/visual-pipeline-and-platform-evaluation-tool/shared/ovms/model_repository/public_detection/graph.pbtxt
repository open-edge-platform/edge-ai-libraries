# Public OVMS MediaPipe calculators for SSD Lite detection and rendered labels.
input_stream: "IMAGE:input"
output_stream: "IMAGE:annotated_image"

node {
  calculator: "OpenVINOModelServerSessionCalculator"
  output_side_packet: "SESSION:detection_session"
  node_options: {
    [type.googleapis.com/mediapipe.OpenVINOModelServerSessionCalculatorOptions]: {
      servable_name: "public_ssdlite_object_detection"
      servable_version: "1"
    }
  }
}

node {
  calculator: "ImageTransformationCalculator"
  input_stream: "IMAGE:input"
  output_stream: "IMAGE:detection_image"
  node_options: {
    [type.googleapis.com/mediapipe.ImageTransformationCalculatorOptions] {
      output_width: 320
      output_height: 320
    }
  }
}

node {
  calculator: "OpenVINOConverterCalculator"
  input_stream: "IMAGE:detection_image"
  output_stream: "TENSORS:detection_tensor"
  node_options: {
    [type.googleapis.com/mediapipe.OpenVINOConverterCalculatorOptions] {
      enable_normalization: true
      zero_center: true
    }
  }
}

node {
  calculator: "OpenVINOInferenceCalculator"
  input_side_packet: "SESSION:detection_session"
  input_stream: "OVTENSORS:detection_tensor"
  output_stream: "OVTENSORS2:detection_tensors"
  node_options: {
    [type.googleapis.com/mediapipe.OpenVINOInferenceCalculatorOptions] {
      input_order_list: "normalized_input_image_tensor"
      output_order_list: "raw_outputs/box_encodings"
      output_order_list: "raw_outputs/class_predictions"
    }
  }
}

node {
  calculator: "SsdAnchorsCalculator"
  output_side_packet: "anchors"
  node_options: {
    [type.googleapis.com/mediapipe.SsdAnchorsCalculatorOptions] {
      num_layers: 6
      min_scale: 0.2
      max_scale: 0.95
      input_size_height: 320
      input_size_width: 320
      anchor_offset_x: 0.5
      anchor_offset_y: 0.5
      strides: 16
      strides: 32
      strides: 64
      strides: 128
      strides: 256
      strides: 512
      aspect_ratios: 1.0
      aspect_ratios: 2.0
      aspect_ratios: 0.5
      aspect_ratios: 3.0
      aspect_ratios: 0.3333
      reduce_boxes_in_lowest_layer: true
    }
  }
}

node {
  calculator: "OpenVINOTensorsToDetectionsCalculator"
  input_stream: "TENSORS:detection_tensors"
  input_side_packet: "ANCHORS:anchors"
  output_stream: "DETECTIONS:detections"
  node_options: {
    [type.googleapis.com/mediapipe.OpenVINOTensorsToDetectionsCalculatorOptions] {
      num_classes: 91
      num_boxes: 2034
      num_coords: 4
      ignore_classes: 0
      apply_exponential_on_box_size: true
      x_scale: 10.0
      y_scale: 10.0
      h_scale: 5.0
      w_scale: 5.0
    }
  }
}

node {
  calculator: "NonMaxSuppressionCalculator"
  input_stream: "detections"
  output_stream: "filtered_detections"
  node_options: {
    [type.googleapis.com/mediapipe.NonMaxSuppressionCalculatorOptions] {
      min_suppression_threshold: 0.4
      min_score_threshold: 0.6
      max_num_detections: 5
      overlap_type: INTERSECTION_OVER_UNION
    }
  }
}

node {
  calculator: "DetectionLabelIdToTextCalculator"
  input_stream: "filtered_detections"
  output_stream: "labeled_detections"
  node_options: {
    [type.googleapis.com/mediapipe.DetectionLabelIdToTextCalculatorOptions] {
      label_map_path: "/models/model_repository/public_detection/ssdlite_object_detection_labelmap.txt"
    }
  }
}

node {
  calculator: "DetectionsToRenderDataCalculator"
  input_stream: "DETECTIONS:labeled_detections"
  output_stream: "RENDER_DATA:render_data"
  node_options: {
    [type.googleapis.com/mediapipe.DetectionsToRenderDataCalculatorOptions] {
      color {
        r: 255
        g: 220
        b: 0
      }
      thickness: 3.0
    }
  }
}

node {
  calculator: "AnnotationOverlayCalculator"
  input_stream: "IMAGE:input"
  input_stream: "render_data"
  output_stream: "IMAGE:annotated_image"
}