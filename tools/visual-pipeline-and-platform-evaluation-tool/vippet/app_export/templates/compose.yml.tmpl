#
# Generated by ViPPET "Export as app". Start the app with ./start_app.sh: it
# writes the host user, render group and ports to .env, which compose reads.
name: @NAME@

services:
  # RTSP server for the "rtsp" output: rtsp://localhost:${RTSP_PORT}/<name>
  mediamtx:
    image: @MEDIAMTX_IMAGE@
    ports:
      - "${RTSP_PORT:-18554}:8554"
    restart: unless-stopped

  # DL Streamer Pipeline Server 2.0: runs the pipelines started by ./run.sh.
  dlstreamer-pipeline-server:
    image: ${DLSPS2_IMAGE:-@DLSPS2_IMAGE@}
    # The host user, so that ./output stays writable and owned by you.
    user: "${APP_UID:-1000}:${APP_GID:-1000}"
    ports:
      # The REST API has no authentication, so it is published on localhost only.
      - "127.0.0.1:${REST_PORT:-18080}:8080"
    environment:
      REST_SERVER_PORT: "8080"
      APP_LOG_LEVEL: ${APP_LOG_LEVEL:-INFO}
      GST_DEBUG: "1"
      no_proxy: "${no_proxy:+${no_proxy},}localhost,127.0.0.1,mediamtx"
      NO_PROXY: "${no_proxy:+${no_proxy},}localhost,127.0.0.1,mediamtx"
    volumes:
      - ./assets/models:/models:ro
      - ./assets/videos:/videos:ro
      - ./output:/output
    tmpfs:
      - /tmp
      - /var/tmp
@DEVICES_BLOCK@
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request as u; u.build_opener(u.ProxyHandler({})).open('http://127.0.0.1:8080/pipelines/status', timeout=5)"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s
    depends_on:
      - mediamtx
    restart: on-failure:5
