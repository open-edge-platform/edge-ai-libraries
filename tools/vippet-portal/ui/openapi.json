    "/api/v1/benchmarks/runs": {
      "get": {
        "tags": ["benchmarks"],
        "summary": "Get Benchmark Runs",
        "description": "Every benchmark suite run known to every enabled instance.",
        "operationId": "get_benchmark_runs",
