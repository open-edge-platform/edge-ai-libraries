#
# Force LF regardless of the checking-out platform/core.autocrlf setting --
# a CRLF-corrupted shell script fails with confusing bash syntax errors
# ("unexpected token `$'{\r''") only on Linux, not on the Windows dev
# machine where it's easy to introduce and easy to miss.
*.sh text eol=lf
*.md text eol=lf
.gitattributes text eol=lf
