  "outputs": [
    {
      "id": "install",
      "label": "Install",
      "fallback": "Select a module to see a command…",
      "rules": [
        {
          "when": {
            "PROFILE": "computer_vision",
            "OP_SYSTEM": "UBUNTU_24_04"
          },
          "text": "curl -fsSL https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/refs/heads/main/frameworks/oep-installer-cli/rendered/openedge-cli | bash -s -- install computer_vision"
        },
        {
          "when": {
            "PROFILE": "computer_vision",
            "OP_SYSTEM": "UBUNTU_26_04"
          },
          "text": "curl -fsSL https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/refs/heads/main/frameworks/oep-installer-cli/rendered/openedge-cli | bash -s -- install computer_vision"
        },
        {
          "when": {
            "PROFILE": "inferencing",
            "OP_SYSTEM": "UBUNTU_24_04"
          },
          "text": "curl -fsSL https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/refs/heads/main/frameworks/oep-installer-cli/rendered/openedge-cli | bash -s -- install inferencing"
        },
        {
          "when": {
            "PROFILE": "inferencing",
            "OP_SYSTEM": "UBUNTU_26_04"
          },
          "text": "curl -fsSL https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/refs/heads/main/frameworks/oep-installer-cli/rendered/openedge-cli | bash -s -- install inferencing"
        },
        {
          "when": {
            "OP_SYSTEM": "UBUNTU_24_04"
          },
          "text": "curl -sSfL https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/refs/heads/main/frameworks/oep-installer-cli/rendered/openedge-cli | bash -s -- install {{MODULE}}"
        },
        {
          "when": {
            "OP_SYSTEM": "UBUNTU_26_04"
          },
          "text": "curl -sSfL https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/refs/heads/main/frameworks/oep-installer-cli/rendered/openedge-cli | bash -s -- install {{MODULE}}"
        }
      ]
    },
    {
      "id": "nextsteps",
      "label": "Next Steps",
      "fallback": "Select a module to see next steps…",
      "startStop": {
        "start": "openedge-cli start {{MODULE}}",
        "stop": "openedge-cli stop {{MODULE}}"
      },
      "remove": "openedge-cli remove {{TARGET}}"
    },
