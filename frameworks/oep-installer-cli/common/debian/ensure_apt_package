
# install simple package
ensure_apt_install_package () {
  local module="${1%%=*}"
  if ensure_apt_is_installed "${@%%"*"}"; then
    echo "${*%%=*} $([ ${#*} -eq 1 ] && echo is || echo are) installed." >&2
  else
    ensure_prop set installed/${module//[^a-zA-Z0-9]/_}/owned true
    ensure_apt update
    ensure_apt install --no-install-recommends -y "$@"
  fi
}

# remove simple package
ensure_apt_remove_package () {
  local module="${1%%=*}"
  [ "$(ensure_prop get installed/${module//[^a-zA-Z0-9]/_}/owned)" = "true" ] || return 0
  ensure_apt autoremove -y "$@"
}

