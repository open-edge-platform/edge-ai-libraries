
ensure_apt_preference () {
  local pref_file=$1; shift
  # apt preference stanzas must be separated by a blank line; otherwise apt
  # merges them into one record and only the last Package/Pin pair applies
  local line first=1
  for line in "$@"; do
    [[ "$line" != Package:* ]] || [ $first -eq 1 ] || echo
    first=0
    echo "$line"
  done | ensure_sudo tee "$pref_file" > /dev/null
}

