
# apt with apt update executed only once
ensure_apt () {
  local no_proxy1=$(echo ${no_proxy:-$NO_PROXY} | tr ',' '\n' | grep -v -E '^[.]?intel.com$' | tr '\n' ',')
  case "$1" in
  update)
    # apt-get update got executed only once unless -y is specified
    [[ -e /dev/shm/apt_update && " $* " != *" -y "* ]] || ensure_sudo env DEBIAN_FRONTEND=noninteractive no_proxy=${no_proxy1%%,} NO_PROXY=${no_proxy1%%,} apt-get "$@"
    touch /dev/shm/apt_update
    ;;
  autoremove|remove|purge)
    # make sure the package list exists
    local package_list=()
    local options=()
    for v in ${*:2}; do
      if [[ "$v" = -* ]]; then
        options+=($v)
      else
        package_list+=($v)
      fi
    done
    if [ ${#package_list[*]} -gt 0 ]; then
      local valid_packages=($(dpkg-query -W -f='${db:Status-Status} ${Package}\n' "${package_list[@]}" 2>/dev/null | awk '$1!="not-installed"{print $2}'))
      if [ ${#valid_packages[*]} -gt 0 ]; then
        ensure_sudo env DEBIAN_FRONTEND=noninteractive no_proxy=${no_proxy1%%,} NO_PROXY=${no_proxy%%,} apt-get $1 -y ${options[*]} ${valid_packages[*]}
      fi
    fi
    ;;
  install) # apt-get update runs at least once on the system
    [ -e /dev/shm/apt_update ] || ensure_apt update -y
    ;;&
  *)
    ensure_sudo env DEBIAN_FRONTEND=noninteractive no_proxy=${no_proxy1%%,} NO_PROXY=${no_proxy%%,} apt-get -y "$@"
    ;;
  esac
}

# check pacakge installation. add =<version> to check version.
ensure_apt_is_installed () {
  for pkg in $*; do
    [ "$(dpkg-query -W -f='${db:Status-Status}' ${pkg%%=*} 2>/dev/null)" = "installed" ] || return 1
    [[ "$pkg" != *=* ]] || [[ "$(dpkg-query -W -f='${Version}' ${pkg%%=*} 2>/dev/null)" = "${pkg#*=}"* ]] || return 1
  done
}

# install simple package
ensure_apt_install_package () {
  if ensure_apt_is_installed "${@%%"*"}"; then
    echo "${*%%=*} is/are already installed. Skipping..."
  else
    ensure_apt update
    ensure_apt install --no-install-recommends -y "$@"
  fi
}

