
# create/destroy a tmpdir with trap to delete the folder on ERR
ensure_tmpdir () {
  # $1: op
  # $2: varname in create or tmpdir in destroy
  # $3: prefix in create
  # $4: /tmp
  case "$1" in
  create)
    printf -v $2 "%s" $(mktemp -d ${4:-/tmp}/openedge-cli-${3:-}.XXXXXX)
    ensure_trap "rm -rf ${!2} || ensure_sudo rm -rf ${!2}" ERR SIGINT EXIT
    ;;
  destroy)
    rm -rf "$2"
    ensure_trap - ERR SIGINT EXIT
    ;;
  esac
}

