
# collect groups created by modules. enforce them.
ensure_groups_prelude () {
  local groups=(docker: video: render:992)
  ensure_group_add ${groups[@]} || {
    echo -e "${red}Failed to acquire required groups; aborting.${reset}" 1>&2
    echo "If '$(id -un)' is a directory (LDAP/AD) account, local group membership" 1>&2
    echo "may not apply. Ask your administrator to add: ${groups[*]%:*}" 1>&2
    exit 3
  }

  # Process credentials -- no argument to id, deliberately.
  local g needed=0
  for g in ${groups[@]}; do
    id -nG | tr ' ' '\n' | grep -qx "${g%:*}" || { needed=1; break; }
  done
  [ $needed -eq 1 ] || return 0

  if [ -n "${OEP_GROUP_REEXEC:-}" ]; then
    echo -e "${yellow}groups still not effective after re-exec${reset}" 1>&2
    return 0
  fi

  subcommand_setup
  local installer="$HOME/.local/bin/$installer_name"
  [ -x "$installer" ] || {
    echo -e "${red}$installer not found; run 'setup' first${reset}" 1>&2
    exit 3
  }

  local args_str="$*"
  ensure_sudo setpriv --reuid "$(id -u)" --regid "$(id -g)" --groups "$(id -G "$(id -un)" | tr ' ' ',')" --inh-caps=-all bash -c "export OEP_GROUP_REEXEC=1;$installer ${args_str#setup }"
  local rc=$?
  [ $rc -le 250 ] || rc=1
  [ $rc -eq 0 ] || return $rc
  return 251
}

