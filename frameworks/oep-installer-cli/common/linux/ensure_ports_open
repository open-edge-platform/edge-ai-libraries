
# ensure ports are open
ensure_ports_open () {
  local ports="$1" out; shift
  for port in $ports; do
    if command -v ss > /dev/null; then
      out="$(ss -Hltn "sport = :$port")" || continue
      [ -n "$out" ] || continue
      printf "${red}port %s occupied${reset}\n%s\n" "$port" "$out" >&2
      "$@" || true
      [ -n "$(ss -Hltn "sport = :$port")" ] || continue
    elif command -v lsof > /dev/null; then
      ensure_sudo lsof -nP -i TCP:$port -s TCP:LISTEN || continue
      printf "${red}port %s occupied${reset}\n" "$port" >&2
      "$@" || true
      ensure_sudo lsof -nP -i TCP:$port -s TCP:LISTEN || continue
    else
      echo "Missing ss or lsof" 1>&2
      return 1
    fi
    echo "TCP port $port is occupied" 1>&2
    return 3
  done
}

