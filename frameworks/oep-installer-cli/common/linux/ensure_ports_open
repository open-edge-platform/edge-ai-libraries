
# ensure ports are open
ensure_ports_open () {
  local act_name="${1:?}"
  local name="${2:?}"
  shift 2

  case "$act_name" in
  install) ensure_prop set installed/$name/ports "$*";;
  start) ensure_prop set started/$name/ports "$*";;
  esac

  if command -v ss > /dev/null; then
    local port out stopper mname mpath
    for port in $*; do
      out="$(ss -Hltunp "sport = :$port")"
      [ -n "$out" ] || continue

      printf "${red}Port %s is occupied${reset}\n" "$port" >&2
      for mpath in $(ensure_prop find "installed/*/ports") $(ensure_prop find "started/*/ports"); do
        [[ " $(ensure_prop get $mpath) " = *" $port "* ]] || continue
        mname="${mpath#*/}"; mname="${mname%/*}"
        stopper="${_act_cache_functions[stop_$mname]:-}"
        [ -n "$stopper" ] || continue
        printf "${red}Stopping $mname to release port %s${reset}\n" "$port" >&2
        ( set -e; $stopper "$mname" -- ) >&2 || true
      done

      out="$(ss -Hltunp "sport = :$port")"
      [ -n "$out" ] || continue

      printf "${red}Port %s is occupied${reset}\n%s\n" "$port" "$out" >&2
      return 3
    done
  else
    printf "${red}Missing ss on the system${reset}\n" >&2
    return 1
  fi
}

