
# add version repository skillpath ...
# remove skillname ...
ensure_skills () {
  local op="$1"

  case "$op" in
  add)
    local version="${2:?}"
    local repository="${3:?}"
    shift 3

    local tmpdir agent p
    ensure_tmpdir create tmpdir skills
    ensure_git_export "$tmpdir" "$version" "$repository" "$@"
    mkdir -p "$HOME"/.agents/skills
    for p in "$@"; do
      [ ! -e "$HOME"/.agents/skills/"${p##*/}" ] || ensure_rm "$HOME"/.agents/skills/"${p##*/}"
      cp -r "$tmpdir/${p}" "$HOME"/.agents/skills
    done
    ensure_tmpdir destory "$tmpdir"
  
    for agent in .claude .cursor .copilot .codex; do
      [ -d "$HOME/$agent/skills" ] || continue
      for p in "${@##*/}"; do
        if [[ -e "$HOME/$agent/skills/$name" || -L "$HOME/$agent/skills/$name" ]]; then
          ensure_rm "$HOME/$agent/skills/$p"
        fi
        ln -sf "$HOME/.agents/skills/$p" "$HOME/$agent/skills/$p"
      done
    done
    ;;
  remove)
    set -x
    local name agent
    for agent in .agents .claude .cursor .copilot .codex; do
      for name in "${@##*/}"; do
        if [[ -e "$HOME/$agent/skills/$name" || -L "$HOME/$agent/skills/$name" ]]; then
          ensure_rm "$HOME/$agent/skills/$name"
        fi
      done
    done
    ;;
  esac
}

