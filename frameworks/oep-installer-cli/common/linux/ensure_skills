
# add version repository skillpath ...
# remove skillname ...
ensure_skills () {
  local op="$1"

  case "$op" in
  add)
    local version="${2:?}"
    local repository="${3:?}"
    shift 3

    local tmpdir p name
    ensure_tmpdir create tmpdir skills
    ensure_git_export "$tmpdir" "$version" "$repository" "$@"
    mkdir -p "$HOME"/.agents/skills
    for p in "$@"; do
      name="${p##*/}"
      if [[ -e "$HOME/.agents/skills/$name" || -L "$HOME/.agents/skills/$name" ]]; then
        ensure_rm "$HOME/.agents/skills/$name"
      fi
      cp -r "$tmpdir/$p" "$HOME"/.agents/skills
    done
    ensure_tmpdir destroy "$tmpdir"
    ;;
  remove)
    local name agent
    for name in "${@##*/}"; do
      if [[ -e "$HOME/.agents/skills/$name" || -L "$HOME/.agents/skills/$name" ]]; then
        ensure_rm "$HOME/.agents/skills/$name"
      fi
    done
    ;;
  esac
}

