
# Set HF_TOKEN as an environment variable
# Verify if model permissions are granted on the token
ensure_hf_token () {
  local models=($*)

  export HF_TOKEN
  if [ -z "$HF_TOKEN" ]; then
    if [ -r "$HOME"/.cache/huggingface/token ]; then
      export HF_TOKEN=$(< "$HOME"/.cache/huggingface/token)
    elif [ -r "$HOME"/.hf_token ]; then
      export HF_TOKEN=$(< "$HOME"/.hf_token)
    else
      export HF_TOKEN=$(grep -m1 -F '"HF_TOKEN":' "$HOME"/.vscode/launch.json > /dev/null 2>&1 || true)
    fi
  fi

  if ! ensure_hf_token_check_models "$@"; then
    [ -z "$HF_TOKEN" ] || { echo "Invalid or unauthroized HF_TOKEN" 1>&2; return 3; }

    # write an askpass helper
    local rundir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    [ -d "$rundir" ] && [ -w "$rundir" ] || rundir="$(ensure_project_path)/${installer_name:?}"
    mkdir -p "$rundir" 2>/dev/null || return 1
    {
      flock -w 300 -e 9 || { echo "ensure_hf_token: timed out waiting for another installer" >&2; return 1; }
      local askpass_helper="$rundir"/askpass-hftoken
      act_panelled_logs_askpass "$askpass_helper" HF_TOKEN || { echo "ensure_hf_token: failed to create askpass helper" >&2; return 1; }
      export HF_TOKEN="$("$askpass_helper" 'HF_TOKEN:' | tr -d '\n')"
    } 9< "$rundir"

    ensure_hf_token_check_models "$@"
  fi
}

# Verify if model permissions are granted on the token
ensure_hf_token_check_models () {
  local models=("$@")
  local model f
  for model in ${models[*]}; do
    local probes=()
    for f in $(curl -s -L "https://huggingface.co/api/models/${model}?full=tree" | tr ',' '\n' | grep -F '"rfilename":' | cut -f4 -d'"'); do
      case "$f" in
      *config.yaml|*config.json|*tokenizer.json)
        probes+=($f)
        break
        ;;
      esac
    done
    if [ ${#probes[*]} -eq 0 ]; then
      echo "No probe found with $model" 1>&2
      return 3
    fi
    for f in ${probes[*]}; do
      local code=$(curl -s -o /dev/null -w "%{http_code}" -L -r 0-0 -H "Authorization: Bearer $HF_TOKEN" https://huggingface.co/${model}/resolve/main/$f)
      case "$code" in
      200|206)
        continue
        ;;
      401|403|404) 
        echo "gated model: $model" 1>&2
        return 1
        ;;
      *)
        echo "Unknown probe code $code" 1>&2
        return 3
        ;;
      esac
    done
  done
  return 0
}

