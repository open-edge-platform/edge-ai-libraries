
# perform sudo in automation or in tty
ensure_sudo () {
  local askpass_helper="$HOME/.local/bin/$installer_name-askpass"
  if sudo -nv 2>/dev/null || sudo -n true 2>/dev/null; then
    # cached timestamp still valid or passwordless sudo: no password needed
    sudo "$@"
  elif [ -x "$askpass_helper" ]; then
    SUDO_ASKPASS="$askpass_helper" sudo -A "$@"
  elif [ -t 0 ]; then
    # genuine interactive terminal: safe to prompt for a password
    sudo "$@"
  else
    # No password available and no usable TTY (e.g. under the panelled UI or a
    # pipe/background job). Avoid hanging forever on a hidden password prompt.
    echo "ensure_sudo: sudo requires a password but none is available" 1>&2
    return 1
  fi
}

# the askpass helper
ensure_sudo_askpass_helper () {
  set -u
  cache=/dev/shm/openedge-cli-sudo-password-cache

  # 0) non-interactive / CI: env wins, no tty needed
  [ -z "${SUDO_PASSWORD:-}" ] || { printf '%s\n' "$SUDO_PASSWORD"; exit 0; }

  # 1) serialize: parallel components must not race to prompt
  exec 9>"$cache.lock" || exit 1
  flock 9 || exit 1

  # 2) someone already asked -> reuse, no second prompt
  [ -s "$cache" ] && { cat "$cache"; exit 0; }

  # 3) first real need. sudo's stdin/stdout are pipes; /dev/tty is not.
  exec 8<>/dev/tty 2>/dev/null || exit 1

  saved=$(stty -g <&8) || exit 1
  trap 'rm -f "$cache.prompt"; stty "$saved" <&8 2>/dev/null; printf "\033[%d;1H\033[K" "${rows:-1}" >&8' EXIT INT TERM
  stty -echo <&8

  # last row: _draw only ever writes rows 1..rows-1, so this is never repainted
  rows=$(stty size <&8 | cut -d' ' -f1)
  printf '%s' "$1" > "$cache.prompt"
  printf '\033[%d;1H\033[K%s' "$rows" "$1" >&8
  IFS= read -r pw <&8
  rm -f "$cache.prompt"
  printf '\033[%d;1H\033[K' "$rows" >&8

  # 4) cache on tmpfs, 0600, for the rest of the run
  (umask 077; printf '%s\n' "$pw" > "$cache")
  printf '%s\n' "$pw"
}

