
# --reinstall "$@"
ensure_parse_option () {
  local option="$1"; shift
  [[ " $* " = *" $option "* ]]
}

ensure_parse_reinstall () {
  ensure_parse_option --reinstall "$@"
}

# version --version=2026.2.0 "$@"
ensure_parse_value_option () {
  local key="$1"; shift
  local v v1 value=""
  for v in "$@"; do
    case "$v" in
    "--$key="*)
      value="${v#*=}"
      ;;
    "--$key")
      ;;
    *)
      if [ "$v1" = "--$key" ]; then
        value="$v"; v=""
      fi
      ;;
    esac
    v1="$v"
  done
  echo "$value"
}

# select --gpu/--npu from command line arguments
# default to best device for init and "" for start
# select devices: --devices=gpu,npu
ensure_parse_device () {
  local devices=($(ensure_parse_value_option devices --devices=cpu,gpu,npu "$@" | tr ',' ' '))
  local device=""
  ! ensure_parse_option cpu "${devices[@]}" || device=cpu
  [ ! -e /dev/accel/accel0 ] || ! ensure_parse_option npu "${devices[@]}" || device="npu"
  [ ! -e /dev/dri/renderD128 ] || ! ensure_parse_option gpu "${devices[@]}" || device="gpu"
  [ -n "$device" ] || {
    echo "No acceptable device device" >&2
    return 3
  }
  for d in "${devices[@]}"; do
    ! ensure_parse_option --$d "${@,,}" || device="$d"
  done
  echo "$device"
}


