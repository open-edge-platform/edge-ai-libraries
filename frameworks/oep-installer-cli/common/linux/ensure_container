
# start smart_parking [resources]
ensure_container_namespace () {
  local act_name="${1:?}"
  local name="${2:?}"
  shift 2

  case "$act_name" in
  install) ensure_prop set installed/$name/containers "$*" ;;
  start) ensure_prop set started/$name/containers "$*" ;;
  esac

  local container_resources=(
    $(docker ps --no-trunc --format '{{.Names}}' | tr ',' '\n' | sed 's/^/name:/')
    $(docker network ls --format '{{.Name}}' | sed 's/^/net:/')
    $(docker volume ls --format '{{.Name}}'  | sed 's/^/vol:/')
    $(ss -Hltun | awk '{p=$5; sub(/.*:/,"",p); if (!(p in seen)) {seen[p]; print "port:" p}}')
  )
  local c stopper mname mpath
  for c in "$@"; do
    [[ " ${container_resources[*]} " = *" $c "* ]] || continue

    printf "${red}%s is in conflict${reset}\n" "$c" >&2
    for mpath in $(ensure_prop find "installed/*/containers") $(ensure_prop find "started/*/containers"); do
      [[ " $(ensure_prop get "$mpath") " = *" $c "* ]] || continue
      mname="${mpath#*/}"; mname="${mname%/*}"
      stopper="${_act_cache_functions[stop_$mname]:-}"
      [ -n "$stopper" ] || continue
      printf "${red}Stopping $mname to release container %s${reset}\n" "$c" >&2
      ( set -e; $stopper "$mname" -- ) >&2 || true
    done

    container_resources=(
      $(docker ps --no-trunc --format '{{.Names}}' | tr ',' '\n' | sed 's/^/name:/')
      $(docker network ls --format '{{.Name}}' | sed 's/^/net:/')
      $(docker volume ls --format '{{.Name}}'  | sed 's/^/vol:/')
      $(ss -Hltun | awk '{p=$5; sub(/.*:/,"",p); if (!(p in seen)) {seen[p]; print "port:" p}}')
    )
    [[ " ${container_resources[*]} " = *" $c "* ]] || continue

    printf "${red}%s is occupied${reset}\n%s\n" "$c" "${container_resources[*]}" >&2
    return 3
  done
}

# [--project=<name>] [--with-external] [--excludes=,,] [yaml files]
ensure_container_parse_yaml () {
  python3 - "$@" <<'EOF'
import os, re, sys, yaml

class Override:
  def __init__(self, v): self.v = v
RESET = object()
def _reset(loader, node): return RESET
def _override(loader, node):
  if isinstance(node, yaml.MappingNode):  return Override(loader.construct_mapping(node, deep=True))
  if isinstance(node, yaml.SequenceNode): return Override(loader.construct_sequence(node, deep=True))
  return Override(loader.construct_scalar(node))
yaml.SafeLoader.add_constructor("!reset", _reset)
yaml.SafeLoader.add_constructor("!override", _override)

def strip(v):  # drop tag markers inside a value that wasn't merged
  if isinstance(v, Override): return strip(v.v)
  if isinstance(v, dict): return {k: strip(x) for k, x in v.items() if x is not RESET}
  if isinstance(v, list): return [strip(x) for x in v if x is not RESET]
  return None if v is RESET else v

def as_map(v):  # networks: [a, b] -> {a: {}, b: {}}
  return {k: {} for k in v} if isinstance(v, list) else (v or {})

def merge(base, over, key=None):
  if isinstance(over, Override): return strip(over.v)
  if key == "networks" and (isinstance(base, list) or isinstance(over, list)):
    base, over = as_map(base), as_map(over)
  if isinstance(base, dict) and isinstance(over, dict):
    out = dict(base)
    for k, v in over.items():
      if v is RESET: out.pop(k, None)
      elif k in out: out[k] = merge(out[k], v, k)
      else: out[k] = strip(v)
    return out
  if isinstance(base, list) and isinstance(over, list):
    out = list(base)
    for x in strip(over):
      if x not in out: out.append(x)
    return out
  return strip(over)

def load(path, seen=()):
  path = os.path.abspath(path)
  if path in seen: return {}
  with open(path) as f:
    d = yaml.safe_load(f) or {}
  model = {}
  for inc in d.pop("include", None) or []:   # Compose `include:`
    files = inc.get("path") if isinstance(inc, dict) else inc
    for p in ([files] if isinstance(files, str) else files or []):
      model = merge(model, load(os.path.join(os.path.dirname(path), p), seen + (path,)))
  return merge(model, d)

INNER = re.compile(r"\$\{([A-Za-z_]\w*)(?:(:?)([-?+])([^${}]*))?\}")
def resolve(v):
  if v is None: return None
  s = str(v).replace("$$", "\0")
  while (m := INNER.search(s)):
    if m.group(3) != "-": return None
    s = s[:m.start()] + m.group(4) + s[m.end():]
  if re.search(r"\$[A-Za-z_]", s): return None
  return s.replace("\0", "$")
def normalize(n):
  return re.sub(r"[^a-z0-9_-]", "", n.lower()).lstrip("_-")
def host_ports(p):
  if isinstance(p, int): return []
  if isinstance(p, dict):
    port = resolve(p.get("published"))
  else:
    s = resolve(p)
    if s is None: return []
    s = s.partition("/")[0]
    if s.startswith("["): s = s.partition("]:")[2]
    parts = s.rsplit(":", 2)
    port = parts[-2] if len(parts) >= 2 else None
  m = re.fullmatch(r"(\d+)(?:-(\d+))?", port or "")
  if not m: return []
  lo = int(m.group(1))
  return range(lo, int(m.group(2) or lo) + 1)

cli_project, paths, with_external, seen, model = None, [], False, set(), {}
for a in sys.argv[1:]:
  if a.startswith("--project="): cli_project = a.split("=", 1)[1]
  elif a.startswith("--excludes="):
    for p in a.split("=", 1)[1].split(','):
      seen.add(tuple(p.split(":")))
  elif a == "--with-external": with_external = True
  else: paths.append(a)
if not paths: sys.exit(0)

for path in paths:
  model = merge(model, load(path))

services = {n: s for n, s in (model.get("services") or {}).items() if isinstance(s, dict)}
networks = {k: (v or {}) for k, v in (model.get("networks") or {}).items()}
volumes  = {k: (v or {}) for k, v in (model.get("volumes") or {}).items()}

# Project name as `docker compose -f f1 -f f2 ...` picks it:
#   --project > COMPOSE_PROJECT_NAME > last `name:` among the -f files > first file's directory.
# `name:` from `include:` files is ignored.
top_name = None
for p in paths:
  with open(p) as f:
    n = (yaml.safe_load(f) or {}).get("name")
  if n is RESET: top_name = None
  elif n is not None: top_name = strip(n)
proj = (resolve(cli_project)
        or resolve(top_name)
        or os.path.basename(os.path.dirname(os.path.abspath(paths[0]))))
proj = normalize(proj)

def out(kind, v):
  if v is not None and (kind, v) not in seen:
    seen.add((kind, v)); print(f"{kind}:{v}")

needs_default = False
for n, s in services.items():
  if s.get("container_name"):
    out("name", resolve(s["container_name"]))
  else:
    r = resolve(s.get("scale") or (s.get("deploy") or {}).get("replicas") or 1)
    for i in range(1, (int(r) if str(r).isdigit() else 1) + 1):
      out("name", f"{proj}-{n}-{i}")
  if "network_mode" not in s and not s.get("networks"):
    needs_default = True
  for p in s.get("ports") or []:
    for port in host_ports(p):
      out("port", port)
if needs_default: networks.setdefault("default", {})
for kind, table in (("net", networks), ("vol", volumes)):
  for k, c in table.items():
    ext = c.get("external")
    if ext and not with_external: continue
    if isinstance(ext, dict) and ext.get("name"):
      name = resolve(ext["name"])
    elif c.get("name"):
      name = resolve(c["name"])
    else:
      name = k if ext else f"{proj}_{k}"
    out(kind, name)
EOF
}

# [resources]
ensure_container_cleanup () {
  local c
  for c in "$@"; do
    case "$c" in
    name:*) 
      echo "Cleaning up $c..." >&2
      docker container rm -v -f ${c#name:} > /dev/null || true
      ;;
    vol:*)
      echo "Cleaning up $c..." >&2
      docker volume rm -f ${c#vol:} > /dev/null || true
      ;;
    net:*)
      echo "Cleaning up $c..." >&2
      docker network rm -f ${c#net:} > /dev/null || true
      ;;
    esac
  done
  echo "Cleaning up anonymous volumes..." >&2
  docker volume prune -f > /dev/null || true
}

