
# start smart_parking [container-names]
ensure_container_namespace () {
  local act_name="${1:?}"
  local name="${2:?}"
  shift 2

  case "$act_name" in
  install) ensure_prop set installed/$name/containers "$*" ;;
  start) ensure_prop set started/$name/containers "$*" ;;
  esac

  local running_containers=" $(docker ps --format '{{.Names}}' | tr '\n' ' ') "
  local c stopper mname mpath
  for c in "$@"; do
    [[ "$running_containers" = *" $c "* ]] || continue

    printf "${red}Container %s is in conflict${reset}\n" "$c" >&2
    for mpath in $(ensure_prop find "installed/*/containers") $(ensure_prop find "started/*/containers"); do
      [[ " $(ensure_prop get "$mpath") " = *" $c "* ]] || continue
      mname="${mpath#*/}"; mname="${mname%/*}"
      stopper="${_act_cache_functions[stop_$mname]:-}"
      [ -n "$stopper" ] || continue
      printf "${red}Stopping $mname to release container %s${reset}\n" "$c" >&2
      ( set -e; $stopper "$mname" -- ) >&2 || true
    done

    running_containers=" $(docker ps --format '{{.Names}}' | tr '\n' ' ') "
    [[ "$running_containers" = *" $c "* ]] || continue

    printf "${red}Container %s is occupied${reset}\n" "$c" >&2
    docker ps >&2
    return 3
  done
}

# yaml files
ensure_container_parse_names () {
  awk '/^  *container_name: /{print$NF}' "$@" | tr '\n' ' '
}

