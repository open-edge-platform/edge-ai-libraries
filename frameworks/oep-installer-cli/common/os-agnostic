
# return the installation path
ensure_project_path () {
  echo "$HOME/open-edge-platform"
}

# perform sudo in automation or in tty
ensure_sudo () {
  if [ -n "$SUDO_PASSWORD" ]; then
    echo "$SUDO_PASSWORD" | sudo -S "$@"
  else
    sudo "$@"
  fi
}

# create/destroy a tmpdir with trap to delete the folder on ERR
ensure_tmpdir () {
  # $1: op
  # $2: varname in create or tmpdir in destroy
  # $3: prefix in create
  case "$1" in
  create)
    printf -v $2 "%s" $(mktemp -d /tmp/openedge-cli-${3:-}.XXXXXX)
    trap "ensure_sudo rm -rf ${!2}" ERR SIGINT EXIT
    ;;
  destroy)
    trap - ERR SIGINT EXIT
    rm -rf "$2"
    ;;
  esac
}

# sparse or full git clone
# full clone: <workspace> <version> <repository>
# sparse clone: <workspace> <version> <repository> <dirs> [<dirs>...]
ensure_git_clone () {
  local workspace="$1"
  local version="$2"
  local repository="$3"

  ensure_rmdir "$workspace"
  mkdir -p "$(dirname "$workspace")"
  if [ ${#@} -ge 4 ]; then
    # sparse checkout
    mkdir -p "$workspace"
    pushd "$workspace" > /dev/null
    git clone --filter=blob:none --no-checkout $repository .
    git sparse-checkout init --cone
    git sparse-checkout set "${@:4}"
    git checkout $version
    popd > /dev/null
  else
    # full checkout
    git clone -b $version --depth 1 $repository "$workspace"
    pushd "$workspace" > /dev/null
    [ ! -e .gitmodules ] || git submodule update --init --recursive
    popd > /dev/null
  fi
}

# return the current machine IP address
ensure_ip () {
  ip -4 addr show scope global | sed -n '/^[0-9]*:.*state UP/,/^[0-9]*:/{/^ *inet /{s|.*inet \([0-9.]*\).*|\1|;p}}' | head -n1
}

# completely remove dir
ensure_rmdir () {
  rm -rf "$1" 2> /dev/null || ensure_sudo rm -rf "$1"
}

# idempotently pull an image and (re)create a detached named container.
# generic helper for docker-image based ISV applications.
# $1: container name  $2: image reference  ${@:3}: extra "docker run" args
ensure_docker_container () {
  local name="$1"
  local image="$2"

  # already running or stopped-but-present: leave as-is
  if docker inspect "$name" > /dev/null 2>&1; then
    echo "Container $name already exists. Skipping create..."
    return 0
  fi

  echo "Pulling image $image (this may take several minutes for large images)..."
  docker pull "$image"
  docker run -dt --name "$name" "${@:3}" "$image"
}

# check disk space
ensure_disk_space () {
  local disk_size=$1            # in MB
  local disk_path="${2:-$HOME}" # optional disk path
  local disk_avail=$(df -h --output=avail "$disk_path" | awk '/[0-9]G/{a=$1*1000}/[0-9]M/{a=$1*1}/[0-9]K/{a=$1/1000}END{print int(a)}')
  if [ "$disk_size" -gt "$disk_avail" ]; then
    echo "Not enough disk space: required ${disk_size}MiB and available ${disk_avail}MiB"
    return 3
  fi
}

# show output in columns, allowing merged last row and ignoring color sequence
ensure_columns () {
  local sep=${1:-'|'}
  python3 -c '
import sys,re
ansi_re = re.compile(r"\x1b\[[0-9;]*[a-zA-Z]|\033\[[0-9;]*[a-zA-Z]")
rows=[line.strip().split(sys.argv[1]) for line in sys.stdin if line.strip()]
cols=max(len(r) for r in rows)
widths=[max((len(ansi_re.sub("",r[c])) for r in rows if c < len(r)-1),default=0) for c in range(cols-1)]
for r in rows:
  print((" "*2).join([r[i]+(" "*max(0,widths[i]-len(ansi_re.sub("",r[i])))) for i in range(len(r)-1)]+[r[-1]]))
' "$sep"
}

