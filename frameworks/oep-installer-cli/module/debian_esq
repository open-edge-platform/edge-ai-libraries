
configure_esq () {
  workspace="$(readlink -f ~)/openedge-catalog/esq"
}

debian_70_profile_esq () {
  echo "curl git libgl1 make edk docker uv"
}

debian_70_install_esq () {
  configure_uv
  if uv tool list 2> /dev/null | grep -q -E "^esq " && [[ "$*" != *"--reset-esq"* ]]; then
    echo "Esq is already installed. Skipping..."
  else
    curl -sL https://raw.githubusercontent.com/open-edge-platform/edge-system-qualification/refs/heads/main/scripts/system-setup.sh | ensure_sudo bash -s -- -f
    curl -sL https://raw.githubusercontent.com/open-edge-platform/edge-system-qualification/refs/heads/main/scripts/system-setup-advanced.sh | ensure_sudo bash -s -- -f
    uv tool install --force --refresh git+https://github.com/open-edge-platform/edge-system-qualification.git@main

    configure_esq
    mkdir -p "$workspace"
    echo "esq installed at $(which esq)"
    echo "esq workspace created at $workspace"
  fi
}

debian_70_start_esq () {
  local options=()
  for v in "$@"; do
    case "$v" in
    --all|-a|--qualification-only|-qo)
      options+=($v)
      ;;
    --profile=*|-p=*|--suite=*|-s=*|--sub-suite=*|-ss=*|--test=*|-t=*)
      options+=(${v/=/ })
      ;;
    esac
  done
  if [ ${#options[@]} -eq 0 ]; then
    options=(-qo)
  fi

  configure_uv
  configure_esq
  pushd "$workspace" > /dev/null
  esq clean --all
  esq run -f ${options[@]}
  esq summary
  esq report
  popd > /dev/null
}

debian_70_remove_esq () {
  configure_uv
  configure_esq
  ensure_rmdir "$workspace"
  esq clean --all
  uv tool uninstall --force esq || true
}
