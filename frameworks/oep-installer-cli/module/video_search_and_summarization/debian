
configure_video_search_and_summarization () {
  workspace="$(ensure_project_path)/video-search-and-summarization"
  version="$(ensure_parse_value_option version --version=2026.3.0-rc1 "$@")"
  repository="https://github.com/open-edge-platform/edge-ai-libraries.git"
  skills=(vss-search-index vss-summarize-video)

  export APP_HOST_PORT=${APP_HOST_PORT:-12345}
  used_ports=($APP_HOST_PORT 3001 7890 6016 6008 8999 9777 8300 9300 8090 4001 4002 55555 9090 9273 5432 1883 5672 8640)

  [ ! -r "$workspace"/.device_from_install ] || set -- "$@" "--$(< "$workspace"/.device_from_install)"
  local device=$(ensure_parse_device "$@")

  export VLM_MODEL_NAME=OpenVINO/Qwen3.5-4B-int8-ov
  export ENABLED_WHISPER_MODELS=tiny.en,small.en,medium.en
  export OD_MODEL_NAME=yolov8l
  export ASR_MODEL=whisper-base
  export TEXT_EMBEDDING_MODEL=QwenText/qwen3-embedding-0.6b
  export OVMS_LLM_MODEL_NAME=OpenVINO/Qwen3-4B-int8-ov

  export PM_AUDIO_USE_FULL_TRANSCRIPT_SUMMARY=false
  export MULTIMODAL_EMBEDDING_MODEL=CLIP/clip-vit-b-32
  export FRAME_INTERVAL=15
  export MM_DATAPREP_ALLOW_DUPLICATE_UPLOADS=true
  export ROI_CONSOLIDATION_ENABLED=true
  export ROI_CONSOLIDATION_IOU_THRESHOLD=0.2
  export ROI_CONSOLIDATION_CLASS_AWARE=false
  export ROI_CONSOLIDATION_CONTEXT_SCALE=0.2
  export ENABLE_METRICS_MANAGER=true
  export PM_VLM_CONCURRENT=6
  export PM_LLM_CONCURRENT=1
  export VLM_COMPRESSION_WEIGHT_FORMAT=int4
  export LLM_COMPRESSION_WEIGHT_FORMAT=int4
  export SDK_USE_OPENVINO=true
  export DATAPREP_DETECTION_MODEL=OpenVINO/yolox_s-int8-ov
  export DATAPREP_EMBEDDING_DEVICE=${device^^}
  export DATAPREP_DETECTION_DEVICE=${device^^}
  export MME_EMBEDDING_DEVICE=${device^^}
  export VLM_TARGET_DEVICE=${device^^}
  export HF_HUB_CACHE="$workspace"/sample-applications/video-search-and-summarization/.cache
  export LLM_TARGET_DEVICE=${device^^}
  export PM_MULTI_FRAME_COUNT=34
  export ENABLE_EMBEDDING_GPU=$([ "$device" = "gpu" ] && echo true || echo false)
  export EMBEDDING_PROCESSING_MODE=sdk
  export ENABLE_OBJECT_DETECTION=false
  export MINIO_ROOT_USER=$(cat /dev/random | tr -dc a-z | head -c 5)
  export MINIO_ROOT_PASSWORD=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
  export POSTGRES_USER=$(cat /dev/random | tr -dc a-z | head -c 5)
  export POSTGRES_PASSWORD=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
  export RABBITMQ_USER=$(cat /dev/random | tr -dc a-z | head -c 5)
  export RABBITMQ_PASSWORD=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
  export REGISTRY_URL=intel
  export TAG="$version"
}

configure_video_search_and_summarization_gated () {
  ensure_hf_token $VLM_MODEL_NAME ${TEXT_EMBEDDING_MODEL/QwenText/Qwen} $OVMS_LLM_MODEL_NAME
  export HUGGINGFACE_TOKEN="$HF_TOKEN"
  export GATED_MODEL=$([ -n "$HF_TOKEN" ] && echo true || echo false)
}

verify_video_search_and_summarization () {
  local files_to_check=(
    ov_models/object-detection/ultralytics/public/yolov8l/FP32/yolov8l.bin
    ov_models/object-detection/ultralytics/public/yolov8l/FP16/yolov8l.bin
    ov_models/ovms/openvino_models/gpu/int8/OpenVINO/Qwen3-4B-int8-ov/openvino_model.bin
    ov_models/ovms/openvino_models/gpu/int8/OpenVINO/Qwen3.5-4B-int8-ov/openvino_language_model.bin
  )
  for f in "${files_to_check[@]}"; do
    [ -e "$workspace"/sample-applications/video-search-and-summarization/$f ] || {
      echo "Missing $f" >&2
      return 1
    }
  done
}

debian_85_profile_video_search_and_summarization () {
  echo "git curl gawk python3_venv edge_base docker_io"
}

debian_85_install_video_search_and_summarization () {
  configure_video_search_and_summarization "$@"
  if verify_video_search_and_summarization && ! ensure_parse_reinstall "$@"; then
    echo "Video Search and Summarization is installed." >&2
  else
    ensure_disk_size 8000
    ensure_ports_open install video_search_and_summarization "${used_ports[@]}"
    ensure_container_namespace install video_search_and_summarization name:vss-model-download

    echo "@@STEP Cloning repository"
    ensure_git_export "$workspace" release-${version%-rc*} $repository sample-applications/video-search-and-summarization

    echo "@@STEP Configuring models"
    configure_video_search_and_summarization_gated

    echo "@@STEP Setting up VSS"
    echo "@@STEP @@IF [[]model-download] [^(]+ [(]([^)]+)[)]: queued @@THEN Downloading \\1"
    echo "@@STEP @@IF docker compose .* pull .* @@THEN Pulling images"
    cd "$workspace"/sample-applications/video-search-and-summarization
    sed -i "s|export HOST_IP=.*|export HOST_IP=$(ensure_ip)|" setup.sh
    sed 's|FINAL_ARGS=.*|FINAL_ARGS=(pull --ignore-pull-failures)|' setup.sh > .setup.sh
    sed -i 's|"Unified Summarization/Search UI is now available.*"|""|' .setup.sh
    . ./.setup.sh --search-and-summary

    echo "@@STEP Installing skills"
    ensure_skills add -- "${skills[@]/#/.github/skills/}"

    verify_video_search_and_summarization
  fi

  local device=$(ensure_parse_device "$@")
  echo "$device" > "$workspace"/.device_from_install

  echo "@@HIGHLIGHT workspace: ${workspace/#"$HOME"/"~"}"
  echo "@@HIGHLIGHT start|stop|remove"
}

debian_85_start_video_search_and_summarization () {
  configure_video_search_and_summarization "$@"
  ensure_ports_open start video_search_and_summarization "${used_ports[@]}"
  ensure_container_namespace start video_search_and_summarization $(ensure_container_parse_yaml "$workspace"/sample-applications/video-search-and-summarization/docker/*.yaml)

  configure_video_search_and_summarization_gated
  cd "$workspace"/sample-applications/video-search-and-summarization
  . ./setup.sh --search-and-summary

  echo "@@HIGHLIGHT URL: http://$(ensure_ip):${APP_HOST_PORT}"
  echo "@@HIGHLIGHT stop|remove"
}

debian_85_stop_video_search_and_summarization () {
  configure_video_search_and_summarization "$@" || true

  docker rm -f vss-model-download || true
  cd "$workspace"/sample-applications/video-search-and-summarization && {
    . ./setup.sh --stop || true
    . ./setup.sh --clean-data || true
    ensure_container_cleanup $(ensure_container_parse_yaml docker/*.yaml) 
  } || true
}

debian_85_remove_video_search_and_summarization () {
  debian_85_stop_video_search_and_summarization "$@"
  ensure_rm "$workspace" || true
  ensure_skills remove "${skills[@]}"
}
