
debian_60_profile_core_types () {
  [ "$1" != "install" ] || echo "cpuid curl"
}

debian_60_install_core_types () {
  if [ -e /etc/core-types ] && [[ " $* " != *" --reinstall "* ]]; then
    echo "/etc/core-types exists." >&2
  else
    ensure_prop set installed/core_types/owned true

    local script="https://raw.githubusercontent.com/open-edge-platform/edge-workloads-and-benchmarks/refs/heads/main/utils/obtain_cores.sh"

    set -o pipefail
    ensure_fetch "$script" - | bash | sed -n -E 's/^[[:space:]]*([a-zA-Z0-9_-]+)[[:space:]]*:[[:space:]]*(.*)/\U\1\E=\2/p' | ensure_sudo tee /etc/core-types
    echo "@@HIGHLIGHT Core types are detected and written to /etc/core-types"
  fi
}

debian_60_remove_core_types () {
  # leave untouched if not written by core_types
  [ "$(ensure_prop get installed/core_types/owned)" = "true" ] || return 0
  ensure_rm /etc/core-types
}

