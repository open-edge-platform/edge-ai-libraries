
debian_15_profile_core_types () {
  echo "cpuid curl"
}

debian_15_install_core_types () {
  [ ! -e /etc/core-types ] || [[ " $* " = *" --reset-core_types "* ]] || return 0

  local script="https://raw.githubusercontent.com/open-edge-platform/edge-workloads-and-benchmarks/refs/heads/main/utils/obtain_cores.sh"
  curl -sSL $script | bash | sed -n -E 's/^[[:space:]]*([a-zA-Z0-9_-]+)[[:space:]]*:[[:space:]]*(.*)/\U\1\E=\2/p' | ensure_sudo tee /etc/core-types
}

