
# Autonomous Mobile Robot (AMR) - the Robotics AI Suite ROS 2 SDK for
# sensing, perception, SLAM & mapping, navigation, and the Wandering app.
# https://docs.openedgeplatform.intel.com/dev/edge-ai-suites/robotics-ai-suite/robotics/index.html
configure_autonomous_mobile_robot () {
  case "$VERSION_CODENAME" in
  jammy) ros_distro=humble ;;
  noble) ros_distro=jazzy ;;
  *)     ros_distro=jazzy ;;
  esac
  # standard SDK by default; pass --complete for the full (~20GB) SDK
  # (an installed complete SDK also satisfies a standard SDK request)
  amr_sdk_pkg=ros-$ros_distro-robotics-sdk
  if [[ " $* " = *" --complete "* ]] || ensure_apt_is_installed ros-$ros_distro-robotics-sdk-complete; then
    amr_sdk_pkg=ros-$ros_distro-robotics-sdk-complete
  fi
  # Collaborative SLAM acceleration variants:
  #   lze  -> Intel GPU (Level-Zero)   avx2 -> Intel Core CPU   sse -> Atom/default
  amr_slam_pkgs=(ros-$ros_distro-collab-slam-lze ros-$ros_distro-collab-slam-avx2 ros-$ros_distro-collab-slam-sse)
}

# select the Collaborative SLAM variant for the device (GPU, CPU or NPU)
configure_autonomous_mobile_robot_slam () {
  local device="$1"
  amr_slam_pkg=ros-$ros_distro-collab-slam-sse
  if [ "$device" = GPU ]; then
    amr_slam_pkg=ros-$ros_distro-collab-slam-lze
  elif grep -q -w avx2 /proc/cpuinfo; then
    amr_slam_pkg=ros-$ros_distro-collab-slam-avx2
  fi
}

configure_autonomous_mobile_robot_device () {
  configure_autonomous_mobile_robot_slam "$1"
  ensure_apt_is_installed "$amr_slam_pkg" && return 0

  ensure_apt remove -y $(printf '%s\n' "${amr_slam_pkgs[@]}" | grep -v -x -F "$amr_slam_pkg")
  ensure_apt install -y "$amr_slam_pkg"
  ensure_apt_is_installed "$amr_slam_pkg"
}

debian_90_profile_autonomous_mobile_robot () {
  echo "git curl edge_base_robotics"
}

verify_autonomous_mobile_robot () {
  configure_autonomous_mobile_robot "$@"
  ensure_apt_is_installed $amr_sdk_pkg
}

debian_90_install_autonomous_mobile_robot () {
  configure_autonomous_mobile_robot "$@"

  if verify_autonomous_mobile_robot "$@" && [[ " $* " != *" --reinstall "* ]]; then
    echo "Autonomous Mobile Robot is already installed. Skipping..."
  else
    # declare ownership
    ensure_prop set installed/autonomous_mobile_robot/owned true

    ensure_disk_size $([[ "$amr_sdk_pkg" = *complete ]] && echo 40000 || echo 15000)

    ensure_oneapi_ros_openvino

    ensure_apt update -y
    ensure_osrf_gazebo_ros2

    # Intel oneAPI requires GCC >= 12 on Ubuntu 22.04 / Humble
    if [ "$ros_distro" = humble ]; then
      ensure_apt install -y gcc-12 g++-12
      ensure_sudo update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 60 --slave /usr/bin/g++ g++ /usr/bin/g++-12
    fi

    # the Autonomous Mobile Robot SDK meta-package
    ensure_apt install -y "$amr_sdk_pkg"

    verify_autonomous_mobile_robot "$@"
  fi

  # Collaborative SLAM variant (default: GPU if available)
  local device=$(ensure_select_device "$@")
  configure_autonomous_mobile_robot_device "${device^^}"

  echo "@@HIGHLIGHT Autonomous Mobile Robot ($amr_sdk_pkg, $amr_slam_pkg) installed for ROS 2 $ros_distro"
  echo "@@HIGHLIGHT shell env @source /opt/ros/$ros_distro/setup.bash"
  echo "@@HIGHLIGHT tutorials @https://docs.openedgeplatform.intel.com/dev/edge-ai-suites/robotics-ai-suite/robotics/dev_guide/index_tutorials.html"
  echo "@@HIGHLIGHT $installer_name install [--complete] [--gpu|cpu]"
  echo "@@HIGHLIGHT $installer_name remove"
}

debian_90_remove_autonomous_mobile_robot () {
  # leave untouched if not installed by autonomous_mobile_robot
  [ "$(ensure_prop get installed/autonomous_mobile_robot/owned)" = "true" ] || return 0

  configure_autonomous_mobile_robot
  if ensure_apt_is_installed ros-$ros_distro-robotics-sdk || ensure_apt_is_installed ros-$ros_distro-robotics-sdk-complete; then
    ensure_apt autoremove -m -y \
      ros-$ros_distro-robotics-sdk ros-$ros_distro-robotics-sdk-complete "${amr_slam_pkgs[@]}" || true
    verify_robotics_in_use_ros_openvino || remove_osrf_gazebo_ros2
    remove_oneapi_ros_openvino
  else
    echo "Autonomous Mobile Robot already removed. Skipping"
  fi
}

debian_90_sbom_autonomous_mobile_robot () {
  configure_autonomous_mobile_robot "$@"
  local device=$(ensure_select_device "$@")
  configure_autonomous_mobile_robot_slam "${device^^}"

  sbom_oneapi_ros_openvino
  echo "---"

  # Intel oneAPI requires GCC >= 12 on Ubuntu 22.04 / Humble
  if [ "$ros_distro" = humble ]; then
    ensure_sbom_format pkg-list gcc-12 g++-12
    echo "---"
  fi

  sbom_osrf_gazebo_ros2
  echo "---"

  ensure_sbom_format pkg-list $amr_sdk_pkg $amr_slam_pkg
}
