
# Autonomous Mobile Robot (AMR) - the Robotics AI Suite ROS 2 SDK for
# sensing, perception, SLAM & mapping, navigation, and the Wandering app.
# https://docs.openedgeplatform.intel.com/dev/edge-ai-suites/robotics-ai-suite/robotics/index.html
configure_autonomous_mobile_robot () {
  case "$VERSION_CODENAME" in
  jammy) ros_distro=humble ;;
  noble) ros_distro=jazzy ;;
  *)     ros_distro=jazzy ;;
  esac
  # standard SDK by default; pass --complete for the full (~20GB) SDK
  amr_sdk_pkg=ros-$ros_distro-robotics-sdk

  # Intel oneAPI Base Toolkit repo + version pins - the robotics SDK links the
  # oneAPI runtime/compiler/MKL packages. Previously provided by amr_apt_repo.
  oneapi_repo_name="apt.repos.intel.com"
  oneapi_key_url="https://$oneapi_repo_name/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB"
  oneapi_key_file=/usr/share/keyrings/oneapi-archive-keyring.gpg
  oneapi_list=/etc/apt/sources.list.d/oneAPI.list
  oneapi_pref=(
    "Package: intel-oneapi-runtime-*"
    "Pin: version 2025.3.*"
    "Pin-Priority: 1001"
    "Package: intel-oneapi-compiler-*"
    "Pin: version 2025.3.*"
    "Pin-Priority: 1001"
    "Package: intel-oneapi-mkl-*"
    "Pin: version 2025.3.*"
    "Pin-Priority: 1001"
  )
  oneapi_pref_file=/etc/apt/preferences.d/oneapi
  oneapi_deb_entry="deb [signed-by=$oneapi_key_file] https://$oneapi_repo_name/oneapi all main"
}

debian_90_profile_autonomous_mobile_robot () {
  echo "git curl edge_base ros2 ros_openvino realsense"
}

verify_autonomous_mobile_robot () {
  configure_autonomous_mobile_robot
  ensure_apt_is_installed ros-$ros_distro-robotics-sdk || \
  ensure_apt_is_installed ros-$ros_distro-robotics-sdk-complete
}

# add the OSRF Gazebo apt repository (needed for the robotics-sdk dependencies)
configure_osrf_gazebo () {
  osrf_name=packages.osrfoundation.org
  osrf_key_url="https://$osrf_name/gazebo.gpg"
  osrf_key=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg
  osrf_entry="deb [signed-by=$osrf_key] https://$osrf_name/gazebo/$ID-stable $VERSION_CODENAME main"
  osrf_list=/etc/apt/sources.list.d/gazebo-stable.list
}

amr_setup_osrf_gazebo () {
  configure_osrf_gazebo
  ensure_apt install -y curl lsb-release gnupg
  ensure_apt_key "$osrf_key" "$osrf_key_url"
  ensure_apt_source "$osrf_list" "$osrf_entry"
  ensure_apt update -y
  [ "$ros_distro" != jazzy ] || ensure_apt install -y gz-harmonic || true
}

debian_90_install_autonomous_mobile_robot () {
  configure_autonomous_mobile_robot
  [[ " $* " != *" --complete "* ]] || amr_sdk_pkg=ros-$ros_distro-robotics-sdk-complete

  if verify_autonomous_mobile_robot && [[ " $* " != *" --reset-autonomous_mobile_robot "* ]]; then
    echo "Autonomous Mobile Robot is already installed. Skipping..."
  else
    ensure_disk_space $([[ "$amr_sdk_pkg" = *complete ]] && echo 40000 || echo 15000)

    # Intel oneAPI Base Toolkit apt repo (signing key + source + version pins)
    ensure_apt install -y software-properties-common curl gnupg wget
    ensure_apt_key "$oneapi_key_file" "$oneapi_key_url" --dearmor
    ensure_apt_source "$oneapi_list" "$oneapi_deb_entry"
    ensure_apt_preference "$oneapi_pref_file" "${oneapi_pref[@]}"

    ensure_apt update -y

    amr_setup_gazebo

    # Intel oneAPI requires GCC >= 12 on Ubuntu 22.04 / Humble
    if [ "$ros_distro" = humble ]; then
      ensure_apt install -y gcc-12 g++-12
      ensure_sudo update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 60 --slave /usr/bin/g++ g++ /usr/bin/g++-12
    fi

    # the Autonomous Mobile Robot SDK meta-package
    ensure_apt install -y "$amr_sdk_pkg"

    # Collaborative SLAM acceleration variant, selected by hardware capability:
    #   lze  -> Intel GPU (Level-Zero)   avx2 -> Intel Core CPU   sse -> Atom/default
    local slam_pkg=ros-$ros_distro-collab-slam-sse
    grep -q -w avx2 /proc/cpuinfo && slam_pkg=ros-$ros_distro-collab-slam-avx2
    [ -e /dev/dri/renderD128 ] && slam_pkg=ros-$ros_distro-collab-slam-lze
    ensure_apt install -y "$slam_pkg"
  fi

  echo "@@HIGHLIGHT Autonomous Mobile Robot ($amr_sdk_pkg) installed for ROS 2 $ros_distro"
  echo "@@HIGHLIGHT shell env @source /opt/ros/$ros_distro/setup.bash"
  echo "@@HIGHLIGHT tutorials @https://docs.openedgeplatform.intel.com/dev/edge-ai-suites/robotics-ai-suite/robotics/dev_guide/index_tutorials.html"
}

debian_90_remove_autonomous_mobile_robot () {
  configure_autonomous_mobile_robot
  if verify_autonomous_mobile_robot; then
    ensure_apt autoremove -m -y \
      ros-$ros_distro-robotics-sdk ros-$ros_distro-robotics-sdk-complete \
      ros-$ros_distro-collab-slam-sse ros-$ros_distro-collab-slam-avx2 ros-$ros_distro-collab-slam-lze || true
    configure_osrf_gazebo
    ensure_sudo rm -f $osrf_list $osrf_key
    ensure_sudo rm -f "$oneapi_key_file" "$oneapi_list" "$oneapi_pref_file"
  else
    echo "Autonomous Mobile Robot already removed. Skipping"
  fi
}

debian_90_sbom_autonomous_mobile_robot () {
  configure_autonomous_mobile_robot
  (
    IFS=$'|'
    local oneapi_pref_str="${oneapi_pref[*]}"
    cat <<EOF
"name": "$oneapi_repo_name"
"gpg-key": "$oneapi_key_url"
"key-file": "$oneapi_key_file"
"apt-source": "$oneapi_deb_entry"
"apt-list-file": "$oneapi_list"
"apt-pref": ["${oneapi_pref_str//'|'/'","'}"]
"apt-pref-file": "$oneapi_pref_file"
EOF
  )
  echo "---"
  # Intel oneAPI requires GCC >= 12 on Ubuntu 22.04 / Humble
  if [ "$ros_distro" = humble ]; then
    cat <<EOF
"pkg-list": ["gcc-12","g++-12"]
---
EOF
  fi

  cat <<EOF
"pkg-list": ["gnupg"]
EOF

  if [ "$ros_distro" = jazzy ]; then
    configure_osrf_gazebo
    cat <<EOF
"name": "$osrf_name"
"apt-source": "$osrf_entry"
"apt-list-file": "$osrf_list"
"pkg-list": ["gz-harmonic"]
---
EOF
  fi

  cat <<EOF
"pkg-list": ["$amr_sdk_pkg","ros-$ros_distro-collab-slam-sse"]
EOF
}

