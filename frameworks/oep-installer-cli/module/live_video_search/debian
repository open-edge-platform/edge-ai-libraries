
configure_live_video_search () {
  workspace="$(ensure_project_path)/live-video-search"
  version=release-2026.2.0
  repository="https://github.com/open-edge-platform/metro-ai-suite.git"
  used_ports=(8080 3001 9998 4001 4002 5432 7890 6008 19530 55555 6016 9766 80 5000 8000 1883 6379 9777 6008 19530 9091 8554 9090 9273)
  get_model_script="https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/refs/tags/2026.2.1/microservices/model-download/scripts/get_model.sh"
}

configure_live_video_search_device () {
  local device="$1"
  cat > "$workspace"/live-video-analysis/live-video-search/docker/.env <<EOF
REGISTRY_URL=intel
MINIO_ROOT_USER=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
MINIO_ROOT_PASSWORD=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
POSTGRES_USER=$(cat /dev/random | tr -dc a-z | head -c 5)
POSTGRES_PASSWORD=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
MQTT_USER=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
MQTT_PASSWORD=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
MULTIMODAL_EMBEDDING_MODEL=CLIP/clip-vit-b-32
DATAPREP_EMBEDDING_DEVICE=${device^^}
DATAPREP_DETECTION_DEVICE=${device^^}
MME_EMBEDDING_DEVICE=${device^^}
APP_HOST_PORT=${used_ports[0]}
EOF
}

verify_live_video_search () {
  [ -e "$workspace"/live-video-analysis/live-video-search ]
}

debian_90_profile_live_video_search () {
  echo "git curl gawk jq edge_base docker"
}

debian_90_install_live_video_search () {
  configure_live_video_search
  if verify_live_video_search && [[ " $* " != *" --reinstall "* ]]; then
    echo "Live Video Search is already installed. Skipping"
  else
    # clone the repository
    ensure_disk_space 64000
    ensure_git_clone "$workspace" $version $repository live-video-analysis/live-video-search
    verify_live_video_search
  fi

  local device=$(ensure_select_device "$@")
  configure_live_video_search_device "$device"

  echo "@@HIGHLIGHT workspace: $workspace"
  echo "@@HIGHLIGHT $installer_name start|remove"
}

debian_90_start_live_video_search () {
  configure_live_video_search
  ensure_ports_open "${used_ports[*]}" debian_90_stop_live_video_search

  local device=$(ensure_select_device "$@")
  [[ " ${*,,} " != *" --$device "* ]] || configure_live_video_search_device "$device"

  cd "$workspace"/live-video-analysis/live-video-search
  set -a
  . ./docker/.env
  set +a
  . ./setup.sh --start

  echo "@@HIGHLIGHT URL: http://$(ensure_ip):${used_ports[0]}"
  echo "@@HIGHLIGHT $installer_name stop|remove"
}

debian_90_stop_live_video_search () {
  configure_live_video_search
  cd "$workspace"/live-video-analysis/live-video-search && {
    set -a
    . ./docker/.env || true
    set +a
    . ./setup.sh --down || true
    . ./setup.sh --clean-data || true
  }
}

debian_90_remove_live_video_search () {
  debian_90_stop_live_video_search "$@"
  rm -rf "$workspace" 2> /dev/null || ensure_sudo rm -rf "$workspace" 
}
