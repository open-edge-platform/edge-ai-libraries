
configure_edge_pack_base_standard () {
  configure_edge_pack "$@"
  version="1.0"
}

debian_40_profile_edge_pack_base_standard () {
  echo "edge_pack"
}

debian_40_group_edge_pack_base_standard () {
  echo "render:992 video:"
}

debian_40_install_edge_pack_base_standard () {
  configure_edge_pack_base_standard "$@"
  if ensure_apt_is_installed intel-edge-base-standard && [[ " $* " != *" --reinstall "* ]]; then
    echo "intel-edge-base-standard is installed." >&2
  else
    ensure_prop set installed/edge_pack_base_standard/owned true
    ensure_apt purge --auto-remove -y intel-edge-base-standard || true
    ensure_apt_allow_downgrades "${edge_pack_allow_downgrades[*]}" "${edge_pack_install_options[@]}" "intel-edge-base-standard=$version*" || true
    ensure_apt install --allow-downgrades "${edge_pack_install_options[@]}" "intel-edge-base-standard=$version*"
  fi
  [ -c /dev/dri/renderD128 ]
  ensure_group_add $(debian_40_group_edge_pack_base_standard)
}

debian_40_remove_edge_pack_base_standard () {
  [ "$(ensure_prop get installed/edge_pack_base_standard/owned)" = "true" ] || return 0
  ensure_apt purge --auto-remove -y intel-edge-base-standard || true
}

debian_40_sbom_edge_pack_base_standard () {
  configure_edge_pack_base_standard "$@"
  sbom_edge_pack_repo_entries "$@"
  ensure_sbom_format pkg-list "intel-edge-base-standard=$version*"
}

