
# OpenVINO(TM) Runtime (pinned to 2025.3.0) and the ROS 2 OpenVINO Toolkit
# required by the Robotics AI Suite perception tutorials. Kept separate from the
# generic `openvino` module because the robotics stack pins a specific version
# and adds the ROS OpenVINO node / wrapper packages.
# https://docs.openedgeplatform.intel.com/dev/edge-ai-suites/robotics-ai-suite/robotics/gsg_robot/index.html
configure_ros_openvino () {
  ov_repo_name=apt.repos.intel.com
  ov_version=2025.3.0
  ov_key_url=https://$ov_repo_name/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB
  ov_key_file=/usr/share/keyrings/openvino-archive-keyring.gpg
  ov_list=/etc/apt/sources.list.d/intel-openvino.list
  ov_pref=/etc/apt/preferences.d/intel-openvino
  ov_deb_entry="deb [signed-by=$ov_key_file] https://$ov_repo_name/openvino/2025 ${ID}${VERSION_ID%.*} main"
  case "$VERSION_CODENAME" in
  jammy) ros_distro=humble ;;
  noble) ros_distro=jazzy ;;
  *)     ros_distro=jazzy ;;
  esac
  ov_deb_pref=(
    "Package: openvino"
    "Pin: version $ov_version"
    "Pin-Priority: 1001"
    "Package: ros-$ros_distro-openvino-wrapper-lib"
    "Pin: version $ov_version*"
    "Pin-Priority: 1002"
    "Package: ros-$ros_distro-openvino-node"
    "Pin: version $ov_version*"
    "Pin-Priority: 1002"
  )

  # Autonomous Mobile Robot (AMR) apt feed - hosts the ROS OpenVINO node /
  # wrapper packages (ros-<distro>-openvino-node) pulled in below. Previously
  # provided by the standalone amr_apt_repo module.
  # https://docs.openedgeplatform.intel.com/dev/edge-ai-suites/robotics-ai-suite/robotics/gsg_robot/index.html
  amr_repo_name="amrdocs.intel.com"
  amr_key_url=https://$amr_repo_name/repos/gpg-keys/GPG-PUB-KEY-INTEL-AMR.gpg
  amr_key_file=/usr/share/keyrings/amr-archive-keyring.gpg
  amr_list=/etc/apt/sources.list.d/amr.list
  amr_pref=(
    "Package: *"
    "Pin: origin $amr_repo_name"
    "Pin-Priority: 1001"
  )
  amr_pref_file=/etc/apt/preferences.d/amr
  amr_deb_entry="$(printf 'deb [signed-by=%s] https://%s/repos/%s amr main' "$amr_key_file" "$amr_repo_name" "$VERSION_CODENAME")"
  amr_deb_src_entry="$(printf 'deb-src [signed-by=%s] https://%s/repos/%s amr main\n' "$amr_key_file" "$amr_repo_name" "$VERSION_CODENAME")"
}

# Intel oneAPI Base Toolkit repo + version pins, shared by the Robotics AI Suite
# components (autonomous_mobile_robot, stationary_robot_vision) whose robotics
# stack links the oneAPI runtime/compiler/MKL packages.
configure_oneapi_ros_openvino () {
  oneapi_repo_name="apt.repos.intel.com"
  oneapi_key_url="https://$oneapi_repo_name/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB"
  oneapi_key_file=/usr/share/keyrings/oneapi-archive-keyring.gpg
  oneapi_list=/etc/apt/sources.list.d/oneAPI.list
  oneapi_pref=(
    "Package: intel-oneapi-runtime-*"
    "Pin: version 2025.3.*"
    "Pin-Priority: 1001"
    "Package: intel-oneapi-compiler-*"
    "Pin: version 2025.3.*"
    "Pin-Priority: 1001"
    "Package: intel-oneapi-mkl-*"
    "Pin: version 2025.3.*"
    "Pin-Priority: 1001"
  )
  oneapi_pref_file=/etc/apt/preferences.d/oneapi
  oneapi_deb_entry="deb [signed-by=$oneapi_key_file] https://$oneapi_repo_name/oneapi all main"
}

ensure_oneapi_ros_openvino () {
  configure_oneapi_ros_openvino
  ensure_apt install -y wget
  ensure_apt_key "$oneapi_key_file" "$oneapi_key_url" --dearmor
  ensure_apt_source "$oneapi_list" "$oneapi_deb_entry"
  ensure_apt_preference "$oneapi_pref_file" "${oneapi_pref[@]}"
}

# succeeds if any Robotics AI Suite apt component is still installed. Expects $ros_distro.
verify_robotics_in_use_ros_openvino () {
  local pkg
  for pkg in ros-$ros_distro-robotics-sdk ros-$ros_distro-robotics-sdk-complete \
             ros-$ros_distro-rvc ros-$ros_distro-rvc-simulation; do
    ! ensure_apt_is_installed $pkg || return 0
  done
  return 1
}

# remove the shared oneAPI repo only when no robotics component still needs it
remove_oneapi_ros_openvino () {
  configure_oneapi_ros_openvino
  ! verify_robotics_in_use_ros_openvino || return 0
  ensure_sudo rm -f "$oneapi_key_file" "$oneapi_list" "$oneapi_pref_file"
}

sbom_oneapi_ros_openvino () {
  configure_oneapi_ros_openvino
  ensure_sbom_format name "$oneapi_repo_name"
  ensure_sbom_format gpg-key "$oneapi_key_url"
  ensure_sbom_format key-file "$oneapi_key_file"
  ensure_sbom_format apt-source "$oneapi_deb_entry"
  ensure_sbom_format apt-list-file "$oneapi_list"
  ensure_sbom_format apt-pref "${oneapi_pref[@]}"
  ensure_sbom_format apt-pref-file "$oneapi_pref_file"
  ensure_sbom_format pkg-list "intel-oneapi-runtime-*" "intel-oneapi-compiler-*" "intel-oneapi-mkl-*"
  echo "---"
  ensure_sbom_format pkg-list wget
}

debian_55_profile_ros_openvino () {
  echo "curl gnupg ros2 libze1 debconf_utils"
  # --realtime (set by edge_base_robotics) supplies GPU/NPU prep via
  # edge_pack_base_realtime instead; skip edge_base to avoid installing both
  # the standard and real-time edge-pack base bundles together.
  [[ " $* " = *" --realtime "* ]] || echo "edge_base"
}

verify_ros_openvino () {
  configure_ros_openvino
  [ -r "$amr_key_file" ] && [ -r "$amr_list" ] || return 1
  ensure_apt_is_installed openvino=$ov_version ros-$ros_distro-openvino-node
}

debian_55_install_ros_openvino () {
  configure_ros_openvino

  if verify_ros_openvino && [[ " $* " != *" --reinstall "* ]]; then
    echo "ROS 2 OpenVINO toolkit is already installed. Skipping..."
  else
    # declare ownership
    ensure_prop set installed/ros_openvino/owned true

    # AMR apt feed (signing key + source + pin) providing the ROS OpenVINO node
    ensure_sudo mkdir -p "$(dirname "$amr_key_file")"
    ensure_apt_key "$amr_key_file" "$amr_key_url"
    ensure_apt_source "$amr_list" "$amr_deb_entry" "$amr_deb_src_entry"
    ensure_apt_preference "$amr_pref_file" "${amr_pref[@]}"

    # OpenVINO apt repository + signing key
    ensure_apt_key $ov_key_file $ov_key_url --dearmor
    ensure_apt_source $ov_list "$ov_deb_entry"

    # pin OpenVINO and the ROS OpenVINO packages to the same version
    ensure_apt_preference $ov_pref "${ov_deb_pref[@]}"

    ensure_apt update -y

    # clear any stale openvino-node debconf configuration
    ensure_apt purge -y ros-$ros_distro-openvino-node || true
    ensure_apt autoremove -y || true
    echo PURGE | ensure_sudo debconf-communicate ros-$ros_distro-openvino-node > /dev/null 2>&1 || true

    # preseed the "install OpenVINO IR models" prompt to yes (tutorials need it)
    echo "ros-$ros_distro-openvino-node ros-$ros_distro-openvino-node/install_models boolean true" | \
      ensure_sudo debconf-set-selections > /dev/null 2>&1 || true

    ensure_apt install -y openvino
    ensure_apt install -y ros-$ros_distro-openvino-node
  fi

  echo "@@HIGHLIGHT OpenVINO $ov_version + ros-$ros_distro-openvino-node installed"
  echo "@@HIGHLIGHT If the OpenVINO IR models were not installed, reinstall ros-$ros_distro-openvino-node interactively and answer Yes"
}

debian_55_remove_ros_openvino () {
  # leave untouched if not installed by ros_openvino
  [ "$(ensure_prop get installed/ros_openvino/owned)" = "true" ] || return 0

  configure_ros_openvino
  if verify_ros_openvino; then
    ensure_apt autoremove -m -y ros-$ros_distro-openvino-node openvino || true
    ensure_sudo rm -f "$ov_key_file" "$ov_list" "$ov_pref" \
      "$amr_key_file" "$amr_list" "$amr_pref_file"
  else
    echo "ROS 2 OpenVINO toolkit already removed. Skipping"
  fi
}

debian_55_sbom_ros_openvino () {
  configure_ros_openvino
  ensure_sbom_format name "$amr_repo_name"
  ensure_sbom_format gpg-key "$amr_key_url"
  ensure_sbom_format key-file "$amr_key_file"
  ensure_sbom_format apt-source "$amr_deb_entry"
  ensure_sbom_format apt-src-source "$amr_deb_src_entry"
  ensure_sbom_format apt-list-file "$amr_list"
  ensure_sbom_format apt-pref "${amr_pref[@]}"
  ensure_sbom_format apt-pref-file "$amr_pref_file"
  echo "---"
  ensure_sbom_format name "$ov_repo_name"
  ensure_sbom_format gpg-key "$ov_key_url"
  ensure_sbom_format key-file "$ov_key_file"
  ensure_sbom_format apt-source "$ov_deb_entry"
  ensure_sbom_format apt-list-file "$ov_list"
  ensure_sbom_format pkg-list "openvino" "ros-$ros_distro-openvino-node"
  ensure_sbom_format apt-pref-file "$ov_pref"
  ensure_sbom_format apt-pref "${ov_deb_pref[@]}"
  echo "---"
  ensure_sbom_format pkg-list curl gnupg
}
