
configure_smart_parking () {
  workspace="$(ensure_project_path)/smart-parking"
  version=release-2026.2.0
  repository="https://github.com/open-edge-platform/metro-ai-suite.git"
  used_ports=(80 443)
  duration=120
}

configure_smart_parking_device () {
  local device="$1"
  sed -i "/No device selected/,/fi/{s|defaulting to ...|defaulting to ${device^^}|;s|forced.*=.*$|forced${device^^}=true|}" "$workspace"/metro-vision-ai-app-recipe/smart-parking/sample_start.sh
}

verify_smart_parking () {
  local i p
  for i in 1 2 3 4; do
    [ -e "$workspace"/metro-vision-ai-app-recipe/smart-parking/src/dlstreamer-pipeline-server/videos/new_video_$i.mp4 ]
  done
  for p in FP16 FP32 INT8; do
    [ -e "$workspace"/metro-vision-ai-app-recipe/smart-parking/src/dlstreamer-pipeline-server/models/public/yolo11s/$p/yolo11s.bin ]
  done
  [ -e "$workspace"/metro-vision-ai-app-recipe/smart-parking/src/dlstreamer-pipeline-server/models/colorcls2/colorcls2.bin ]
}

debian_90_profile_smart_parking () {
  echo "git curl gawk edge_base docker"
}

debian_90_install_smart_parking () {
  configure_smart_parking
  if verify_smart_parking && [[ " $* " != *" --reinstall "* ]]; then
    echo "Smart parking is already installed. Skipping..."
  else
    # clone the repository
    ensure_disk_space 300
    ensure_git_export "$workspace" $version $repository metro-vision-ai-app-recipe

    # setup
    cd "$workspace/metro-vision-ai-app-recipe"
    sed -i 's|curl | curl -f |' smart-parking/install.sh
    ./install.sh smart-parking $(ensure_ip)
    verify_smart_parking
  fi

  local device=$(ensure_select_device "$@")
  configure_smart_parking_device "$device"

  echo "@@HIGHLIGHT workspace: $workspace"
  echo "@@HIGHLIGHT $installer_name install [--gpu|npu|cpu]" 
  echo "@@HIGHLIGHT $installer_name start [--gpu|npu|cpu]" 
  echo "@@HIGHLIGHT $installer_name remove"
}

debian_90_start_smart_parking () {
  ensure_ports_open "${used_ports[*]}" debian_90_stop_smart_parking
  configure_smart_parking

  local device=$(ensure_select_device "$@")
  [[ " ${*,,} " != *" --$device "* ]] || configure_smart_parking_device "$device"

  cd "$workspace"/metro-vision-ai-app-recipe
  docker compose up -d --wait

  echo "@@HIGHLIGHT URL: http://$(ensure_ip):${used_ports[0]}"
  echo "@@HIGHLIGHT Grafana AUTH: admin/admin"
  echo "@@HIGHLIGHT $installer_name start [--gpu|npu|cpu]" 
  echo "@@HIGHLIGHT $installer_name stop|remove"

  ./sample_start.sh && ./sample_status.sh
}

debian_90_stop_smart_parking () {
  configure_smart_parking
  cd "$workspace"/metro-vision-ai-app-recipe
  ./sample_stop.sh || true
  docker compose down -v --remove-orphans
}

debian_90_remove_smart_parking () {
  debian_90_stop_smart_parking || true
  ensure_sudo rm -rf "$workspace" 2> /dev/null || true
}

