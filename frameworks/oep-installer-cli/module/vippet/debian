
configure_vippet () {
  workspace="$(ensure_project_path)/vippet"
  version=release-2026.2.0
  repository=https://github.com/open-edge-platform/edge-ai-libraries.git
  used_ports=(80 7860 8000 9090 8554 8889)
}

verify_vippet () {
  [ -r "$workspace/tools/visual-pipeline-and-platform-evaluation-tool/.env" ]
}

debian_90_profile_vippet () {
  echo "docker_io make curl git edge_base"
}

debian_90_install_vippet () {
  configure_vippet
  if verify_vippet && [[ " $* " != *" --reinstall "* ]]; then
    echo "Vipet is installed." >&2
  else
    ensure_ports_open install vippet "${used_ports[@]}"
    ensure_git_clone "$workspace" $version $repository tools/visual-pipeline-and-platform-evaluation-tool
    cd "$workspace/tools/visual-pipeline-and-platform-evaluation-tool"
    make build-onvif-discovery
    docker compose -f compose.yml pull --ignore-buildable
  fi
  echo "@@HIGHLIGHT $installer_name start"
  echo "@@HIGHLIGHT $installer_name remove"
}

debian_90_start_vippet () {
  configure_vippet
  ensure_ports_open start vippet "${used_ports[@]}"

  cd "$workspace/tools/visual-pipeline-and-platform-evaluation-tool"
  make run
  echo "@@HIGHLIGHT URL: http://$(ensure_ip)"
  echo "@@HIGHLIGHT $installer_name stop|remove"
}

debian_90_stop_vippet () {
  configure_vippet
  cd "$workspace/tools/visual-pipeline-and-platform-evaluation-tool" && make stop || true
}

debian_90_remove_vippet () {
  debian_90_stop_vippet $* || true
  ensure_rm "$workspace"
}
