
configure_edge_pack_compute_extra () {
  configure_edge_pack "$@"
  version="1.0"
}

debian_40_profile_edge_pack_compute_extra () {
  echo "edge_pack"
}

debian_40_install_edge_pack_compute_extra () {
  configure_edge_pack_compute_extra "$@"
  if ensure_apt_is_installed intel-edge-compute-extra && ! ensure_parse_reinstall "$@"; then
    echo "intel-edge-compute-extra is installed." >&2
  else
    ensure_prop set installed/edge_pack_compute_extra/owned true
    ensure_apt purge --auto-remove -y intel-edge-compute-extra || true
    ensure_apt_allow_downgrades "${edge_pack_allow_downgrades[*]}" "${edge_pack_install_options[@]}" "intel-edge-compute-extra=$version*" || true
    ensure_apt install --allow-downgrades "${edge_pack_install_options[@]}" "intel-edge-compute-extra=$version*"
  fi
}

debian_40_remove_edge_pack_compute_extra () {
  [ "$(ensure_prop get installed/edge_pack_compute_extra/owned)" = "true" ] || return 0
  ensure_apt purge --auto-remove -y intel-edge-compute-extra || true
}

debian_40_sbom_edge_pack_compute_extra () {
  configure_edge_pack_compute_extra "$@"
  sbom_edge_pack_repo_entries "$@"
  ensure_sbom_format pkg-list "intel-edge-compute-extra=$version*"
}

