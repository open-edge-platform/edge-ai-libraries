
configure_openvino () {
  repo_name="apt.repos.intel.com"
  key_url="https://$repo_name/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB"
  key_file=/usr/share/keyrings/intel-gpg-archive-keyring.gpg
  apt_entry="deb [signed-by=$key_file] https://$repo_name/openvino ${ID}${VERSION_ID%.*} main"
  apt_file=/etc/apt/sources.list.d/intel-openvino.list
  version=$([[ " $* " = *" dlstreamer "* ]] && echo 2026.2.0 || echo 2026.3.0)
  workspace="$(ensure_project_path)/openvino"
  model="https://github.com/onnx/models/raw/4c46cd00fbdb7cd30b6c1c17ab54f2e1f4f7b177/validated/vision/classification/squeezenet/model/squeezenet1.0-12.onnx"
}

debian_70_profile_openvino () {
  echo "curl gnupg python3_venv edge_base"
}

verify_openvino () {
  ensure_apt_is_installed openvino-${version}
  [ -r "$workspace"/.venv/bin/activate ]
  . "$workspace"/.venv/bin/activate
  pip show openvino-genai 2> /dev/null | grep -q -F ${version}
}

debian_70_install_openvino () {
  configure_openvino $*
  
  if verify_openvino && [[ " $* " != *" --reinstall "* ]]; then
    echo "openvino-${version} already installed. Skipping"
  else
    # remove old versions
    debian_70_remove_openvino "$@"

    # product key
    ensure_apt_key $key_file $key_url --dearmor

    # deb entry
    ensure_apt_source $apt_file "$apt_entry"

    # apt update
    ensure_apt update -y

    # install openvino
    ensure_apt install --no-install-recommends -y openvino-$version

    # install openvino-genai
    mkdir -p "$workspace"
    python3 -m venv "$workspace"/.venv
    . "$workspace"/.venv/bin/activate
    pip install openvino-genai==${version}

    echo "openvino-${version} installed successfully."

    if [[ " $* " = *" --validate "* ]]; then
      [ -e "$workspace"/${model##*/} ] || ensure_fetch "$model" "$workspace"/${model##*/}
      for device in CPU GPU NPU; do
        echo "Validating ${model##*/} inferencing on $device..."
        benchmark_app -t 5 -m "$workspace"/${model##*/} -d $device
      done
    fi
  fi

  # info
  echo "@@HIGHLIGHT openvino-genai @$workspace/.venv"
  echo "@@HIGHLIGHT openvino samples @/usr/share/openvino"
}

debian_70_remove_openvino () {
  ensure_apt autoremove -m -y $(dpkg -l | grep openvino | awk '{print$2}') || true
}

debian_70_sbom_openvino () {
  configure_openvino "$@"
  cat <<EOF
$(ensure_sbom_format name "$repo_name")
$(ensure_sbom_format gpg-key "$key_url")
$(ensure_sbom_format key-file "$key_file")
$(ensrue_sbom_format apt-source "$apt_entry")
$(ensure_sbom_format apt-list-file "$apt_file")
$(ensure_sbom_format pkg-list "openvino-$version")
EOF
}
