
configure_openvino () {
  repo_name="apt.repos.intel.com"
  key_url="https://$repo_name/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB"
  key_file=/usr/share/keyrings/intel-gpg-archive-keyring.gpg
  apt_entry="deb [signed-by=$key_file] https://$repo_name/openvino ${ID}${VERSION_ID%.*} main"
  apt_file=/etc/apt/sources.list.d/intel-openvino.list
  version=$([[ " $* " = *" dlstreamer "* ]] && echo 2026.1.0 || echo 2026.3.0)
  openvino_venv="$(ensure_project_path)/openvino-genai"
}

debian_70_profile_openvino () {
  echo "curl gpg python3_venv edge_base"
}

verify_openvino () {
  ensure_apt_is_installed openvino-${version} || return 1
  [ -r "$openvino_venv"/bin/activate ] || return 1
  . "$openvino_venv"/bin/activate
  pip show openvino-genai 2> /dev/null | grep -q -F ${version} || return 1
}

debian_70_install_openvino () {
  configure_openvino $*
  
  if verify_openvino && [[ " $* " != *" --reset-openvino "* ]]; then
    echo "openvino-${version} already installed. Skipping"
  else
    # remove old versions
    ensure_apt autoremove -m -y $(dpkg -l | grep openvino | awk '{print$2}') || true

    # product key
    ensure_apt_key $key_file $key_url --dearmor

    # deb entry
    ensure_apt_source $apt_file "$apt_entry"

    # apt update
    ensure_apt update -y

    # install openvino
    ensure_apt install --no-install-recommends -y openvino-$version

    # install openvino-genai
    python3 -m venv "${openvino_venv}"
    . "${openvino_venv}"/bin/activate
    pip install openvino-genai==${version}
  fi

  # info
  echo "@@HIGHLIGHT openvino-genai @$openvino_venv"
  echo "@@HIGHLIGHT openvino samples @/usr/share/openvino"
}

debian_70_remove_openvino () {
  configure_openvino $*

  if verify_openvino; then
    ensure_apt autoremove -m -y openvino-${version} openvino || true
    ensure_sudo rm -rf "$openvino_venv" $apt_file $key_file
  else
    echo "openvino-${version} already removed. Skipping"
  fi
}

debian_70_sbom_openvino () {
  configure_openvino "$@"
  cat <<EOF
"name": "$repo_name"
"gpg-key": "$key_url"
"key-file": "$key_file"
"apt-source": "$apt_entry"
"apt-list-file": "$apt_file"
"pkg-list": ["openvino-$version"]
EOF
}
