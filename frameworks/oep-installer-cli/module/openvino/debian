
configure_openvino () {
  key_url=https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB
  key_file=/usr/share/keyrings/intel-gpg-archive-keyring.gpg
  deb_entry="deb [signed-by=$key_file] https://apt.repos.intel.com/openvino ${ID}${VERSION_ID%.*} main"
  version=2026.3.0
  openvino_venv="$(ensure_project_path)/openvino-genai"
}

debian_70_profile_openvino () {
  echo "curl gpg python3_venv"
}

verify_openvino () {
  dpkg-query -L openvino-${version} > /dev/null 2>&1 || return 1
  [ -r "$openvino_venv"/bin/activate ] || return 1
  . "$openvino_venv"/bin/activate
  pip show openvino-genai 2> /dev/null | grep -q -F ${version} || return 1
}

debian_70_install_openvino () {
  configure_openvino
  
  if verify_openvino; then
    echo "openvino-${version} already installed. Skipping"
  else
    # product key
    ensure_sudo mkdir -p $(dirname $key_file)
    no_proxy= NO_PROXY= curl -fsL $key_url | gpg --dearmor | ensure_sudo tee $key_file

    # deb entry
    echo "$deb_entry" | ensure_sudo tee /etc/apt/sources.list.d/intel-openvino.list

    # apt update
    ensure_apt update -y

    # install openvino
    ensure_apt install --no-install-recommends -y openvino-$version

    # install openvino-genai
    python3 -m venv "${openvino_venv}"
    . "${openvino_venv}"/bin/activate
    pip install openvino-genai==${version}

    echo "@@HIGHLIGHT openvino installed at $workspace"
    echo "@@HIGHLIGHT explore samples at /usr/share/openvino"
  fi
}

debian_70_remove_openvino () {
  configure_openvino

  if verify_openvino; then
    ensure_apt autoremove -y openvino-${version}
    ensure_rmdir "$openvino_venv"
  else
    echo "openvino-${version} already removed. Skipping"
  fi
}

