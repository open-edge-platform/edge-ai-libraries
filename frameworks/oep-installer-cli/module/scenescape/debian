
configure_scenescape () {
  workspace="$(ensure_project_path)/scenescape"
  version="$(ensure_parse_value_option version --version=release-2026.3.0 "$@")"
  repository=https://github.com/open-edge-platform/scenescape.git
  used_ports=(443)
  skills=(scenescape-setup)
}

verify_scenescape () {
  [ -d "$workspace" ]
}

debian_90_profile_scenescape () {
  echo "docker_io curl git make unzip rsync python3_venv edge_base"
}

debian_90_install_scenescape () {
  configure_scenescape "$@"
  if verify_scenescape && ! ensure_parse_reinstall "$@"; then
    echo "Scenescape is installed." >&2
  else
    ensure_disk_size 300
    ensure_ports_open install scenescape "${used_ports[@]}"

    echo "@@STEP Cloning git repository"
    ensure_git_export "$workspace" "$version" "$repository"

    echo "@@STEP Installing skills"
    cd "$workspace"
    ensure_skills add -- "${skills[@]/#/.github/skills/}"

    verify_scenescape
  fi

  echo "@@HIGHLIGHT workspace: ${workspace/#"$HOME"/"~"}"
  echo "@@HIGHLIGHT $installer_name start"
  echo "@@HIGHLIGHT $installer_name remove"
}

debian_90_start_scenescape () {
  configure_scenescape "$@"
  ensure_ports_open start scenescape "${used_ports[@]}"
  ensure_container_namespace start scenescape $(ensure_container_parse_yaml "$workspace"/sample_data/compose/compose.*.yml)

  cd "$workspace"
  export SUPASS=$(cat /dev/random | tr -dc a-z | head -c 5)
  make init-secrets
  make demo-all DEMO_REBUILD_IMAGES=false

  echo "@@HIGHLIGHT UI: https://$(ensure_ip):${used_ports[0]}"
  echo "@@HIGHLIGHT SUPASS: $SUPASS"
  echo "@@HIGHLIGHT $installer_name stop|remove"
}

debian_90_stop_scenescape () {
  configure_scenescape "$@"
  cd "$workspace" && {
    make demo-close || true
    make clean-all || true
    ensure_container_cleanup $(ensure_container_parse_yaml sample_data/compose/compose.*.yml)
  } || true
}

debian_90_remove_scenescape () {
  debian_90_stop_scenescape "$@"
  ensure_rm "$workspace" || true
  ensure_skills remove "${skills[@]}"
}

