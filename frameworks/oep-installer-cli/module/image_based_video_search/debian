
configure_image_based_video_search () {
  workspace="$(ensure_project_path)/image-based-video-search"
  version=release-2026.2.0
  repository="https://github.com/open-edge-platform/metro-ai-suite.git"
  used_ports=(443 80 8554)
}

verify_image_based_video_search () {
  local files_to_check=(
    resnet-50-pytorch/FP32/resnet-50-pytorch.bin
    resnet-50-pytorch/FP16/resnet-50-pytorch.bin
    public/yolo11s/INT8/yolo11s.bin
    public/yolo11s/FP32/yolo11s.bin
    public/yolo11s/FP16/yolo11s.bin
  )
  for f in "${files_to_check[@]}"; do
    [ -e "$workspace"/image-based-video-search/src/dlstreamer-pipeline-server/models/$f ] || {
      echo "Missing ${f%/*}" >&2
      return 1
    }
  done
}

debian_90_profile_image_based_video_search () {
  echo "git curl edge_base docker_io"
}

debian_90_install_image_based_video_search () {
  configure_image_based_video_search "$@"
  if verify_image_based_video_search && [[ " $* " != *" --reinstall "* ]]; then
    echo "Video Search and Summarization is installed." >&2
  else
    ensure_disk_size 8000
    ensure_ports_open install image_based_video_search "${used_ports[@]}"

    # clone the repository
    ensure_git_export "$workspace" $version $repository image-based-video-search

    # download models
    cd "$workspace"/image-based-video-search/src/dlstreamer-pipeline-server
    MODELS_PATH="$(pwd)/models"
    mkdir -p "$MODELS_PATH"

    docker run --rm --user=root -e http_proxy -e https_proxy -e no_proxy -v "$MODELS_PATH:/output" \
        openvino/ubuntu24_dev:2024.6.0 bash -c "omz_downloader --name resnet-50-pytorch --output_dir models && \
        omz_converter --name resnet-50-pytorch --download_dir models --output_dir models && \
        cp -r ./models/public/resnet-50-pytorch /output && chown -R $(id -u):$(id -g) /output"
    
    docker run --rm --user=root -e http_proxy -e https_proxy -e no_proxy -v "$MODELS_PATH:/output" \
        intel/dlstreamer:2026.2.0-ubuntu24 bash -c "$(cat <<EOF
mkdir -p src/dlstreamer-pipeline-server/models/public
export MODELS_PATH=/output
chmod +x /home/dlstreamer/dlstreamer/samples/download_public_models.sh
if [ ! -e "src/dlstreamer-pipeline-server/models/public/yolo11s/FP16/yolo11s.xml" ]; then
  for attempt in {1..3}; do
    echo "Attempt $attempt: Running model download and quantization..."
    if /home/dlstreamer/dlstreamer/samples/download_public_models.sh yolo11s coco128; then
      echo "Model download and quantization successful!"
      break
    else
      echo "Download attempt $attempt failed. Retrying..."
      sleep 2
    fi
  done
fi
EOF
)"

    verify_image_based_video_search
  fi

  echo "@@HIGHLIGHT workspace: ${workspace/#"$HOME"/"~"}"
  echo "@@HIGHLIGHT start|stop|remove"
}

debian_90_start_image_based_video_search () {
  configure_image_based_video_search "$@"
  ensure_ports_open start image_based_video_search "${used_ports[@]}"

  cd "$workspace"/image-based-video-search
  docker compose up -d

  echo "@@HIGHLIGHT URL: https://$(ensure_ip):${used_ports[0]}"
  echo "@@HIGHLIGHT stop|remove"
}

debian_90_stop_image_based_video_search () {
  configure_image_based_video_search "$@"

  cd "$workspace"/image-based-video-search && {
    docker compose down -v --remove-orphans
  } || true
}

debian_90_remove_image_based_video_search () {
  debian_90_stop_image_based_video_search "$@"
  ensure_rm "$workspace"
}
