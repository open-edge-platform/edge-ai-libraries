
configure_edk () {
  workspace="$(readlink -f ~)/openedge-catalog/edk"
  version=1.1.1
  repository="https://github.com/open-edge-platform/edge-developer-kit-reference-scripts"
}

debian_30_profile_edk () {
  echo "git"
}

debian_30_install_edk () {
  configure_edk
  if [ -d "$workspace" ] && [[ "$*" != "--reset-edk" ]]; then
    echo "Edk is already installed. Skipping..."
  else
    ensure_git_clone "$workspace" $version $repository
    pushd "$workspace" > /dev/null
    ensure_sudo ./main_installer.sh
    popd "$workspace"
  fi
}

debian_30_remove_edk () {
  configure_edk
  ensure_rmdir "$workspace"
}

