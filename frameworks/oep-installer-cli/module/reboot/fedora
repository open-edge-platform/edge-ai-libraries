
configure_reboot () {
  touch "${installer_state?}"/reboot_required
}

fedora_29_install_reboot () {
  [ -e "${installer_state?}"/reboot_required ] || return 
  local delay=2
  ensure_sudo shutdown -r +$delay "$installer_name scheduled a reboot in $delay minutes. Save your work now!"
  rm -f "${installer_state?}"/reboot_required
  sleep infinity
}

