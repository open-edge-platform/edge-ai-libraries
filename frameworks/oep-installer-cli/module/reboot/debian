
configure_reboot () {
  touch "${installer_state?}"/reboot_required
}

debian_29_install_reboot () {
  [ -e "${installer_state?}"/reboot_required ] || return 

  echo "@@STEP Rebooting"
  local reboot_message="RERUN '$installer_name resume' AFTER SYSTEM IS BACK."
  echo "@@HIGHLIGHT $reboot_message"

  printf -- "---\n---\n${red}%s${reset}\n---\n---\n" "$reboot_message"

  local delay=2
  ensure_sudo shutdown -r +$delay "$reboot_message" &&
  rm -f "${installer_state?}"/reboot_required

  sleep infinity
}

