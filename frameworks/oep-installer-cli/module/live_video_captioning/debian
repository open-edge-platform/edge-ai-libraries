
configure_live_video_captioning () {
  workspace="$(ensure_project_path)/live-video-captioning"
  version=release-2026.2.0
  repository="https://github.com/open-edge-platform/metro-ai-suite.git"
  used_ports=(4173 8040 1883 9090 8889 9273 8556)
  get_model_script="https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/refs/tags/2026.2.1/microservices/model-download/scripts/get_model.sh"
}

verify_live_video_captioning () {
  [ -e "$workspace"/live-video-analysis/live-video-captioning/ov_models/gpu/InternVL2-1B/config.json ]
  [ -e "$workspace"/live-video-analysis/live-video-captioning/ov_detection_models/yolov8s/public/yolov8s/FP16/yolov8s.bin ]
}

debian_90_profile_live_video_captioning () {
  echo "git curl gawk jq edge_base docker"
}

debian_90_install_live_video_captioning () {
  configure_live_video_captioning
  if verify_live_video_captioning && [[ " $* " != *" --reinstall "* ]]; then
    echo "Live Video Captioning is already installed. Skipping"
  else
    # clone the repository
    ensure_disk_space 64000
    ensure_git_clone "$workspace" $version $repository live-video-analysis/live-video-captioning
    export -n socks_server ftp_proxy

    # setup
    cd "$workspace/live-video-analysis/live-video-captioning"
    sed -i "s|^ENABLE_DETECTION_PIPELINE=.*|ENABLE_DETECTION_PIPELINE=true|" .env.example
    ensure_hf_token OpenGVLab/InternVL2-1B
    sed -i "s|^HUGGINGFACEHUB_API_TOKEN=.*|HUGGINGFACEHUB_API_TOKEN=$HF_TOKEN|" .env.example
    bash scripts/setup_env.sh

    local device=$(ensure_select_device "$@")
    export MODEL_DOWNLOAD_EPHEMERAL_SCRIPT_URL="$get_model_script"
    ./model_download_scripts/download_models.sh --model OpenGVLab/InternVL2-1B --type vlm --weight-format int8 --device $device
    ./model_download_scripts/download_models.sh --model yolov8s --type vision --device $device
    docker compose -f compose.yaml pull 
    verify_live_video_captioning
  fi

  echo "@@HIGHLIGHT workspace: $workspace"
  echo "@@HIGHLIGHT $installer_name start|remove"
}

debian_90_start_live_video_captioning () {
  configure_live_video_captioning
  ensure_ports_open "${used_ports[*]}" debian_90_stop_live_video_captioning

  cd "$workspace"/live-video-analysis/live-video-captioning
  docker compose -f compose.yaml up -d

  echo "@@HIGHLIGHT URL: http://$(ensure_ip):${used_ports[0]}"
  echo "@@HIGHLIGHT $installer_name stop|remove"
}

debian_90_stop_live_video_captioning () {
  configure_live_video_captioning
  cd "$workspace"/live-video-analysis/live-video-captioning
  docker compose -f compose.yaml down -v --remove-orphans
}

debian_90_remove_live_video_captioning () {
  debian_90_stop_live_video_captioning || true
  ensure_sudo rm -rf "$workspace" 2> /dev/null || true
}
