
configure_uncrewed_aerial_vehicle_vision_analytics () {
  repository="https://github.com/open-edge-platform/federal-and-aerospace-ai-suite.git"
  version="release-2026.3.0"
  workspace="$(ensure_project_path)/uav-mission-compute-sdk/vision-analytics"
  app_dir="$workspace/uav-vision-analytics"
  compose_files=(-f docker-compose-pymavlink.yml)
}

verify_uncrewed_aerial_vehicle_vision_analytics_models () {
  local detection="$app_dir/resources/models/yolo11s/yolo11s_openvino_model/yolo11s"
  local caption="$app_dir/resources/ov_models/gpu/InternVL2-1B"
  [[ -f "$detection.xml" && -f "$detection.bin" ]] &&
    compgen -G "$caption/*.xml" >/dev/null && compgen -G "$caption/*.bin" >/dev/null
}

verify_uncrewed_aerial_vehicle_vision_analytics_installed () {
  [ -r "$app_dir/Makefile" ] && [ -r "$app_dir/.env" ] &&
    [ -n "$(ensure_prop get installed/uncrewed_aerial_vehicle_vision_analytics/version)" ]
}

verify_uncrewed_aerial_vehicle_vision_analytics () {
  verify_uncrewed_aerial_vehicle_vision_analytics_installed &&
    verify_uncrewed_aerial_vehicle_vision_analytics_models
}

debian_90_profile_uncrewed_aerial_vehicle_vision_analytics () {
  echo "docker_io git curl make v4l_utils edge_base python3_venv gawk"
}

debian_90_license_uncrewed_aerial_vehicle_vision_analytics () {
  ensure_license_use_model YOLO11S https://github.com/ultralytics/ultralytics/blob/main/LICENSE
  ensure_license_use_model InternVL2-1B 'https://huggingface.co/OpenGVLab/InternVL2-1B#license'
}

install_uncrewed_aerial_vehicle_vision_analytics_source () {
  if [[ -e "$workspace" || -L "$workspace" ]]; then
    if [[ -L "$workspace" || ! -d "$workspace/.git" ]]; then
      echo "Refusing incompatible source destination: $workspace" >&2
      return 1
    fi
    local remote changes
    remote="$(git -C "$workspace" remote get-url origin)" || return $?
    changes="$(git -C "$workspace" status --porcelain --untracked-files=no)" || return $?
    if [[ "$remote" != "$repository" || -n "$changes" ]]; then
      echo "Refusing to overwrite a different repository or tracked local changes at $workspace." >&2
      return 1
    fi
    if [ -n "$(ensure_prop get started/uncrewed_aerial_vehicle_vision_analytics/ports)" ]; then
      echo "Stop uncrewed_aerial_vehicle_vision_analytics before updating its source." >&2
      return 1
    fi
  else
    mkdir -p "$(dirname "$workspace")"
    git clone --no-checkout --depth 1 "$repository" "$workspace" || return $?
  fi
  git -C "$workspace" fetch --depth 1 origin "$version" &&
    git -C "$workspace" checkout --detach FETCH_HEAD || return $?
  echo "UAV source commit: $(git -C "$workspace" rev-parse HEAD)"
}

debian_90_install_uncrewed_aerial_vehicle_vision_analytics () {
  configure_uncrewed_aerial_vehicle_vision_analytics "$@"
  if verify_uncrewed_aerial_vehicle_vision_analytics && ! ensure_parse_reinstall "$@"; then
    echo "uncrewed_aerial_vehicle_vision_analytics is already installed."
    return 0
  fi
  if ! compgen -G '/dev/accel/accel*' >/dev/null || ! compgen -G '/dev/dri/renderD*' >/dev/null; then
    echo "Vision Analytics requires Intel NPU and GPU device nodes." >&2
    return 1
  fi
  python3 -c 'import ensurepip' || return $?
  echo "@@STEP Fetching UAV source ref $version for vision-analytics"
  install_uncrewed_aerial_vehicle_vision_analytics_source || return $?
  if [[ ! -f "$app_dir/Makefile" || ! -f "$app_dir/.env.example" ]]; then
    echo "Required UAV application source is missing: $app_dir" >&2
    return 1
  fi
  ensure_prop remove installed/uncrewed_aerial_vehicle_vision_analytics/version || return $?
  cd "$app_dir" || return $?
  echo "Review $app_dir/.env and upstream LAN bindings before starting the application."
  make init || return $?
  sed -i "s|^HOST_IP=.*|HOST_IP=$(ensure_ip)|" .env || return $?
  local detection="$app_dir/resources/models/yolo11s/yolo11s_openvino_model/yolo11s"
  local caption="$app_dir/resources/ov_models/gpu/InternVL2-1B"
  if [[ ! -f "$detection.xml" || ! -f "$detection.bin" ]]; then
    make model ACCEPT_LICENSE=y || return $?
  fi
  if ! compgen -G "$caption/*.xml" >/dev/null || ! compgen -G "$caption/*.bin" >/dev/null; then
    ensure_container_namespace install uncrewed_aerial_vehicle_vision_analytics "name:${MODEL_DOWNLOAD_EPHEMERAL_CONTAINER_NAME:-model-download-ephemeral}" || true
    make vlm-model VLM_DEVICE=GPU ACCEPT_LICENSE=y || return $?
  fi
  if ! verify_uncrewed_aerial_vehicle_vision_analytics_models; then
    echo "Model setup did not produce the required YOLO11s and GPU InternVL2 XML/BIN artifacts." >&2
    return 1
  fi
  make _check_certs || return $?
  docker compose "${compose_files[@]}" pull --ignore-buildable &&
    docker compose "${compose_files[@]}" build || return $?
  if [ ! -f "$app_dir/.env" ]; then
    echo "Application initialization did not produce $app_dir/.env." >&2
    return 1
  fi
  ensure_prop set installed/uncrewed_aerial_vehicle_vision_analytics/version "$version" --create || return $?
  verify_uncrewed_aerial_vehicle_vision_analytics || return $?
  echo "@@HIGHLIGHT workspace: $app_dir"
  echo "@@HIGHLIGHT $installer_name start uncrewed_aerial_vehicle_vision_analytics"
}

verify_uncrewed_aerial_vehicle_vision_analytics_services () {
  local expected running service
  expected="$(docker compose "${compose_files[@]}" config --services)" || return $?
  running="$(docker compose "${compose_files[@]}" ps --status running --services)" || return $?
  [ -n "$expected" ] || return 1
  while IFS= read -r service; do
    grep -Fxq -- "$service" <<< "$running" || return 1
  done <<< "$expected"
  docker exec dlstreamer-pipeline-server python3 -c \
    'from urllib.request import urlopen; urlopen("http://127.0.0.1:8081/pipelines/status", timeout=5).close()'
}

verify_uncrewed_aerial_vehicle_vision_analytics_manager () {
  docker exec dlstreamer-pipeline-server python3 -c '
from pathlib import Path
import sys
expected = [b"python3", b"/home/pipeline-server/scripts/pipeline_manager.py", b"--start-now"]
for path in Path("/proc").glob("[0-9]*/cmdline"):
    try:
        command = path.read_bytes().rstrip(b"\0").split(b"\0")
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        continue
    if command == expected:
        sys.exit(0)
sys.exit(1)
'
}

verify_uncrewed_aerial_vehicle_vision_analytics_pipelines () {
  verify_uncrewed_aerial_vehicle_vision_analytics_manager || return 1
  local status
  status="$(docker exec dlstreamer-pipeline-server python3 /home/pipeline-server/scripts/pipeline_manager.py --status)" || return $?
  printf '%s\n' "$status" | awk '
    NR > 1 { if (NF != 6 || $4 != "RUNNING" || $6 != "yes") failed = 1; count++ }
    END { exit (failed || !count) }
  '
}

debian_90_start_uncrewed_aerial_vehicle_vision_analytics () {
  configure_uncrewed_aerial_vehicle_vision_analytics "$@"
  if ! verify_uncrewed_aerial_vehicle_vision_analytics; then
    echo "uncrewed_aerial_vehicle_vision_analytics installation is missing source, configuration, or models. Run install to repair it." >&2
    return 1
  fi
  cd "$app_dir" || return $?
  local used_ports=()
  if [ -z "$(ensure_prop get started/uncrewed_aerial_vehicle_vision_analytics/ports)" ]; then
    local config ports
    config="$(docker compose "${compose_files[@]}" config --format json)" || return $?
    ports="$(python3 -c '
import json, sys
config = json.load(sys.stdin)
print(" ".join(sorted({str(port["published"]) for service in config["services"].values()
                       for port in service.get("ports", []) if "published" in port})))
' <<< "$config")" || return $?
    read -r -a used_ports <<< "$ports"
    ensure_ports_open install uncrewed_aerial_vehicle_vision_analytics "${used_ports[@]}" || return $?
  else
    read -r -a used_ports <<< "$(ensure_prop get started/uncrewed_aerial_vehicle_vision_analytics/ports)"
  fi
  sed -i "s|^HOST_IP=.*|HOST_IP=$(ensure_ip)|" .env || return $?
  ensure_container_namespace start uncrewed_aerial_vehicle_vision_analytics $(ensure_container_parse_yaml docker-compose-pymavlink.yml) || true
  make pymav-up || return $?
  local check attempt ready
  for check in services pipelines; do
    if [ "$check" = pipelines ]; then
      make check-cameras || return $?
      if ! verify_uncrewed_aerial_vehicle_vision_analytics_manager; then
        docker exec --detach dlstreamer-pipeline-server sh -c \
          'exec python3 /home/pipeline-server/scripts/pipeline_manager.py --start-now >/tmp/oep-uav-manager.log 2>&1' || return $?
      fi
    fi
    local attempts=24
    [ "$check" != pipelines ] || attempts=240
    ready=0
    for ((attempt=0; attempt<attempts; attempt++)); do
      if "verify_uncrewed_aerial_vehicle_vision_analytics_$check"; then ready=1; break; fi
      sleep 5
    done
    if [ "$ready" -ne 1 ]; then
      echo "vision-analytics readiness timed out ($check). Inspect docker compose logs in $app_dir." >&2
      return 1
    fi
  done
  ensure_prop create started/uncrewed_aerial_vehicle_vision_analytics/ports || return $?
  ensure_prop set started/uncrewed_aerial_vehicle_vision_analytics/ports "${used_ports[*]:-none}" || return $?
  echo "@@HIGHLIGHT Status: cd $app_dir && make cameras-status"
  echo "@@HIGHLIGHT $installer_name stop uncrewed_aerial_vehicle_vision_analytics"
}

debian_90_stop_uncrewed_aerial_vehicle_vision_analytics () {
  configure_uncrewed_aerial_vehicle_vision_analytics "$@"
  if ! verify_uncrewed_aerial_vehicle_vision_analytics_installed; then
    echo "uncrewed_aerial_vehicle_vision_analytics is not installed." >&2
    return 1
  fi
  cd "$app_dir" && {
    docker compose "${compose_files[@]}" down || true
    ensure_container_cleanup $(ensure_container_parse_yaml docker-compose-pymavlink.yml) || true
  } || true
  ensure_prop remove started/uncrewed_aerial_vehicle_vision_analytics/
}

debian_90_remove_uncrewed_aerial_vehicle_vision_analytics () {
  configure_uncrewed_aerial_vehicle_vision_analytics "$@"
  if ! verify_uncrewed_aerial_vehicle_vision_analytics_installed; then
    echo "uncrewed_aerial_vehicle_vision_analytics is not installed." >&2
    return 1
  fi
  cd "$app_dir" && {
    docker compose "${compose_files[@]}" down --volumes --remove-orphans || true
    ensure_container_cleanup $(ensure_container_parse_yaml docker-compose-pymavlink.yml) || true
  } || true
  ensure_prop remove started/uncrewed_aerial_vehicle_vision_analytics/ || true
  ensure_rm "$workspace" || return $?
  ensure_prop remove installed/uncrewed_aerial_vehicle_vision_analytics/
}
