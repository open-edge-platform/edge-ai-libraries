
configure_uav_mission_compute_sdk () {
  workspace="$(ensure_project_path)/uav-mission-compute-sdk"
  version="release-2026.2.0"
  repository="https://github.com/open-edge-platform/edge-ai-suites.git"
}

verify_uav_mission_compute_sdk () {
  [ -e "$workspace" ]
}

debian_85_profile_uav_mission_compute_sdk () {
  echo "docker git curl make v4l_utils"
}

debian_85_install_uav_mission_compute_sdk () {
  configure_uav_mission_compute_sdk
  if verify_uav_mission_compute_sdk && [[ " $* " != *" --reinstall "* ]]; then
    echo "UAV mission compute sdk is already installed. Skipping..." 1>&2
  else
    ensure_git_export "$workspace" "$version" "$repository" federal-and-aerospace-ai-suite/uav-mission-compute-sdk
    cd "$workspace"/federal-and-aerospace-ai-suite/uav-mission-compute-sdk
    make init
    sed -i "s|^HOST_IP=.*$|HOST_IP=$(ensure_ip)|" .env
    export HTTP_PROXY="${HTTP_PROXY:-$http_proxy}" HTTPS_PROXY="${HTTPS_PROXY:-$https_proxy}" NO_PROXY="${NO_PROXY:-$no_proxy}"
    make build
    verify_uav_mission_compute_sdk
  fi

  local profile="sim-camera"
  [[ " $* " != *" --sim "* ]] || profile="sim-camera"
  [[ " $* " != *" --usb "* ]] || profile="usb-camera"
  [[ " $* " != *" --realsense "* ]] || profile="realsense-camera"
  cd "$workspace"/federal-and-aerospace-ai-suite/uav-mission-compute-sdk
  sed -i '/^PROFILE=/{d}' "$workspace"/federal-and-aerospace-ai-suite/uav-mission-compute-sdk/.env
  echo "PROFILE=$profile" >> "$workspace"/federal-and-aerospace-ai-suite/uav-mission-compute-sdk/.env

  echo "@@HIGHLIGHT workspace: $workspace"
}

debian_85_start_uav_mission_compute_sdk () {
  ensure_ports_open "8086 3000 9090 9273" debian_85_stop_uav_mission_compute_sdk "$@"
  configure_uav_mission_compute_sdk
  cd "$workspace"/federal-and-aerospace-ai-suite/uav-mission-compute-sdk
  . .env
  export HTTP_PROXY="${HTTP_PROXY:-$http_proxy}" HTTPS_PROXY="${HTTPS_PROXY:-$https_proxy}" NO_PROXY="${NO_PROXY:-$no_proxy}"
  make up-$PROFILE
}

debian_85_stop_uav_mission_compute_sdk () {
  configure_uav_mission_compute_sdk
  cd "$workspace"/federal-and-aerospace-ai-suite/uav-mission-compute-sdk && make down || true
}

debian_85_remove_uav_mission_compute_sdk () {
  debian_85_stop_uav_mission_compute_sdk "$@"
  ensure_sudo rm -rf "$workspace"
}

