
configure_libze1 () {
  libze1_deb="https://snapshot.ppa.launchpadcontent.net/kobuk-team/intel-graphics/ubuntu/20260606T100000Z/pool/main/l/level-zero-loader/libze1_1.28.2-1~${VERSION_ID}~ppa1_amd64.deb"
}

debian_15_profile_libze1 () {
  echo "curl"
}

debian_15_install_libze1 () {
  configure_libze1 

  if ensure_apt_is_installed libze1; then
    echo "libze1 is already installed. Skipping..."
  else
    curl -fsSL "$libze1_deb" -o /tmp/libze1.deb && {
      ensure_apt install -y /tmp/libze1.deb || {
        ensure_apt purge -y level-zero level-zero-devel && ensure_apt install -y /tmp/libze1.deb
      }
    }
  fi
}

debian_15_sbom_libze1 () {
  configure_libze1
  cat <<EOF
$(ensure_sbom_format pkg-list "$libze1_deb")
EOF
}

