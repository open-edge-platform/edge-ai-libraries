
configure_libze1 () {
  version=1.32.0
  libze1_deb="https://github.com/oneapi-src/level-zero/releases/download/v$version/libze1_$version+u${VERSION_ID}_amd64.deb"
}

debian_15_profile_libze1 () {
  echo "curl"
}

debian_15_install_libze1 () {
  configure_libze1 

  if ensure_apt_is_installed libze1=$version && [[ " $* " != *" --reinstall "* ]]; then
    echo "libze1 is already installed. Skipping..."
  else
    local deb="/tmp/$(basename "$libze1_deb")"
    curl -fsSL "$libze1_deb" -o "$deb" && {
      ensure_apt install -y "$deb" || {
        ensure_apt purge -y level-zero level-zero-devel && ensure_apt install -y /tmp/libze1.deb
      }
      rm -f "$deb"
    }
  fi
}

debian_15_sbom_libze1 () {
  configure_libze1
  cat <<EOF
$(ensure_sbom_format pkg-list "$libze1_deb")
EOF
}

