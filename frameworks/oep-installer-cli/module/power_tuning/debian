configure_power_tuning () {
  workspace="$(ensure_project_path)/power_tuning"
  repository="https://github.com/open-edge-platform/edge-node-infrastructure-blueprint.git"
  version=6adeb8ad778d8700b2f9773cbd438e10a718bf79
  power_tuning_path="/opt/edge/developer/tools/power-tuning"
}

verify_power_tuning () {
  [ -e "$power_tuning_path"/openvino_stress.sh ]
}

debian_45_profile_power_tuning () {
  echo "intel_lpmd pcm sysbench msr_tools lm_sensors stress_ng linux_tools"
}

debian_45_install_power_tuning () {
  configure_power_tuning "$@"
  if verify_power_tuning && ! ensure_parse_reinstall "$@"; then
    echo "power_tuning is installed." >&2
  else
    ensure_prop set installed/power_tuning/owned true

    echo "@@STEP Cloning repository"
    ensure_git_export "$workspace" "$version" "$repository" tools/power-tuning
    # fix paths
    sed -i -e 's|^MODEL_PATH=.*|MODEL_PATH=/tmp/openvino-stress/models|' -e 's|^GNU_VENV_DIR=.*|GNU_VENV_DIR=/tmp/openvino-stress/venv|' "$workspace"/tools/power-tuning/openvino_stress.sh
    
    ensure_sudo mkdir -p "$power_tuning_path"
    ensure_sudo cp -r "$workspace"/tools/power-tuning/. "$power_tuning_path"
    verify_power_tuning
  fi
}

debian_45_remove_power_tuning () {
  configure_power_tuning "$@"
  [ "$(ensure_prop get installed/power_tuning/owned)" = "true" ] || return 0
  ensure_rm "$power_tuning_path" /tmp/openvino-stress
}
