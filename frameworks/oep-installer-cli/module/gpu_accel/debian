
configure_gpu_accel () {
  repo_name="repositories.intel.com"
  key_url="https://$repo_name/gpu/intel-graphics.key"
  key_file="/usr/share/keyrings/intel-graphics.gpg"
  apt_entry="deb [signed-by=$key_file] https://$repo_name/gpu/${ID} ${VERSION_CODENAME} unified"
  apt_file="/etc/apt/sources.list.d/intel-graphics.list"
  pkg_list=(clinfo libze-intel-gpu1 intel-media-va-driver-non-free intel-opencl-icd)
  allow_downgrades=(libva-wayland2)
}

verify_gpu_accel () {
  [ -c /dev/dri/renderD128 ] &&
  verify_gpu_accel_packages
}

# checks the driver packages only, independent of GPU hardware being present.
# used to confirm a fresh install succeeded even on systems without a discrete/exposed GPU device.
verify_gpu_accel_packages () {
  ensure_apt_is_installed intel-media-va-driver-non-free
}

debian_40_profile_gpu_accel () {
  echo "curl gnupg libze1"
}

debian_40_group_gpu_accel () {
  echo "render:992 video:"
}

debian_40_install_gpu_accel () {
  configure_gpu_accel "$@"

  if verify_gpu_accel && [[ " $* " != *" --reinstall "* ]]; then
    echo "Gpu drivers are already installed. Skipping..."
  else
    # declare stack ownership
    ensure_prop set installed/gpu_accel/owned true

    # remove legacies
    debian_40_remove_gpu_accel || true

    # product key & list 
    ensure_apt_key $key_file $key_url --dearmor
    ensure_apt_source $apt_file "$apt_entry"

    # apt update
    ensure_apt update -y

    # install the packages
    ensure_apt_allow_downgrades "${allow_downgrades[*]}" --no-install-recommends "${pkg_list[@]}"
    ensure_apt install --no-install-recommends --allow-downgrades -y "${pkg_list[@]}"
    verify_gpu_accel_packages
  fi

  # create the render group
  ensure_group_add $(debian_40_group_gpu_accel)
}

debian_40_remove_gpu_accel () {
  # Leave untouched if not installed by gpu_accel
  [ "$(ensure_prop get installed/gpu_accel/owned)" = "true" ] || return 0

  configure_gpu_accel "$@"
  ensure_apt autoremove -m -y clinfo libze-intel-gpu1 intel-media-va-driver-non-free intel-opencl-icd || true
  # Remove legacy/conflicting apt sources and keyrings for the Intel GPU repo.
  # Older installer versions wrote /etc/apt/sources.list.d/intel-gpu.list using the
  # intel-gpu-archive-keyring.gpg keyring. Because that entry points at the same
  # repository as $apt_file but with a different Signed-By, apt refuses to update
  # ("Conflicting values set for option Signed-By"). Drop any such stale entry
  # (anything referencing the gpu repo other than our own $apt_file) so the current
  # entry is authoritative.
  ensure_apt_source_remove https://repositories.intel.com/gpu
  ensure_sudo rm -f /usr/share/keyrings/intel-gpu-archive-keyring.gpg $key_file $apt_file
}

debian_40_sbom_gpu_accel () {
  configure_gpu_accel "$@"
  cat <<EOF
$(ensure_sbom_format name "$repo_name")
$(ensure_sbom_format apt-source "$apt_entry")
$(ensure_sbom_format apt-list-file "$apt_file")
$(ensure_sbom_format gpg-key "$key_url")
$(ensure_sbom_format key-file "$key_file")
$(ensure_sbom_format pkg-list "${pkg_list[@]}")
EOF
}

