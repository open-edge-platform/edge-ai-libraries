
debian_99_profile_mission_decision_support_blueprint () {
  case "$1" in
  bootstrap)
    echo "core_types system_inspection system_summary cdi realsense chrony edge_pack_base_standard edge_pack_npu edge_pack_ipu edge_pack_manageability edge_pack_tsn edge_pack_media_ffmpeg edge_pack_media_gst gpu_accel npu_accel power_tuning system_info docker_io k3s_io ubuntu_server"
    ;;
  *)
    local modules=(core_types system_inspection system_summary power_tuning system_info cdi realsense chrony ubuntu_server)
    if ensure_parse_option --k3s "$@"; then
      modules+=(k3s_io)
    else
      modules+=(docker_io)
    fi
    modules+=($(configure_edge_pack_selection "edge_pack_base_standard edge_pack_npu edge_pack_ipu edge_pack_manageability edge_pack_tsn edge_pack_media_ffmpeg edge_pack_media_gst" "$@"))
    echo "${modules[*]}"
    ;;
  esac
}

