
fedora_80_profile_anomalib () {
  :
}

fedora_80_install_anomalib () {
  configure_anomalib $*
  if verify_anomalib && [[ " $* " != *" --reinstall "* ]]; then
    echo "Anomalib is installed." >&2
  else
    ensure_disk_size 15000

    echo "@@STEP Installing anomalib=${version}"
    mkdir -p "$workspace"
    cd "$workspace"
    python3 -m venv .venv
    . .venv/bin/activate
    pip install "anomalib[openvino,cpu]==${version}"

    echo "@@STEP Installing skills"
    ensure_skills add "$version_skills" "$repository_skills" "${skills[@]/#/.agents/skills/}"
    verify_anomalib
  fi

  # validation
  test_anomalib "$@"

  echo "@@HIGHLIGHT venv: $workspace/.venv"
}

fedora_80_remove_anomalib () {
  configure_anomalib $*
  ensure_rm "$workspace" || true
  ensure_skills remove "${skills[@]}"
}

