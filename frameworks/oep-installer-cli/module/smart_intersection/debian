
configure_smart_intersection () {
  workspace="$(ensure_project_path)/smart-intersection"
  version=release-2026.2.0
  repository="https://github.com/open-edge-platform/metro-ai-suite.git"
}

configure_smart_intersection_device () {
  local device="$1"
  cd "$workspace"/metro-vision-ai-app-recipe
  sed -i "s|_DEVICE=.*|_DEVICE=${device^^}|" docker-compose.yml
  [ -e smart-intersection/src/dlstreamer-pipeline-server/config.json.orig ] || cp -f smart-intersection/src/dlstreamer-pipeline-server/config.json smart-intersection/src/dlstreamer-pipeline-server/config.json.orig
  case "$device" in
  cpu)
    jq -r '.config.pipelines |= map(select(.name | test("-(gpu|npu)$") | not))' smart-intersection/src/dlstreamer-pipeline-server/config.json.orig > smart-intersection/src/dlstreamer-pipeline-server/config.json
    ;;
  npu)
    jq -r '.config.pipelines |= map(select(.name | endswith("-npu")))' smart-intersection/src/dlstreamer-pipeline-server/config.json.orig > smart-intersection/src/dlstreamer-pipeline-server/config.json
    ;;
  gpu)
    jq -r '.config.pipelines |= map(select(.name | endswith("-gpu")))' smart-intersection/src/dlstreamer-pipeline-server/config.json.orig > smart-intersection/src/dlstreamer-pipeline-server/config.json
    ;;
  *)
    cp -f smart-intersection/src/dlstreamer-pipeline-server/config.json.orig smart-intersection/src/dlstreamer-pipeline-server/config.json
    ;;
  esac
}

verify_smart_intersection () {
  local v
  for v in 1122east_h264.ts 1122north_h264.ts 1122south_h264.ts 1122west_h264.ts; do
    [ -e "$workspace"/metro-vision-ai-app-recipe/smart-intersection/src/dlstreamer-pipeline-server/videos/$v ]
  done
  [ -e "$workspace"/metro-vision-ai-app-recipe/smart-intersection/src/dlstreamer-pipeline-server/models/intersection/openvino.bin ]
}

debian_90_profile_smart_intersection () {
  echo "git curl gawk jq edge_base docker"
}

debian_90_install_smart_intersection () {
  configure_smart_intersection
  if verify_smart_intersection && [[ " $* " != *" --reinstall "* ]]; then
    echo "Smart intersection is already installed. Skipping"
  else
    # clone the repository
    ensure_disk_size 1500
    ensure_git_export "$workspace" $version $repository metro-vision-ai-app-recipe

    # setup
    cd "$workspace/metro-vision-ai-app-recipe"
    sed -i 's|sudo chown|#sudo chown|' smart-intersection/install.sh
    sed -i 's|curl -k |curl -f |' smart-intersection/init.sh
    ./install.sh smart-intersection $(ensure_ip)
    verify_smart_intersection
  fi

  local device=$(ensure_select_device "$@")
  configure_smart_intersection_device "$device"

  echo "@@HIGHLIGHT workspace: $workspace"
  echo "@@HIGHLIGHT $installer_name start [--gpu|npu|cpu]"
  echo "@@HIGHLIGHT $installer_name remove"
}

debian_90_start_smart_intersection () {
  configure_smart_intersection
  ensure_ports_open 443 debian_90_stop_smart_intersection

  local device=$(ensure_select_device "$@")
  [[ " ${*,,} " != *" --$device "* ]] || configure_smart_intersection_device "$device"

  cd "$workspace"/metro-vision-ai-app-recipe
  export SUPASS=$(cat smart-intersection/src/secrets/supass)
  docker compose up -d 

  echo "@@HIGHLIGHT URL: https://$(ensure_ip)"
  echo "@@HIGHLIGHT username/password: admin/$SUPASS"
  echo "@@HIGHLIGHT $install_name start [--gpu|npu|cpu]"
  echo "@@HIGHLIGHT $install_name stop|remove"
}

debian_90_stop_smart_intersection () {
  configure_smart_intersection
  cd "$workspace"/metro-vision-ai-app-recipe
  docker compose -f compose-scenescape.yml down -v --remove-orphans
}

debian_90_remove_smart_intersection () {
  debian_90_stop_smart_intersection || true
  ensure_sudo rm -rf "$workspace" 2> /dev/null || true
}
