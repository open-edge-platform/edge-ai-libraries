debian_99_profile_system_summary () {
  [ "$1" != "bootstrap" ] || echo "system_inspection curl dmidecode pciutils kmod"
  [ "$1" != "install" ] || echo "curl dmidecode pciutils kmod"
}

debian_99_install_system_summary () {
  echo "@@REPORT SYSTEM SUMMARY"
  install_system_inspection "$@" || true
}
