configure_k3s_io () {
  workspace="$(ensure_project_path)/k3s_io"
  repository="https://github.com/open-edge-platform/edge-node-infrastructure-blueprint.git"
  version=8e6f01943286f0e838dad3bf46390119b7645ad2
  install_sh_sha256=d75e014f2d2ab5d30a318efa5c326f3b0b7596f194afcff90fa7a7a91166d5f7
}

verify_k3s_io () {
  command -v k3s > /dev/null 2>&1 && systemctl is-active --quiet k3s
}

debian_31_profile_k3s_io () {
  echo "git curl docker_io"
}

debian_31_install_k3s_io () {
  configure_k3s_io "$@"
  if verify_k3s_io && [[ " $* " != *" --reinstall "* ]]; then
    echo "k3s_io is installed." >&2
  else
    if [ -e "$HOME/.kube/config" ] &&
       { [ ! -r /etc/rancher/k3s/k3s.yaml ] ||
         ! cmp -s /etc/rancher/k3s/k3s.yaml "$HOME/.kube/config"; }; then
      echo "Refusing to overwrite the existing $HOME/.kube/config." 1>&2
      echo "Back it up or move it before installing k3s_io." 1>&2
      return 1
    fi

    echo "@@STEP Clone repository"
    ensure_git_export "$workspace" "$version" "$repository" infrastructure/installation-scripts

    echo "@@STEP Disable docker download"
    cd "$workspace"/infrastructure/installation-scripts
    sed -i '/^DOCKER_STATIC_URL/,/^success "docker-compose saved"/{d}' download-resources.sh

    echo "@@STEP Downloading k3s resources"
    cd "$workspace"/infrastructure/installation-scripts
    mkdir -p resources/docker
    local k3s_binary="$PWD/resources/k3s/k3s"
    (
      local kubectl_wrapper_dir
      kubectl_wrapper_dir="$(mktemp -d "${TMPDIR:-/tmp}/oep-k3s-kubectl.XXXXXX")"
      trap 'rm -rf -- "$kubectl_wrapper_dir"' EXIT
      printf '%s\n' '#!/bin/sh' 'exec "'"$k3s_binary"'" kubectl "$@"' > "$kubectl_wrapper_dir/kubectl"
      chmod 755 "$kubectl_wrapper_dir/kubectl"
      ensure_sudo env PATH="$kubectl_wrapper_dir:$PATH" \
        K3S_INSTALL_SH_SHA256="$install_sh_sha256" ./download-resources.sh
    )

    local manifest
    for manifest in nfd nfd-node-feature-rules gpu-plugin npu-plugin; do
      if [ ! -s "$workspace/infrastructure/installation-scripts/resources/intel-device-plugins/manifests/$manifest.yaml" ]; then
        echo "Intel device-plugin manifest '$manifest.yaml' was not prepared; refusing to install K3s without the plugin resources." 1>&2
        return 1
      fi
    done

    echo "@@STEP Installing k3s"
    ensure_sudo ./install-k3s.sh
    verify_k3s_io || {
      echo "K3s installation completed without an active K3s service." 1>&2
      return 1
    }
    ensure_prop set installed/k3s_io/owned true
  fi
}

debian_31_start_k3s_io () {
  configure_k3s_io "$@"
  [ "$(ensure_prop get installed/k3s_io/owned)" = "true" ] || return 0

  if kubectl status > /dev/null 2>&1; then
    echo "k3s is started" >&2
  else
    cd "$workspace"/infrastructure/installation-scripts &&
    ensure_sudo ./kubernetes-provision.sh
  fi
}

debian_31_remove_k3s_io () {
  configure_k3s_io
  [ "$(ensure_prop get installed/k3s_io/owned)" = "true" ] || return 0
  local script found=0 kubeconfig=0
  # Preserve kubeconfig changes made since the installer copied the original.
  if [ -f "$HOME/.kube/config" ] &&
     ! ensure_sudo cmp -s /etc/rancher/k3s/k3s.yaml "$HOME/.kube/config"; then
    kubeconfig=1
  fi
  for script in /usr/local/bin/k3s-uninstall.sh /usr/local/bin/k3s-agent-uninstall.sh; do
    [ -x "$script" ] || continue
    found=1
    echo "Removing the K3s runtime ($script)..."
    ensure_sudo "$script"
  done
  if [ $found -eq 0 ] &&
     { command -v k3s > /dev/null 2>&1 || systemctl is-active --quiet k3s; }; then
    echo "K3s is still installed, but no K3s uninstall script was found." 1>&2
    return 1
  fi
  [ $kubeconfig -eq 1 ] || rm -f "$HOME/.kube/config"
  if command -v k3s > /dev/null 2>&1 || systemctl is-active --quiet k3s; then
    echo "K3s is still present after running its uninstall script." 1>&2
    return 1
  fi
  ensure_rm "$workspace"
  ensure_prop remove installed/k3s_io/owned
}
