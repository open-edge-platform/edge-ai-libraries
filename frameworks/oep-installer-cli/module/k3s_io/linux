lifecycle_k3s_io () {
  ensure_sudo /usr/bin/python3 - "$1" "$workspace" "$(id -u)" \
    "$(ensure_prop get installed/k3s_io/owned)" "$install_sh_sha256" <<'PY'
# SPDX-FileCopyrightText: (C) 2026 Intel Corporation
# SPDX-License-Identifier: Apache-2.0

import base64
import copy
import hashlib
import json
import os
from pathlib import Path
import pwd
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid

import yaml


class Lifecycle:
    def __init__(self, workspace, uid, legacy_owned, install_sha):
        self.scripts = Path(workspace) / "infrastructure/installation-scripts"
        self.user = pwd.getpwuid(int(uid))
        self.home = Path(self.user.pw_dir)
        self.directory = Path("/var/lib/openedge-cli/k3s_io") / str(self.user.pw_uid)
        for directory in reversed([self.directory, *self.directory.parents][:-1]):
            if directory.is_symlink():
                raise RuntimeError(f"Refusing symlink in lifecycle state path: {directory}")
            directory.mkdir(mode=0o700, exist_ok=True)
            if directory.stat().st_uid != 0:
                raise RuntimeError(f"Lifecycle state directory is not root-owned: {directory}")
            if directory in (self.directory, self.directory.parent, self.directory.parent.parent):
                directory.chmod(0o700)
        self.path = self.directory / "state.json"
        if self.path.is_symlink():
            raise RuntimeError("Refusing symlink for lifecycle state")
        self.state = json.loads(self.path.read_text()) if self.path.exists() else {}
        self.legacy_owned = legacy_owned == "true"
        self.install_sha = install_sha
        self.env = dict(os.environ, KUBECONFIG="/etc/rancher/k3s/k3s.yaml")

    def run(self, *args, data=None, check=True, env=None):
        result = subprocess.run(
            args, input=data, text=True, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, env=self.env if env is None else env, check=False,
        )
        if check and result.returncode:
            # Command output can contain proxy credentials or kubeconfig data.
            raise RuntimeError(f"{args[0]} {args[1] if len(args) > 1 else ''} failed "
                               f"(exit {result.returncode}); lifecycle state retained")
        return result

    def save(self):
        fd, name = tempfile.mkstemp(dir=self.directory)
        try:
            with os.fdopen(fd, "w") as stream:
                json.dump(self.state, stream)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(name, self.path)
        finally:
            if os.path.exists(name):
                os.unlink(name)

    def service(self, name):
        load = self.run("systemctl", "show", "-p", "LoadState", "--value", name).stdout.strip()
        active = self.run("systemctl", "is-active", "--quiet", name, check=False)
        enabled = self.run("systemctl", "is-enabled", "--quiet", name, check=False)
        if active.returncode not in (0, 3, 4) or enabled.returncode not in (0, 1, 4):
            raise RuntimeError(f"Unable to determine original service state: {name}")
        return {
            "exists": load != "not-found",
            "active": active.returncode == 0,
            "enabled": enabled.returncode == 0,
        }

    def remember_file(self, path):
        path = Path(path)
        key = str(path)
        files = self.state.setdefault("files", {})
        if key in files:
            return
        if path.is_symlink() or any(parent.is_symlink() for parent in path.parents):
            raise RuntimeError(f"Refusing to overwrite configuration through a symlink: {path}")
        before = None
        if path.exists():
            if not path.is_file():
                raise RuntimeError(f"Configuration is not a regular file: {path}")
            stat = path.stat()
            before = {
                "data": base64.b64encode(path.read_bytes()).decode(),
                "mode": stat.st_mode & 0o777, "uid": stat.st_uid, "gid": stat.st_gid,
            }
        files[key] = {"before": before, "after": None}
        self.save()

    @staticmethod
    def open_file(path, flags, mode=0o600):
        path = Path(path)
        if not path.is_absolute() or ".." in path.parts:
            raise RuntimeError("Configuration path must be absolute and canonical")
        directory = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
        try:
            for part in path.parts[1:-1]:
                child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                dir_fd=directory)
                os.close(directory)
                directory = child
            return os.open(path.name, flags | os.O_NOFOLLOW, mode, dir_fd=directory)
        finally:
            os.close(directory)

    def record_file(self, path):
        path = Path(path)
        self.state["files"][str(path)]["after"] = hashlib.sha256(path.read_bytes()).hexdigest()
        self.save()

    def write_file(self, path, content, mode=0o600):
        path = Path(path)
        self.remember_file(path)
        record = self.state["files"][str(path)]
        expected = record["after"]
        if expected is None and record["before"]:
            expected = hashlib.sha256(base64.b64decode(record["before"]["data"])).hexdigest()
        path.parent.mkdir(parents=True, exist_ok=True)
        flags = os.O_RDWR | os.O_CREAT | (os.O_EXCL if expected is None else 0)
        fd = self.open_file(path, flags)
        with os.fdopen(fd, "r+b") as stream:
            current = stream.read()
            if (expected is not None and hashlib.sha256(current).hexdigest() != expected
                    or expected is None and current):
                raise RuntimeError(f"Configuration changed outside OEP: {path}")
            record["after"] = hashlib.sha256(content).hexdigest()
            self.save()
            stream.seek(0)
            stream.truncate(0)
            stream.write(content)
            os.fchmod(stream.fileno(), mode)
        self.record_file(path)

    def cluster(self):
        result = self.run("k3s", "kubectl", "get", "namespace", "kube-system", "-o", "json")
        return json.loads(result.stdout)["metadata"]["uid"]

    def check_cluster(self):
        expected = self.state.get("cluster")
        if expected and self.cluster() != expected:
            raise RuntimeError("K3s cluster identity changed; refusing to provision or remove resources")

    def wait_api(self):
        for attempt in range(60):
            result = self.run("k3s", "kubectl", "get", "nodes", "-o", "json",
                              "--request-timeout=5s", check=False)
            if result.returncode == 0 and json.loads(result.stdout).get("items"):
                return
            if attempt < 59:
                time.sleep(5)
        raise RuntimeError("K3s API/nodes did not become available; provisioning state retained")

    def prepare(self):
        if self.state:
            return
        present = shutil.which("k3s") is not None
        if not present and not self.legacy_owned:
            for path in (Path("/etc/rancher/k3s"), Path("/var/lib/rancher/k3s")):
                if path.exists() and any(path.iterdir()):
                    raise RuntimeError(f"K3s binary is missing but pre-existing data exists at {path}; "
                                       "restore the original runtime before provisioning")
        self.state = {
            "owner": str(uuid.uuid4()), "runtime_owned": self.legacy_owned,
            "runtime_present": present, "resources": [], "files": {},
            "service": self.service("k3s"),
        }
        self.save()

    @staticmethod
    def configuration(obj, comparable=True):
        obj = copy.deepcopy(obj)
        obj.pop("status", None)
        metadata = obj.setdefault("metadata", {})
        for key in ("uid", "resourceVersion", "generation", "creationTimestamp",
                    "managedFields", "deletionTimestamp", "deletionGracePeriodSeconds"):
            metadata.pop(key, None)
        if comparable:
            for key in ("kubectl.kubernetes.io/last-applied-configuration",
                        "deployment.kubernetes.io/revision",
                        "deprecated.daemonset.template.generation"):
                metadata.get("annotations", {}).pop(key, None)
        return obj

    def get(self, obj):
        result = self.run("k3s", "kubectl", "get", "--ignore-not-found", "-f", "-",
                          "-o", "json", data=json.dumps(obj))
        return json.loads(result.stdout) if result.stdout.strip() else None

    def apply(self, obj):
        records = self.state["resources"]
        identity = (obj["apiVersion"], obj["kind"], obj["metadata"].get("namespace"),
                    obj["metadata"]["name"])
        record = next((r for r in records if tuple(r["identity"]) == identity), None)
        current = self.get(obj)
        if record is None:
            record = {"identity": identity, "object": obj,
                      "before": self.configuration(current, comparable=False) if current else None,
                      "uid": current["metadata"]["uid"] if current else None,
                      "after": None}
            records.append(record)
            self.save()
        elif record["uid"] and (not current or current["metadata"]["uid"] != record["uid"]):
            raise RuntimeError(f"Resource identity changed: {identity}")
        elif record["after"] and self.configuration(current) != record["after"]:
            raise RuntimeError(f"Resource changed outside OEP: {identity}")
        if current and record["before"] and not record["after"]:
            owner = current["metadata"].get("annotations", {}).get(
                "openedgeplatform.intel.com/k3s-owner")
            if owner != self.state["owner"] and (
                    self.configuration(current) != self.configuration(record["before"])):
                raise RuntimeError(f"Resource changed during interrupted provisioning: {identity}")
        desired = copy.deepcopy(obj)
        desired.setdefault("metadata", {}).setdefault("annotations", {})[
            "openedgeplatform.intel.com/k3s-owner"] = self.state["owner"]
        if current:
            if record["uid"] is None:
                owner = current["metadata"].get("annotations", {}).get(
                    "openedgeplatform.intel.com/k3s-owner")
                if owner != self.state["owner"]:
                    raise RuntimeError(f"Resource was concurrently created outside OEP: {identity}")
            # resourceVersion makes concurrent writes fail instead of overwriting them.
            desired = self.merge(current, desired)
            desired.pop("status", None)
            action = "replace"
        else:
            action = "create"
        print(f"Provisioning {obj['kind']}/{obj['metadata']['name']}", flush=True)
        result = self.run("k3s", "kubectl", action, "-f", "-", "-o", "json",
                          data=json.dumps(desired))
        installed = json.loads(result.stdout)
        record["uid"] = installed["metadata"]["uid"]
        record["after"] = self.configuration(installed)
        if record["before"] is None:
            uids = self.state.setdefault("created_uids", [])
            if record["uid"] not in uids:
                uids.append(record["uid"])
        self.save()
        if obj["kind"] == "CustomResourceDefinition":
            self.run("k3s", "kubectl", "wait", "--for=condition=Established",
                     "--timeout=120s", "crd/" + obj["metadata"]["name"])

    @classmethod
    def merge(cls, original, changes):
        result = copy.deepcopy(original)
        for key, value in changes.items():
            if isinstance(value, dict) and isinstance(result.get(key), dict):
                result[key] = cls.merge(result[key], value)
            else:
                result[key] = copy.deepcopy(value)
        return result

    def deploy(self):
        resources = self.scripts / "resources/intel-device-plugins"
        for archive in sorted((resources / "images").glob("*.tar")):
            self.run("k3s", "ctr", "images", "import", str(archive))
        for namespace in ("node-feature-discovery", "intel-device-plugins"):
            self.apply({
                "apiVersion": "v1", "kind": "Namespace",
                "metadata": {"name": namespace, "labels": {
                    "pod-security.kubernetes.io/enforce": "privileged",
                    "pod-security.kubernetes.io/audit": "privileged",
                    "pod-security.kubernetes.io/warn": "privileged",
                }},
            })
        for name in ("nfd", "nfd-node-feature-rules", "gpu-plugin", "npu-plugin"):
            manifest = resources / "manifests" / (name + ".yaml")
            documents = list(yaml.safe_load_all(manifest.read_text()))
            objects = []
            for document in documents:
                if document:
                    objects.extend(document["items"] if document.get("kind") == "List" else [document])
            if not objects:
                raise RuntimeError(f"Empty device-plugin manifest: {name}")
            for obj in objects:
                if obj["kind"] not in ("Namespace", "CustomResourceDefinition",
                                       "ClusterRole", "ClusterRoleBinding", "NodeFeatureRule"):
                    obj.setdefault("metadata", {}).setdefault(
                        "namespace", "intel-device-plugins" if name.endswith("plugin")
                        else "node-feature-discovery")
                self.apply(obj)
            for obj in objects:
                if obj["kind"] in ("Deployment", "DaemonSet"):
                    self.run("k3s", "kubectl", "rollout", "status",
                             obj["kind"].lower() + "/" + obj["metadata"]["name"],
                             "-n", obj["metadata"]["namespace"], "--timeout=180s")

    def proxy(self):
        values = {name: os.environ.get(name) or os.environ.get(name.lower(), "")
                  for name in ("HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY")}
        if not (values["HTTP_PROXY"] or values["HTTPS_PROXY"]):
            return
        lines = ["[Service]"]
        for name, value in values.items():
            if any(char in value for char in "\r\n\0"):
                raise RuntimeError("Invalid newline or NUL in proxy configuration")
            escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%")
            for key in (name, "CONTAINERD_" + name):
                lines.append(f'Environment="{key}={escaped}"')
        path = Path("/etc/systemd/system/k3s.service.d/99-oep-proxy.conf")
        self.write_file(path, ("\n".join(lines) + "\n").encode())
        self.run("systemctl", "daemon-reload")
        self.run("systemctl", "restart", "k3s")

    def sriov(self):
        config = Path("/etc/cloud/config-file")
        if not config.exists():
            return
        enabled = any(line.strip().partition("=")[0] == "enable_sriov"
                      and line.strip().partition("=")[2].strip().strip("'\"").lower() == "true"
                      for line in config.read_text().splitlines())
        if not enabled:
            return
        pf = Path("/sys/bus/pci/devices/0000:00:02.0")
        count = pf / "sriov_numvfs"
        if not count.exists():
            raise RuntimeError("SR-IOV requested but Intel GPU VF controls are unavailable")
        if "sriov" not in self.state:
            before = int(count.read_text())
            self.state["sriov"] = {"count": before, "values": {}, "after": {},
                                   "service": self.service("intel-sriov-vf.service")}
            self.save()
        snapshot = self.state["sriov"]
        if snapshot["count"]:
            print("Preserving pre-existing SR-IOV VFs and boot configuration")
            return
        if snapshot.get("attempted"):
            if int(count.read_text()) != snapshot.get("after_count", snapshot["count"]):
                raise RuntimeError("SR-IOV VF count changed outside OEP")
            for key, value in snapshot.get("after", {}).items():
                if Path(key).read_text() != value:
                    raise RuntimeError(f"SR-IOV tuning changed outside OEP: {key}")
        cards = sorted((pf / "drm").glob("card[0-9]*"))
        if not cards:
            raise RuntimeError("SR-IOV requested but no Intel GPU DRM card is available")
        driver = (pf / "driver").resolve().name
        if driver not in ("xe", "i915"):
            raise RuntimeError("SR-IOV requires the xe or i915 driver")
        paths = [cards[0] / "prelim_iov/pf/auto_provisioning"]
        if driver == "xe":
            paths.extend(Path("/sys/kernel/debug/dri/0/gt0/pf") / name
                         for name in ("ggtt_spare", "contexts_spare", "doorbells_spare"))
        for path in paths:
            if not path.is_file() or not os.access(path, os.R_OK | os.W_OK):
                raise RuntimeError(f"Cannot safely snapshot/restore SR-IOV control: {path}")
            snapshot["values"].setdefault(str(path), path.read_text())
        self.save()
        for name, source in (
            ("container_setup_sriov.sh", self.scripts / "container_setup_sriov.sh"),
            ("intel-sriov-vf.service", self.scripts / "systemd/intel-sriov-vf.service"),
        ):
            target = Path("/opt/edge/scripts") / name if name.endswith(".sh") else (
                Path("/etc/systemd/system") / name)
            self.write_file(target, source.read_bytes(), 0o755 if name.endswith(".sh") else 0o644)
        self.state["sriov"]["attempted"] = True
        self.save()
        self.run("modprobe", "i2c-algo-bit")
        self.run("modprobe", "video")
        try:
            self.run("bash", "-e", "-o", "pipefail",
                     str(self.scripts / "container_setup_sriov.sh"))
        finally:
            snapshot["after"] = {str(path): path.read_text() for path in paths}
            snapshot["after_count"] = int(count.read_text())
            self.save()
        actual = int(count.read_text())
        if actual != int((pf / "sriov_totalvfs").read_text()):
            raise RuntimeError("SR-IOV provisioning did not create the expected VF count")
        expected = [1] + ([500 * 1024 * 1024, 9216, 32] if driver == "xe" else [])
        if any(int(path.read_text()) != value for path, value in zip(paths, expected)):
            raise RuntimeError("SR-IOV PF tuning was not applied successfully")
        self.run("systemctl", "daemon-reload")
        self.run("systemctl", "enable", "intel-sriov-vf.service")
        # A display restart is disruptive but has no persistent setting to restore.
        if self.service("display-manager.service")["active"]:
            self.run("systemctl", "restart", "display-manager.service")

    def install(self):
        if not self.state:
            raise RuntimeError("Missing preparation state")
        if not shutil.which("k3s") or (
                self.state["runtime_owned"] and self.state.get("runtime_installer_started") is False):
            if self.state["runtime_present"] and not self.state["runtime_owned"]:
                raise RuntimeError("Pre-existing K3s disappeared; refusing to claim its data")
            if self.state.get("cluster"):
                raise RuntimeError("Previously provisioned K3s is missing; remove its recorded state first")
            # Record intent before the upstream installer can fail part-way.
            self.state["runtime_owned"] = True
            self.state.setdefault("runtime_installer_started", False)
            self.save()
            self.install_runtime()
        self.run("systemctl", "enable", "--now", "k3s")
        self.wait_api()
        # Check identity before changing proxy files, resources, or host devices.
        self.check_cluster()
        self.state.setdefault("cluster", self.cluster())
        self.save()
        self.proxy()
        self.wait_api()
        self.run("k3s", "kubectl", "wait", "--for=condition=Ready", "nodes", "--all", "--timeout=300s")
        self.check_cluster()
        if not shutil.which("helm"):
            target = Path("/usr/local/bin/helm")
            if target.exists() or target.is_symlink():
                raise RuntimeError("Refusing to replace an existing Helm file outside PATH")
            self.remember_file(target)
            self.prepare_helm(target)
            try:
                self.run("bash", str(self.scripts / "install-helm.sh"))
            finally:
                if target.exists():
                    self.record_file(target)
        self.run("helm", "version", "--short")
        self.deploy()
        self.sriov()
        self.state["complete"] = True
        self.save()

    def prepare_helm(self, target):
        arch = {"x86_64": "amd64", "aarch64": "arm64", "armv7l": "arm"}.get(os.uname().machine)
        if arch is None:
            raise RuntimeError("Unsupported Helm architecture")
        archives = sorted((self.scripts / "resources/helm").glob(f"helm-*-linux-{arch}.tar.gz"))
        if not archives:
            raise RuntimeError("Helm archive is missing")
        archive = archives[0]
        checksums = Path(str(archive) + ".sha256sum").read_text().split()
        if not checksums or hashlib.sha256(archive.read_bytes()).hexdigest() != checksums[0]:
            raise RuntimeError("Helm archive checksum mismatch")
        with tarfile.open(archive, "r:gz") as bundle:
            member = bundle.getmember(f"linux-{arch}/helm")
            if not member.isfile():
                raise RuntimeError("Helm archive does not contain a regular binary")
            with bundle.extractfile(member) as binary:
                digest = hashlib.sha256(binary.read()).hexdigest()
        self.state["files"][str(target)]["after"] = digest
        self.save()

    def install_runtime(self):
        if os.environ.get("K3S_MODE", "server") != "server":
            raise RuntimeError("k3s_io provisions a server; agent-only installation is not supported")
        resources = self.scripts / "resources/k3s"
        script = (resources / "install.sh").read_bytes()
        if hashlib.sha256(script).hexdigest() != self.install_sha:
            raise RuntimeError("K3s install script checksum mismatch")
        archives = sorted(resources.glob("k3s-airgap-images-*.tar.*"))
        if not archives:
            raise RuntimeError("K3s airgap image archive is missing")
        binary = Path("/usr/local/bin/k3s")
        if (binary.exists() or binary.is_symlink()) and str(binary) not in self.state["files"]:
            raise RuntimeError("Refusing to overwrite an existing K3s binary outside PATH")
        images = Path("/var/lib/rancher/k3s/agent/images")
        self.stage_file(resources / "k3s", binary, "755")
        self.run("install", "-d", "-m", "700", "/etc/rancher/k3s")
        self.run("install", "-d", "-m", "755", str(images))
        for archive in archives:
            target = images / archive.name
            self.stage_file(archive, target, "644")
        config = os.environ.get("K3S_CONFIG_FILE")
        if config:
            self.write_file(Path("/etc/rancher/k3s/config.yaml"), Path(config).read_bytes())
        env = dict(self.env, INSTALL_K3S_SKIP_DOWNLOAD="true",
                   INSTALL_K3S_BIN_DIR="/usr/local/bin")
        # Execute precisely the verified bytes, without the first-boot wrapper's
        # unconditional user-home overwrite or a second read of the script path.
        self.state["runtime_installer_started"] = True
        self.save()
        self.run("bash", data=script.decode(), env=env)
        source = Path("/etc/rancher/k3s/k3s.yaml")
        target = self.home / ".kube/config"
        if target.exists() or target.is_symlink():
            print("Preserving existing user kubeconfig; using the K3s server kubeconfig for provisioning")
            return
        new_directory = not target.parent.exists()
        self.write_file(target, source.read_bytes())
        if new_directory:
            fd = self.open_file(target.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fchown(fd, self.user.pw_uid, self.user.pw_gid)
            finally:
                os.close(fd)
        fd = self.open_file(target, os.O_RDONLY)
        try:
            os.fchown(fd, self.user.pw_uid, self.user.pw_gid)
        finally:
            os.close(fd)

    def stage_file(self, source, target, mode):
        if target.is_symlink():
            raise RuntimeError(f"Refusing to stage through a symlink: {target}")
        if target.exists():
            expected = hashlib.sha256(source.read_bytes()).hexdigest()
            if hashlib.sha256(target.read_bytes()).hexdigest() != expected:
                raise RuntimeError(f"Staged file conflicts with existing content: {target}")
            return
        self.remember_file(target)
        self.state["files"][str(target)]["after"] = hashlib.sha256(source.read_bytes()).hexdigest()
        self.save()
        self.run("install", "-m", mode, str(source), str(target))

    def restore_files(self):
        for key, record in list(self.state.get("files", {}).items())[::-1]:
            path = Path(key)
            if record["after"] is None:
                # No successful write recorded: leave the original in place.
                continue
            if path.is_symlink() or any(parent.is_symlink() for parent in path.parents):
                raise RuntimeError(f"Refusing to restore configuration through a symlink: {path}")
            if path.exists() and hashlib.sha256(path.read_bytes()).hexdigest() != record["after"]:
                raise RuntimeError(f"Configuration changed outside OEP; preserve and resolve before retry: {path}")
            before = record["before"]
            if before:
                path.parent.mkdir(parents=True, exist_ok=True)
                existed = path.exists()
                flags = os.O_RDWR | os.O_CREAT | (0 if existed else os.O_EXCL)
                fd = self.open_file(path, flags)
                with os.fdopen(fd, "r+b") as stream:
                    current = stream.read()
                    if existed and hashlib.sha256(current).hexdigest() != record["after"]:
                        raise RuntimeError(f"Configuration changed during restoration: {path}")
                    stream.seek(0)
                    stream.truncate(0)
                    stream.write(base64.b64decode(before["data"]))
                    os.fchmod(stream.fileno(), before["mode"])
                    os.fchown(stream.fileno(), before["uid"], before["gid"])
            elif path.exists():
                path.unlink()
            del self.state["files"][key]
            self.save()

    def restore_sriov(self):
        snapshot = self.state.get("sriov", {})
        if not snapshot.get("attempted"):
            return
        count = Path("/sys/bus/pci/devices/0000:00:02.0/sriov_numvfs")
        if not count.exists():
            raise RuntimeError("SR-IOV hardware is unavailable; cannot safely restore its configuration")
        if int(count.read_text()) not in (snapshot["count"], snapshot.get("after_count")):
            raise RuntimeError("SR-IOV VF count changed outside OEP; refusing to reset it")
        for key, value in snapshot.get("after", {}).items():
            if Path(key).read_text() != value:
                raise RuntimeError(f"SR-IOV tuning changed outside OEP: {key}")
        self.run("systemctl", "disable", "--now", "intel-sriov-vf.service")
        count.write_text(str(snapshot["count"]))
        for key, value in snapshot["values"].items():
            Path(key).write_text(value)
        snapshot["attempted"] = False
        snapshot["restore_service"] = True
        self.save()

    def has_foreign_contents(self, obj):
        kind = obj["kind"]
        if kind == "CustomResourceDefinition":
            name = obj["metadata"]["name"]
            items = json.loads(self.run("k3s", "kubectl", "get", name, "-A",
                                        "-o", "json").stdout)["items"]
            return bool(self.foreign_items(items))
        if kind != "Namespace":
            return False
        name = obj["metadata"]["name"]
        kinds = self.run("k3s", "kubectl", "api-resources", "--namespaced=true",
                         "--verbs=list", "-o", "name").stdout.split()
        items = []
        for resource in kinds:
            items.extend(json.loads(self.run("k3s", "kubectl", "get", resource, "-n", name,
                                            "-o", "json").stdout)["items"])
        return any((item["kind"], item["metadata"]["name"]) not in (
            ("ServiceAccount", "default"), ("ConfigMap", "kube-root-ca.crt"),
        ) and item["kind"] != "Event" for item in self.foreign_items(items))

    def foreign_items(self, items):
        # Controller-created ReplicaSets, Pods and NFD NodeFeatures inherit
        # ownership. Retain parent UIDs after deletion while garbage collection runs.
        owned = set(self.state.get("created_uids", []))
        while True:
            children = {item["metadata"]["uid"] for item in items
                        if any(ref["uid"] in owned
                               for ref in item["metadata"].get("ownerReferences", []))}
            if children <= owned:
                break
            owned.update(children)
        return [item for item in items if item["metadata"]["uid"] not in owned]

    def restore_resources(self):
        self.check_cluster()
        for record in list(self.state["resources"])[::-1]:
            current = self.get(record["object"])
            if current:
                uid = current["metadata"]["uid"]
                if record["uid"] and uid != record["uid"]:
                    raise RuntimeError(f"Resource replaced outside OEP: {record['identity']}")
                if record["after"] and self.configuration(current) != record["after"]:
                    raise RuntimeError(f"Resource modified outside OEP: {record['identity']}")
                if record["before"] and not record["after"]:
                    owner = current["metadata"].get("annotations", {}).get(
                        "openedgeplatform.intel.com/k3s-owner")
                    if owner != self.state["owner"] and (
                            self.configuration(current) != self.configuration(record["before"])):
                        raise RuntimeError(f"Resource changed during interrupted provisioning: {record['identity']}")
                if record["before"]:
                    restored = copy.deepcopy(record["before"])
                    restored["metadata"]["resourceVersion"] = current["metadata"]["resourceVersion"]
                    self.run("k3s", "kubectl", "replace", "-f", "-", data=json.dumps(restored))
                else:
                    owner = current["metadata"].get("annotations", {}).get(
                        "openedgeplatform.intel.com/k3s-owner")
                    if owner != self.state["owner"]:
                        raise RuntimeError(f"Unowned resource encountered: {record['identity']}")
                    if self.has_foreign_contents(current):
                        raise RuntimeError(f"Resource contains foreign objects; preserve and resolve "
                                           f"before retry: {record['identity']}")
                    # DeleteOptions preconditions guard against replacement between get and delete.
                    api = current["apiVersion"]
                    prefix = "/api/" + api if "/" not in api else "/apis/" + api
                    resources = json.loads(self.run("k3s", "kubectl", "get", "--raw",
                                                    prefix).stdout)["resources"]
                    resource = next(r["name"] for r in resources
                                    if r["kind"] == current["kind"] and "/" not in r["name"])
                    namespace = current["metadata"].get("namespace")
                    url = prefix + ("/namespaces/" + namespace if namespace else "")
                    url += "/" + resource + "/" + current["metadata"]["name"]
                    self.run("k3s", "kubectl", "delete", "--raw", url, "-f", "-",
                             data=json.dumps({"apiVersion": "v1", "kind": "DeleteOptions",
                                              "propagationPolicy": "Foreground",
                                              "preconditions": {
                                                  "uid": uid,
                                                  "resourceVersion": current["metadata"]["resourceVersion"],
                                              }}))
                    self.run("k3s", "kubectl", "wait", "--for=delete", "-f", "-",
                             "--timeout=180s", data=json.dumps(record["object"]))
            elif record["before"]:
                raise RuntimeError(f"Original resource disappeared: {record['identity']}")
            self.state["resources"].remove(record)
            self.save()

    def remove(self):
        if not self.state:
            if self.legacy_owned:
                # Migration from the old module: no Helm/plugin ownership was recorded.
                self.prepare()
            else:
                print("No OEP K3s provisioning state; leaving the cluster unchanged")
                return
        if self.state.get("cluster") and (shutil.which("k3s") or not self.state["runtime_owned"]):
            self.check_cluster()
        self.restore_sriov()
        if self.state.get("cluster") and not self.state["runtime_owned"]:
            self.restore_resources()
        if self.state["runtime_owned"]:
            script = Path("/usr/local/bin/k3s-uninstall.sh")
            if script.is_file():
                self.check_cluster()
                self.run("bash", str(script))
            elif shutil.which("k3s") and self.state.get("runtime_installer_started", True):
                raise RuntimeError("Owned K3s is present but its uninstall script is missing")
            elif self.state.get("runtime_installer_started") is False:
                self.restore_files()
            if shutil.which("k3s"):
                raise RuntimeError("K3s is still present after uninstall")
            self.state["resources"] = []
            self.state.pop("cluster", None)
            self.save()
        self.restore_files()
        self.run("systemctl", "daemon-reload")
        sriov = self.state.get("sriov", {})
        if sriov.get("restore_service"):
            self.restore_service("intel-sriov-vf.service", sriov["service"])
        if not self.state["runtime_owned"]:
            self.restore_service("k3s", self.state["service"])
        self.path.unlink()
        self.directory.rmdir()

    def restore_service(self, name, before):
        if not before.get("exists", True):
            return
        self.run("systemctl", "enable" if before["enabled"] else "disable", name)
        self.run("systemctl", "restart" if before["active"] else "stop", name)


