
configure_pcb_anomaly_detection () {
  workspace="$(ensure_project_path)/pcb-anomaly-detection"
  version=release-2026.2.0
  repository="https://github.com/open-edge-platform/manufacturing-ai-suite.git"
  used_ports=(80 443 3478 8000)
}

verify_pcb_anomaly_detection () {
  [ -e "$workspace"/industrial-edge-insights-vision/resources/pcb-anomaly-detection/videos/anomalib_pcb_test.avi ] || {
    echo "anomalib_pcb_test.avi missing" 1>&2
    return 1
  }
  [ -e "$workspace/industrial-edge-insights-vision/resources/pcb-anomaly-detection/models/pcb-anomaly-detection/deployment/Anomaly classification/model/model.bin" ] || {
    echo "model.bin missing" 1>&2
    return 1
  }
}

debian_90_profile_pcb_anomaly_detection () {
  echo "git curl gawk edge_base docker_io"
}

debian_90_install_pcb_anomaly_detection () {
  configure_pcb_anomaly_detection
  if verify_pcb_anomaly_detection && [[ " $* " != *" --reinstall "* ]]; then
    echo "PCB anomaly detection is installed." >&2
  else
    ensure_disk_size 10000
    ensure_ports_open install pcb_anomaly_detection "${used_ports[@]}"

    # clone the repository
    ensure_git_export "$workspace" $version $repository industrial-edge-insights-vision

    # setup
    cd "$workspace/industrial-edge-insights-vision"
    cat > .env <<EOF
$(cat .env_pcb-anomaly-detection)
HOST_IP=$(ensure_ip)
ENABLE_HTTPS_MODE=true
MINIO_ACCESS_KEY=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
MINIO_SECRET_KEY=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
MTX_WEBRTCICESERVERS2_0_USERNAME=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
MTX_WEBRTCICESERVERS2_0_PASSWORD=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
S3_STORAGE_USERNAME=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
S3_STORAGE_PASSWORD=$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)
EOF
    sed -i 's|curl |curl -f |' apps/pcb-anomaly-detection/setup.sh
    ./setup.sh
    verify_pcb_anomaly_detection
  fi

  local device=$(ensure_select_device "$@")
  echo "_$device" > "$workspace"/.device

  echo "@@HIGHLIGHT workspace: ${workspace/#"$HOME"/"~"}"
  echo "@@HIGHLIGHT $installer_name install [--gpu|--npu|--cpu]"
  echo "@@HIGHLIGHT $installer_name start [--gpu|--npu|--cpu]"
  echo "@@HIGHLIGHT $installer_name remove"
}

debian_90_start_pcb_anomaly_detection () {
  configure_pcb_anomaly_detection
  ensure_ports_open start pcb_anomaly_detection "${used_ports[@]}"

  local device=$(ensure_select_device "$@")
  [[ " ${*,,} " != *" --$device "* ]] || echo "_$device" > "$workspace"/.device
  
  cd "$workspace"/industrial-edge-insights-vision
  docker compose up -d --wait

  echo "@@HIGHLIGHT URL: http://$(ensure_ip):${used_ports[0]}"
  echo "@@HIGHLIGHT $installer_name start [--gpu|--npu|--cpu]"
  echo "@@HIGHLIGHT $installer_name stop|remove"

  local pipeline="pcb_anomaly_detection$(< ../.device)"
  ./sample_start.sh -p ${pipeline%_cpu} && {
    local status
    while true; do
      status="$(./sample_status.sh)" || break
      printf "%s\n" "$status" | grep frame_fps
      case "$status" in
      *COMPLETE*|*ERROR*) break;;
      esac
      sleep 5
    done
  }
}

debian_90_stop_pcb_anomaly_detection () {
  configure_pcb_anomaly_detection
  cd "$workspace"/industrial-edge-insights-vision && {
    ./sample_stop.sh || true
    docker compose down -v --remove-orphans
  } || true
}

debian_90_remove_pcb_anomaly_detection () {
  debian_90_stop_pcb_anomaly_detection
  ensure_rm "$workspace"
}
