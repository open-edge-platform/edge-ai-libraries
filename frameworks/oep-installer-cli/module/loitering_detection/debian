
configure_loitering_detection () {
  workspace="$(ensure_project_path)/loitering-detection"
  version=release-2026.1.0
  repository="https://github.com/open-edge-platform/edge-ai-suites.git"
}

verify_loitering_detection () {
  [ -e "$workspace"/metro-ai-suite/metro-vision-ai-app-recipe/loitering-detection/src/dlstreamer-pipeline-server/videos/VIRAT_S_000101.mp4 ]
}

debian_90_profile_loitering_detection () {
  echo "git curl gawk"
}

debian_90_install_loitering_detection () {
  configure_loitering_detection
  ! verify_loitering_detection || [[ "$*" = *"--reset-loitering_detection"* ]] || return 0
  ensure_disk_space 280

  # clone the repository
  ensure_git_clone "$workspace" $version $repository metro-ai-suite/metro-vision-ai-app-recipe

  # setup
  pushd "$workspace/metro-ai-suite/metro-vision-ai-app-recipe" > /dev/null
  ./install.sh loitering-detection $(ensure_ip)
  verify_loitering_detection
  popd > /dev/null
}

debian_90_start_loitering_detection () {
  configure_loitering_detection
  pushd "$workspace"/metro-ai-suite/metro-vision-ai-app-recipe > /dev/null
  docker compose -f compose-without-scenescape.yml up -d
  ./sample_start.sh
  echo "UI entrypoint: $(ensure_ip)"
  popd > /dev/null
}

debian_90_stop_loitering_detection () {
  configure_loitering_detection
  pushd "$workspace"/metro-ai-suite/metro-vision-ai-app-recipe > /dev/null
  ./sample_stop.sh
  docker compose -f compose-without-scenescape.yml down -v
  popd > /dev/null
}

debian_90_remove_loitering_detection () {
  configure_loitering_detection
  ensure_rmdir "$workspace"
}
