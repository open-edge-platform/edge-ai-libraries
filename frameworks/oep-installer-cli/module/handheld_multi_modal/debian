
configure_handheld_multi_modal () {
  workspace="$(ensure_project_path)/handheld-multi-modal"
  version=main
  repository=https://github.com/open-edge-platform/federal-and-aerospace-ai-suite.git
  used_ports=(3478 8010 8011 8012 8080 8186 8189 8200 8443 8554 8888 9090 9273 9997)
}

verify_handheld_multi_modal () {
  local app_dir="$workspace"/handheld-multi-modal
  [ -r "$app_dir/Makefile" ] &&
    [ -r "$app_dir/compose/handheld-multi-modal.yaml" ] &&
    [ -r "$app_dir/docs/user-guide/index.md" ] &&
    [ -r "$app_dir/config/devices.yaml" ] &&
    python3 "$app_dir/scripts/demo_assets.py" check-model --root "$app_dir"
}

debian_90_profile_handheld_multi_modal () {
  echo "yq make curl git docker_io edge_base"
}

debian_90_install_handheld_multi_modal () {
  local installed
  installed="$(ensure_prop find "installed/*")" || return $?
  local blueprint
  while IFS= read -r blueprint; do
    case "$blueprint" in
    installed/uncrewed_aerial_vehicle_blueprint|installed/mission_decision_support_blueprint)
      echo "Cannot install handheld_multi_modal while ${blueprint#installed/} is installed." >&2
      return 1
      ;;
    esac
  done <<< "$installed"

  configure_handheld_multi_modal
  if verify_handheld_multi_modal $* && [[ " $* " != *" --reinstall "* ]]; then
    echo "handheld_multi_modal is installed." >&2
  else
    ensure_disk_size 45000
    ensure_ports_open install handheld_multi_modal "${used_ports[@]}"

    ensure_git_clone "$workspace" $version $repository handheld-multi-modal
    cd "$workspace"/handheld-multi-modal
    make setup
    make prereq CONFIRM=yes
    docker compose -f compose/handheld-multi-modal.yaml -f compose/cameras.yaml -f config/devices.yaml pull --ignore-buildable
    verify_handheld_multi_modal $*
  fi

  echo "@@HIGHLIGHT workspace: ${workspace/#"$HOME"/"~"}"
  echo "@@HIGHLIGHT $installer_name start|remove"
}

debian_90_start_handheld_multi_modal () {
  configure_handheld_multi_modal
  ensure_ports_open start handheld_multi_modal "${used_ports[@]}"
  cd "$workspace"/handheld-multi-modal
  make up CONFIRM=yes
  echo "@@HIGHLIGHT URL: https://localhost:8443/ (trust config/tls/server.crt)"
  echo "@@HIGHLIGHT $installer_name stop|remove"
}

debian_90_stop_handheld_multi_modal () {
  configure_handheld_multi_modal
  cd "$workspace"/handheld-multi-modal
  make stop
}

debian_90_remove_handheld_multi_modal () {
  configure_handheld_multi_modal
  local app_dir="$workspace"/handheld-multi-modal
  [ ! -d "$app_dir" ] || (cd "$app_dir" && make clean-all CONFIRM=yes)
  ensure_rm "$workspace"
}
