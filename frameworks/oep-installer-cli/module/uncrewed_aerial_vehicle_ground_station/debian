configure_uncrewed_aerial_vehicle_ground_station () {
  repository="https://github.com/open-edge-platform/federal-and-aerospace-ai-suite.git"
  version="release-2026.3.0"
  workspace="$(ensure_project_path)/uav-mission-compute-sdk/ground-station"
  app_dir="$workspace/uav-ground-station"
  compose_files=(-f docker-compose.yml -f docker-compose-mediamtx.yml)
}

verify_uncrewed_aerial_vehicle_ground_station () {
  [ -r "$app_dir/Makefile" ] && [ -r "$app_dir/.env" ] &&
    [ -n "$(ensure_prop get installed/uncrewed_aerial_vehicle_ground_station/version)" ]
}

debian_90_profile_uncrewed_aerial_vehicle_ground_station () {
  echo "docker_io git curl make v4l_utils"
}

install_uncrewed_aerial_vehicle_ground_station_source () {
  if [[ -e "$workspace" || -L "$workspace" ]]; then
    if [[ -L "$workspace" || ! -d "$workspace/.git" ]]; then
      echo "Refusing incompatible source destination: $workspace" >&2
      return 1
    fi
    local remote changes
    remote="$(git -C "$workspace" remote get-url origin)" || return $?
    changes="$(git -C "$workspace" status --porcelain --untracked-files=no)" || return $?
    if [[ "$remote" != "$repository" || -n "$changes" ]]; then
      echo "Refusing to overwrite a different repository or tracked local changes at $workspace." >&2
      return 1
    fi
    if [ -n "$(ensure_prop get started/uncrewed_aerial_vehicle_ground_station/ports)" ]; then
      echo "Stop uncrewed_aerial_vehicle_ground_station before updating its source." >&2
      return 1
    fi
  else
    mkdir -p "$(dirname "$workspace")"
    git clone --no-checkout --depth 1 "$repository" "$workspace" || return $?
  fi
  git -C "$workspace" fetch --depth 1 origin "$version" &&
    git -C "$workspace" checkout --detach FETCH_HEAD || return $?
  echo "UAV source commit: $(git -C "$workspace" rev-parse HEAD)"
}

debian_90_install_uncrewed_aerial_vehicle_ground_station () {
  configure_uncrewed_aerial_vehicle_ground_station "$@"
  if verify_uncrewed_aerial_vehicle_ground_station && ! ensure_parse_reinstall "$@"; then
    echo "uncrewed_aerial_vehicle_ground_station is already installed."
    return 0
  fi
  echo "@@STEP Fetching UAV source ref $version for ground-station"
  install_uncrewed_aerial_vehicle_ground_station_source || return $?
  if [[ ! -f "$app_dir/Makefile" || ! -f "$app_dir/.env.example" ]]; then
    echo "Required UAV application source is missing: $app_dir" >&2
    return 1
  fi
  ensure_prop remove installed/uncrewed_aerial_vehicle_ground_station/version || return $?
  cd "$app_dir" || return $?
  echo "Review $app_dir/.env and upstream LAN bindings before starting the application."
  make init || return $?
  sed -i \
    -e "s|^VIZ_HOST_IP=.*|VIZ_HOST_IP=$(ensure_ip)|" \
    -e "s|^VIZ_PUBLIC_HOST=.*|VIZ_PUBLIC_HOST=$(ensure_ip)|" .env || return $?
  docker compose "${compose_files[@]}" pull --ignore-buildable &&
    docker compose "${compose_files[@]}" build || return $?
  if [ ! -f "$app_dir/.env" ]; then
    echo "Application initialization did not produce $app_dir/.env." >&2
    return 1
  fi
  ensure_prop set installed/uncrewed_aerial_vehicle_ground_station/version "$version" --create || return $?
  verify_uncrewed_aerial_vehicle_ground_station || return $?
  echo "@@HIGHLIGHT workspace: $app_dir"
  echo "@@HIGHLIGHT $installer_name start uncrewed_aerial_vehicle_ground_station"
}

verify_uncrewed_aerial_vehicle_ground_station_services () {
  local expected running service
  expected="$(docker compose "${compose_files[@]}" config --services)" || return $?
  running="$(docker compose "${compose_files[@]}" ps --status running --services)" || return $?
  [ -n "$expected" ] || return 1
  while IFS= read -r service; do
    grep -Fxq -- "$service" <<< "$running" || return 1
  done <<< "$expected"
  docker compose "${compose_files[@]}" exec -T viz-backend python3 -c \
    'from urllib.request import urlopen; urlopen("http://127.0.0.1:8080/api/runtime-config", timeout=5).close()'
}

debian_90_start_uncrewed_aerial_vehicle_ground_station () {
  configure_uncrewed_aerial_vehicle_ground_station "$@"
  if ! verify_uncrewed_aerial_vehicle_ground_station; then
    echo "uncrewed_aerial_vehicle_ground_station installation is missing source or configuration. Run install to repair it." >&2
    return 1
  fi
  cd "$app_dir" || return $?
  local used_ports=()
  if [ -z "$(ensure_prop get started/uncrewed_aerial_vehicle_ground_station/ports)" ]; then
    local config ports
    config="$(docker compose "${compose_files[@]}" config --format json)" || return $?
    ports="$(python3 -c '
import json, sys
config = json.load(sys.stdin)
print(" ".join(sorted({str(port["published"]) for service in config["services"].values()
                       for port in service.get("ports", []) if "published" in port})))
' <<< "$config")" || return $?
    read -r -a used_ports <<< "$ports"
    ensure_ports_open install uncrewed_aerial_vehicle_ground_station "${used_ports[@]}" || return $?
  else
    read -r -a used_ports <<< "$(ensure_prop get started/uncrewed_aerial_vehicle_ground_station/ports)"
  fi
  sed -i \
    -e "s|^VIZ_HOST_IP=.*|VIZ_HOST_IP=$(ensure_ip)|" \
    -e "s|^VIZ_PUBLIC_HOST=.*|VIZ_PUBLIC_HOST=$(ensure_ip)|" .env || return $?
  make up || return $?
  local attempt ready=0
  for ((attempt=0; attempt<24; attempt++)); do
    if verify_uncrewed_aerial_vehicle_ground_station_services; then ready=1; break; fi
    sleep 5
  done
  if [ "$ready" -ne 1 ]; then
    echo "ground-station readiness timed out. Inspect docker compose logs in $app_dir." >&2
    return 1
  fi
  ensure_prop create started/uncrewed_aerial_vehicle_ground_station/ports || return $?
  ensure_prop set started/uncrewed_aerial_vehicle_ground_station/ports "${used_ports[*]:-none}" || return $?
  echo "@@HIGHLIGHT Dashboard: http://<VIZ_HOST_IP>:<VIZ_PORT> from $app_dir/.env"
  echo "@@HIGHLIGHT $installer_name stop uncrewed_aerial_vehicle_ground_station"
}

debian_90_stop_uncrewed_aerial_vehicle_ground_station () {
  configure_uncrewed_aerial_vehicle_ground_station "$@"
  if ! verify_uncrewed_aerial_vehicle_ground_station; then
    echo "uncrewed_aerial_vehicle_ground_station is not installed." >&2
    return 1
  fi
  cd "$app_dir" || return $?
  docker compose "${compose_files[@]}" down || return $?
  ensure_prop remove started/uncrewed_aerial_vehicle_ground_station/
}

debian_90_remove_uncrewed_aerial_vehicle_ground_station () {
  configure_uncrewed_aerial_vehicle_ground_station "$@"
  if ! verify_uncrewed_aerial_vehicle_ground_station; then
    echo "uncrewed_aerial_vehicle_ground_station is not installed." >&2
    return 1
  fi
  cd "$app_dir" || return $?
  docker compose "${compose_files[@]}" down --volumes --remove-orphans || return $?
  ensure_prop remove started/uncrewed_aerial_vehicle_ground_station/ || return $?
  ensure_rm "$workspace" || return $?
  ensure_prop remove installed/uncrewed_aerial_vehicle_ground_station/
}
