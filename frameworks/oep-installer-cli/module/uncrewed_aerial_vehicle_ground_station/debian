ground_station_configure_uav_application () {
  uav_module="$1"
  uav_app="$2"
  uav_repository="https://github.com/open-edge-platform/federal-and-aerospace-ai-suite.git"
  uav_commit="cebc4af2abda194c2c62055fb378c48ec4119783"
  uav_workspace="$(ensure_project_path)/uav-mission-compute-sdk"
  uav_checkout="$uav_workspace/$uav_app"
  uav_dir="$uav_checkout/uav-$uav_app"
  if [ -d "$uav_workspace/uav-mission-compute-sdk" ]; then
    echo "Legacy UAV Mission Compute SDK found at $uav_workspace. Stop it and move the legacy workspace aside before installing PR 15 apps; it will not be deleted automatically." >&2
    return 1
  fi
  if [ "$uav_app" = ground-station ]; then
    uav_compose=(-f docker-compose.yml -f docker-compose-mediamtx.yml)
  else
    uav_compose=(-f docker-compose-pymavlink.yml)
  fi
}

ground_station_verify_uav_application_installed () {
  [ -r "$uav_dir/Makefile" ] && [ -r "$uav_dir/.env" ] &&
    [ -n "$(ensure_prop get "installed/$uav_module")" ]
}

ground_station_verify_uav_application_models () {
  local detection="$uav_dir/resources/models/yolo11s/yolo11s_openvino_model/yolo11s"
  local caption="$uav_dir/resources/ov_models/gpu/InternVL2-1B"
  [[ -f "$detection.xml" && -f "$detection.bin" ]] &&
    compgen -G "$caption/*.xml" >/dev/null && compgen -G "$caption/*.bin" >/dev/null
}

ground_station_verify_uav_application () {
  ground_station_verify_uav_application_installed || return 1
  [ "$uav_app" != vision-analytics ] || ground_station_verify_uav_application_models
}

ground_station_configure_uav_application_source () {
  if [[ -e "$uav_checkout" || -L "$uav_checkout" ]]; then
    if [[ -L "$uav_checkout" || ! -d "$uav_checkout/.git" ]]; then
      echo "Refusing incompatible source destination: $uav_checkout" >&2
      return 1
    fi
    local remote changes
    remote="$(git -C "$uav_checkout" remote get-url origin)" || return $?
    changes="$(git -C "$uav_checkout" status --porcelain --untracked-files=no)" || return $?
    if [[ "$remote" != "$uav_repository" || -n "$changes" ]]; then
      echo "Refusing to overwrite a different repository or tracked local changes at $uav_checkout." >&2
      return 1
    fi
    if [ -n "$(ensure_prop get "started/$uav_module/ports")" ]; then
      echo "Stop $uav_module before updating its source." >&2
      return 1
    fi
  else
    mkdir -p "$uav_workspace"
    git clone --no-checkout --depth 1 "$uav_repository" "$uav_checkout" || return $?
  fi
  git -C "$uav_checkout" fetch --depth 1 origin "$uav_commit" &&
    git -C "$uav_checkout" checkout --detach FETCH_HEAD || return $?
  echo "UAV source commit: $(git -C "$uav_checkout" rev-parse HEAD)"
}

ground_station_configure_uav_application_models () {
  local detection="$uav_dir/resources/models/yolo11s/yolo11s_openvino_model/yolo11s"
  local caption="$uav_dir/resources/ov_models/gpu/InternVL2-1B"
  if [[ ! -f "$detection.xml" || ! -f "$detection.bin" ]]; then
    make model ACCEPT_LICENSE=y || return $?
  fi
  if ! compgen -G "$caption/*.xml" >/dev/null || ! compgen -G "$caption/*.bin" >/dev/null; then
    make vlm-model VLM_DEVICE=GPU ACCEPT_LICENSE=y || return $?
  fi
  if ! ground_station_verify_uav_application_models; then
    echo "Model setup did not produce the required YOLO11s and GPU InternVL2 XML/BIN artifacts." >&2
    return 1
  fi
}

ground_station_install_uav_application () {
  ground_station_configure_uav_application "$1" "$2" || return $?
  if ground_station_verify_uav_application && [[ " $* " != *" --reinstall "* ]]; then
    echo "$uav_app is already installed."
    return 0
  fi
  if [ "$uav_app" = vision-analytics ]; then
    if ! compgen -G '/dev/accel/accel*' >/dev/null || ! compgen -G '/dev/dri/renderD*' >/dev/null; then
      echo "Vision Analytics requires Intel NPU and GPU device nodes." >&2
      return 1
    fi
    python3 -c 'import ensurepip' || return $?
  fi
  echo "@@STEP Fetching UAV source commit $uav_commit for $uav_app"
  ground_station_configure_uav_application_source || return $?
  if [[ ! -f "$uav_dir/Makefile" || ! -f "$uav_dir/.env.example" ]]; then
    echo "Required UAV application source is missing: $uav_dir" >&2
    return 1
  fi
  ensure_prop remove "installed/$uav_module" || return $?
  cd "$uav_dir" || return $?
  echo "Review $uav_dir/.env and upstream LAN bindings before starting the application."
  make init || return $?
  if [ "$uav_app" = vision-analytics ]; then
    ground_station_configure_uav_application_models || return $?
    make _check_certs || return $?
  fi
  docker compose "${uav_compose[@]}" pull --ignore-buildable &&
    docker compose "${uav_compose[@]}" build || return $?
  if [ ! -f "$uav_dir/.env" ]; then
    echo "Application initialization did not produce $uav_dir/.env." >&2
    return 1
  fi
  ensure_prop create "installed/$uav_module" || return $?
  ensure_prop set "installed/$uav_module" "$uav_commit" || return $?
  ground_station_verify_uav_application || return $?
  echo "@@HIGHLIGHT workspace: $uav_dir"
  echo "@@HIGHLIGHT $installer_name start $uav_module"
}

ground_station_verify_uav_application_services () {
  local expected running service
  expected="$(docker compose "${uav_compose[@]}" config --services)" || return $?
  running="$(docker compose "${uav_compose[@]}" ps --status running --services)" || return $?
  [ -n "$expected" ] || return 1
  while IFS= read -r service; do
    grep -Fxq -- "$service" <<< "$running" || return 1
  done <<< "$expected"
  if [ "$uav_app" = ground-station ]; then
    docker compose "${uav_compose[@]}" exec -T viz-backend python3 -c \
      'from urllib.request import urlopen; urlopen("http://127.0.0.1:8080/api/runtime-config", timeout=5).close()'
  else
    docker exec dlstreamer-pipeline-server python3 -c \
      'from urllib.request import urlopen; urlopen("http://127.0.0.1:8081/pipelines/status", timeout=5).close()'
  fi
}

ground_station_verify_uav_application_manager () {
  docker exec dlstreamer-pipeline-server python3 -c '
from pathlib import Path
import sys
expected = [b"python3", b"/home/pipeline-server/scripts/pipeline_manager.py", b"--start-now"]
for path in Path("/proc").glob("[0-9]*/cmdline"):
    try:
        command = path.read_bytes().rstrip(b"\0").split(b"\0")
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        continue
    if command == expected:
        sys.exit(0)
sys.exit(1)
'
}

ground_station_verify_uav_application_pipelines () {
  ground_station_verify_uav_application_manager || return 1
  local status
  status="$(docker exec dlstreamer-pipeline-server python3 /home/pipeline-server/scripts/pipeline_manager.py --status)" || return $?
  printf '%s\n' "$status" | awk '
    NR > 1 { if (NF != 6 || $4 != "RUNNING" || $6 != "yes") failed = 1; count++ }
    END { exit (failed || !count) }
  '
}

ground_station_wait_for_uav_application () {
  local check="$1" attempts="$2" attempt
  for ((attempt=0; attempt<attempts; attempt++)); do
    if "$check"; then return 0; fi
    sleep 5
  done
  echo "$uav_app readiness timed out ($check). Inspect docker compose logs in $uav_dir." >&2
  return 1
}

ground_station_configure_uav_application_ports () {
  local config ports
  config="$(docker compose "${uav_compose[@]}" config --format json)" || return $?
  ports="$(python3 -c '
import json, sys
config = json.load(sys.stdin)
print(" ".join(sorted({str(port["published"]) for service in config["services"].values()
                       for port in service.get("ports", []) if "published" in port})))
' <<< "$config")" || return $?
  read -r -a uav_ports <<< "$ports"
  ensure_ports_open install "$uav_module" "${uav_ports[@]}"
}

ground_station_start_uav_application () {
  ground_station_configure_uav_application "$1" "$2" || return $?
  ground_station_verify_uav_application || { echo "$uav_module installation is missing source, configuration, or models. Run install to repair it." >&2; return 1; }
  cd "$uav_dir" || return $?
  if [ -z "$(ensure_prop get "started/$uav_module/ports")" ]; then
    ground_station_configure_uav_application_ports || return $?
  else
    read -r -a uav_ports <<< "$(ensure_prop get "started/$uav_module/ports")"
  fi
  if [ "$uav_app" = ground-station ]; then
    make up || return $?
  else
    make pymav-up || return $?
  fi
  ground_station_wait_for_uav_application ground_station_verify_uav_application_services 24 || return $?
  if [ "$uav_app" = vision-analytics ]; then
    make check-cameras || return $?
    if ! ground_station_verify_uav_application_manager; then
      docker exec --detach dlstreamer-pipeline-server sh -c \
        'exec python3 /home/pipeline-server/scripts/pipeline_manager.py --start-now >/tmp/oep-uav-manager.log 2>&1' || return $?
    fi
    ground_station_wait_for_uav_application ground_station_verify_uav_application_pipelines 240 || return $?
    echo "@@HIGHLIGHT Status: cd $uav_dir && make cameras-status"
  else
    echo "@@HIGHLIGHT Dashboard: http://<VIZ_HOST_IP>:<VIZ_PORT> from $uav_dir/.env"
  fi
  ensure_prop create "started/$uav_module/ports" || return $?
  ensure_prop set "started/$uav_module/ports" "${uav_ports[*]:-none}" || return $?
  echo "@@HIGHLIGHT $installer_name stop $uav_module"
}

ground_station_stop_uav_application () {
  ground_station_configure_uav_application "$1" "$2" || return $?
  ground_station_verify_uav_application_installed || { echo "$uav_module is not installed." >&2; return 1; }
  cd "$uav_dir" || return $?
  docker compose "${uav_compose[@]}" down || return $?
  ensure_prop remove "started/$uav_module/"
}

ground_station_remove_uav_application () {
  ground_station_configure_uav_application "$1" "$2" || return $?
  ground_station_verify_uav_application_installed || { echo "$uav_module is not installed." >&2; return 1; }
  cd "$uav_dir" || return $?
  docker compose "${uav_compose[@]}" down --volumes --remove-orphans || return $?
  ensure_prop remove "started/$uav_module/" || return $?
  ensure_rm "$uav_checkout" || return $?
  ensure_prop remove "installed/$uav_module"
}
