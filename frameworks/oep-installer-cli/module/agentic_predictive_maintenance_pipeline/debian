
configure_agentic_predictive_maintenance_pipeline () {
  workspace="$(ensure_project_path)/agentic-predictive-maintenance-pipeline"
  version=release-2026.2.0
  repository=https://github.com/open-edge-platform/metro-ai-suite.git
  used_ports=(8080 8010 8554 8200 9091 9090)
  models=(Qwen/Qwen2.5-1.5B-Instruct microsoft/Phi-4-mini-instruct)
}

configure_agentic_predictive_maintenance_pipeline_device () {
  local device="$1"
  cd "$workspace"/agentic-predictive-maintenance-pipeline/apps/pipeline-defect-detection
  sed -i -e "s|^LLM_DEVICE=.*|LLM_DEVICE=$device|" -e "s|^DL_DEVICE=.*|DL_DEVICE=$device|" .env_pipeline-defect-detection

  rm -rf models/llm_model_pipeline-defect-detection
  cd ../..
  . ./scripts/download_llm_model.sh --use-case pipeline-defect-detection
}

verify_agentic_predictive_maintenance_pipeline () {
  [ -f "$workspace"/agentic-predictive-maintenance-pipeline/apps/pipeline-defect-detection/resources/videos/datastream.mp4 ]
}

debian_90_profile_agentic_predictive_maintenance_pipeline () {
  echo "git curl gawk jq edge_base docker"
}

debian_90_install_agentic_predictive_maintenance_pipeline () {
  configure_agentic_predictive_maintenance_pipeline
  if verify_agentic_predictive_maintenance_pipeline && [[ " $* " != *" --reinstall "* ]]; then
    echo "Agentic Predictive Maintenance Pipeline already installed. Skipping" 1>&2
  else
    ensure_ports_open "${used_ports[*]}" return 3
    ensure_disk_size 60
    ensure_git_export "$workspace" "$version" "$repository" agentic-predictive-maintenance-pipeline

    cd "$workspace"/agentic-predictive-maintenance-pipeline/apps/pipeline-defect-detection
    sed -i "s|^HOST_IP=.*|HOST_IP=$(ensure_ip)|" .env_pipeline-defect-detection
    sed -i "s|^REGISTRY=.*|REGISTRY=intel/|" .env_pipeline-defect-detection
    ensure_hf_token "${models[@]}"
    echo "HUGGINGFACEHUB_API_TOKEN=$HF_TOKEN" >> .env_pipeline-defect-detection

    # download video
    curl -fsSL https://github.com/open-edge-platform/edge-ai-resources/raw/c13b8dbf23d514c2667d39b66615bd1400cb889d/videos/anomalib_pcb_test.avi -o resources/videos/datastream.mp4

    verify_agentic_predictive_maintenance_pipeline
  fi

  local device=$(ensure_select_device "$@")
  configure_agentic_predictive_maintenance_pipeline_device "${device^^}"

  echo "@@HIGHLIGHT workspace: $workspace"
  echo "@@HIGHLIGHT $installer_name install [--gpu|npu|cpu]"
  echo "@@HIGHLIGHT $installer_name start|remove"
}

debian_90_start_agentic_predictive_maintenance_pipeline () {
  configure_agentic_predictive_maintenance_pipeline
  ensure_ports_open "${used_ports[*]}" debian_90_stop_agentic_predictive_maintenance_pipeline "$@"

  local device=$(ensure_select_device "$@")
  [[ " ${*,,} " != *" --$device "* ]] || configure_agentic_predictive_maintenance_pipeline_device "${device^^}"

  cd "$workspace"/agentic-predictive-maintenance-pipeline
  . ./setup.sh --use-case pipeline-defect-detection

  echo "@@HIGHLIGHT URL: http://$(ensure_ip):${used_ports[0]}"
  echo "@@HIGHLIGHT $installer_name start [--gpu|npu|cpu]"
  echo "@@HIGHLIGHT $installer_name stop|remove"
}

debian_90_stop_agentic_predictive_maintenance_pipeline () {
  configure_agentic_predictive_maintenance_pipeline
  cd "$workspace"/agentic-predictive-maintenance-pipeline && {
    . ./setup.sh --stop || true
    . ./setup.sh --clean-data
  } || true
}

debian_90_remove_agentic_predictive_maintenance_pipeline () {
  debian_90_stop_agentic_predictive_maintenance_pipeline "$@"
  ensure_sudo rm -rf "$workspace"
}

