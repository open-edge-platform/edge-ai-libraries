
debian_90_profile_sample_si () {
  echo "git curl gawk"
}

configure_sample_si () {
  workspace="$(readlink -f ~)/openedge-samples/smart-intersection"
  verision=release-2026.1.0
  respository=https://github.com/open-edge-platform/edge-ai-suites.git
}

debian_90_install_sample_si () {
  configure_sample_si
  [ ! -e "$workspace" ] || [[ "$*" = *"--reset-sample_si"* ]] || return 0

  # clone the repository
  ensure_git_clone "$workspace" $version $repository metro-ai-suite/metro-vision-ai-app-recipe

  # setup
  pushd "$workspace/metro-ai-suite/metro-vision-ai-app-recipe" > /dev/null
  ./install.sh smart-intersection $(ensure_ip)
  popd > /dev/null
}

debian_90_start_sample_si () {
  configure_sample_si
  pushd "$workspace"/metro-ai-suite/metro-vision-ai-app-recipe > /dev/null
  ./sample_start.sh
  popd > /dev/null
}

debian_90_stop_sample_si () {
  configure_sample_si
  pushd "$workspace"/metro-ai-suite/metro-vision-ai-app-recipe > /dev/null
  ./sample_start.sh
  popd > /dev/null
}

debian_90_remove_sample_si () {
  configure_sample_si
  rm -rf "$workspace" || ensure_sudo rm -rf "$workspace"
}
