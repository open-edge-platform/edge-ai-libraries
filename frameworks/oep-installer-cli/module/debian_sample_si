
debian_90_profile_sample_si () {
  echo "git curl gawk"
}

debian_90_install_sample_si () {
  local workspace="~/openedge-samples/smart-intersection"
  [ ! -e $workspace ] || [[ "$*" = *"--reset-smart_intersection"* ]] || return 0

  # clone the repository
  local VERSION=release-2026.1.0
  local REPOSITORY=https://github.com/open-edge-platform/edge-ai-suites.git
  ensure_git_clone $workspace $VERSION $REPOSITORY metro-ai-suite/metro-vision-ai-app-recipe

  # setup
  pushd "$workspace/metro-ai-suite/metro-vision-ai-app-recipe"
  ./install.sh smart-intersection $(ensure_ip)
  popd
}

