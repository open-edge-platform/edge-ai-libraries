
configure_edge_pack_graphics_sriov () {
  configure_edge_pack "$@"
  version="1.0"
}

debian_20_profile_edge_pack_graphics_sriov () {
  echo "edge_pack"
}

debian_20_group_edge_pack_graphics_sriov () {
  echo "render:992 video:"
}

debian_20_install_edge_pack_graphics_sriov () {
  configure_edge_pack_graphics_sriov "$@"
  if ensure_apt_is_installed intel-edge-graphics-sriov && [[ " $* " != *" --reinstall "* ]]; then
    echo "intel-edge-graphics-sriov is installed." >&2
  else
    ensure_prop set installed/edge_pack_graphics_sriov/owned true
    ensure_apt purge --auto-remove -y intel-edge-graphics-sriov || true
    ensure_apt_allow_downgrades "${edge_pack_allow_downgrades[*]}" "${edge_pack_install_options[@]}" "intel-edge-graphics-sriov=$version*"
    ensure_apt install --allow-downgrades "${edge_pack_install_options[@]}" "intel-edge-graphics-sriov=$version*"
  fi
  [ -c /dev/dri/renderD128 ]
  ensure_group_add $(debian_20_group_edge_pack_graphics_sriov)
}

debian_20_remove_edge_pack_graphics_sriov () {
  [ "$(ensure_prop get installed/edge_pack_graphics_sriov/owned)" = "true" ] || return 0
  ensure_apt purge --auto-remove -y intel-edge-graphics-sriov || true
  debian_19_remove_edge_pack "$@" || true
}

debian_20_sbom_edge_pack_graphics_sriov () {
  configure_edge_pack_graphics_sriov "$@"
  debian_19_sbom_edge_pack_repo_entries "$@"
  ensure_sbom_format pkg-list "intel-edge-graphics-sriov=$version*"
}

