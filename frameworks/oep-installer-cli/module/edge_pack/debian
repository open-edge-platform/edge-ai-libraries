
configure_edge_pack () {
  edge_pack_repo="apt.repos.intel.com"
  edge_pack_key_url="https://$edge_pack_repo/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB"
  edge_pack_key_file=/etc/apt/keyrings/intel-edge-pack.gpg
  edge_pack_source="deb [signed-by=$edge_pack_key_file] https://$edge_pack_repo/edgepack $VERSION_CODENAME stable"
  edge_pack_list_file=/etc/apt/sources.list.d/intel-edge-pack.list
  edge_pack_pref=(
    "Package: *"
    "Pin: origin $edge_pack_repo"
    "Pin-Priority: 1001"
  )
  edge_pack_pref_file=/etc/apt/preferences.d/intel-edge-pack.pref
  edge_pack_incompatible_pref_files=(/etc/apt/preferences.d/priorities /etc/apt/preferences.d/edgepack.pref)
  edge_pack_install_options=("--no-install-recommends")
  edge_pack_allow_downgrades=(libgbm1 libgstreamer-gl1.0-0 libva-wayland2 mesa-libgallium weston libegl-mesa0 libgbm-dev libgl1-mesa-dev libgl1-mesa-dri libglx-mesa0 mesa-common-dev mesa-vulkan-drivers mesa-opencl-icd)

  edge_pack_ppa_repo=
  edge_pack_ppa_key_url=
  edge_pack_ppa_key_file=
  edge_pack_ppa_source=
  edge_pack_ppa_list_file=
}

debian_39_profile_edge_pack () {
  echo "curl gnupg linux_image_generic_7.0"
}

debian_39_install_edge_pack () {
  configure_edge_pack "$@"
  local reinstall=$([[ " $* " = *" --reinstall "* ]] && echo 1 || echo 0)
  local reconfigured=0
  if [ ! -e "$edge_pack_key_file" ] || [ $reinstall -eq 1 ]; then
    ensure_apt_key "$edge_pack_key_file" "$edge_pack_key_url" --dearmor
    reconfigured=1
  fi
  if [ ! -e "$edge_pack_source_file" ] || [ $reinstall -eq 1 ]; then
    ensure_apt_source "$edge_pack_list_file" "$edge_pack_source"
    reconfigured=1
  fi
  if [ ! -e "$edge_pack_pref_file" ] || [ $reinstall -eq 1 ]; then
    ensure_apt_preference "$edge_pack_pref_file" "${edge_pack_pref[@]}"
    local p
    for p in "${edge_pack_incompatible_pref_files[@]}"; do
      [ ! -f "$p" ] || ensure_sudo mv -f "$p" "$p".save
    done
    reconfigured=1
  fi
  if [ -n "$edge_pack_ppa_repo" ]; then
    if [ ! -e "$edge_pack_ppa_key_file" ] || [ $reinstall -eq 1 ]; then
      ensure_apt_key "$edge_pack_ppa_key_file" "$edge_pack_ppa_key_url" --dearmor
      reconfigured=1
    fi
    if [ ! -e "$edge_pack_ppa_source_file" ] || [ $reinstall -eq 1 ]; then
      ensure_apt_source "$edge_pack_ppa_list_file" "$edge_pack_ppa_source"
      reconfigured=1
    fi
  fi
  [ $reconfigured -eq 0 ] || ensure_apt update -y
}

debian_39_remove_edge_pack () {
  dpkg -l | grep -q -F intel-edge- || { 
    configure_edge_pack "$@"
    ensure_rm "$edge_pack_key_file" "$edge_pack_source_file" "$edge_pack_pref_file"
    [ -z "$edge_pack_ppa_repo" ] || ensure_rm "$edge_pack_ppa_list_file" "$edge_pack_ppa_key_file"
  }
}

sbom_edge_pack_repo_entries () {
  if [ -n "$edge_pack_ppa_repo" ]; then
    ensure_sbom_format gpg-key "$edge_pack_ppa_key_url"
    ensure_sbom_format key-file "$edge_pack_ppa_key_file"
    ensure_sbom_format apt-source "$edge_pack_ppa_source"
    ensure_sbom_format apt-list-file "$edge_pack_ppa_list_file"
    echo "---"
  fi
  ensure_sbom_format name "$edge_pack_repo"
  ensure_sbom_format gpg-key "$edge_pack_key_url"
  ensure_sbom_format key-file "$edge_pack_key_file"
  ensure_sbom_format apt-source "$edge_pack_source"
  ensure_sbom_format apt-list-file "$edge_pack_list_file"
  ensure_sbom_format apt-pref "${edge_pack_pref[@]}"
  ensure_sbom_format apt-pref-file "$edge_pack_pref_file"
}

