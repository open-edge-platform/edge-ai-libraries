configure_edge_pack () {
  version="$(ensure_parse_value_option version --version=1.0 "$@")"
  edge_pack_repo="apt.repos.intel.com"
  edge_pack_key_url="https://$edge_pack_repo/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB"
  edge_pack_key_file=/etc/apt/keyrings/intel-edge-pack.gpg
  edge_pack_source="deb [signed-by=$edge_pack_key_file] https://$edge_pack_repo/edgepack $VERSION_CODENAME stable"
  edge_pack_list_file=/etc/apt/sources.list.d/intel-edge-pack.list
  edge_pack_pref=(
    "Package: *"
    "Pin: origin $edge_pack_repo"
    "Pin-Priority: 1001"
  )
  edge_pack_pref_file=/etc/apt/preferences.d/intel-edge-pack.pref

  edge_pack_ppa_repo="keyserver.ubuntu.com"
  edge_pack_ppa_key_url="https://$edge_pack_ppa_repo/pks/lookup?op=get&search=0x0c0e6af955ce463c03fc51574d098d70afbe5e1f"
  edge_pack_ppa_key_file=/etc/apt/keyrings/kobuk-ppa.gpg
  edge_pack_ppa_source="deb [signed-by=$edge_pack_ppa_key_file] https://snapshot.ppa.launchpadcontent.net/kobuk-team/intel-graphics/$ID/20260830T100000Z/ $VERSION_CODENAME main"
  edge_pack_ppa_list_file=/etc/apt/sources.list.d/kobuk-ppa.list

  edge_pack_install_options=(
    "--no-install-recommends" 
    "--allow-downgrades"
    $(ensure_parse_reinstall "$@" && echo --reinstall || true)
  )
}

debian_39_profile_edge_pack () {
  echo "curl gnupg edge_pack_kernel_image"
}

verify_edge_pack () {
  [[ -f "$edge_pack_key_file" && -f "$edge_pack_list_file" && -f "$edge_pack_pref_file" && -f "$edge_pack_ppa_key_file" && -f "$edge_pack_ppa_list_file" ]] || return 1
  local current="$(< "$edge_pack_list_file")$(< "$edge_pack_pref_file")$(< "$edge_pack_ppa_list_file")"
  local updated="$(printf "%s\n" "$edge_pack_source")$(printf "%s\n" "${edge_pack_pref[@]}")$(printf "%s\n" "$edge_pack_ppa_source")"
  [ "$current" = "$updated" ]
}

debian_39_install_edge_pack () {
  configure_edge_pack "$@"
  if verify_edge_pack && ! ensure_parse_reinstall "$@"; then
    echo "edge_pack configured" >&2
  else
    ensure_prop set installed/edge_pack/owned true

    ensure_apt_key "$edge_pack_key_file" "$edge_pack_key_url" --dearmor
    ensure_apt_source "$edge_pack_list_file" "$edge_pack_source"
    ensure_apt_preference "$edge_pack_pref_file" "${edge_pack_pref[@]}"

    ensure_apt_key "$edge_pack_ppa_key_file" "$edge_pack_ppa_key_url" --dearmor
    ensure_apt_source "$edge_pack_ppa_list_file" "$edge_pack_ppa_source"

    ensure_apt update -y
  fi
}

install_edge_pack_meta () {
  local pkg="$1"; shift
  ensure_apt update
  ensure_apt install "${edge_pack_install_options[@]}" "$pkg" "$@"
  ensure_sudo apt-mark manual "${pkg%%=*}"
}

debian_39_remove_edge_pack () {
  dpkg -l | grep -q -F intel-edge- || { 
    configure_edge_pack "$@"
    [ "$(ensure_prop get installed/edge_pack/owned)" = "true" ] || return 0
    ensure_rm "$edge_pack_key_file" "$edge_pack_source_file" "$edge_pack_pref_file" "$edge_pack_ppa_key_file" "$edge_pack_ppa_list_file"
  }
}

remove_edge_pack_meta () {
  local pkg="$1"
  ensure_apt_is_installed "$pkg" || return 0

  local closure=($(apt-cache depends --recurse --installed --no-recommends --no-suggests --no-conflicts --no-breaks \
      --no-replaces --no-enhances "$pkg" 2>/dev/null | awk '/^[^ <]/{sub(/:.*/,"");print}' | sort -u))

  ensure_sudo apt-mark auto "$pkg" >/dev/null

  local candidates=($(apt-get -s autoremove 2>/dev/null | awk '$1=="Remv"{sub(/:.*/,"",$2);print $2}' | sort -u))
  local remove=($(comm -12 <(printf '%s\n' "${closure[@]}") <(printf '%s\n' "${candidates[@]}")))
  [ ${#remove[@]} -eq 0 ] || ensure_apt purge -y "${remove[@]}" || true
}

sbom_edge_pack_repo_entries () {
  ensure_sbom_format repo-name "$edge_pack_ppa_repo"
  ensure_sbom_format gpg-key "$edge_pack_ppa_key_url"
  ensure_sbom_format key-file "$edge_pack_ppa_key_file"
  ensure_sbom_format apt-source "$edge_pack_ppa_source"
  ensure_sbom_format apt-list-file "$edge_pack_ppa_list_file"
  echo "---"
  ensure_sbom_format repo-name "$edge_pack_repo"
  ensure_sbom_format gpg-key "$edge_pack_key_url"
  ensure_sbom_format key-file "$edge_pack_key_file"
  ensure_sbom_format apt-source "$edge_pack_source"
  ensure_sbom_format apt-list-file "$edge_pack_list_file"
  ensure_sbom_format apt-pref "${edge_pack_pref[@]}"
  ensure_sbom_format apt-pref-file "$edge_pack_pref_file"
}
