
configure_loss_prevention () {
  workspace="$(ensure_project_path)/loss-prevention"
  version="$(ensure_parse_value_option version --version=59ef5cc4aadd81ca2971294fecb2238a98d5fbe4 "$@")"
  repository="https://github.com/intel-retail/loss-prevention.git"
  used_ports=(4000 15672 5672 8002 4001)
}

configure_loss_prevention_options () {
  local device="$1"; shift

  cd "$workspace"
  sed -i -e "s|^TARGET_DEVICE [?]= .*|TARGET_DEVICE ?= ${device^^}|" -e "s|^VLM_DEVICE [?]= .*|VLM_DEVICE ?= ${device^^}|" Makefile

  local camera_stream="$(< .camera_stream)"
  local workload_dist="$(< .workload_dist)"
  local benchmark_mode="$(< .benchmark_mode)"

  if ensure_parse_option --od "$@"; then
    benchmark_mode="object detection $device"
    camera_stream="camera_to_workload_asc_object_detection.json"
    workload_dist="workload_to_pipeline_asc_object_detection_$device.json"
  elif ensure_parse_option --oc "$@"; then
    benchmark_mode="object classification $device"
    camera_stream="camera_to_workload_asc_object_detection_classification.json"
    workload_dist="workload_to_pipeline_asc_object_detection_classification_$device.json"
  elif ensure_parse_option --age "$@"; then
    benchmark_mode="age verification $device"
    camera_stream="camera_to_workload_asc_age_verification.json"
    workload_dist="workload_to_pipeline_asc_age_verification_$device.json"
  elif ensure_parse_option --lpvlm "$@"; then
    benchmark_mode="VLM gpu"
    camera_stream="camera_to_workload_vlm.json"
    workload_dist="workload_to_pipeline_vlm.json"
  elif ensure_parse_option --lp "$@"; then
    benchmark_mode="default ${device/npu/gpu-npu}"
    camera_stream="camera_to_workload.json"
    workload_dist="workload_to_pipeline_${device/npu/gpu-npu}.json"
  fi

  [ "$camera_stream" = "$(< .camera_stream)" ] || {
    echo "@@STEP Download videos"
    make download-sample-videos CAMERA_STREAM="$camera_stream" && {
      local v rc=0
      for v in $(grep '"fileSrc":' configs/$camera_stream | cut -f4 -d'"' | cut -f1 -d'|'); do
        [ $(find performance-tools/sample-media -name "${v/.mp4}-*.mp4" | wc -l) -gt 0 ] || { 
          echo "Failed to download video $v" 1>&2
          rc=1
        }
      done
      [ $rc -eq 0 ]
    }
  }

  [ "$workload_dist" = "$(< .workload_dist)" ] || {
    echo "@@STEP Download models"
    make download-models WORKLOAD_DIST="$workload_dist" && {
      local m rc=0
      for m in $(grep -E '"model":|"vlm_model":' configs/$workload_dist | cut -f4 -d'"'); do
        [ $(find models -ipath "*/$m/*" -name "*.bin" -print | wc -l) -gt 0 ] || { 
          echo "Failed to download model $m" 1>&2
          rc=1
        }
      done
      [ $rc -eq 0 ]
    }
  }

  echo "@@STEP Configured $benchmark_mode"
  echo "$camera_stream" > .camera_stream
  echo "$workload_dist" > .workload_dist
  echo "$benchmark_mode" > .benchmark_mode
}

verify_loss_prevention () {
  [ -e "$workspace"/src/.env ] && 
  [ -e "$workspace"/Makefile ]
}

debian_90_profile_loss_prevention () {
  echo "git curl gawk make python3_venv docker_io edge_base"
}

debian_90_install_loss_prevention () {
  configure_loss_prevention "$@"

  if verify_loss_prevention && ! ensure_parse_reinstall "$@"; then
    echo "Loss prevention is installed." >&2
  else 
    ensure_disk_size 15000
    ensure_ports_open install loss_prevention "${used_ports[@]}"

    # clone the repository
    echo "@@STEP Clonging repository"
    ensure_git_clone "$workspace" $version $repository

    # setup
    cd "$workspace"
    sed -i 's|^benchmark-stream-density: .*|benchmark-stream-density:|' Makefile
    sed -i 's|^benchmark: .*|benchmark:|' Makefile
    sed -i 's|^run-lp: .*|run-lp:|' Makefile
    touch .camera_stream .workload_dist .benchmark_mode
    cat > src/.env <<EOF
MINIO_ROOT_USER="$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)"
MINIO_ROOT_PASSWORD="$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)"
MINIO_API_HOST_PORT="4000"
MINIO_CONSOLE_HOST_PORT="4001"
RABBITMQ_USER="$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)"
RABBITMQ_PASSWORD="$(cat /dev/random | tr -dc a-z | head -c 5)$(cat /dev/random | tr -dc 0-9 | head -c 5)"
EOF

    # build images
    echo "@@STEP Building benchmark"
    make build-benchmark

    # create benchmark venv
    echo "@@STEP Creating venv"
    ( 
      cd performance-tools/benchmark-scripts
      python3 -m venv venv
      . venv/bin/activate
      pip3 install -r requirements.txt
    )

    # modify Makefile so venv does not always rebuild
    sed -i -e 's|python3* -m venv venv|echo|' -e 's|pip3* install -r requirements.txt|echo|' Makefile
    
    verify_loss_prevention
  fi

  local device=$(ensure_parse_device "$@")
  configure_loss_prevention_options "$device" "$@" --lp   # --lp as default

  echo "@@HIGHLIGHT workspace: ${workspace/#"$HOME"/"~"}"
  echo "@@HIGHLIGHT $installer_name start --od [--benchmark]"
  echo "@@HIGHLIGHT $installer_name start --oc [--benchmark]"
  echo "@@HIGHLIGHT $installer_name start --age [--benchmark]"
  echo "@@HIGHLIGHT $installer_name start --lp [--benchmark]"
  echo "@@HIGHLIGHT $installer_name start --lpvlm [--benchmark]"
}

debian_90_start_loss_prevention () {
  configure_loss_prevention "$@"
  ensure_ports_open start loss_prevention "${used_ports[@]}"
  ensure_container_namespace start loss_prevention $(ensure_container_parse_yaml "$workspace"/src/docker-compose*.yml)

  cd "$workspace"
  local device1="$(ensure_parse_device "$@")"
  local device2="$(grep -m1 -E '^TARGET_DEVICE [?]=' Makefile | cut -f2 -d= | tr -d ' ')"
  ensure_parse_option --"$device1" "$@" || ensure_parse_option --"${device1^^}" "$@" || device1="${device2,,}"
  configure_loss_prevention_options "$device1" "$@"

  make down-lp 2> /dev/null || true

  local camera_stream="$(< .camera_stream)" workload_dist="$(< .workload_dist)"
  ensure_rm benchmark results
  if ensure_parse_option --benchmark "$@"; then
    if [[ "$workload_dist" = *"vlm"* ]]; then
      make benchmark CAMERA_STREAM="$camera_stream" WORKLOAD_DIST="$workload_dist"
    else
      make benchmark-stream-density CAMERA_STREAM="$camera_stream" WORKLOAD_DIST="$workload_dist" &
      local pid_b=$!
      while kill -0 $pid_b; do
        sleep 1
        find benchmark -name stream_density.log -exec tail --pid=$pid_b -f {} \;
      done &
      wait
    fi
  else
    make run-lp CAMERA_STREAM="$camera_stream" WORKLOAD_DIST="$workload_dist"
  fi

  echo "@@HIGHLIGHT $installer_name start --od [--benchmark]"
  echo "@@HIGHLIGHT $installer_name start --oc [--benchmark]"
  echo "@@HIGHLIGHT $installer_name start --age [--benchmark]"
  echo "@@HIGHLIGHT $installer_name start --lp [--benchmark]"
  echo "@@HIGHLIGHT $installer_name start --lpvlm [--benchmark]"
  echo "@@HIGHLIGHT $installer_name remove"
}

debian_90_stop_loss_prevention () {
  configure_loss_prevention "$@"
  cd "$workspace" && {
    pkill -f "python3 benchmark.py" || true
    make down-lp || true
    cd src && docker compose down -v --remove-orphans || true
    ensure_container_namespace start loss_prevention $(ensure_container_parse_yaml docker-compose*.yml)
  } || true
  docker volume rm -f lp-mcp-data || true
}

debian_90_remove_loss_prevention () {
  configure_loss_prevention "$@"
  debian_90_stop_loss_prevention "$@"
  ensure_rm "$workspace"
}

