
debian_50_install_npu () {
  if [[ "$VISION_ID" != "24.04" ]]; then
    echo "NPU driver and firmware requires 24.04, found $VISION_ID" 1>&2
    return 3
  fi

  if [ ! -c /dev/accel/accel0 ] && [[ "$*" = *"--reset-npu"* ]]; then
    echo "Removing legacy NPU drivers and firmware..."
    with_sudo dpkg --purge --force-remove-reinstreq intel-driver-compiler-npu intel-fw-npu intel-level-zero-npu intel-level-zero-npu-dbgsym

    if ! dpkg-query -L libtbb12 > /dev/null 2>&1; then
      echo "Installing libtbb12..."
      with_sudo apt install -y libtbb12
    fi

    local tmpdir
    with_tmpdir create tmpdir npu

      echo "Downloading NPU drivers and firmware..."
      local NPU_DRIVER_URL=https://github.com/intel/linux-npu-driver/releases/download/v1.33.0/linux-npu-driver-v1.33.0.20260529-26625960453-ubuntu2404.tar.gz
      wget -O - $NPU_DRIVER_URL | tar -xfz - -C $tmpdir

      echo "Installing NPU drivers and firmwares"
      with_sudo dpkg -i $tmpdir/*.deb

    with_tmpdir destroy $tmpdir

    echo "Setting up udev rules for NPU..."
    echo 'SUBSYSTEM=="accel", KERNEL=="accel*", GROUP="render", MODE="0660"' | with_sudo tee /etc/udev/rules.d/10-intel-vpu.rules
    with_sudo -S udevadm control --reload-rules
    with_sudo -S udevadm trigger --subsystem-match=accel
  fi
}

