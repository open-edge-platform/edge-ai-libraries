
debian_50_profile_npu () {
  echo "curl"
}

debian_50_install_npu () {
  if [[ "$VERSION_ID" != "24.04" ]]; then
    echo "NPU driver and firmware requires 24.04, found $VERSION_ID" 1>&2
    return 3
  fi

  if [ -c /dev/accel/accel0 ] && [[ "$*" != *"--reset-npu"* ]]; then
    echo "NPU is already installed. Skipping..."
    return 0
  fi

  echo "Removing legacy NPU drivers and firmware..."
  ensure_sudo dpkg --purge --force-remove-reinstreq intel-driver-compiler-npu intel-fw-npu intel-level-zero-npu intel-level-zero-npu-dbgsym

  if ! dpkg-query -L libtbb12 > /dev/null 2>&1; then
    echo "Installing libtbb12..."
    ensure_apt update
    ensure_apt install -y libtbb12
  fi

  local tmpdir
  ensure_tmpdir create tmpdir npu

    echo "Downloading NPU drivers and firmware..."
    local NPU_DRIVER_URL=https://github.com/intel/linux-npu-driver/releases/download/v1.33.0/linux-npu-driver-v1.33.0.20260529-26625960453-ubuntu2404.tar.gz
    curl -sL $NPU_DRIVER_URL | tar xfz - -C $tmpdir

    echo "Installing NPU drivers and firmwares"
    ensure_sudo dpkg -i $tmpdir/*.deb

  ensure_tmpdir destroy $tmpdir

  echo "Setting up udev rules for NPU..."
  echo 'SUBSYSTEM=="accel", KERNEL=="accel*", GROUP="render", MODE="0660"' | ensure_sudo tee /etc/udev/rules.d/10-intel-vpu.rules
  ensure_sudo -S udevadm control --reload-rules
  ensure_sudo -S udevadm trigger --subsystem-match=accel
}

