
# ROS 2 distribution, auto-selected from the Ubuntu codename:
#   Ubuntu 22.04 (jammy) -> ROS 2 Humble
#   Ubuntu 24.04 (noble) -> ROS 2 Jazzy
# https://docs.openedgeplatform.intel.com/dev/edge-ai-suites/robotics-ai-suite/robotics/gsg_robot/index.html
configure_ros2 () {
  case "$VERSION_CODENAME" in
  jammy) ros_distro=humble ;;
  noble) ros_distro=jazzy ;;
  *)     ros_distro=jazzy ;;
  esac

  local codename="${UBUNTU_CODENAME:-$VERSION_CODENAME}"
  ros_apt_ver="$(curl -fsSL https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F '"tag_name"' | awk -F'"' '{print $4}')"
  ros_deb_src="https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ros_apt_ver}/ros2-apt-source_${ros_apt_ver}.${codename}_all.deb"
}

# OSRF Gazebo apt repository, shared by the Robotics AI Suite ROS 2 components
# (autonomous_mobile_robot, stationary_robot_vision). Expects $ros_distro.
configure_osrf_gazebo_ros2 () {
  osrf_name=packages.osrfoundation.org
  osrf_key_url="https://$osrf_name/gazebo.gpg"
  osrf_key=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg
  osrf_entry="deb [signed-by=$osrf_key] https://$osrf_name/gazebo/$ID-stable $VERSION_CODENAME main"
  osrf_list=/etc/apt/sources.list.d/gazebo-stable.list
}

ensure_osrf_gazebo_ros2 () {
  configure_osrf_gazebo_ros2
  ensure_apt install -y curl lsb-release gnupg
  ensure_apt_key "$osrf_key" "$osrf_key_url"
  ensure_apt_source "$osrf_list" "$osrf_entry"
  ensure_apt update -y
  [ "$ros_distro" != jazzy ] || ensure_apt install -y gz-harmonic || true
}

remove_osrf_gazebo_ros2 () {
  configure_osrf_gazebo_ros2
  ensure_sudo rm -f "$osrf_list" "$osrf_key"
}

sbom_osrf_gazebo_ros2 () {
  configure_osrf_gazebo_ros2
  cat <<EOF
$(ensure_sbom_format name $osrf_name)
$(ensure_sbom_format gpg-key "$osrf_key_url")
$(ensure_sbom_format key-file "$osrf_key")
$(ensure_sbom_format apt-source "$osrf_entry")
$(ensure_sbom_format apt-list-file "$osrf_list")
$(ensure_sbom_format pkg-list curl lsb-release gnupg $([ "$ros_distro" != jazzy ] || echo gz-harmonic))
EOF
}

debian_50_profile_ros2 () {
  echo "curl gnupg git software_properties_common lsb_release"
  # --realtime (set by edge_base_robotics) supplies GPU/NPU prep via
  # edge_pack_base_realtime instead; skip edge_base to avoid installing both
  # the standard and real-time edge-pack base bundles together.
  [[ " $* " = *" --realtime "* ]] || echo "edge_base"
}

verify_ros2 () {
  [ -r /opt/ros/$ros_distro/setup.bash ]
}

debian_50_install_ros2 () {
  configure_ros2

  if verify_ros2 && [[ " $* " != *" --reinstall "* ]]; then
    echo "ROS 2 $ros_distro is already installed. Skipping..."
  else
    # declare ownership
    ensure_prop set installed/ros2/owned true

    ensure_apt_add_repository universe || true

    # bootstrap the ROS 2 apt repository via the ros2-apt-source package,
    # which self-configures the apt source list and signing key
    local tmpdir
    ensure_tmpdir create tmpdir ros2
    ensure_fetch "$ros_deb_src" "$tmpdir/ros2-apt-source.deb"
    ensure_apt install -y "$tmpdir/ros2-apt-source.deb"
    ensure_tmpdir destroy $tmpdir

    ensure_apt update -y
    ensure_apt install -y ros-$ros_distro-desktop ros-dev-tools

    # permanent ROS 2 environment
    grep -q "source /opt/ros/$ros_distro/setup.bash" ~/.bashrc 2>/dev/null || \
      echo "source /opt/ros/$ros_distro/setup.bash" >> ~/.bashrc
    grep -q "export ROS_DOMAIN_ID=" ~/.bashrc 2>/dev/null || \
      echo "export ROS_DOMAIN_ID=42" >> ~/.bashrc
  fi

  echo "@@HIGHLIGHT ROS 2 $ros_distro @/opt/ros/$ros_distro"
  echo "@@HIGHLIGHT shell env @source /opt/ros/$ros_distro/setup.bash"
}

debian_50_remove_ros2 () {
  # leave untouched if not installed by ros2
  [ "$(ensure_prop get installed/ros2/owned)" = "true" ] || return 0

  configure_ros2
  if verify_ros2; then
    ensure_apt autoremove -m -y ros-$ros_distro-desktop || true
  else
    echo "ROS 2 already removed. Skipping"
  fi
}

debian_50_sbom_ros2 () {
  configure_ros2 "$@"
  cat <<EOF
$(ensure_sbom_format pkg-list software-properties-common gnupg lsb-release ca-certificates)
---
$(ensure_sbom_format pkg-list ros-$ros_distro-desktop ros-dev-tools)
$(ensure_sbom_format apt-repository universe)
EOF
}
