
configure_realsense () {
  workspace="$(ensure_project_path)/realsense"
  eci_repo_name=eci.intel.com
  eci_key_url="https://$eci_repo_name/repos/gpg-keys/GPG-PUB-KEY-INTEL-ECI.gpg"
  eci_key_file=/etc/apt/keyrings/intel-eci.gpg
  eci_repo_list="deb [signed-by=$eci_key_file] https://$eci_repo_name/repos/$VERSION_CODENAME isar main"
  eci_repo_list_file=/etc/apt/sources.list.d/intel-eci.list

  rs_repo_name="librealsense.realsenseai.com"
  rs_key_url="https://$rs_repo_name/Debian/librealsenseai.asc"
  rs_key_file=/etc/apt/keyrings/librealsenseai.gpg
  rs_list=/etc/apt/sources.list.d/librealsense.list
  rs_deb_entry="deb [signed-by=$rs_key_file] https://$rs_repo_name/Debian/apt-repo $VERSION_CODENAME main"

  rs_packages=(librealsense2 librealsense2-dkms librealsense2-utils librealsense2-dev librealsense2-gl)
  rs_ros_package=
  if [[ " $* " = *" ros2 "* || " $* " = *" edge_base_robotics "* ]]; then
    case "$VERSION_CODENAME" in
    jammy) rs_ros_package=ros-humble-librealsense2 ;;
    noble) rs_ros_package=ros-jazzy-librealsense2 ;;
    *)
      echo "RealSense ROS support requires Ubuntu jammy or noble." >&2
      return 3
      ;;
    esac
    rs_packages+=("$rs_ros_package")
  fi
}

debian_55_profile_realsense () {
  echo "curl gnupg"
}

verify_realsense () {
  configure_realsense "$@"
  ensure_apt_is_installed "${rs_packages[@]}"
}

debian_55_install_realsense () {
  configure_realsense "$@"
  ensure_prop create installed/realsense/packages/
  if ensure_apt_is_installed "${rs_packages[@]}" && [[ " $* " != *" --reinstall "* ]]; then
    echo "RealSense packages are installed." >&2
  else
    local package
    for package in "${rs_packages[@]}"; do
      if ! ensure_apt_is_installed "$package"; then
        ensure_prop set "installed/realsense/packages/$package" true
      fi
    done

    echo "@@STEP Configuring Apt"
    local repo_file
    ensure_prop create installed/realsense/repositories/
    for repo_file in "$eci_key_file" "$eci_repo_list_file" "$rs_key_file" "$rs_list"; do
      if [ ! -e "$repo_file" ] && [ ! -L "$repo_file" ]; then
        ensure_prop set "installed/realsense/repositories/${repo_file##*/}" true
      fi
    done
    ensure_apt_key "$eci_key_file" "$eci_key_url" --dearmor
    ensure_apt_source "$eci_repo_list_file" "$eci_repo_list"
    ensure_apt_key "$rs_key_file" "$rs_key_url" --dearmor
    ensure_apt_source "$rs_list" "$rs_deb_entry"
    ensure_apt update -y

    echo "@@STEP Installing RealSense packages"
    ensure_apt install -y --no-install-recommends "${rs_packages[@]}"
    verify_realsense "$@"
  fi
}

debian_55_remove_realsense () {
  configure_realsense
  local package owned_packages=()
  for package in "${rs_packages[@]}" ros-humble-librealsense2 ros-jazzy-librealsense2; do
    if [ "$(ensure_prop get "installed/realsense/packages/$package")" = true ]; then
      owned_packages+=("$package")
    fi
  done
  if [ ${#owned_packages[@]} -gt 0 ]; then
    ensure_apt purge -y "${owned_packages[@]}" || return $?
  fi
  local repo_file
  for repo_file in "$eci_repo_list_file" "$rs_list" "$eci_key_file" "$rs_key_file"; do
    if [ "$(ensure_prop get "installed/realsense/repositories/${repo_file##*/}")" = true ]; then
      ensure_rm "$repo_file" || return $?
      ensure_prop remove "installed/realsense/repositories/${repo_file##*/}"
    fi
  done
}

debian_55_sbom_realsense () {
  configure_realsense "$@"
  ensure_sbom_format repo-name "$rs_repo_name"
  ensure_sbom_format gpg-key "$rs_key_url"
  ensure_sbom_format key-file "$rs_key_file"
  ensure_sbom_format apt-source "$rs_deb_entry"
  ensure_sbom_format apt-list-file "$rs_list"
  ensure_sbom_format pkg-list "${rs_packages[@]}"
}
