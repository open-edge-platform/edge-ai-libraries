
configure_edge_pack_media_ffmpeg () {
  configure_edge_pack "$@"
  version="1.0"
}

debian_70_profile_edge_pack_media_ffmpeg () {
  echo "edge_pack"
}

debian_70_install_edge_pack_media_ffmpeg () {
  configure_edge_pack_media_ffmpeg "$@"
  if ensure_apt_is_installed intel-edge-media-ffmpeg && [[ " $* " != *" --reinstall "* ]]; then
    echo "intel-edge-media-ffmpeg is installed." >&2
  else
    ensure_prop set installed/edge_pack_media_ffmpeg/owned true
    ensure_apt purge --auto-remove -y intel-edge-media-ffmpeg || true
    ensure_apt install "${edge_pack_install_options[@]}" "intel-edge-media-ffmpeg=$version*"
  fi
}

debian_70_remove_edge_pack_media_ffmpeg () {
  [ "$(ensure_prop get installed/edge_pack_media_ffmpeg/owned)" = "true" ] || return 0
  ensure_apt purge --auto-remove -y intel-edge-media-ffmpeg || true
}

debian_70_sbom_edge_pack_media_ffmpeg () {
  configure_edge_pack_media_ffmpeg "$@"
  sbom_edge_pack_repo_entries "$@"
  ensure_sbom_format pkg-list "intel-edge-media-ffmpeg=$version*"
}

