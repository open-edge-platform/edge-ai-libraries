
configure_edge_pack_media_ffmpeg () {
  configure_edge_pack "$@"
  version="1.0"
}

debian_70_profile_edge_pack_media_ffmpeg () {
  echo "edge_pack"
}

debian_70_install_edge_pack_media_ffmpeg () {
  configure_edge_pack_media_ffmpeg "$@"
  if ensure_apt_is_installed intel-edge-media-ffmpeg=$version && [[ " $* " != *" --reinstall "* ]]; then
    echo "intel-edge-media-ffmpeg already installed. Skipping" 1>&2
  else
    debian_20_remove_edge_pack_media_ffmpeg
    ensure_apt install --no-install-recommends "intel-edge-media-ffmpeg=$version*"
  fi
}

debian_70_remove_edge_pack_media_ffmpeg () {
  ensure_apt autoremove -y intel-edge-media-ffmpeg || true
}

debian_70_sbom_edge_pack_media_ffmpeg () {
  configure_edge_pack_media_ffmpeg "$@"
  cat <<EOF
$(ensure_sbom_format name "$edge_pack_repo")
$(ensure_sbom_format gpg-key "$edge_pack_key_url")
$(ensure_sbom_format key-file "$edge_pack_key_file")
$(ensure_sbom_format apt-source "$edge_pack_source")
$(ensure_sbom_format apt-list-file "$edge_pack_list_file")
$(ensure_sbom_format apt-pref "${edge_pack_pref[@]}")
$(ensure_sbom_format apt-pref-file "$edge_pack_pref_file")
$(ensure_sbom_format pkg-list "intel-edge-media-ffmpeg=$version*")
EOF
}

