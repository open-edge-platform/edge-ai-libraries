
configure_docker () {
  if [ -n "${http_proxy:-$HTTP_PROXY}${https_proxy:-$HTTPS_PROXY}" ]; then
    echo "Configure docker engine proxies..."
    grep -q -E 'HTTPS*_PROXY=' /etc/systemd/system/docker.service.d/*.conf 2>/dev/null || (
      ensure_sudo mkdir -p /etc/systemd/system/docker.service.d
      ensure_sudo tee /etc/systemd/system/docker.service.d/oep-proxy.conf <<EOF
[Service]
Environment="HTTP_PROXY=${http_proxy:-$HTTP_PROXY}"
Environment="HTTPS_PROXY=${https_proxy:-$HTTPS_PROXY}"
Environment="NO_PROXY=${no_proxy:-$NO_PROXY}"
EOF
      ensure_sudo systemctl daemon-reload
      ensure_sudo systemctl restart docker
    )

    local CONFIG_JSON="$HOME/.docker/config.json"
    echo "Configure docker client proxies..."
    mkdir -p "$(dirname "$CONFIG_JSON")"
    python3 - "$CONFIG_JSON" <<'EOF'
import json, os, sys
p = sys.argv[1]
cfg = json.load(open(p)) if os.path.exists(p) else {}
cfg.setdefault("proxies", {})["default"] = {
    "httpProxy":  os.environ.get("http_proxy",  os.environ.get("HTTP_PROXY", "")),
    "httpsProxy": os.environ.get("https_proxy", os.environ.get("HTTPS_PROXY", "")),
    "noProxy":    os.environ.get("no_proxy",    os.environ.get("NO_PROXY", "")),
}
json.dump(cfg, open(p, "w"), indent=2)
EOF
  fi
}

debian_20_install_docker () {
  if docker version > /dev/null 2>&1 && docker buildx version > /dev/null 2>&1 && docker compose version > /dev/null 2>&1 && [[ "$*" != *"--reset-docker"* ]]; then
    echo "Docker is already installed. Skipping..."
  elif dpkg-query -W -f '${Status}' docker.io 2> /dev/null | grep -q ' ok installed$' && [[ "$*" != *"--reset-docker"* ]]; then
    ensure_apt update
    ensure_apt install -y docker-buildx docker-compose-v2
  elif dpkg-query -W -f '${Status}' docker-ce 2> /dev/null | grep -q ' ok installed$' && [[ "$*" != *"--reset-docker"* ]]; then 
    ensure_apt update
    ensure_apt install -y docker-buildx-plugin docker-compose-plugin
  else
    echo "Remove legacy installation"
    local legacy_pkgs="$(dpkg-query -W -f='${Package} ${Status}\n' docker docker-engine docker.io docker-ce docker-ce-cli docker-compose-plugin docker-compose-v2 docker-buildx-plugin docker-ce-rootless-extras docker-scan-plugin docker-doc docker-compose podman-docker containerd containerd.io runc 2>/dev/null | awk '$2!="unknown"{print $1}')"
    [ -z "$legacy_pkgs" ] || ensure_apt purge -y $legacy_pkgs

    # create docker group
    ensure_group_add docker:

    ensure_apt  update
    ensure_apt  install -y docker.io docker-buildx docker-compose-v2

    # wait
    local deadline=$((SECONDS+60))
    until systemctl is-active --quiet docker.service > /dev/null 2>&1; do
      [ $SECONDS -lt $deadline ] || {
        echo -e "${red}dockerd did not become ready${reset}" 1>&2
        ensure_sudo systemctl status docker.service --no-pager 1>&2
        ensure_sudo journalctl -u docker.service -n 30 --no-pager 1>&2
        return 1
      }
      sleep 1
    done
  fi
  configure_docker
}

