
configure_order_accuracy_dine_in () {
  workspace="$(ensure_project_path)/order-accuracy-dine-in"
  version=v2026.2.0
  repository="https://github.com/intel-retail/order-accuracy.git"
  ports=(7861 8083 8002 8011 9000 8081 9091)
}

configure_order_accuracy_dine_in_device () {
  local default_device=$(grep -E "^TARGET_DEVICE=" "$workspace"/dine-in/.env | tail -n1 | cut -f2 -d=)
  local selected_device=$(ensure_select_device "$@")
  if [ "$default_device" != "${selected_device^^}" ]; then
    sed -i "s|^TARGET_DEVICE=.*|TARGET_DEVICE=${selected_device^^}|" "$workspace"/dine-in/.env
    cd "$workspace"/ovms-service
    ./setup_models.sh --app dine-in
  fi
}

verify_order_accuracy_dine_in () {
  local model="$(. "$workspace"/dine-in/.env 2> /dev/null || . "$workspace"/dine-in/.env.example 2> /dev/null; echo "$OVMS_MODEL_NAME")"
  [ -e "$workspace"/ovms-service/models/$model/openvino_language_model.bin ]
}

debian_90_profile_order_accuracy_dine_in () {
  echo "git curl gawk make python3_venv docker edge_base"
}

debian_90_install_order_accuracy_dine_in () {
  configure_order_accuracy_dine_in
  export HTTP_PROXY=${HTTP_PROXY:-$http_proxy} HTTPS_PROXY=${HTTPS_PROXY:-$https_proxy} NO_PROXY=${NO_PROXY:-$no_proxy}

  if verify_order_accuracy_dine_in && [[ " $* " != *" --reinstall "* ]]; then
    echo "Order accuracy is already installed. Skipping"
  else 
    ensure_ports_open "${ports[*]}" return 3
    # clone the repository
    ensure_disk_size 10000
    ensure_git_clone "$workspace" $version $repository

    # initialize .env
    cd "$workspace"/dine-in
    make init-env

    # setup
    local model="$(. .env; echo "$OVMS_MODEL_NAME")"
    ensure_hf_token "${model/MiniCPM-V-4_5-int4/MiniCPM-V-4_5}"

    sed -i "s|^HF_TOKEN=.*|HF_TOKEN=$HF_TOKEN|" .env
    sed -i "s|^TARGET_DEVICE=.*|TARGET_DEVICE=|" .env

    cd "$workspace"/dine-in
    make build
  fi

  configure_order_accuracy_dine_in_device "$@"
  verify_order_accuracy_dine_in

  echo "@@HIGHLIGHT workspace @$workspace"
  echo "@@HIGHLIGHT $installer_name start"
}

debian_90_start_order_accuracy_dine_in () {
  configure_order_accuracy_dine_in "$@"
  export HTTP_PROXY=${HTTP_PROXY:-$http_proxy} HTTPS_PROXY=${HTTPS_PROXY:-$https_proxy} NO_PROXY=${NO_PROXY:-$no_proxy}

  ensure_ports_open "${ports[*]}" debian_90_stop_order_accuracy_dine_in "$@"
  cd "$workspace"/dine-in
  make up
  echo "@@HIGHLIGHT URL: http://$(ensure_ip):${ports[0]}"
  echo "@@HIGHLIGHT $installer_name stop"
  echo "@@HIGHLIGHT $installer_name remove"
}

debian_90_stop_order_accuracy_dine_in () {
  configure_order_accuracy_dine_in "$@"
  cd "$workspace"/dine-in && make down || true
}

debian_90_remove_order_accuracy_dine_in () {
  debian_90_stop_order_accuracy_dine_in "$@"
  ensure_sudo rm -rf "$workspace" 2> /dev/null || true
}

