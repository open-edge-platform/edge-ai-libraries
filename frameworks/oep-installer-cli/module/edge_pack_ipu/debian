
configure_edge_pack_ipu () {
  configure_edge_pack "$@"
  version="1.0"
}

debian_40_profile_edge_pack_ipu () {
  echo "edge_pack"
}

debian_40_install_edge_pack_ipu () {
  configure_edge_pack_ipu "$@"
  if ensure_apt_is_installed intel-edge-ipu && [[ " $* " != *" --reinstall "* ]]; then
    echo "intel-edge-ipu is installed." >&2
  else
    ensure_prop set installed/edge_pack_ipu/owned true
    ensure_apt purge --auto-remove -y intel-edge-ipu || true
    ensure_apt_allow_downgrades "${edge_pack_allow_downgrades[*]}" "${edge_pack_install_options[@]}" "intel-edge-ipu=$version*" || true
    ensure_apt install --allow-downgrades "${edge_pack_install_options[@]}" "intel-edge-ipu=$version*"
  fi
}

debian_40_remove_edge_pack_ipu () {
  [ "$(ensure_prop get installed/edge_pack_ipu/owned)" = "true" ] || return 0
  ensure_apt purge --auto-remove -y intel-edge-ipu || true
}

debian_40_sbom_edge_pack_ipu () {
  configure_edge_pack_ipu "$@"
  sbom_edge_pack_repo_entries "$@"
  ensure_sbom_format pkg-list "intel-edge-ipu=$version*"
}

