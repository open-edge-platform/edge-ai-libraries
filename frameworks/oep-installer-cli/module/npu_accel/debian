
configure_npu_accel () {
  version=1.38.0
  repository=https://api.github.com/repos/intel/linux-npu-driver
  releases=https://github.com/intel/linux-npu-driver/releases
  workspace="$(ensure_project_path)/npu"
}

# resolve the release tarball URLs: GitHub API first, release page as fallback
configure_npu_accel_packages () {
  local suffix="${ID}${VERSION_ID//./}.tar.gz"
  (set -o pipefail
   ensure_fetch "$repository/releases/tags/v$version" - | jq -r ".assets[] | select(.name|endswith(\"-$suffix\")) | .browser_download_url" ||
   ensure_fetch "$releases/expanded_assets/v$version" - --html | grep -oP 'href="\K/([^"]+/releases/download/[^"]+'"$suffix"')' | sed 's|^|https://github.com|')
}

verify_npu_accel () {
  [ -c /dev/accel/accel0 ] && verify_npu_accel_packages
}

# checks the driver packages only, independent of NPU hardware being present.
# used to confirm a fresh install succeeded even on systems without an NPU device.
verify_npu_accel_packages () {
  ensure_apt_is_installed intel-level-zero-npu=$version intel-fw-npu=$version intel-driver-compiler-npu=$version
}

debian_40_profile_npu_accel () {
  echo "libtbb12 jq libze1"
}

debian_40_group_npu_accel () {
  echo "render:992"
}

debian_40_install_npu_accel () {
  configure_npu_accel "$@"

  if verify_npu_accel && [[ " $* " != *" --reinstall "* ]]; then
    echo "Npu drivers are installed." >&2
  else
    # declare ownership
    ensure_prop set installed/npu_accel/owned true

    # remove legacies
    debian_40_remove_npu_accel "$@"

    mkdir -p "$workspace"
    cd "$workspace"

    # download deb packages
    local packages=($(configure_npu_accel_packages))
    [ ${#packages[*]} -gt 0 ] || return 3

    for p in ${packages[*]}; do
      (set -o pipefail; ensure_fetch "$p" - | tar xfz -) || {
        echo "npu_accel: failed to download/extract $p" >&2
        return 3
      }
    done 

    # install the debs
    ensure_apt install -y $(find . -name "*.deb" -print)
    ensure_rm "$workspace"
    verify_npu_accel_packages
  fi

  # create the render group
  ensure_group_add $(debian_40_group_npu_accel)
}

debian_40_remove_npu_accel () {
  # leave untouched if not installed by npu_accel
  [ "$(ensure_prop get installed/npu_accel/owned)" = "true" ] || return 0

  configure_npu_accel "$@"
  ensure_apt purge --auto-remove -y intel-driver-compiler-npu intel-fw-npu intel-level-zero-npu intel-level-zero-npu-dbgsym || true
  ensure_rm "$workspace"
}

debian_40_sbom_npu_accel () {
  configure_npu_accel "$@"
  local packages=($(configure_npu_accel_packages))
  [ ${#packages[*]} -gt 0 ] || {
    echo "Failed to fetch npu_accel latest package" >&2
    return 3
  }
  ensure_sbom_format pkg-list "${packages[@]}"
}

