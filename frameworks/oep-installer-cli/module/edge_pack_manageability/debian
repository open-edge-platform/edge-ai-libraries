
debian_40_profile_edge_pack_manageability () {
  echo "edge_pack"
}

debian_40_install_edge_pack_manageability () {
  configure_edge_pack "$@"
  if ensure_apt_is_installed intel-edge-manageability && ! ensure_parse_reinstall "$@"; then
    echo "intel-edge-manageability is installed." >&2
  else
    ensure_prop set installed/edge_pack_manageability/owned true
    install_edge_pack_meta "intel-edge-manageability=$version*"
  fi
}

debian_40_remove_edge_pack_manageability () {
  [ "$(ensure_prop get installed/edge_pack_manageability/owned)" = "true" ] || return 0
  remove_edge_pack_meta intel-edge-manageability
}

debian_40_sbom_edge_pack_manageability () {
  configure_edge_pack "$@"
  sbom_edge_pack_repo_entries "$@"
  ensure_sbom_format pkg-list "intel-edge-manageability=$version*"
}

