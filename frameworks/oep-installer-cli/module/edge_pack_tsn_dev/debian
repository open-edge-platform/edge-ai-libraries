
debian_40_profile_edge_pack_tsn_dev () {
  echo "edge_pack"
}

debian_40_install_edge_pack_tsn_dev () {
  configure_edge_pack "$@"
  if ensure_apt_is_installed intel-edge-tsn-dev && ! ensure_parse_reinstall "$@"; then
    echo "intel-edge-tsn-dev is installed." >&2
  else
    ensure_prop set installed/edge_pack_tsn_dev/owned true
    install_edge_pack_meta "intel-edge-tsn-dev=$version*"
  fi
}

debian_40_remove_edge_pack_tsn_dev () {
  [ "$(ensure_prop get installed/edge_pack_tsn_dev/owned)" = "true" ] || return 0
  remove_edge_pack_meta intel-edge-tsn-dev
}

debian_40_sbom_edge_pack_tsn_dev () {
  configure_edge_pack "$@"
  sbom_edge_pack_repo_entries "$@"
  ensure_sbom_format pkg-list "intel-edge-tsn-dev=$version*"
}

