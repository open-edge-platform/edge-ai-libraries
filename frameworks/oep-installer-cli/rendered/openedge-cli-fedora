    };
    function _mark_fail () 
    { 
        local name=$1 f;
        [[ -z $name ]] && return;
        STATUS[$name]="fail";
        _timer_stop "$name";
        LDIRTY[$name]=1;
        LEFT_VALID=0;
        for f in "${FAILED[@]}";
        do
            [[ $f == "$name" ]] && return;
        done;
        FAILED+=("$name")
    };
    function _push_log () 
    { 
        local c=$1 line=$2 r;
        [[ -z $c ]] && return;
        L1[$c]=${L2[$c]:-};
        L2[$c]=$line;
        LDIRTY[$c]=1;
        LEFT_VALID=0;
        RBUF[$c]+="${line}"'
';
        RCNT[$c]=$(( ${RCNT[$c]:-0} + 1 ));
        if (( RW_NOW > 0 )) && [[ ${WRAPW[$c]:--1} == "$RW_NOW" ]]; then
            _wrap_one "$RW_NOW" "$line";
            for r in "${WRAPPED[@]}";
            do
                WRAPC[$c]+="${r}"'
';
                WRAPCN[$c]=$(( ${WRAPCN[$c]:-0} + 1 ));
            done;
            if (( ${WRAPCN[$c]:-0} > MAX_WRAP )); then
                WRAPW[$c]=-1;
            fi;
            [[ $c == "$RCACHE_COMP" ]] && RCACHE_N=-1;
        fi;
        if (( ${RCNT[$c]:-0} > MAX_RBUF )); then
            local keep=$(( MAX_RBUF / 2 ));
            RBUF[$c]=$(printf '%s' "${RBUF[$c]}" | tail -n "$keep")'
';
            RCNT[$c]=$keep;
            WRAPW[$c]=-1;
            [[ $c == "$RCACHE_COMP" ]] && RCACHE_N=-1;
        fi
    };
    function _push_highlight () 
    { 
