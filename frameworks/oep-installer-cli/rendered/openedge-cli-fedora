install_system_inspection () 
{ 
    set -o pipefail;
    ( echo "----------------------------------------------------------------";
    ok="${green}✓  PASS${reset}";
    nok="${red}⚠  MSG${reset}";
    system_summary="$(system_scan_get_system_summary)";
    echo "System|$system_summary";
    pass=$ok;
    membank_info="$(ensure_prop get installed/system_inspection/membank)";
    [ -n "$membank_info" ] || membank_info="$(system_scan_check_membank)";
    [ -z "$membank_info" ] || ensure_prop set installed/system_inspection/membank "$membank_info";
    [ "$membank_info" = "DUAL/MULTI-CHANNELS" ] || pass="${nok/MSG/Check Memory}";
    echo -e "RAM|$membank_info|$pass";
    [ "$pass" = "$ok" ] || echo -e "@@HIGHLIGHT RAM|$membank_info|$pass" 1>&2;
    case "$PRETTY_NAME" in 
        *"24.04"* | *"26.04"* | *"Red Hat Enterprise"*)
            pass=$ok
        ;;
        *)
            pass="${nok/MSG/Not supported}"
        ;;
    esac;
    echo -e "OS|$PRETTY_NAME|$pass";
    [ "$pass" = "$ok" ] || echo -e "@@HIGHLIGHT OS|$PRETTY_NAME|$pass" 1>&2;
    pass=$ok;
