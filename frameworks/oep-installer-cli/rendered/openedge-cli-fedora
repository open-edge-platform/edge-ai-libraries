system_scan_check_pci_device () 
{ 
    local deviceid=${1,,};
    local default_name="$2";
    local lspci_out="$(lspci -v -n -d $deviceid)";
    local subsystem="$(echo "$lspci_out" | grep -m1 Subsystem: | cut -f2- -d: | sed 's|^ ||g' || true)";
    if [ -n "$subsystem" ]; then
        local name="$(echo "$lspci_out" | grep -m1 DeviceName: | cut -f2- -d: | sed 's|^ ||g' || true)";
        local driver="$(echo "$lspci_out" | awk '/Kernel driver in use:/{print$NF}' || true)";
        local driver_str="";
        if [ -n "$driver" ]; then
            driver_str=$(modinfo $driver 2> /dev/null | awk '/vermagic:/{print$2}' || true);
            [ -z "$driver_str" ] || driver_str=" · driver $driver $driver_str";
        fi;
        echo "${name:-$default_name}$driver_str";
    fi
}
system_scan_get_system_summary () 
{ 
    local cpuinfo="$(grep -m1 "model name" /proc/cpuinfo | cut -f2 -d: | sed 's|^ ||g')";
    local coreinfo="$(grep "processor" /proc/cpuinfo | wc -l) cores";
    local meminfo="$(grep -m1 "MemTotal:" /proc/meminfo | cut -f2 -d: | tr -d ' ')";
    [[ "$meminfo" != *kB ]] || meminfo="$(( ${meminfo%kB} / 1024 / 1024 ))GB";
    [[ "$meminfo" != *mB ]] || meminfo="$(( ${meminfo%mB} / 1024 ))GB";
    echo "$cpuinfo · $coreinfo · $meminfo RAM"
}
