    function _set_step () 
    { 
        STEP_TEXT=$1
    };
    function _clear_step () 
    { 
        STEP_TEXT=""
    };
    function _add_step_rule () 
    { 
        local spec=$1 rx fmt;
        [[ $spec == *' @@THEN '* ]] || return 1;
        rx=${spec%%' @@THEN '*};
        fmt=${spec#*' @@THEN '};
        [[ -z $rx ]] && return 1;
        [[ x =~ $rx ]];
        (( $? == 2 )) && return 1;
        STEP_RX+=("$rx");
        STEP_FMT+=("$fmt")
    };
    function _clear_step_rules () 
    { 
        STEP_RX=();
        STEP_FMT=()
    };
    function _apply_step_rules () 
    { 
        (( ${#STEP_RX[@]} == 0 )) && return 1;
        local s=$1 i j out;
        for ((i = 0; i < ${#STEP_RX[@]}; i++ ))
        do
            if [[ $s =~ ${STEP_RX[i]} ]]; then
                out=${STEP_FMT[i]};
                for ((j = ${#BASH_REMATCH[@]} - 1; j >= 0; j-- ))
                do
                    out=${out//"\\$j"/"${BASH_REMATCH[j]}"};
                done;
                _set_step "$out";
                return 0;
            fi;
        done;
        return 1
    };
    TITLEROW="";
    function _title_row () 
    { 
        local w=$1 tw sw room left;
        _fit_v "$w" "$TITLE" 1;
        TITLEROW="${C_BOLD}${FITTED}${C_RESET}";
        [[ -z $STEP_TEXT ]] && return;
        _dwidth "$TITLE";
        tw=$REPLY;
        room=$(( w - tw - 3 ));
        (( room < STEP_MIN )) && return;
        _dwidth "$STEP_TEXT";
        sw=$REPLY;
        (( sw > room )) && sw=$room;
        _fit_v $(( w - sw - 1 )) "$TITLE" 1;
        left=$FITTED;
        _fit_v "$sw" "$STEP_TEXT" 1;
        TITLEROW="${C_BOLD}${left}${C_RESET}${C_CYAN}${FITTED}${C_RESET} "
    };
    function _ensure_wrap () 
    { 
        local c=$1 w=$2 src r;
        [[ -z $c ]] && return;
        [[ ${WRAPW[$c]:--1} == "$w" ]] && return;
        local acc="" n=0;
        if [[ -n ${RBUF[$c]:-} ]]; then
            while IFS= read -r src; do
                _wrap_one "$w" "$src";
                for r in "${WRAPPED[@]}";
                do
                    acc+="${r}"'
';
                    n=$(( n + 1 ));
                done;
            done <<< "${RBUF[$c]}";
        fi;
        WRAPC[$c]=$acc;
        WRAPCN[$c]=$n;
        WRAPW[$c]=$w;
        [[ $c == "$RCACHE_COMP" ]] && RCACHE_N=-1
    };
    function _load_rows () 
    { 
        local c=$1 w=$2;
        if [[ -z $c ]]; then
            RCACHE_ROWS=();
            RCACHE_COMP="";
            RCACHE_W=-1;
            RCACHE_N=-1;
            return;
        fi;
        _ensure_wrap "$c" "$w";
        if [[ $c == "$RCACHE_COMP" ]] && (( RCACHE_W == w )) && (( RCACHE_N == ${WRAPCN[$c]:-0} )); then
            return;
        fi;
        RCACHE_ROWS=();
        if [[ -n ${WRAPC[$c]:-} ]]; then
            mapfile -t RCACHE_ROWS <<< "${WRAPC[$c]%'
'}";
        fi;
        RCACHE_COMP=$c;
        RCACHE_W=$w;
        RCACHE_N=${WRAPCN[$c]:-0}
    };
    function _timer_tick () 
    { 
        (( ${#TSTART[@]} == 0 )) && return 1;
        local c s hit=1;
        for c in "${!TSTART[@]}";
        do
            [[ -z $c ]] && continue;
            _elapsed_ms "$c";
            s=$(( REPLY / 1000 ));
            if (( s != ${TSHOWN[$c]:--1} )); then
                TSHOWN[$c]=$s;
                LDIRTY[$c]=1;
                LEFT_VALID=0;
                hit=0;
            fi;
        done;
        return $hit
    };
    function _build_block () 
