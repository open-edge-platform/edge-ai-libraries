    else
        if [ -t 0 ] && [ -z "$SUDO_PASSWORD" ] && [ -z "$_INSTALLER_PANEL_ACTIVE" ]; then
            sudo env "${proxy_args[@]}" "$@";
        else
            local rundir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}";
            [ -d "$rundir" ] && [ -w "$rundir" ] || rundir="$(ensure_project_path)/${installer_name:?}";
            mkdir -p "$rundir" 2> /dev/null || return 1;
            ( flock -w 300 -e 9 || { 
                echo "ensure_sudo: timed out waiting for another installer" 1>&2;
                exit 1
            };
            if [ ! -x "$SUDO_ASKPASS" ]; then
                askpass_helper="$rundir"/askpass-sudo;
                act_panelled_logs_askpass "$askpass_helper" SUDO_PASSWORD || { 
                    echo "ensure_sudo: failed to create askpass helper" 1>&2;
                    exit 1
                };
                export SUDO_ASKPASS="$askpass_helper";
            fi;
            sudo -A env "${proxy_args[@]}" "$@" ) 9< "$rundir";
        fi;
    fi
}
ensure_tmpdir () 
{ 
    case "$1" in 
        create)
            printf -v $2 "%s" $(mktemp -d ${4:-/tmp}/openedge-cli-${3:-}.XXXXXX);
            ensure_trap "rm -rf ${!2} || ensure_sudo rm -rf ${!2}" SIGINT EXIT
        ;;
        destroy)
            rm -rf "$2";
            ensure_trap - SIGINT EXIT
        ;;
    esac
}
ensure_trap () 
{ 
    local script="$1" sig var_sig;
    shift;
    for sig in "$@";
    do
        var_sig="${sig//[^a-zA-Z0-9_]/_}";
        local -n stack="_ENSURE_TRAP_STACK_${var_sig}";
        if [[ "$script" == "-" || -z "$script" ]]; then
            if (( ${#stack[@]} > 0 )); then
                unset "stack[$((${#stack[@]} - 1))]";
                stack=("${stack[@]}");
            fi;
            if (( ${#stack[@]} == 0 )); then
                trap - "$sig";
            fi;
        else
            if [[ -z "$(trap -p "$sig")" ]]; then
                stack=();
                trap "
          _ENSURE_TRAP_IDX_${var_sig}=\$((\${#_ENSURE_TRAP_STACK_${var_sig}[@]} - 1))
          while (( _ENSURE_TRAP_IDX_${var_sig} >= 0 )); do
            eval \"\${_ENSURE_TRAP_STACK_${var_sig}[\$_ENSURE_TRAP_IDX_${var_sig}]}\"
            (( _ENSURE_TRAP_IDX_${var_sig}-- )) || true
          done
          trap - \"$sig\"
          case \"$sig\" in
            EXIT|0|ERR|RETURN|DEBUG) ;;
            *) kill -s \"$sig\" \$\$ ;;
          esac
        " "$sig";
            fi;
            stack+=("$script");
        fi;
    done
}
