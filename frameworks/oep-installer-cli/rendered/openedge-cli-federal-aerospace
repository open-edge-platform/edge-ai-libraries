    function _open_tty () 
    { 
        if [[ -e /dev/tty ]] && { 
            exec {TTY_FD}<> /dev/tty
        } 2> /dev/null; then
            return 0;
        fi;
        if [[ -t 2 ]] && { 
            exec {TTY_FD}>&2
        } 2> /dev/null; then
            return 0;
        fi;
        if [[ -t 1 ]] && { 
            exec {TTY_FD}>&1
        } 2> /dev/null; then
            return 0;
        fi;
        TTY_FD=-1;
        return 1
    };
    function _probe_geom () 
    { 
        local sz;
        if (( TTY_FD >= 0 )); then
            sz=$(stty size <&"$TTY_FD" 2> /dev/null);
            if [[ $sz == +([0-9])' '+([0-9]) ]]; then
                printf '%s %s' "${sz##* }" "${sz%% *}";
                return 0;
            fi;
        fi;
        if [[ -n ${COLUMNS:-} && -n ${LINES:-} ]]; then
            printf '%s %s' "$COLUMNS" "$LINES";
            return 0;
        fi;
        return 1
    };
    function _read_geom () 
    { 
        local c r sz;
        shopt -s checkwinsize 2> /dev/null;
        if [[ -n ${FORCE_COLS:-} ]]; then
            c=$FORCE_COLS;
            r=${FORCE_ROWS:-${LINES:-24}};
        else
            sz=$(_probe_geom) || sz="";
            if [[ -n $sz ]]; then
                c=${sz%% *};
                r=${sz##* };
            else
                c=${COLUMNS:-80};
                r=${LINES:-24};
            fi;
        fi;
        [[ $c == +([0-9]) ]] || c=80;
        [[ $r == +([0-9]) ]] || r=24;
        (( c < 40 )) && c=40;
        (( r < 10 )) && r=10;
        if (( c != TTY_COLS || r != TTY_ROWS )); then
            FULL_CLEAR=1;
            DWCACHE=();
            HRCACHE=();
            PREV=();
        fi;
        TTY_COLS=$c;
        TTY_ROWS=$r;
        GEOM_DIRTY=0
    };
    function _cellw () 
    { 
        local ch=$1 cp;
        if [[ -z $ch ]]; then
            REPLY=0;
            return;
        fi;
        if [[ $ch == [[:ascii:]] ]]; then
            REPLY=1;
            return;
        fi;
        if (( NARROW_GLYPHS )); then
            REPLY=1;
            return;
        fi;
        if [[ -n ${WCACHE[$ch]:-} ]]; then
            REPLY=${WCACHE[$ch]};
            return;
        fi;
        printf -v cp '%d' "'$ch" 2> /dev/null || cp=0;
        local w=1;
        if (( cp >= 0x1100  && cp <= 0x115F  )); then
            w=2;
        else
