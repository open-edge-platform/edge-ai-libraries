    function _dwidth () 
    { 
        local s=$1;
        if [[ -z $s ]]; then
            REPLY=0;
            return;
        fi;
        if [[ $s != *[![:ascii:]]* ]]; then
            REPLY=${#s};
            return;
        fi;
        if [[ -n ${DWCACHE[$s]:-} ]]; then
            REPLY=${DWCACHE[$s]};
            return;
        fi;
        local n=0 i;
        for ((i = 0; i < ${#s}; i++ ))
        do
            _cellw "${s:i:1}";
            n=$(( n + REPLY ));
        done;
        (( ${#DWCACHE[@]} > 4000 )) && DWCACHE=();
        DWCACHE[$s]=$n;
        REPLY=$n
    };
    TAKEN="";
    TAKENW=0;
    function _take_cells () 
    { 
        local w=$1 s=$2;
        if (( w <= 0 )) || [[ -z $s ]]; then
            TAKEN="";
            TAKENW=0;
            return;
        fi;
        if [[ $s != *[![:ascii:]]* ]]; then
            if (( ${#s} <= w )); then
                TAKEN=$s;
                TAKENW=${#s};
            else
                TAKEN=${s:0:w};
                TAKENW=$w;
            fi;
            return;
        fi;
        local n=0 i out="";
        for ((i = 0; i < ${#s}; i++ ))
        do
            _cellw "${s:i:1}";
            (( n + REPLY > w )) && break;
            out+=${s:i:1};
            n=$(( n + REPLY ));
        done;
        TAKEN=$out;
        TAKENW=$n
    };
    function _now_ms () 
    { 
        printf '%s' $(( ${EPOCHREALTIME/./} / 1000 ))
    };
    function _elapsed_ms () 
    { 
        local c=$1;
        REPLY=0;
        [[ -z $c ]] && return;
        if [[ -n ${TDONE[$c]:-} ]]; then
            REPLY=${TDONE[$c]};
            return;
        fi;
        local acc=${TACC[$c]:-0};
        if [[ -n ${TSTART[$c]:-} ]]; then
            REPLY=$(( acc + $(_now_ms) - ${TSTART[$c]} ));
        else
            REPLY=$acc;
        fi;
        (( REPLY < 0 )) && REPLY=0
    };
    function _fmt_elapsed () 
    { 
        local ms=${1:-0} s m h;
        (( ms < 0 )) && ms=0;
        s=$(( ms / 1000 ));
        if (( s < 60 )); then
            printf -v REPLY '%ds' "$s";
        else
            if (( s < 3600 )); then
                printf -v REPLY '%dm%02ds' $(( s / 60 )) $(( s % 60 ));
            else
                printf -v REPLY '%dh%02dm' $(( s / 3600 )) $(( (s % 3600) / 60 ));
            fi;
        fi
    };
    function _timer_start () 
    { 
        local c=$1;
        [[ -z $c ]] && return;
        if [[ -n ${TDONE[$c]:-} ]]; then
            TACC[$c]=${TDONE[$c]};
            unset "TDONE[$c]";
        fi;
        : "${TACC[$c]:=0}";
        TSTART[$c]=$(_now_ms);
        TSHOWN[$c]=-1;
        (( T_FIRST == 0 )) && T_FIRST=${TSTART[$c]}
    };
    function _timer_stop () 
    { 
        local c=$1;
        [[ -z $c ]] && return;
        [[ -n ${TDONE[$c]:-} ]] && return;
        [[ -z ${TSTART[$c]:-} && -z ${TACC[$c]:-} ]] && return;
        _elapsed_ms "$c";
        TDONE[$c]=$REPLY;
        unset "TSTART[$c]"
    };
    HRULE="";
    function _hrule_v () 
    { 
        local w=$1;
        (( w <= 0 )) && { 
            HRULE="";
            return
        };
        if [[ -n ${HRCACHE[$w]:-} ]]; then
            HRULE=${HRCACHE[$w]};
            return;
        fi;
        local s;
        printf -v s '%*s' "$w" '';
        HRULE=${s// /$BC_H};
        HRCACHE[$w]=$HRULE
    };
    PLAIN="";
    SGRTEXT="";
    function _sanitize_v () 
    { 
        local s=$1 keep=$2 out="" pre rest fin i ch;
        s=${s//'	'/    };
        s=${s//''/ };
        s=${s//''/ };
        s=${s//''/};
        while [[ $s == *'' ]]; do
            s=${s%''};
        done;
        [[ $s == *''* ]] && s=${s##*''};
        if [[ $s == *''* ]]; then
            while [[ $s == *''* ]]; do
                pre=${s%%''*};
                out+=$pre;
                rest=${s:${#pre}+1};
                case ${rest:0:1} in 
                    '[')
                        i=1;
                        while (( i < ${#rest} )); do
                            ch=${rest:i:1};
                            [[ $ch == $CSI_FINAL ]] && break;
                            (( i++ ));
                        done;
                        fin=${rest:i:1};
                        if (( keep )) && [[ $fin == m ]]; then
                            out+=''"${rest:0:i+1}";
                        fi;
                        s=${rest:i+1}
                    ;;
                    ']')
                        if [[ $rest == *''* ]]; then
                            s=${rest#*''};
                        else
                            if [[ $rest == *'\'* ]]; then
                                s=${rest#*'\'};
                            else
                                s="";
                            fi;
                        fi
                    ;;
                    'P' | 'X' | '^' | '_')
                        if [[ $rest == *'\'* ]]; then
                            s=${rest#*'\'};
                        else
                            s="";
                        fi
                    ;;
                    *)
                        s=${rest:1}
                    ;;
                esac;
            done;
            out+=$s;
        else
            out=$s;
        fi;
        out=${out%"${out##*[![:space:]]}"};
        if (( keep )); then
            SGRTEXT=$out;
        else
            PLAIN=$out;
        fi
    };
    function _plain_v () 
    { 
        _sanitize_v "$1" 0
    };
    FITTED="";
    function _fit_v () 
    { 
        local w=$1 raw=$2 fp=${3:-0};
        if (( w <= 0 )); then
            FITTED="";
            return;
        fi;
        _plain_v "$raw";
        local plain=$PLAIN;
        _dwidth "$plain";
        local pw=$REPLY;
        if (( ! fp && KEEP_COLOR )) && [[ $raw == *''* ]]; then
            _sanitize_v "$raw" 1;
            local c=$SGRTEXT;
            if (( pw <= w )); then
                printf -v FITTED '%s%s%*s' "$c" "$C_RESET" $(( w - pw )) '';
                return;
            fi;
            local out="" n=0 i ch seg;
            while [[ -n $c ]]; do
                if [[ ${c:0:1} == '' ]]; then
                    i=2;
                    while (( i < ${#c} )); do
                        ch=${c:i:1};
                        [[ $ch == $CSI_FINAL ]] && break;
                        (( i++ ));
                    done;
                    out+=${c:0:i+1};
                    c=${c:i+1};
                    continue;
                fi;
                seg=${c%%''*};
                c=${c:${#seg}};
                _take_cells $(( w - 1 - n )) "$seg";
                out+=$TAKEN;
                n=$(( n + TAKENW ));
                (( n >= w - 1 )) && break;
            done;
            printf -v FITTED '%s%s%s%*s' "$out" "$C_RESET" "$G_ELL" $(( w - n - 1 )) '';
            return;
        fi;
        if (( pw <= w )); then
            printf -v FITTED '%s%*s' "$plain" $(( w - pw )) '';
        else
            _take_cells $(( w - 1 )) "$plain";
            printf -v FITTED '%s%s%*s' "$TAKEN" "$G_ELL" $(( w - TAKENW - 1 )) '';
        fi
    };
    declare -a WRAPPED=();
    function _wrap_into () 
    { 
        local w=$1;
        (( w <= 0 )) && return;
        _plain_v "$2";
        local s=$PLAIN t tw brk sw row;
        if [[ -z $s ]]; then
            printf -v row '%*s' "$w" '';
            WRAPPED+=("$row");
            return;
        fi;
        while :; do
            _dwidth "$s";
            sw=$REPLY;
            if (( sw <= w )); then
                printf -v row '%s%*s' "$s" $(( w - sw )) '';
                WRAPPED+=("$row");
                return;
            fi;
            _take_cells "$w" "$s";
            t=$TAKEN;
            tw=$TAKENW;
            [[ -z $t ]] && { 
                t=${s:0:1};
                _dwidth "$t";
                tw=$REPLY
            };
            if [[ $t == *" "* && ${s:${#t}:1} != " " ]]; then
                brk=${t% *};
                if (( ${#brk} > 0 )); then
                    t=$brk;
                    _dwidth "$t";
                    tw=$REPLY;
                fi;
            else
                if [[ $t == *"/"* && ${s:${#t}:1} != " " ]]; then
                    brk=${t%/*};
                    brk=${t:0:${#brk}+1};
                    if (( ${#brk} > 1 && ${#brk} < ${#t} )); then
                        t=$brk;
                        _dwidth "$t";
                        tw=$REPLY;
                    fi;
                fi;
            fi;
            printf -v row '%s%*s' "$t" $(( w - tw )) '';
            WRAPPED+=("$row");
            s=${s:${#t}};
            [[ ${s:0:1} == " " ]] && s=${s:1};
            [[ -z $s ]] && return;
        done
    };
    function _wrap_color_into () 
    { 
        local w=$1 s=$2;
        (( w <= 0 )) && return;
        local active="" row="" n=0 seg i ch esc brk segw t tw out;
        while [[ -n $s ]]; do
            if [[ ${s:0:1} == '' ]]; then
                i=2;
                while (( i < ${#s} )); do
                    ch=${s:i:1};
                    [[ $ch == $CSI_FINAL ]] && break;
                    (( i++ ));
                done;
                esc=${s:0:i+1};
                s=${s:i+1};
                if [[ $esc == '[0m' || $esc == '[m' ]]; then
                    active="";
                else
                    active+=$esc;
                fi;
                row+=$esc;
                continue;
            fi;
            seg=${s%%''*};
            [[ -z $seg ]] && continue;
            s=${s:${#seg}};
            while :; do
                _dwidth "$seg";
                segw=$REPLY;
                if (( n + segw <= w )); then
                    row+=$seg;
                    n=$(( n + segw ));
                    break;
                fi;
                _take_cells $(( w - n )) "$seg";
                t=$TAKEN;
                tw=$TAKENW;
                [[ -z $t ]] && { 
                    t=${seg:0:1};
                    _dwidth "$t";
                    tw=$REPLY
                };
                if [[ $t == *" "* && ${seg:${#t}:1} != " " ]]; then
                    brk=${t% *};
                    if (( ${#brk} > 0 )); then
                        t=$brk;
                        _dwidth "$t";
                        tw=$REPLY;
                    fi;
                fi;
                row+=$t;
                n=$(( n + tw ));
                printf -v out '%s%s%*s' "$row" "$C_RESET" $(( w - n )) '';
                WRAPPED+=("$out");
                row=$active;
                n=0;
                seg=${seg:${#t}};
                [[ ${seg:0:1} == " " ]] && seg=${seg:1};
                [[ -z $seg ]] && break;
            done;
        done;
        printf -v out '%s%s%*s' "$row" "$C_RESET" $(( w - n )) '';
        WRAPPED+=("$out")
    };
    function _wrap_one () 
    { 
        local w=$1 line=$2;
        WRAPPED=();
        if [[ $WRAP_MODE == clip ]]; then
            _fit_v "$w" "$line";
            WRAPPED=("$FITTED");
        else
            if (( KEEP_COLOR )); then
                _wrap_color_into "$w" "$line";
            else
                _wrap_into "$w" "$line";
            fi;
        fi
    };
    SG_C="";
    SG_M="";
