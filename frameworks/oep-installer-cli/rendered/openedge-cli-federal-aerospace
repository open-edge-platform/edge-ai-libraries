    };
    function _ensure_wrap () 
    { 
        local c=$1 w=$2 src r;
        [[ -z $c ]] && return;
        [[ ${WRAPW[$c]:--1} == "$w" ]] && return;
        local acc="" n=0;
        if [[ -n ${RBUF[$c]:-} ]]; then
            while IFS= read -r src; do
                _wrap_one "$w" "$src";
                for r in "${WRAPPED[@]}";
                do
                    acc+="${r}"'
';
                    n=$(( n + 1 ));
                done;
            done <<< "${RBUF[$c]}";
        fi;
        WRAPC[$c]=$acc;
        WRAPCN[$c]=$n;
