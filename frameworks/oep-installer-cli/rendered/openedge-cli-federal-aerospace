{ 
    configure_k3s_io;
    [ "$(ensure_prop get installed/k3s_io/owned)" = "true" ] || return 0;
    local script found=0 kubeconfig=0;
    if [ -f "$HOME/.kube/config" ] && ! ensure_sudo cmp -s /etc/rancher/k3s/k3s.yaml "$HOME/.kube/config"; then
        kubeconfig=1;
    fi;
    for script in /usr/local/bin/k3s-uninstall.sh /usr/local/bin/k3s-agent-uninstall.sh;
    do
        [ -x "$script" ] || continue;
        found=1;
        echo "Removing the K3s runtime ($script)...";
