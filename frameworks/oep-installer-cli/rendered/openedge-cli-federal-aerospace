    for k, c in (d.get(sec) or {}).items():
      tgt.setdefault(k, {}).update(c or {})
proj = resolve(cli_project or file_name) or os.path.basename(os.path.dirname(os.path.abspath(paths[0])))
proj = normalize(proj)
seen = set()
def out(kind, v):
  if v is not None and (kind, v) not in seen:
    seen.add((kind, v)); print(f"{kind}:{v}")
needs_default = False
for n, s in services.items():
  if s.get("container_name"):
    out("name", resolve(s["container_name"]))
  else:
    r = resolve(s.get("scale") or (s.get("deploy") or {}).get("replicas") or 1)
    for i in range(1, (int(r) if str(r).isdigit() else 1) + 1):
      out("name", f"{proj}-{n}-{i}")
  if "network_mode" not in s and not s.get("networks"):
    needs_default = True
  for p in s["ports"]:
    for port in host_ports(p):
      out("port", port)
if needs_default: networks.setdefault("default", {})
for kind, table in (("net", networks), ("vol", volumes)):
