system_scan_check_membank () 
{ 
    local dmi_out;
    dmi_out="$(ensure_sudo dmidecode -t memory 2> /dev/null)" || return 0;
    local installed_modules=();
    mapfile -t installed_modules < <(echo "$dmi_out" | awk -v in_dev=0 '
    /^Memory Device$/ {
      if (in_dev && size !~ /No Module Installed/ && size !~ /Unknown/ && size != "") {
        print size " | Locator: " loc " | Bank: " bank
      }
      in_dev=1;size="";loc="N/A";bank="N/A"
    }
    /^[[:space:]]*Size:/ {
      tmp=$0; sub(/^[[:space:]]*Size:[[:space:]]*/,"",tmp); size=tmp
    }
    /^[[:space:]]*Locator:/ {
      tmp=$0; sub(/^[[:space:]]*Locator:[[:space:]]*/,"",tmp); loc=tmp
    }
    /^[[:space:]]*Bank Locator:/ {
      tmp=$0; sub(/^[[:space:]]*Bank Locator:[[:space:]]*/,"",tmp); bank=tmp
    }
    END {
      if (in_dev && size !~ /No Module Installed/ && size !~ /Unknown/ && size != "") {
        print size " | Locator: " loc " | Bank: " bank
      }
    }');
    local total_slots=$(echo "$dmi_out" | grep -c "^\s*Locator:" || true);
    local populated_count=${#installed_modules[@]};
    if [[ ${populated_count} -eq 0 ]]; then
        echo "Not detected";
        return 0;
    fi;
    local channels=() mod;
    for mod in "${installed_modules[@]}";
    do
        local channel_id="";
        if [[ "$mod" =~ ([Cc]ontroller[0-9]+|[Mm][Cc][0-9]+|[Nn]ode[0-9]+|[Pp][0-9]+)[_-]?([Cc][Hh][Aa][Nn][Nn]?[Ee]?[Ll]?[_-]?[[:space:]]*[A-Za-z0-9]+) ]]; then
            channel_id="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}";
        else
            if [[ "$mod" =~ [Cc][Hh][Aa][Nn][Nn]?[Ee]?[Ll]?[_-]?[[:space:]]*([A-Za-z0-9]+) ]]; then
                channel_id="Channel_${BASH_REMATCH[1]}";
            else
                if [[ "$mod" =~ Locator:[[:space:]]*[A-Za-z0-9_-]*([A-Za-z])[0-9] ]]; then
                    channel_id="Channel_${BASH_REMATCH[1]}";
                fi;
            fi;
        fi;
        [ -z "$channel_id" ] || channels+=("$channel_id");
    done;
    local uniq_channels=($(printf "%s\n" "${channels[@]}" | sort -u));
    local uniq_channel_count=${#uniq_channels[@]};
    if [[ $populated_count -eq 1 ]]; then
        echo "SINGLE-CHANNEL";
    else
        if [[ $uniq_channel_count -ge 2 ]]; then
            echo "DUAL/MULTI-CHANNELS";
        else
            if [[ ${uniq_channel_count} -eq 1 && $populated_count -gt 1 ]]; then
                echo "MISCONFIGURED SINGLE-CHANNEL";
            else
                echo "UNKNOWN";
            fi;
        fi;
    fi
}
system_scan_check_network_access () 
{ 
    local check_urls=(http://connectivity-check.ubuntu.com https://apt.repos.intel.com) url;
    for url in "${check_urls[@]}";
    do
        curl -fsSL --retry 2 --connect-timeout 10 $url > /dev/null || { 
            [[ "$url" = https://* ]] && curl -k -fsSL --connect-timeout 10 $url > /dev/null && echo "Clock skewed" || echo "$url by $(id -un)";
            return 0
        };
    done;
    echo "registry reachable"
}
system_scan_check_pci_device () 
{ 
    local deviceid=${1,,};
    local default_name="$2";
    local lspci_out="$(lspci -v -n -d $deviceid)";
    local subsystem="$(echo "$lspci_out" | grep -m1 Subsystem: | cut -f2- -d: | sed 's|^ ||g' || true)";
    if [ -n "$subsystem" ]; then
        local name="$(echo "$lspci_out" | grep -m1 DeviceName: | cut -f2- -d: | sed 's|^ ||g' || true)";
        local driver="$(echo "$lspci_out" | awk '/Kernel driver in use:/{print$NF}' || true)";
        local driver_str="";
        if [ -n "$driver" ]; then
            driver_str=$(modinfo $driver 2> /dev/null | awk '/vermagic:/{print$2}' || true);
            [ -z "$driver_str" ] || driver_str=" · driver $driver $driver_str";
        fi;
        echo "${name:-$default_name}$driver_str";
    fi
}
system_scan_get_system_summary () 
{ 
    local cpuinfo="$(grep -m1 "model name" /proc/cpuinfo | cut -f2 -d: | sed 's|^ ||g')";
    local coreinfo="$(grep "processor" /proc/cpuinfo | wc -l) cores";
    local meminfo="$(grep -m1 "MemTotal:" /proc/meminfo | cut -f2 -d: | tr -d ' ')";
    [[ "$meminfo" != *kB ]] || meminfo="$(( ${meminfo%kB} / 1024 / 1024 ))GB";
    [[ "$meminfo" != *mB ]] || meminfo="$(( ${meminfo%mB} / 1024 ))GB";
    echo "$cpuinfo · $coreinfo · $meminfo RAM"
}
uav_mission_compute_sdk_checkout () 
{ 
    if [[ -e "$source_path" || -L "$source_path" ]]; then
        if [[ -L "$source_path" || ! -d "$source_path/.git" ]]; then
            echo "Refusing incompatible SDK source destination: $source_path" 1>&2;
            return 1;
        fi;
        local remote changes;
        remote="$(git -C "$source_path" remote get-url origin)" || return $?;
        changes="$(git -C "$source_path" status --porcelain --untracked-files=no)" || return $?;
        if [[ "$remote" != "$repository" || -n "$changes" ]]; then
            echo "Refusing to overwrite a different repository or tracked local changes at $source_path." 1>&2;
            return 1;
        fi;
        if [ -n "$(ensure_prop get started/uav_mission_compute_sdk/ports)" ]; then
            echo "Stop uav_mission_compute_sdk before updating its source." 1>&2;
            return 1;
        fi;
        git -C "$source_path" sparse-checkout init --cone || return $?;
        git -C "$source_path" sparse-checkout set uav-mission-compute-sdk || return $?;
    else
        mkdir -p "$workspace";
        git clone --filter=blob:none --no-checkout --depth 1 "$repository" "$source_path" || return $?;
        git -C "$source_path" sparse-checkout init --cone || return $?;
        git -C "$source_path" sparse-checkout set uav-mission-compute-sdk || return $?;
    fi;
    git -C "$source_path" fetch --depth 1 origin "$version" && git -C "$source_path" checkout --detach FETCH_HEAD || return $?
}
