ensure_ports_open () 
{ 
    local act_name="${1:?}";
    local name="${2:?}";
    shift 2;
    case "$act_name" in 
        install)
            ensure_prop set installed/$name/ports "$*"
        ;;
        start)
            ensure_prop set started/$name/ports "$*"
        ;;
    esac;
    if command -v ss > /dev/null; then
        local port out stopper mname mpath;
        for port in $*;
        do
            out="$(ss -Hltunp "sport = :$port")";
            [ -n "$out" ] || continue;
            printf "${red}Port %s is occupied${reset}\n" "$port" 1>&2;
            for mpath in $(ensure_prop find "installed/*/ports") $(ensure_prop find "started/*/ports");
            do
                [[ " $(ensure_prop get $mpath) " = *" $port "* ]] || continue;
                mname="${mpath#*/}";
