    function _set_step () 
    { 
        STEP_TEXT=$1
    };
    function _clear_step () 
    { 
        STEP_TEXT=""
    };
    function _add_step_rule () 
    { 
        local spec=$1 rx fmt;
        [[ $spec == *' @@THEN '* ]] || return 1;
        rx=${spec%%' @@THEN '*};
        fmt=${spec#*' @@THEN '};
        [[ -z $rx ]] && return 1;
        [[ x =~ $rx ]];
        (( $? == 2 )) && return 1;
        STEP_RX+=("$rx");
        STEP_FMT+=("$fmt")
    };
    function _clear_step_rules () 
    { 
        STEP_RX=();
        STEP_FMT=()
    };
    function _apply_step_rules () 
    { 
        (( ${#STEP_RX[@]} == 0 )) && return 1;
        local s=$1 i j out;
        for ((i = 0; i < ${#STEP_RX[@]}; i++ ))
        do
            if [[ $s =~ ${STEP_RX[i]} ]]; then
                out=${STEP_FMT[i]};
                for ((j = ${#BASH_REMATCH[@]} - 1; j >= 0; j-- ))
                do
                    out=${out//"\\$j"/"${BASH_REMATCH[j]}"};
                done;
                _set_step "$out";
                return 0;
            fi;
        done;
        return 1
    };
    TITLEROW="";
    function _title_row () 
    { 
        local w=$1 tw sw room left;
        _fit_v "$w" "$TITLE" 1;
