}
ensure_columns () 
{ 
    local sep=${1:-'|'};
    python3 -c '
import sys,re
ansi_re = re.compile(r"\x1b\[[0-9;]*[a-zA-Z]|\033\[[0-9;]*[a-zA-Z]")
rows=[line.strip().split(sys.argv[1]) for line in sys.stdin]
if not rows: sys.exit(0)
cols=max(len(r) for r in rows)
widths=[max((len(ansi_re.sub("",r[c])) for r in rows if c < len(r)-1),default=0) for c in range(cols-1)]
for r in rows:
  print((" "*2).join([r[i]+(" "*max(0,widths[i]-len(ansi_re.sub("",r[i])))) for i in range(len(r)-1)]+[r[-1]]))
' "$sep"
}
ensure_disk_size () 
{ 
    local disk_size=$1;
    local disk_path="${2:-$HOME}";
    local disk_avail=$(df -B1 --output=avail "$disk_path" | awk 'NR==2{print int($1/1000000)}');
    if [ "$disk_size" -gt "$disk_avail" ]; then
        echo "Not enough disk space: required ${disk_size} MB and available ${disk_avail} MB" 1>&2;
        return 3;
    fi
}
ensure_fetch () 
{ 
    local url="$1" dest="${2:-?}" html="${3:-}";
    local rc=1 first tmp_dir i;
    ensure_tmpdir create tmp_dir fetch || return 1;
    local tmp_file="$tmp_dir/download";
    for i in {1..5};
    do
        [ $i -eq 1 ] || sleep 5;
        if command -v curl > /dev/null 2>&1; then
            curl -fsSL --retry 3 --retry-delay 5 -A Mozilla/5.0 -o "$tmp_file" "$url" && rc=0 || rc=$?;
        else
            if command -v wget > /dev/null 2>&1; then
                wget -q -t 3 -w 5 -O "$tmp_file" "$url" && rc=0 || rc=$?;
            else
                if command -v python3 > /dev/null 2>&1; then
                    python3 - "$url" > "$tmp_file" <<'PY' && 
import sys, shutil, urllib.request
with urllib.request.urlopen(sys.argv[1], timeout=60) as r:
  shutil.copyfileobj(r, sys.stdout.buffer)
PY
 rc=0 || rc=$?;
                else
                    echo "ensure_fetch: no curl, wget, or python3 available" 1>&2;
                    rc=127;
                    break;
                fi;
            fi;
        fi;
        if [ "$rc" -eq 0 ] && [ -s "$tmp_file" ]; then
            [ "$html" != "--html" ] || break;
            first=$(head -c 512 "$tmp_file" 2> /dev/null | tr -d '\0') || true;
            case "${first,,}" in 
                *"<!doctype html"* | *"<html"*)

                ;;
                *)
                    break
                ;;
            esac;
        fi;
        rc=1;
        rm -f "$tmp_file";
    done;
    if [ "$rc" -eq 0 ]; then
        if [ "$dest" = "-" ]; then
            cat "$tmp_file" && rc=0 || rc=$?;
        else
            { 
                cp -f "$tmp_file" "$dest" 2> /dev/null || ensure_sudo cp -f "$tmp_file" "$dest"
            } && rc=0 || rc=$?;
        fi;
    else
        echo "ensure_fetch: giving up on $url" 1>&2;
    fi;
    ensure_tmpdir destroy "$tmp_dir" || true;
    return "$rc"
}
ensure_git_clone () 
{ 
    local workspace="$1";
    local version="$2";
    local repository="$3";
    ensure_rm "$workspace";
    mkdir -p "$(dirname "$workspace")";
    if [ ${#@} -ge 4 ]; then
        mkdir -p "$workspace";
        pushd "$workspace" > /dev/null;
        git clone --filter=blob:none --no-checkout $repository .;
        git sparse-checkout init --cone;
        git sparse-checkout set "${@:4}";
        git checkout $version;
        popd > /dev/null;
    else
        mkdir -p "$workspace";
        pushd "$workspace" > /dev/null;
        git init -q;
        git remote add origin "$repository";
        git fetch --depth 1 origin "$version";
        git checkout -q FETCH_HEAD;
        [ ! -e .gitmodules ] || git submodule update --init --recursive;
        popd > /dev/null;
    fi
}
ensure_git_export () 
{ 
    ensure_git_clone "$@";
    ensure_rm "$1"/.git
}
ensure_group_add () 
{ 
    local group1 gid1;
    for group1 in "$@";
    do
        case "$group1" in 
            *:)
                gid1="--system"
            ;;
            *:*)
                gid1="--system --gid ${group1#*:}";
                getent group ${group1%:*} > /dev/null 2>&1 || [ -z "$(getent group ${gid1##* })" ] || { 
                    echo "gid ${gid1##* } is taken" 1>&2;
                    gid1="--system"
                }
            ;;
            *)
                gid1=""
            ;;
        esac;
        getent group ${group1%:*} > /dev/null 2>&1 || ensure_sudo groupadd $gid1 ${group1%:*};
        id -nG | tr ' ' '\n' | grep -qx ${group1%:*} || ensure_sudo usermod -aG ${group1%:*} "$(id -un)";
    done;
    local deadline=$((SECONDS + 30));
    local flushed=0 missing;
    while :; do
        missing="";
        for group1 in "$@";
        do
            id -G "$(id -un)" | tr ' ' '\n' | grep -qx "$(getent group ${group1%:*} | cut -f3 -d:)" || missing+=" ${group1%:*}";
        done;
        [ -n "$missing" ] || return 0;
        if [ $flushed -eq 0 ]; then
            flushed=1;
            command -v nscd > /dev/null && ensure_sudo nscd -i group > /dev/null 2>&1;
            command -v sss_cache > /dev/null && ensure_sudo sss_cache -G > /dev/null 2>&1;
            continue;
        fi;
        [ $SECONDS -ge $deadline ] && { 
            echo -e "${red}groups not visible:${missing}${reset}" 1>&2;
            return 1
        };
        sleep 1;
    done
}
ensure_grub_set_default_entry () 
{ 
    local kver="$1";
    ensure_sudo sed -i -e '/^GRUB_TOP_LEVEL=/d' -e 's/^GRUB_DEFAULT=.*/GRUB_DEFAULT=0/' /etc/default/grub;
    echo "GRUB_TOP_LEVEL=/boot/vmlinuz-$kver" | ensure_sudo tee -a /etc/default/grub > /dev/null;
    ensure_sudo update-grub;
    ensure_sudo grep -m1 -E '^\s*linux\s' /boot/grub/grub.cfg | grep -q "vmlinuz-$KVER" || { 
        ensure_sudo sed -i 's/^GRUB_DEFAULT=.*/GRUB_DEFAULT=saved/' /etc/default/grub;
        ensure_sudo update-grub;
        local SUBMENU="$(ensure_sudo grep -rn GRUB_DISABLE_SUBMENU=y /etc/default/grub /etc/default/grub.d/ 2> /dev/null)";
        local SUB="$(ensure_sudo grep -om1 "gnulinux-advanced-[^']*" /boot/grub/grub.cfg)";
        local ENTRY="$(ensure_sudo grep -om1 "gnulinux-$kver-advanced-[^']*" /boot/grub/grub.cfg)";
        if [ -n "$SUBMENU" ]; then
            ensure_sudo grub-set-default "$ENTRY";
        else
            ensure_sudo grub-set-default "$SUB>$ENTRY";
        fi
    }
}
ensure_grub_set_kernel_args () 
{ 
    local k="$1";
    shift;
    local line="$(. /etc/default/grub; printf "%s" "${!k}")" o;
    for o in "$@";
    do
        [[ " $line " == *" $o "* ]] || line="$line $o";
    done;
    ensure_sudo sed -i "s|^$k=.*|$k=\"$line\"|" /etc/default/grub;
    ensure_sudo update-grub
}
ensure_hf_token () 
{ 
    local models=($*);
    export HF_TOKEN;
    [ -n "$HF_TOKEN" ] || [ ! -r "$HOME"/.cache/huggingface/token ] || export HF_TOKEN="$(< "$HOME"/.cache/huggingface/token)";
    [ -n "$HF_TOKEN" ] || [ ! -r "$HOME"/.vscode/launch.json ] || export HF_TOKEN="$(grep -m1 -F '"HF_TOKEN":' "$HOME"/.vscode/launch.json)";
    if ! ensure_hf_token_check_models "$@"; then
        [ -z "$HF_TOKEN" ] || { 
            echo "Invalid or unauthroized HF_TOKEN" 1>&2;
            return 3
        };
        echo -e "${red}HF_TOKEN requried for downloading the following models:{reset}" 1>&2;
        echo "$*" 1>&2;
        local rundir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}";
        [ -d "$rundir" ] && [ -w "$rundir" ] || rundir="$(ensure_project_path)/${installer_name:?}";
        mkdir -p "$rundir" 2> /dev/null || return 1;
        { 
            flock -w 300 -e 9 || { 
                echo "ensure_hf_token: timed out waiting for another installer" 1>&2;
                return 1
            };
            local askpass_helper="$rundir"/askpass-hftoken;
            act_panelled_logs_askpass "$askpass_helper" HF_TOKEN || { 
                echo "ensure_hf_token: failed to create askpass helper" 1>&2;
                return 1
            };
            export HF_TOKEN="$("$askpass_helper" 'HF_TOKEN:' | tr -d '\n')"
        } 9< "$rundir";
        if [[ -n "$HF_TOKEN" && ! -e "$HOME"/.cache/huggingface/token ]]; then
            mkdir -p "$HOME"/.cache/huggingface;
            ( umask 0077;
            echo "$HF_TOKEN" > "$HOME"/.cache/huggingface/token );
        fi;
        ensure_hf_token_check_models "$@";
    fi
}
ensure_hf_token_check_models () 
{ 
    local models=("$@");
    local model f;
    for model in ${models[*]};
    do
        local probes=();
        for f in $(curl -s -L "https://huggingface.co/api/models/${model}?full=tree" | tr ',' '\n' | grep -F '"rfilename":' | cut -f4 -d'"');
        do
            case "$f" in 
                *config.yaml | *config.json | *tokenizer.json)
                    probes+=($f);
                    break
                ;;
            esac;
        done;
        if [ ${#probes[*]} -eq 0 ]; then
            echo "No probe found with $model" 1>&2;
            return 3;
        fi;
        for f in ${probes[*]};
        do
            local code=$(curl -s -o /dev/null -w "%{http_code}" -L -r 0-0 -H "Authorization: Bearer $HF_TOKEN" https://huggingface.co/${model}/resolve/main/$f);
            case "$code" in 
                200 | 206)
                    continue
                ;;
                401 | 403 | 404)
                    echo "gated model: $model" 1>&2;
                    return 1
                ;;
                *)
                    echo "Unknown probe code $code" 1>&2;
                    return 3
                ;;
            esac;
        done;
    done;
    return 0
}
ensure_ip () 
{ 
    ip -4 addr show scope global | sed -n '/^[0-9]*:.*state UP/,/^[0-9]*:/{/^ *inet /{s|.*inet \([0-9.]*\).*|\1|;p}}' | head -n1
}
ensure_parse_device () 
{ 
    local device="cpu";
    local args_uc=" ${*^^} ";
    [ ! -e /dev/accel/accel0 ] || device="npu";
    [ ! -e /dev/dri/renderD128 ] || device="gpu";
    [[ "$args_uc" != *" --CPU "* ]] || device="cpu";
    [[ "$args_uc" != *" --NPU "* ]] || [ ! -e /dev/accel/accel0 ] || device="npu";
    [[ "$args_uc" != *" --GPU "* ]] || [ ! -e /dev/dri/renderD128 ] || device="gpu";
    echo $device
}
ensure_parse_value_option () 
{ 
    local key="$1";
    shift;
    local v v1 value="";
    for v in $*;
    do
        case "$v" in 
            "--$key="*)
                value="${v#*=}"
            ;;
            "--$key")

            ;;
            *)
                if [ "$v1" = "--$key" ]; then
                    value="$v";
                    v="";
                fi
            ;;
        esac;
        v1="$v";
    done;
    echo "$value"
}
ensure_ports_open () 
{ 
    local act_name="${1:?}";
    local name="${2:?}";
    shift 2;
    if [ "$act_name" = "start" ]; then
        ensure_prop set started/$name/ports "$*";
    fi;
    if command -v ss > /dev/null; then
        local port out stopper;
        for port in $*;
        do
            out="$(ss -Hltunp "sport = :$port")";
            [ -n "$out" ] || continue;
            printf "${red}Port %s is occupied${reset}\n" "$port" 1>&2;
            for mname in $(ensure_prop find "started/*/ports" | cut -f2 -d/);
            do
                [[ " $(ensure_prop get started/$mname/ports) " = *" $port "* ]] || continue;
                stopper="${_act_cache_functions[stop_$mname]:-}";
                [ -n "$stopper" ] || continue;
                printf "${red}Stopping $mname to release port %s${reset}\n" "$port" 1>&2;
                ( set -e;
                $stopper "$mname" -- ) 1>&2 || true;
            done;
            out="$(ss -Hltunp "sport = :$port")";
            [ -n "$out" ] || continue;
            printf "${red}Port %s is occupied${reset}\n%s\n" "$port" "$out" 1>&2;
            return 3;
        done;
    else
        printf "${red}Missing ss on the system${reset}\n" 1>&2;
        return 1;
    fi
}
ensure_project_path () 
{ 
    echo "$HOME/.local/open-edge-platform"
}
ensure_prop () 
{ 
    local op="$1" key_path="${2:?}" value="${3:-}";
    local key_base="$(ensure_project_path)/${installer_name:?}";
    case "$op" in 
        set)
            ( umask 077;
            printf '%s' "$value" > "$key_base/$key_path" )
        ;;
        get)
            [ -r "$key_base/$key_path" ] && cat "$key_base/$key_path" || printf '%s' "$value"
        ;;
        find)
            ( cd "$key_base" && find . -ipath "./$key_path" -print 2> /dev/null | cut -f2- -d/ )
        ;;
        create)
            mkdir -m 700 -p "$key_base/${key_path%/*}"
        ;;
        remove)
            if [ -f "$key_base/$key_path" ]; then
                rm -f "$key_base/$key_path";
            else
                if [[ "$key_path" = */ && -d "$key_base/${key_path%/}" ]]; then
                    rm -rf "$key_base/${key_path%/}";
                fi;
            fi
        ;;
    esac
}
ensure_ram_size () 
{ 
    local ram_size=$1;
    local mem_total=$(awk '/^MemTotal:/{print$2}' /proc/meminfo);
    if [ "$ram_size" -gt "$mem_total" ]; then
        echo "Not enough RAM: required ${ram_size} KiB and available ${mem_total} KiB" 1>&2;
        return 3;
    fi;
    local swap_size=${2:-0};
    local swap_total=$(awk '/^SwapTotal:/{print$2}' /proc/meminfo);
    if [ "$(( ram_size + swap_size ))" -gt "$(( mem_total + swap_total ))" ]; then
        echo "Not enough RAM or swap space:" 1>&2;
        echo " required swap ${swap_size} KiB and available ${swap_total} KiB" 1>&2;
        echo " required mem+swap $(( ram_size + swap_size )) KiB and available $(( mem_total + swap_total )) KiB" 1>&2;
        return 3;
    fi
}
ensure_rm () 
{ 
    local p norm rc=0;
    local protected=" / /bin /boot /dev /etc /home /lib /lib64 /media /mnt /opt /proc /root /run /sbin /srv /sys /tmp /usr /var /etc/apt /etc/apt/keyrings /etc/apt/preferences.d /etc/apt/sources.list.d /etc/systemd /etc/systemd/system /usr/bin /usr/lib /usr/local /usr/share /usr/share/keyrings /var/lib $HOME $HOME/.local $HOME/.local/bin ";
    for p in "$@";
    do
        [ -n "$p" ] || continue;
        norm="$(realpath -m -s -- "$p")";
        if [[ "$protected" = *" $norm "* ]]; then
            echo "ensure_rm: refusing to remove protected path '$p'" 1>&2;
            return 3;
        fi;
        [ -e "$norm" ] || [ -L "$norm" ] || continue;
        rm -rf -- "$norm" 2> /dev/null || ensure_sudo rm -rf -- "$norm" || rc=$?;
    done;
    return $rc
}
ensure_sbom_format () 
{ 
    local key=$1;
