system_scan_check_membank () 
{ 
    local dmi_out;
    dmi_out="$(ensure_sudo dmidecode -t memory 2> /dev/null)" || return 0;
    local installed_modules=();
    mapfile -t installed_modules < <(echo "$dmi_out" | awk -v in_dev=0 '
    /^Memory Device$/ {
      if (in_dev && size !~ /No Module Installed/ && size !~ /Unknown/ && size != "") {
        print size " | Locator: " loc " | Bank: " bank
      }
      in_dev=1;size="";loc="N/A";bank="N/A"
    }
    /^[[:space:]]*Size:/ {
      tmp=$0; sub(/^[[:space:]]*Size:[[:space:]]*/,"",tmp); size=tmp
    }
    /^[[:space:]]*Locator:/ {
      tmp=$0; sub(/^[[:space:]]*Locator:[[:space:]]*/,"",tmp); loc=tmp
    }
    /^[[:space:]]*Bank Locator:/ {
      tmp=$0; sub(/^[[:space:]]*Bank Locator:[[:space:]]*/,"",tmp); bank=tmp
    }
    END {
      if (in_dev && size !~ /No Module Installed/ && size !~ /Unknown/ && size != "") {
        print size " | Locator: " loc " | Bank: " bank
      }
    }');
    local total_slots=$(echo "$dmi_out" | grep -c "^\s*Locator:" || true);
    local populated_count=${#installed_modules[@]};
    if [[ ${populated_count} -eq 0 ]]; then
        echo "Not detected";
        return 0;
    fi;
    local channels=() mod;
    for mod in "${installed_modules[@]}";
    do
        local channel_id="";
        if [[ "$mod" =~ ([Cc]ontroller[0-9]+|[Mm][Cc][0-9]+|[Nn]ode[0-9]+|[Pp][0-9]+)[_-]?([Cc][Hh][Aa][Nn][Nn]?[Ee]?[Ll]?[_-]?[[:space:]]*[A-Za-z0-9]+) ]]; then
            channel_id="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}";
        else
            if [[ "$mod" =~ [Cc][Hh][Aa][Nn][Nn]?[Ee]?[Ll]?[_-]?[[:space:]]*([A-Za-z0-9]+) ]]; then
                channel_id="Channel_${BASH_REMATCH[1]}";
            else
                if [[ "$mod" =~ Locator:[[:space:]]*[A-Za-z0-9_-]*([A-Za-z])[0-9] ]]; then
                    channel_id="Channel_${BASH_REMATCH[1]}";
                fi;
            fi;
        fi;
        [ -z "$channel_id" ] || channels+=("$channel_id");
    done;
    local uniq_channels=($(printf "%s\n" "${channels[@]}" | sort -u));
    local uniq_channel_count=${#uniq_channels[@]};
    if [[ $populated_count -eq 1 ]]; then
        echo "SINGLE-CHANNEL";
    else
        if [[ $uniq_channel_count -ge 2 ]]; then
            echo "DUAL/MULTI-CHANNELS";
        else
            if [[ ${uniq_channel_count} -eq 1 && $populated_count -gt 1 ]]; then
                echo "MISCONFIGURED SINGLE-CHANNEL";
            else
                echo "UNKNOWN";
            fi;
        fi;
    fi
}
