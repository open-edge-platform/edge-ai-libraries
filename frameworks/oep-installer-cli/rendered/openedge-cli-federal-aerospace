    [ -n "$docker_ver" ] || pass="${nok} Missing Docker";
    echo -e "Docker|$docker_ver|$pass";
    [ "$pass" = "$ok" ] || echo -e "@@HIGHLIGHT Docker|$docker_ver|$pass" 1>&2;
    net_pass=$ok;
    net_access="$(system_scan_check_network_access)";
    [[ "$net_access" = *reachable* ]] || { 
        [[ "$net_access" = *skewed* ]] && net_pass="${nok/MSG/Check DateTime}" || net_pass="${nok/MSG/Check Proxies}"
    };
    echo -e "Network|$net_access|$net_pass";
    [ "$net_pass" = "$ok" ] || echo -e "@@HIGHLIGHT Network|$net_access|$net_pass" 1>&2;
    echo;
    echo "Accelerators:";
    pass=$ok;
    cpuinst_info="$(system_scan_check_cpu_instructions)";
    [[ "$cpuinst_info" != *Missing* ]] || pass="${nok/MSG/Check CPU}";
    echo -e "CPU|$cpuinst_info|$pass";
    [ "$pass" = "$ok" ] || echo -e "@@HIGHLIGHT CPU|$cpuinst_info|$pass";
    for accel in $(lspci -d 8086::0300 -n | cut -f3 -d' ');
    do
        pass=$ok;
        accel_info="$(system_scan_check_pci_device $accel "Intel Integrated Graphics")";
        if [ -n "$accel_info" ]; then
            [[ "$accel_info" = *driver* ]] || pass="${nok/MSG/Missing Driver}";
            echo -e "GPU|$accel_info|$pass";
            [ "$pass" = "$ok" ] || echo -e "@@HIGHLIGHT GPU|$accel_info|$pass" 1>&2;
        fi;
    done;
    for accel in $(lspci -d 8086::1200 -n | cut -f3 -d' ');
    do
        pass=$ok;
        accel_info="$(system_scan_check_pci_device $accel "Intel AI Boost")";
        if [ -n "$accel_info" ]; then
            [[ "$accel_info" = *driver* ]] || pass="${nok/MSG/Missing Driver}";
            echo -e "NPU|$accel_info|$pass";
            [ "$pass" = "$ok" ] || echo -e "@@HIGHLIGHT NPU|$accel_info|$pass" 1>&2;
        fi;
    done;
    echo "----------------------------------------------------------------";
    [ "$net_pass" = "$ok" ] ) | ensure_columns
}
