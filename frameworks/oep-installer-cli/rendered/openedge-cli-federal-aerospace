    HDRTXT="";
    function _header_text () 
    { 
        local name=$1;
        HDRTXT="";
        [[ -z $name ]] && return;
        _sg "${STATUS[$name]:-}";
        _elapsed_ms "$name";
        local ms=$REPLY;
        if (( ms <= 0 )) && [[ -z ${TDONE[$name]:-} ]]; then
            HDRTXT="${name} [${SG_L}]";
            return;
        fi;
        _fmt_elapsed "$ms";
        if [[ -z $REPLY ]]; then
            HDRTXT="${name} [${SG_L}]";
        else
            HDRTXT="${name} [${SG_L}, ${REPLY}]";
        fi
    };
    TITLE="";
    function _title_text () 
    { 
        local final=${1:-0} word=${2:-completed} name nok=0 nbad=0;
        TITLE=" ${ACT_TEXT[0]} progress ";
        if (( final )); then
            for name in "${ORDER[@]}";
            do
                [[ -z $name ]] && continue;
                [[ -n ${REPORT[$name]:-} ]] && continue;
                case ${STATUS[$name]:-} in 
                    ok)
                        nok=$(( nok + 1 ))
                    ;;
                    fail)
                        nbad=$(( nbad + 1 ))
                    ;;
                esac;
            done;
            TITLE=" ${ACT_TEXT[0]} ${word}:  ${G_OK} ${nok}  ${G_FAIL} ${nbad}";
        fi;
        if (( T_FIRST > 0 )); then
            local endms=$T_LAST;
            (( endms == 0 )) && endms=$(_now_ms);
            _fmt_elapsed $(( endms - T_FIRST ));
            [[ -n $REPLY ]] && TITLE+="  ${REPLY}";
        fi
    };
    function _note_width () 
    { 
