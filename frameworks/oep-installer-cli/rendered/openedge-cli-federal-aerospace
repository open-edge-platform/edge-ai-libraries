#!/bin/bash

main () {
  if [ -z "$HOME" ]; then
    echo "\$HOME must be set" >&2
    return 3
  fi

  red="\033[31m" green="\033[32m" yellow="\033[33m" reset="\033[0m"
  installer_name=openedge-cli
  installer_bin="$HOME/.local/bin/$installer_name"

  . /etc/os-release
  installer_family="$(x="${ID_LIKE:-$ID}";x="${x##* }";echo "${x//[^a-zA-Z0-9]/}")"

  local _globals=() _cmds=() _args=() cur=-1 v
  for v in "$@"; do
    case $v in
    --help)
      if [ $cur -ge 0 ]; then
        subcommand_${_cmds[$cur]} --help
      else
        _cmds=($(declare -F | grep " subcommand_" | cut -f2- -d_))
        echo "Usage: <$(IFS='|';echo "${_cmds[*]}")> component [component...]"
        echo "common options:"
        echo "  --help          this help message." 
        echo
        local cmd
        for cmd in $(declare -F | grep -E " subcommand_" | cut -f3 -d' '); do
          $cmd --help
        done
      fi
      return 0
      ;;
    --dry-run|--continue)
      _globals+=($v)
      ;;
    *)
      if declare -F subcommand_$v > /dev/null; then
        _cmds+=($v); _args+=(""); cur=$((cur+1))
      elif [ ${#_cmds[@]} -eq 0 ]; then
        echo "Unknown command: $v"
        exit 3
      elif [ $cur -ge 0 ]; then
        _args[$cur]="${_args[$cur]} $v"
      fi
      ;;
    esac
  done

  # --help if nothing specified
  if [ ${#_cmds[@]} -eq 0 ]; then
    main --help
    return 0
  fi

  # initialize act cache
  declare -F act_get > /dev/null && act_get init

  local _i _rc=0
  for ((_i=0;_i<${#_cmds[*]};_i++)); do
    case "${_cmds[$_i]}" in
    setup|list|bootstrap|sbom|resume)
      subcommand_${_cmds[$_i]} ${_globals[*]} ${_args[$_i]}
      _rc=$?
      ;;
    *)
      if [[ " ${_globals[*]} " = *" --dry-run "* ]]; then
        subcommand_${_cmds[$_i]} ${_globals[*]} ${_args[$_i]}
        _rc=$?
      else
        # save args for resume
        ensure_prop set command "$*"

        # critical group permissions
        local -A _groups=()
	local _j _dep _g _gf _deps _resolved _rest_args=() _restart=0 _m _carry=""
        for ((_j=$_i;_j<${#_cmds[@]};_j++)); do
          _rest_args+=(${_cmds[$_j]} ${_args[$_j]})
	  # pass module names forward within this command line so groups are checked against actual use
          _m="$(act_extract_modules ${_cmds[$_j]} ${_args[$_j]})"
          [ -n "${_m// }" ] && _carry="$_m"
          if [ -z "${_m// }" ] && [ -n "$_carry" ] && [ "${_cmds[$_j]}" != "stop" ] && ! [[ "${_cmds[$_j]}" = "remove" && " ${_args[$_j]} " = *" --remove-all "* ]]; then
            _resolved=(${_globals[*]} $_carry ${_args[$_j]})
          else
            _resolved=($(act_resolve_args ${_cmds[$_j]} ${_globals[*]} ${_args[$_j]}))
          fi
	  _deps=($(act_find_deps install ${_resolved[*]}))
          for _dep in ${_deps[*]}; do
            _gf=${_dep/_install_/_group_}
            declare -F $_gf > /dev/null 2>&1 || continue
            for _g in $($_gf $(act_extract_args group ${_dep#*_*_*_} "${_deps[*]#${installer_family}_*_install_}" ${_resolved[*]})); do
              _groups["$_g"]=1
            done
          done
        done

        [ ${#_groups[*]} -eq 0 ] || ensure_group_add ${!_groups[*]} || {
          echo -e "${red}Failed to acquire required groups; aborting.${reset}" 1>&2
          echo "If '$(id -un)' is a directory (LDAP/AD) account, local group membership" 1>&2
          echo "may not apply. Ask your administrator to add: ${!_groups[*]}" 1>&2
          return 3
        }

        for _dep in ${!_groups[*]}; do
          [[ " $(id -nG) " == *" ${_dep%:*} "* ]] || { _restart=1; break; }
        done

        if [ $_restart -eq 0 ]; then
          subcommand_${_cmds[$_i]} ${_globals[*]} ${_args[$_i]}
          _rc=$?
        else
          if [ -n "${OEP_GROUP_REEXEC:-}" ]; then
            echo -e "${yellow}groups still not effective after re-exec${reset}" 1>&2
            return 1
          fi

          [[ " ${_cmds[*]:0:$_i} " = *" setup "* ]] || subcommand_setup "${_globals[@]}"

          [ -x "$installer_bin" ] || {
            echo -e "${red}$installer_bin not found; run 'setup' first${reset}" 1>&2
            return 3
          }

          local _sdir="" _sdir_secrets
          ensure_tmpdir create _sdir secrets /dev/shm
          local _sdir_secrets="$_sdir"/secrets
          (
            umask 077;
            export OEP_GROUP_REEXEC=1
            for e in $(compgen -e | grep -Ev '^BASH_FUNC_|^(SHELLOPTS|BASHOPTS|BASH_ENV|ENV)$'); do
              printf "export %s=%q\n" "$e" "${!e}"
            done > "$_sdir_secrets"
          ) || { echo "Failed to write secrets" >&2; return 3; }
          ensure_sudo setpriv --reuid "$(id -u)" --regid "$(id -g)" --groups "$(id -G "$(id -un)" | tr ' ' ',')" \
            --inh-caps=-all bash -c '
secrets="$1"; installer_bin="$2"; shift 2
. "$secrets"; rm -f "$secrets"
exec "$installer_bin" "$@"
' bash "$_sdir_secrets" "$installer_bin" "${_rest_args[@]}" "${_globals[@]}"
          _rc=$?
          ensure_tmpdir destroy "$_sdir"
          return $_rc
        fi
      fi
      ;;
    esac
    [ $_rc -eq 0 ] || [[ " ${_globals[*]} " = *" --continue "* ]] || break
  done
  return $_rc
}

#### COLLECTION OF MODULES ####

_act_levenshtein () 
{ 
    local a=$1 b=$2 la=${#1} lb=${#2} i j cost d ins sub;
    local -a prev=() cur=();
    for ((j=0; j<=lb; j++))
    do
        prev[j]=$j;
    done;
    for ((i=1; i<=la; i++))
    do
        cur=($i);
        for ((j=1; j<=lb; j++))
        do
            [ "${a:i-1:1}" = "${b:j-1:1}" ] && cost=0 || cost=1;
            d=$((prev[j]+1));
            ins=$((cur[j-1]+1));
            sub=$((prev[j-1]+cost));
            ((ins < d)) && d=$ins;
            ((sub < d)) && d=$sub;
            cur[j]=$d;
        done;
        prev=("${cur[@]}");
    done;
    echo "${prev[lb]}"
}
act_expand_modules () 
{ 
    local act_name=${1%%,*};
    local -a q=($2);
    local -A seen=();
    local i=0;
    while [ $i -lt ${#q[*]} ]; do
        local n=${q[$i]};
        i=$((i+1));
        [ -z "${seen[$n]:-}" ] || continue;
        seen[$n]=1;
        local p="${_act_cache_functions[profile_$n]:-}";
        [ -n "$p" ] && q+=($($p $act_name $(act_extract_args $act_name $n "${q[*]}" "${@:3}")));
    done;
    echo "${!seen[*]}"
}
act_extract_args () 
{ 
    local act_name=${1%%,*};
    local module_name=$2;
    local act_modules="$3";
    local all_modules=(${_act_cache_names[*]:-${_act_cache_modules[*]}});
    local all_module_args=" ${all_modules[*]/#/--} ";
    local args1=() args2=() i j;
    for ((i=4; i<=${#@}; i++))
    do
        if [[ " ${all_module_args} " = *" ${*:$i:1} "* ]]; then
            for ((j=++i; j<=${#*}; j++))
            do
                [[ " ${all_module_args} " != *" ${*:$j:1} "* ]] || break;
            done;
            [ "${*:$((i-1)):1}" != "--${module_name}" ] || args2+=(${*:$i:$((j-i))});
            i=$((j-1));
        else
            if [[ " ${all_module_args} " != *" --${*:$i:1} "* ]]; then
                args1+=(${*:$i:1});
            fi;
        fi;
    done;
    echo "${args1[*]} ${act_modules} -- ${args2[*]}"
}
act_extract_modules () 
{ 
    local act_name=${1%%,*};
    local all_modules=(${_act_cache_names[*]:-${_act_cache_modules[*]}});
    local all_module_args=" ${all_modules[*]/#/--} ";
    local -A modules=();
    local v;
    for v in ${*:2};
    do
        [[ " ${all_module_args} " != *" $v "* ]] || break;
        [[ " ${all_module_args} " != *" --$v "* ]] || modules[$v]=1;
    done;
    echo "${!modules[*]}"
}
act_find_deps () 
{ 
    local act_name=${1%%,*};
    local -A handlers=();
    local name handler;
    for name in $(act_expand_modules $act_name "$(act_extract_modules "$@")" "${@:2}");
    do
        local p="${_act_cache_functions[${act_name}_${name}]:-}";
        [ -n "$p" ] && handlers[$p]=1;
    done;
    echo "${!handlers[*]}"
}
act_find_parents () 
{ 
    local targets=" $1 ";
    shift;
    local p d;
    for p in $(ensure_prop find "installed/*" | cut -f2 -d/ | uniq);
    do
        [[ "$targets" != *" $p "* ]] || continue;
        for d in $(act_expand_modules install $p "$@");
        do
            [ "$d" != "$p" ] || continue;
            [[ "$targets" != *" $d "* ]] || echo "$p:$d";
        done;
    done
}
act_get () 
{ 
    case "$1" in 
        prefix)
            declare -ga _act_reply=();
            local f;
            for f in ${!_act_cache_functions[*]};
            do
                [[ "$f" = "$2"* ]] && _act_reply+=("${_act_cache_functions[$f]}");
            done
        ;;
        init)
            declare -g _act_cache_cmds=($(declare -F | grep -E " subcommand_" | grep -v -E 'subcommand_(list|setup)$' | cut -f2- -d_));
            declare -g _act_cache_modules=($(declare -F | grep -E " ${installer_family}_[0-9]+_($(IFS='|'; echo "${_act_cache_cmds[*]}"))_" | cut -f2,4- -d_ | sort | cut -f2- -d_ | awk '!seen[$0]++'));
            declare -gA _act_cache_functions=();
            local f rest;
            while read -r _ _ f; do
                case $f in 
                    "${installer_family}_"*)
                        rest=${f#"${installer_family}_"};
                        _act_cache_functions[${rest#*_}]=$f
                    ;;
                esac;
            done < <(declare -F);
            declare -ga _act_cache_names=(${_act_cache_modules[*]});
            for f in ${!_act_cache_functions[*]};
            do
                [[ "$f" = profile_* ]] || continue;
                [[ " ${_act_cache_names[*]} " = *" ${f#profile_} "* ]] || _act_cache_names+=("${f#profile_}");
            done
        ;;
    esac
}
act_helper () 
{ 
    local act_name=${1%%,*};
    local act_text="${1#*,}";
    local sort_options="$2";
    shift;
    shift;
    act_validate_modules $act_name "$@" || return 3;
    local explicit_mods="$(act_extract_modules $act_name "$@")";
    local remove_all=0;
    if [[ "$act_name" = "remove" && " $* " = *" --remove-all "* ]]; then
        if [ -z "${explicit_mods// }" ]; then
            remove_all=1;
        else
            echo -e "${yellow}--remove-all ignored: components specified ($explicit_mods)${reset}" 1>&2;
        fi;
    fi;
    set -- $(act_resolve_args $act_name "$@");
    local _act_args="$*";
    local handles=($(act_find_deps $act_name "$@"));
    if [ "$act_name" = "remove" ] && [ $remove_all -eq 0 ] && [ ${#handles[@]} -gt 0 ]; then
        local _targets=() _top=0 _h _o _pair;
        for _h in $(printf '%s\n' "${handles[@]}" | sort $sort_options);
        do
            _o=${_h#*_};
            _o=${_o%%_*};
            [ "$_top" -gt 0 ] || _top=$_o;
            [ "$_o" -ge "$_top" ] || break;
            _targets+=(${_h#*_*_*_});
        done;
        local -A _needed=();
        for _pair in $(act_find_parents "${_targets[*]}" "$@");
        do
            _needed[${_pair#*:}]+="${_needed[${_pair#*:}]:+, }${_pair%%:*}";
        done;
        if [ ${#_needed[@]} -gt 0 ]; then
            for _h in ${!_needed[*]};
            do
                echo -e "${red}Cannot remove $_h: required by ${_needed[$_h]}${reset}" 1>&2;
            done;
            echo "Remove the dependent components in the same command, or use --remove-all." 1>&2;
            return 3;
        fi;
    fi;
    if [ ${#handles[@]} -gt 0 ]; then
        if [ "$act_name" = "install" ]; then
            local -A licenses=() licenses_text=();
            local all_install_modules="${handles[*]#${installer_family}_*_install_}";
            for licenser in ${handles[*]/_install_/_license_};
            do
                if declare -F $licenser > /dev/null 2>&1; then
                    local name1=${licenser#*_*_*_} license_line license_id="" license_keep=0;
                    while IFS= read -r license_line; do
                        case "$license_line" in 
                            "@@LICENSE-ID "*)
                                license_id="${license_line#* }";
                                [ -z "$license_id" ] || licenses[$license_id]="${licenses[$license_id]:-}$name1,";
                                [[ -v licenses_text[$license_id] ]] && license_keep=0 || license_keep=1
                            ;;
                        esac;
                        [ $license_keep -eq 1 ] && licenses_text[$license_id]+="${license_line}"'
';
                    done < <($licenser $(act_extract_args install $name1 "$all_install_modules" "$@"));
                fi;
            done;
            if [ ${#licenses[*]} -gt 0 ]; then
                local id1 rc;
                for id1 in ${!licenses[*]};
                do
                    echo "${licenses_text[$id1]}";
                    echo "@@LICENSE-COMPONENT $(echo "${licenses[$id1]%,}")";
                done | ensure_license_gate $installer_name "$@";
                rc=$?;
                if [ $rc -eq 1 ]; then
                    echo "License declined";
                    exit 3;
                else
                    if [ $rc -ne 0 ]; then
                        echo "License gate failed (no terminal or parse error)";
                        exit 3;
                    fi;
                fi;
            fi;
        fi;
        local hp="${http_proxy:-$HTTP_PROXY}" sp="${https_proxy:-$HTTPS_PROXY}" np=",${no_proxy:-$NO_PROXY},";
        np="${np//,intel.com,/,}";
        np="${np//,.intel.com,/,}";
        np="${np##,}";
        [ -z "$hp" ] || export http_proxy="$hp" HTTP_PROXY="$hp";
        [ -z "$sp" ] || export https_proxy="$sp" HTTPS_PROXY="$sp";
        [ -z "$np" ] || export no_proxy="${np%%,}" NO_PROXY="${np%%,}";
        local rc=0 order=0;
        export _INSTALLER_PANEL_ACTIVE=;
        [ -t 1 ] && export _INSTALLER_PANEL_ACTIVE=1;
        { 
            for handler in $(echo "${handles[*]}" | tr ' ' '\n' | sort $sort_options);
            do
                local name1=${handler#*_*_*_};
                if [ "$act_name" = "remove" ] && [ $remove_all -eq 0 ]; then
                    local order1=${handler#*_};
                    order1=${order1%%_*};
                    [ "$order" -gt 0 ] || order=$order1;
                    [ "$order1" -ge "$order" ] || break;
                fi;
                local invoke_args="$(act_extract_args $act_name $name1 "${handles[*]#${installer_family}_*_${act_name}_}" "$@")";
                if [[ " $* " = *" --dry-run "* ]]; then
                    echo "@@COMP $name1";
                    echo "Invoke $handler with $invoke_args";
                    echo "@@OK $name1";
                else
                    [ "$act_name" = "start" ] && ensure_prop create started/$name1/;
                    [ "$act_name" = "install" ] && ensure_prop create installed/$name1/;
                    echo "@@COMP $name1";
                    local rc1=0;
                    ( set -e;
                    $handler $invoke_args ) & wait $! || rc1=$?;
                    [[ " stop remove " = *" $act_name "* ]] && ensure_prop remove started/$name1/;
                    [ "$act_name" = "remove" ] && [ $rc1 -eq 0 ] && ensure_prop remove installed/$name1/;
                    if [ $rc1 -eq 0 ]; then
                        echo "@@OK $name1";
                    else
                        echo "@@FAIL $name1";
                        rc=$rc1;
                        [[ " $* " = *" --continue "* ]] || break;
                    fi;
                fi;
            done
        } > >(LOG_FILE="$(ensure_project_path)/$installer_name/$(date +%m-%d-%Y).logs"
mkdir -p "$(dirname "$LOG_FILE")"
echo "========== $(date -Ins) ==========" >> "$LOG_FILE"
echo "@@COMMAND $act_name $*" >> "$LOG_FILE"
if [ -n "$_INSTALLER_PANEL_ACTIVE" ]; then
    act_panelled_logs ${act_text//,/ };
else
    tee -a "$LOG_FILE";
fi) 2>&1;
        wait;
        [[ " $* " != *" --dry-run "* && -n "${explicit_mods// }" ]] && ensure_prop set modules "$explicit_mods";
        [[ $remove_all -eq 1 && $rc -eq 0 && " $* " != *" --dry-run "* ]] && ensure_prop remove modules;
        return $rc;
    else
        echo "Component not found" 1>&2;
        [[ " $* " = *" --dry-run "* ]] || ensure_prop remove modules;
        return 3;
    fi
}
