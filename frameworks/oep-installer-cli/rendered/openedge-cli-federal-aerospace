ensure_apt () 
{ 
    while fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock > /dev/null 2>&1; do
        echo "Waiting for apt/unattended-upgrades to finish..." 1>&2;
        sleep 5;
    done;
    case "$1" in 
        update)
            [[ "$(ensure_prop get apt_update)" = "true" && " $* " != *" -y "* ]] || ensure_sudo env DEBIAN_FRONTEND=noninteractive apt-get "$@";
            ensure_prop set apt_update true
        ;;
        autoremove | remove | purge)
            local package_list=();
            local options=();
            for v in ${*:2};
            do
                if [[ "$v" = -* ]]; then
                    options+=($v);
                else
                    package_list+=($v);
                fi;
            done;
            if [ ${#package_list[*]} -gt 0 ]; then
                local valid_packages=($(dpkg-query -W -f='${db:Status-Status} ${Package}\n' "${package_list[@]}" 2> /dev/null | awk '$1!="not-installed"{print $2}'));
                if [ ${#valid_packages[*]} -gt 0 ]; then
                    ensure_sudo env DEBIAN_FRONTEND=noninteractive apt-get $1 -y ${options[*]} ${valid_packages[*]};
                fi;
            fi
        ;;
        *)
            [ "$1" != "install" ] || [ "$(ensure_prop get apt_update)" = "true" ] || ensure_apt update -y;
            ensure_sudo env DEBIAN_FRONTEND=noninteractive apt-get -y "$@"
        ;;
    esac
}
ensure_apt_add_repository () 
{ 
    local r;
    for r in "$@";
    do
        ensure_sudo add-apt-repository -y -n "$r";
    done;
    ensure_apt update -y
}
ensure_apt_allow_downgrades () 
{ 
    local allow_downgrades=($1);
    shift;
    local dg downgrades=();
    for dg in $(apt-get install -s "$@" | awk '
/The following packages will be DOWNGRADED:/{flag=1;next}
/^[^ ]/{flag=0}
flag&&$1{for(i=1;i<=NF;i++)print$i}
');
    do
        [[ " ${allow_downgrades[*]} " = *" $dg "* ]] || downgrades+=("$dg");
    done;
    if [ ${#downgrades[*]} -gt 0 ]; then
        printf "${red}Detected unexpected downgrades: %s${reset}\n" "${downgrades[*]}" 1>&2;
        return 3;
    fi
}
ensure_apt_install_package () 
{ 
    local module="${1%%=*}";
    if ensure_apt_is_installed "${@%%"*"}"; then
        echo "${*%%=*} $([ ${#*} -eq 1 ] && echo is || echo are) installed." 1>&2;
    else
        ensure_prop set installed/${module//[^a-zA-Z0-9]/_}/owned true;
        ensure_apt update;
        ensure_apt install --no-install-recommends -y "$@";
    fi
}
ensure_apt_is_installed () 
{ 
    for pkg in $*;
    do
        [ "$(dpkg-query -W -f='${db:Status-Status}' ${pkg%%=*} 2> /dev/null)" = "installed" ] || return 1;
        [[ "$pkg" != *=* ]] || [[ "$(dpkg-query -W -f='${Version}' ${pkg%%=*} 2> /dev/null)" = "${pkg#*=}"* ]] || return 1;
    done
}
ensure_apt_key () 
{ 
    local key_file="$1" key_url="$2";
    local tmp_dir rc=0;
    ensure_tmpdir create tmp_dir apt_key || return 1;
    ensure_fetch "$key_url" "$tmp_dir/key" || rc=$?;
    if [ $rc -eq 0 ]; then
        ensure_sudo mkdir -p "$(dirname "$key_file")";
        if [[ "$*" = *"--dearmor"* ]]; then
            gpg --batch --yes --dearmor -o "$tmp_dir/key.gpg" "$tmp_dir/key" && ensure_sudo install -m 0644 "$tmp_dir/key.gpg" "$key_file" || rc=$?;
        else
            ensure_sudo install -m 0644 "$tmp_dir/key" "$key_file" || rc=$?;
        fi;
    fi;
    ensure_tmpdir destroy "$tmp_dir" || true;
    return $rc
}
ensure_apt_preference () 
{ 
    local pref_file=$1;
    shift;
    local line first=1;
    for line in "$@";
    do
        [[ "$line" != Package:* ]] || [ $first -eq 1 ] || echo;
        first=0;
        echo "$line";
    done | ensure_sudo tee "$pref_file" > /dev/null
}
ensure_apt_remove_package () 
{ 
    local module="${1%%=*}";
    [ "$(ensure_prop get installed/${module//[^a-zA-Z0-9]/_}/owned)" = "true" ] || return 0;
    ensure_apt autoremove -y "$@"
}
ensure_apt_source () 
{ 
