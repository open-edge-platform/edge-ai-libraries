ensure_prop () 
{ 
    local op="$1" key_path="${2:?}" value="${3:-}";
    local key_base="$(ensure_project_path)/${installer_name:?}";
    case "$op" in 
        set)
            printf '%s' "$value" > "$key_base/$key_path"
        ;;
        get)
            [ -r "$key_base/$key_path" ] && cat "$key_base/$key_path" || printf '%s' "$value"
        ;;
        find)
            ( cd "$key_base" && find . -ipath "./$key_path" -print 2> /dev/null | cut -f2- -d/ )
        ;;
        create)
            mkdir -p "$key_base/${key_path%/*}"
        ;;
        destroy)
            [ ! -r "$key_base/$key_path" ] || rm -f "$key_base/$key_path"
        ;;
    esac
}
ensure_ram_size () 
{ 
    local ram_size=$1;
    local mem_total=$(awk '/^MemTotal:/{print$2}' /proc/meminfo);
    if [ "$ram_size" -gt "$mem_total" ]; then
        echo "Not enough RAM: required ${ram_size} KiB and available ${mem_total} KiB" 1>&2;
        return 3;
    fi;
    local swap_size=${2:-0};
    local swap_total=$(awk '/^SwapTotal:/{print$2}' /proc/meminfo);
    if [ "$(( ram_size + swap_size ))" -gt "$(( mem_total + swap_total ))" ]; then
        echo "Not enough RAM or swap space:" 1>&2;
        echo " required swap ${swap_size} KiB and available ${swap_total} KiB" 1>&2;
        echo " required mem+swap $(( ram_size + swap_size )) KiB and available $(( mem_total + swap_total )) KiB" 1>&2;
        return 3;
    fi
}
ensure_rm () 
{ 
    local p norm rc=0;
    local protected=" / /bin /boot /dev /etc /home /lib /lib64 /media /mnt /opt /proc /root /run /sbin /srv /sys /tmp /usr /var /etc/apt /etc/apt/keyrings /etc/apt/preferences.d /etc/apt/sources.list.d /etc/systemd /etc/systemd/system /usr/bin /usr/lib /usr/local /usr/share /usr/share/keyrings /var/lib $HOME $HOME/.local $HOME/.local/bin ";
    for p in "$@";
    do
        [ -n "$p" ] || continue;
        norm="$(realpath -m -s -- "$p")";
        if [[ "$protected" = *" $norm "* ]]; then
            echo "ensure_rm: refusing to remove protected path '$p'" 1>&2;
            return 3;
        fi;
        [ -e "$norm" ] || [ -L "$norm" ] || continue;
        rm -rf -- "$norm" 2> /dev/null || ensure_sudo rm -rf -- "$norm" || rc=$?;
    done;
    return $rc
}
ensure_sbom_format () 
{ 
    local key=$1;
    shift;
    case "$key" in 
        pkg-list | apt-pref | yum-repo-conf)
            local IFS='|';
            local pkg_str="$*";
            echo "\"$key\": [\"${pkg_str//'|'/\",\"}\"]"
        ;;
        name | gpg-key | key-file | apt-source | apt-src-source | apt-list-file | apt-pref-file | apt-repository | yum-repo-file)
            echo "\"$key\": \"$*\""
        ;;
        *)
            echo "Unsupported SBOM key: $key" 1>&2;
            return 3
        ;;
    esac
}
ensure_select_device () 
{ 
    local device="cpu";
    local args_uc=" ${*^^} ";
    [ ! -e /dev/accel/accel0 ] || device="npu";
    [ ! -e /dev/dri/renderD128 ] || device="gpu";
    [[ "$args_uc" != *" --CPU "* ]] || device="cpu";
    [[ "$args_uc" != *" --NPU "* ]] || [ ! -e /dev/accel/accel0 ] || device="npu";
    [[ "$args_uc" != *" --GPU "* ]] || [ ! -e /dev/dri/renderD128 ] || device="gpu";
    echo $device
}
ensure_skills () 
{ 
    local op="$1";
    case "$op" in 
        add)
            local version="${2:?}";
            local repository="${3:?}";
            shift 3;
            local tmpdir p name;
            ensure_tmpdir create tmpdir skills;
            ensure_git_export "$tmpdir" "$version" "$repository" "$@";
            mkdir -p "$HOME"/.agents/skills;
            for p in "$@";
            do
                ensure_rm "$HOME/.agents/skills/${p##*/}";
                cp -r "$tmpdir/$p" "$HOME"/.agents/skills;
            done;
            ensure_tmpdir destroy "$tmpdir"
        ;;
        remove)
            local names=("${@##*/}");
            local spath="$HOME/.agents/skills/";
            ensure_rm "${names[@]/#/"$spath"}"
        ;;
    esac
}
ensure_sudo () 
{ 
    local hp="${http_proxy:-$HTTP_PROXY}" sp="${https_proxy:-$HTTPS_PROXY}" np="${no_proxy:-$NO_PROXY}" proxy_args=();
    [ -z "$hp" ] || proxy_args+=("http_proxy=$hp" "HTTP_PROXY=$hp");
    [ -z "$sp" ] || proxy_args+=("https_proxy=$sp" "HTTPS_PROXY=$sp");
    [ -z "$np" ] || proxy_args+=("no_proxy=$np" "NO_PROXY=$np");
    if [ -e /dev/tty ] && : < /dev/tty 2> /dev/null; then
        local ppid=$$;
        local pid="$(ensure_prop get pids/sudo/pid$ppid)";
        if [ -z "$pid" ] || ! kill -0 "$pid" 2> /dev/null; then
            ( set +e;
            trap - ERR EXIT INT TERM;
            for fd in /proc/$BASHPID/fd/*;
            do
                fd=${fd##*/};
                (( fd > 2 )) && eval "exec $fd>&-";
            done 2> /dev/null;
            while kill -0 $ppid 2> /dev/null; do
                sleep 60;
                sudo -n -v 2> /dev/null || break;
            done;
            ensure_prop destroy pids/sudo/pid$ppid ) < /dev/null > /dev/null 2>&1 & pid=$!;
            ensure_prop create pids/sudo/pid$ppid;
            ensure_prop set pids/sudo/pid$ppid "$pid";
            disown $pid;
        fi;
    fi;
    if sudo -n true 2> /dev/null; then
        sudo env "${proxy_args[@]}" "$@";
    else
        if [ -t 0 ] && [ -z "$SUDO_PASSWORD" ] && [ -z "$_INSTALLER_PANEL_ACTIVE" ]; then
            sudo env "${proxy_args[@]}" "$@";
        else
            local rundir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}";
            [ -d "$rundir" ] && [ -w "$rundir" ] || rundir="$(ensure_project_path)/${installer_name:?}";
            mkdir -p "$rundir" 2> /dev/null || return 1;
            ( flock -w 300 -e 9 || { 
                echo "ensure_sudo: timed out waiting for another installer" 1>&2;
                exit 1
            };
            if [ ! -x "$SUDO_ASKPASS" ]; then
                askpass_helper="$rundir"/askpass-sudo;
                act_panelled_logs_askpass "$askpass_helper" SUDO_PASSWORD || { 
                    echo "ensure_sudo: failed to create askpass helper" 1>&2;
                    exit 1
                };
                export SUDO_ASKPASS="$askpass_helper";
            fi;
            sudo -A env "${proxy_args[@]}" "$@" ) 9< "$rundir";
        fi;
    fi
}
ensure_tmpdir () 
{ 
    case "$1" in 
        create)
            printf -v $2 "%s" $(mktemp -d ${4:-/tmp}/openedge-cli-${3:-}.XXXXXX);
            ensure_trap "rm -rf ${!2} || ensure_sudo rm -rf ${!2}" SIGINT EXIT
        ;;
        destroy)
            rm -rf "$2";
            ensure_trap - SIGINT EXIT
        ;;
    esac
}
ensure_trap () 
{ 
    local script="$1" sig var_sig;
    shift;
    for sig in "$@";
    do
        var_sig="${sig//[^a-zA-Z0-9_]/_}";
        local -n stack="_ENSURE_TRAP_STACK_${var_sig}";
        if [[ "$script" == "-" || -z "$script" ]]; then
            if (( ${#stack[@]} > 0 )); then
                unset "stack[$((${#stack[@]} - 1))]";
                stack=("${stack[@]}");
            fi;
            if (( ${#stack[@]} == 0 )); then
                trap - "$sig";
            fi;
        else
            if [[ -z "$(trap -p "$sig")" ]]; then
                stack=();
                trap "
          _ENSURE_TRAP_IDX_${var_sig}=\$((\${#_ENSURE_TRAP_STACK_${var_sig}[@]} - 1))
          while (( _ENSURE_TRAP_IDX_${var_sig} >= 0 )); do
            eval \"\${_ENSURE_TRAP_STACK_${var_sig}[\$_ENSURE_TRAP_IDX_${var_sig}]}\"
            (( _ENSURE_TRAP_IDX_${var_sig}-- )) || true
          done
          trap - \"$sig\"
          case \"$sig\" in
            EXIT|0|ERR|RETURN|DEBUG) ;;
            *) kill -s \"$sig\" \$\$ ;;
          esac
        " "$sig";
            fi;
            stack+=("$script");
        fi;
    done
}
