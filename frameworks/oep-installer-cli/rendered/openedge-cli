system_scan_check_cpu_instructions () 
{ 
    local cpu_accels=("vnni" "avx2" "sse2");
    local detected=() missed=();
    for accel in "${cpu_accels[@]}";
    do
        if grep -q -F $accel /proc/cpuinfo > /dev/null; then
            detected+=($accel);
        else
            missed+=($accel);
        fi;
    done;
    if [ ${#missed[@]} -gt 0 ]; then
        echo "Missing ${missed[*]^^}";
    else
        echo "${detected[*]^^}";
    fi
}
