    if [ "$act_name" = "stop" ] && [ ${#margs[@]} -eq 0 ]; then
        local started_path="$(ensure_project_path)/$installer_name/started";
        [ -d "$started_path" ] && args+=($(cd "$started_path"; ls -1));
    else
        if [ "$act_name" = "remove" ] && [[ " $* " = *" --remove-all "* ]] && [ -z "$(act_extract_modules $act_name "$@")" ]; then
            local installed_path="$(ensure_project_path)/$installer_name/installed";
            [ -d "$installed_path" ] && args+=($(cd "$installed_path"; ls -1));
        else
            if [ "$act_name" != "stop" ] && [ -z "$(act_extract_modules $act_name "$@")" ]; then
                local mods_file="$(ensure_project_path)/$installer_name/modules";
                [ ! -r "$mods_file" ] || args=($(< "$mods_file") "${args[@]}");
            fi;
        fi;
    fi;
    echo "${args[*]}"
}
