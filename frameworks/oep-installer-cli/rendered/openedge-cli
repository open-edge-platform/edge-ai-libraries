    declare -a FAILROWS=();
    function _open_tty () 
    { 
        if [[ -e /dev/tty ]] && { 
            exec {TTY_FD}<> /dev/tty
        } 2> /dev/null; then
            return 0;
        fi;
        if [[ -t 2 ]] && { 
            exec {TTY_FD}>&2
        } 2> /dev/null; then
            return 0;
        fi;
        if [[ -t 1 ]] && { 
            exec {TTY_FD}>&1
        } 2> /dev/null; then
            return 0;
        fi;
        TTY_FD=-1;
        return 1
    };
    function _probe_geom () 
    { 
        local sz;
        if (( TTY_FD >= 0 )); then
            sz=$(stty size <&"$TTY_FD" 2> /dev/null);
            if [[ $sz == +([0-9])' '+([0-9]) ]]; then
                printf '%s %s' "${sz##* }" "${sz%% *}";
                return 0;
            fi;
        fi;
        if [[ -n ${COLUMNS:-} && -n ${LINES:-} ]]; then
            printf '%s %s' "$COLUMNS" "$LINES";
            return 0;
        fi;
        return 1
    };
    function _read_geom () 
    { 
        local c r sz;
        shopt -s checkwinsize 2> /dev/null;
        if [[ -n ${FORCE_COLS:-} ]]; then
            c=$FORCE_COLS;
            r=${FORCE_ROWS:-${LINES:-24}};
        else
            sz=$(_probe_geom) || sz="";
            if [[ -n $sz ]]; then
                c=${sz%% *};
                r=${sz##* };
            else
                c=${COLUMNS:-80};
                r=${LINES:-24};
            fi;
        fi;
        [[ $c == +([0-9]) ]] || c=80;
        [[ $r == +([0-9]) ]] || r=24;
        (( c < 40 )) && c=40;
        (( r < 10 )) && r=10;
        if (( c != TTY_COLS || r != TTY_ROWS )); then
            FULL_CLEAR=1;
            DWCACHE=();
            HRCACHE=();
            PREV=();
        fi;
        TTY_COLS=$c;
        TTY_ROWS=$r;
        GEOM_DIRTY=0
    };
    function _cellw () 
    { 
        local ch=$1 cp;
        if [[ -z $ch ]]; then
            REPLY=0;
            return;
        fi;
        if [[ $ch == [[:ascii:]] ]]; then
            REPLY=1;
            return;
        fi;
        if (( NARROW_GLYPHS )); then
            REPLY=1;
            return;
        fi;
        if [[ -n ${WCACHE[$ch]:-} ]]; then
            REPLY=${WCACHE[$ch]};
            return;
        fi;
        printf -v cp '%d' "'$ch" 2> /dev/null || cp=0;
        local w=1;
        if (( cp >= 0x1100  && cp <= 0x115F  )); then
            w=2;
        else
            if (( cp >= 0x2E80  && cp <= 0x303E  )); then
                w=2;
            else
                if (( cp >= 0x3041  && cp <= 0x33FF  )); then
                    w=2;
                else
                    if (( cp >= 0x3400  && cp <= 0x4DBF  )); then
                        w=2;
                    else
                        if (( cp >= 0x4E00  && cp <= 0x9FFF  )); then
                            w=2;
                        else
                            if (( cp >= 0xA000  && cp <= 0xA4CF  )); then
                                w=2;
                            else
                                if (( cp >= 0xAC00  && cp <= 0xD7A3  )); then
                                    w=2;
                                else
                                    if (( cp >= 0xF900  && cp <= 0xFAFF  )); then
                                        w=2;
                                    else
                                        if (( cp >= 0xFE30  && cp <= 0xFE6F  )); then
                                            w=2;
                                        else
                                            if (( cp >= 0xFF00  && cp <= 0xFF60  )); then
                                                w=2;
                                            else
                                                if (( cp >= 0xFFE0  && cp <= 0xFFE6  )); then
                                                    w=2;
                                                else
                                                    if (( cp >= 0x1F300 && cp <= 0x1FAFF )); then
                                                        w=2;
                                                    else
                                                        if (( cp >= 0x20000 && cp <= 0x3FFFD )); then
                                                            w=2;
                                                        else
                                                            if (( cp == 0x26D4 || cp == 0x2757 || cp == 0x2753 )); then
                                                                w=2;
                                                            else
                                                                if (( cp >= 0x25B6 && cp <= 0x25C0 )); then
                                                                    w=1;
                                                                else
                                                                    if (( cp >= 0x2B00 && cp <= 0x2BFF )); then
                                                                        w=2;
                                                                    else
                                                                        if (( cp >= 0x0300 && cp <= 0x036F )); then
                                                                            w=0;
                                                                        else
                                                                            if (( cp >= 0xFE00 && cp <= 0xFE0F )); then
                                                                                w=0;
                                                                            fi;
                                                                        fi;
                                                                    fi;
                                                                fi;
                                                            fi;
                                                        fi;
                                                    fi;
                                                fi;
                                            fi;
                                        fi;
                                    fi;
                                fi;
                            fi;
                        fi;
                    fi;
                fi;
            fi;
        fi;
        WCACHE[$ch]=$w;
        REPLY=$w
    };
    function _dwidth () 
    { 
        local s=$1;
        if [[ -z $s ]]; then
            REPLY=0;
            return;
        fi;
        if [[ $s != *[![:ascii:]]* ]]; then
            REPLY=${#s};
            return;
        fi;
        if [[ -n ${DWCACHE[$s]:-} ]]; then
            REPLY=${DWCACHE[$s]};
            return;
        fi;
        local n=0 i;
        for ((i = 0; i < ${#s}; i++ ))
        do
            _cellw "${s:i:1}";
            n=$(( n + REPLY ));
        done;
        (( ${#DWCACHE[@]} > 4000 )) && DWCACHE=();
        DWCACHE[$s]=$n;
        REPLY=$n
    };
    TAKEN="";
    TAKENW=0;
    function _take_cells () 
    { 
        local w=$1 s=$2;
        if (( w <= 0 )) || [[ -z $s ]]; then
            TAKEN="";
            TAKENW=0;
            return;
        fi;
        if [[ $s != *[![:ascii:]]* ]]; then
            if (( ${#s} <= w )); then
                TAKEN=$s;
                TAKENW=${#s};
            else
                TAKEN=${s:0:w};
                TAKENW=$w;
            fi;
            return;
        fi;
        local n=0 i out="";
        for ((i = 0; i < ${#s}; i++ ))
        do
            _cellw "${s:i:1}";
            (( n + REPLY > w )) && break;
            out+=${s:i:1};
            n=$(( n + REPLY ));
        done;
        TAKEN=$out;
        TAKENW=$n
    };
    function _now_ms () 
    { 
        printf '%s' $(( ${EPOCHREALTIME/./} / 1000 ))
    };
    function _elapsed_ms () 
    { 
        local c=$1;
        REPLY=0;
        [[ -z $c ]] && return;
        if [[ -n ${TDONE[$c]:-} ]]; then
            REPLY=${TDONE[$c]};
            return;
        fi;
        local acc=${TACC[$c]:-0};
        if [[ -n ${TSTART[$c]:-} ]]; then
            REPLY=$(( acc + $(_now_ms) - ${TSTART[$c]} ));
        else
            REPLY=$acc;
        fi;
        (( REPLY < 0 )) && REPLY=0
    };
    function _fmt_elapsed () 
    { 
        local ms=${1:-0} s m h;
        (( ms < 0 )) && ms=0;
        s=$(( ms / 1000 ));
        if (( s < 60 )); then
            printf -v REPLY '%ds' "$s";
        else
            if (( s < 3600 )); then
                printf -v REPLY '%dm%02ds' $(( s / 60 )) $(( s % 60 ));
            else
                printf -v REPLY '%dh%02dm' $(( s / 3600 )) $(( (s % 3600) / 60 ));
            fi;
        fi
    };
    function _timer_start () 
    { 
        local c=$1;
        [[ -z $c ]] && return;
        if [[ -n ${TDONE[$c]:-} ]]; then
            TACC[$c]=${TDONE[$c]};
            unset "TDONE[$c]";
        fi;
        : "${TACC[$c]:=0}";
        TSTART[$c]=$(_now_ms);
        TSHOWN[$c]=-1;
        (( T_FIRST == 0 )) && T_FIRST=${TSTART[$c]}
    };
    function _timer_stop () 
    { 
        local c=$1;
        [[ -z $c ]] && return;
        [[ -n ${TDONE[$c]:-} ]] && return;
        [[ -z ${TSTART[$c]:-} && -z ${TACC[$c]:-} ]] && return;
        _elapsed_ms "$c";
        TDONE[$c]=$REPLY;
        unset "TSTART[$c]"
    };
    HRULE="";
    function _hrule_v () 
    { 
        local w=$1;
        (( w <= 0 )) && { 
            HRULE="";
            return
        };
        if [[ -n ${HRCACHE[$w]:-} ]]; then
            HRULE=${HRCACHE[$w]};
            return;
        fi;
        local s;
        printf -v s '%*s' "$w" '';
        HRULE=${s// /$BC_H};
        HRCACHE[$w]=$HRULE
    };
    PLAIN="";
    SGRTEXT="";
    function _sanitize_v () 
    { 
        local s=$1 keep=$2 out="" pre rest fin i ch;
        s=${s//'	'/    };
        s=${s//''/ };
        s=${s//''/ };
        s=${s//''/};
        while [[ $s == *'' ]]; do
            s=${s%''};
        done;
        [[ $s == *''* ]] && s=${s##*''};
        if [[ $s == *''* ]]; then
            while [[ $s == *''* ]]; do
                pre=${s%%''*};
                out+=$pre;
                rest=${s:${#pre}+1};
                case ${rest:0:1} in 
                    '[')
                        i=1;
                        while (( i < ${#rest} )); do
                            ch=${rest:i:1};
                            [[ $ch == $CSI_FINAL ]] && break;
                            (( i++ ));
                        done;
                        fin=${rest:i:1};
                        if (( keep )) && [[ $fin == m ]]; then
                            out+=''"${rest:0:i+1}";
                        fi;
                        s=${rest:i+1}
                    ;;
                    ']')
                        if [[ $rest == *''* ]]; then
                            s=${rest#*''};
                        else
                            if [[ $rest == *'\'* ]]; then
                                s=${rest#*'\'};
                            else
                                s="";
                            fi;
                        fi
                    ;;
                    'P' | 'X' | '^' | '_')
                        if [[ $rest == *'\'* ]]; then
                            s=${rest#*'\'};
                        else
                            s="";
                        fi
                    ;;
                    *)
                        s=${rest:1}
                    ;;
                esac;
            done;
            out+=$s;
        else
            out=$s;
        fi;
        out=${out%"${out##*[![:space:]]}"};
        if (( keep )); then
            SGRTEXT=$out;
        else
            PLAIN=$out;
        fi
    };
    function _plain_v () 
    { 
        _sanitize_v "$1" 0
    };
    FITTED="";
    function _fit_v () 
    { 
        local w=$1 raw=$2 fp=${3:-0};
        if (( w <= 0 )); then
            FITTED="";
            return;
        fi;
        _plain_v "$raw";
        local plain=$PLAIN;
        _dwidth "$plain";
        local pw=$REPLY;
        if (( ! fp && KEEP_COLOR )) && [[ $raw == *''* ]]; then
            _sanitize_v "$raw" 1;
            local c=$SGRTEXT;
            if (( pw <= w )); then
                printf -v FITTED '%s%s%*s' "$c" "$C_RESET" $(( w - pw )) '';
                return;
            fi;
            local out="" n=0 i ch seg;
            while [[ -n $c ]]; do
                if [[ ${c:0:1} == '' ]]; then
                    i=2;
                    while (( i < ${#c} )); do
                        ch=${c:i:1};
                        [[ $ch == $CSI_FINAL ]] && break;
                        (( i++ ));
                    done;
                    out+=${c:0:i+1};
                    c=${c:i+1};
                    continue;
                fi;
                seg=${c%%''*};
                c=${c:${#seg}};
                _take_cells $(( w - 1 - n )) "$seg";
                out+=$TAKEN;
                n=$(( n + TAKENW ));
                (( n >= w - 1 )) && break;
            done;
            printf -v FITTED '%s%s%s%*s' "$out" "$C_RESET" "$G_ELL" $(( w - n - 1 )) '';
            return;
        fi;
        if (( pw <= w )); then
            printf -v FITTED '%s%*s' "$plain" $(( w - pw )) '';
        else
            _take_cells $(( w - 1 )) "$plain";
            printf -v FITTED '%s%s%*s' "$TAKEN" "$G_ELL" $(( w - TAKENW - 1 )) '';
        fi
    };
    declare -a WRAPPED=();
    function _wrap_into () 
    { 
        local w=$1;
        (( w <= 0 )) && return;
        _plain_v "$2";
        local s=$PLAIN t tw brk sw row;
        if [[ -z $s ]]; then
            printf -v row '%*s' "$w" '';
            WRAPPED+=("$row");
            return;
        fi;
        while :; do
            _dwidth "$s";
            sw=$REPLY;
            if (( sw <= w )); then
                printf -v row '%s%*s' "$s" $(( w - sw )) '';
                WRAPPED+=("$row");
                return;
            fi;
            _take_cells "$w" "$s";
            t=$TAKEN;
            tw=$TAKENW;
            [[ -z $t ]] && { 
                t=${s:0:1};
                _dwidth "$t";
                tw=$REPLY
            };
            if [[ $t == *" "* && ${s:${#t}:1} != " " ]]; then
                brk=${t% *};
                if (( ${#brk} > 0 )); then
                    t=$brk;
                    _dwidth "$t";
                    tw=$REPLY;
                fi;
            else
                if [[ $t == *"/"* && ${s:${#t}:1} != " " ]]; then
                    brk=${t%/*};
                    brk=${t:0:${#brk}+1};
                    if (( ${#brk} > 1 && ${#brk} < ${#t} )); then
                        t=$brk;
                        _dwidth "$t";
                        tw=$REPLY;
                    fi;
                fi;
            fi;
            printf -v row '%s%*s' "$t" $(( w - tw )) '';
            WRAPPED+=("$row");
            s=${s:${#t}};
            [[ ${s:0:1} == " " ]] && s=${s:1};
            [[ -z $s ]] && return;
        done
    };
    function _wrap_color_into () 
    { 
        local w=$1 s=$2;
        (( w <= 0 )) && return;
        local active="" row="" n=0 seg i ch esc brk segw t tw out;
        while [[ -n $s ]]; do
            if [[ ${s:0:1} == '' ]]; then
                i=2;
                while (( i < ${#s} )); do
                    ch=${s:i:1};
                    [[ $ch == $CSI_FINAL ]] && break;
                    (( i++ ));
                done;
                esc=${s:0:i+1};
                s=${s:i+1};
                if [[ $esc == '[0m' || $esc == '[m' ]]; then
                    active="";
                else
                    active+=$esc;
                fi;
                row+=$esc;
                continue;
            fi;
            seg=${s%%''*};
            [[ -z $seg ]] && continue;
            s=${s:${#seg}};
            while :; do
                _dwidth "$seg";
                segw=$REPLY;
                if (( n + segw <= w )); then
                    row+=$seg;
                    n=$(( n + segw ));
                    break;
                fi;
                _take_cells $(( w - n )) "$seg";
                t=$TAKEN;
                tw=$TAKENW;
                [[ -z $t ]] && { 
                    t=${seg:0:1};
                    _dwidth "$t";
                    tw=$REPLY
                };
                if [[ $t == *" "* && ${seg:${#t}:1} != " " ]]; then
                    brk=${t% *};
                    if (( ${#brk} > 0 )); then
                        t=$brk;
                        _dwidth "$t";
                        tw=$REPLY;
                    fi;
                fi;
                row+=$t;
                n=$(( n + tw ));
                printf -v out '%s%s%*s' "$row" "$C_RESET" $(( w - n )) '';
                WRAPPED+=("$out");
                row=$active;
                n=0;
                seg=${seg:${#t}};
                [[ ${seg:0:1} == " " ]] && seg=${seg:1};
                [[ -z $seg ]] && break;
            done;
        done;
        printf -v out '%s%s%*s' "$row" "$C_RESET" $(( w - n )) '';
        WRAPPED+=("$out")
    };
    function _wrap_one () 
    { 
        local w=$1 line=$2;
        WRAPPED=();
        if [[ $WRAP_MODE == clip ]]; then
            _fit_v "$w" "$line";
            WRAPPED=("$FITTED");
        else
            if (( KEEP_COLOR )); then
                _wrap_color_into "$w" "$line";
            else
                _wrap_into "$w" "$line";
            fi;
        fi
    };
    SG_C="";
    SG_M="";
    SG_L="";
    function _sg () 
    { 
        case ${1:-} in 
            ok)
                SG_C=$C_GREEN;
                SG_M=$G_OK;
                SG_L="${ACT_TEXT[2],,}"
            ;;
            fail)
                SG_C=$C_RED;
                SG_M=$G_FAIL;
                SG_L="failed"
            ;;
            *)
                SG_C=$C_YELLOW;
                SG_M=$G_RUN;
                SG_L="${ACT_TEXT[1],,}"
            ;;
        esac
    };
    HDRTXT="";
    function _header_text () 
    { 
        local name=$1;
        HDRTXT="";
        [[ -z $name ]] && return;
        _sg "${STATUS[$name]:-}";
        _elapsed_ms "$name";
        local ms=$REPLY;
        if (( ms <= 0 )) && [[ -z ${TDONE[$name]:-} ]]; then
            HDRTXT="${name} [${SG_L}]";
            return;
        fi;
        _fmt_elapsed "$ms";
        if [[ -z $REPLY ]]; then
            HDRTXT="${name} [${SG_L}]";
        else
            HDRTXT="${name} [${SG_L}, ${REPLY}]";
        fi
    };
    TITLE="";
    function _title_text () 
    { 
        local final=${1:-0} word=${2:-completed} name nok=0 nbad=0;
        TITLE=" ${ACT_TEXT[0]} progress ";
        if (( final )); then
            for name in "${ORDER[@]}";
            do
                [[ -z $name ]] && continue;
                [[ -n ${REPORT[$name]:-} ]] && continue;
                case ${STATUS[$name]:-} in 
                    ok)
                        nok=$(( nok + 1 ))
                    ;;
                    fail)
                        nbad=$(( nbad + 1 ))
                    ;;
                esac;
            done;
            TITLE=" ${ACT_TEXT[0]} ${word}:  ${G_OK} ${nok}  ${G_FAIL} ${nbad}";
        fi;
        if (( T_FIRST > 0 )); then
            local endms=$T_LAST;
            (( endms == 0 )) && endms=$(_now_ms);
            _fmt_elapsed $(( endms - T_FIRST ));
            [[ -n $REPLY ]] && TITLE+="  ${REPLY}";
        fi
    };
    function _note_width () 
    { 
        local name=$1;
        [[ -z $name ]] && return;
        _header_text "$name";
        _dwidth "$HDRTXT";
        local wneed=$(( REPLY + 5 ));
        (( wneed > WIDEST )) && WIDEST=$wneed
    };
    function _touch_comp () 
    { 
        local name=$1;
        [[ -z $name ]] && return;
        [[ -n ${STATUS[$name]:-} ]] && return;
        ORDER+=("$name");
        STATUS[$name]="${ACT_TEXT[1],,}";
        L1[$name]="";
        L2[$name]="";
        RBUF[$name]="";
        RCNT[$name]=0;
        HL[$name]="";
        HCNT[$name]=0;
        REPORT[$name]="";
        TACC[$name]=0;
        TSHOWN[$name]=-1;
        WRAPC[$name]="";
        WRAPCN[$name]=0;
        WRAPW[$name]=-1;
        LDIRTY[$name]=1;
        LEFT_VALID=0;
        _dwidth "$name";
        local wneed=$(( REPLY + 26 ));
        (( wneed > WIDEST )) && WIDEST=$wneed
    };
    function _mark_fail () 
    { 
        local name=$1 f;
        [[ -z $name ]] && return;
        STATUS[$name]="fail";
        _timer_stop "$name";
        LDIRTY[$name]=1;
        LEFT_VALID=0;
        for f in "${FAILED[@]}";
        do
            [[ $f == "$name" ]] && return;
        done;
        FAILED+=("$name")
    };
    function _push_log () 
    { 
        local c=$1 line=$2 r;
        [[ -z $c ]] && return;
        L1[$c]=${L2[$c]:-};
        L2[$c]=$line;
        LDIRTY[$c]=1;
        LEFT_VALID=0;
        RBUF[$c]+="${line}"'
';
        RCNT[$c]=$(( ${RCNT[$c]:-0} + 1 ));
        if (( RW_NOW > 0 )) && [[ ${WRAPW[$c]:--1} == "$RW_NOW" ]]; then
            _wrap_one "$RW_NOW" "$line";
            for r in "${WRAPPED[@]}";
            do
                WRAPC[$c]+="${r}"'
';
                WRAPCN[$c]=$(( ${WRAPCN[$c]:-0} + 1 ));
            done;
            if (( ${WRAPCN[$c]:-0} > MAX_WRAP )); then
                WRAPW[$c]=-1;
            fi;
            [[ $c == "$RCACHE_COMP" ]] && RCACHE_N=-1;
        fi;
        if (( ${RCNT[$c]:-0} > MAX_RBUF )); then
            local keep=$(( MAX_RBUF / 2 ));
            RBUF[$c]=$(printf '%s' "${RBUF[$c]}" | tail -n "$keep")'
';
            RCNT[$c]=$keep;
            WRAPW[$c]=-1;
            [[ $c == "$RCACHE_COMP" ]] && RCACHE_N=-1;
        fi
    };
    function _push_highlight () 
    { 
        local c=$1 text=$2;
        [[ -z $c ]] && return;
        HL[$c]+="${text}"'
';
        HCNT[$c]=$(( ${HCNT[$c]:-0} + 1 ));
