                    fi;
                    buf+='
'"${C_CYAN}${FITTED}${C_RESET}";
                done;
            done <<< "${HL[$name]}";
        else
            local -a tl=();
            [[ -n ${L1[$name]:-} ]] && tl+=("${L1[$name]}");
            [[ -n ${L2[$name]:-} ]] && tl+=("${L2[$name]}");
            for ((i = ${#tl[@]} - TAIL_LINES; i < ${#tl[@]}; i++ ))
            do
                (( i < 0 )) && continue;
                _fit_v "$lw" "  ${BC_B} ${tl[i]}" 1;
                buf+='
'"${C_DIM}${FITTED}${C_RESET}";
            done;
        fi;
        LBLK[$name]=$buf;
        LDIRTY[$name]=""
    };
    function _draw () 
    { 
        local force=${1:-0};
        (( DRAWING )) && return;
        DRAWING=1;
        local t0;
        t0=$(_now_ms);
        if (( ! force && t0 - LAST_DRAW < REDRAW_MS )); then
            DRAWING=0;
            return;
        fi;
        LAST_DRAW=$t0;
        (( GEOM_DIRTY )) && _read_geom;
        local cols=$TTY_COLS rows=$TTY_ROWS;
        local usable=$cols lw;
        if (( LEFT_WIDTH > 0 )); then
            lw=$LEFT_WIDTH;
        else
            local cap=$(( usable * LEFT_MAX_PCT / 100 ));
            lw=$WIDEST;
            (( lw < LEFT_MIN )) && lw=$LEFT_MIN;
            (( lw > cap )) && lw=$cap;
        fi;
        local rw=$(( usable - lw - SEP_W ));
        if (( rw < 24 )); then
            rw=24;
            lw=$(( usable - rw - SEP_W ));
        fi;
        (( lw < 8 )) && lw=8;
        if (( lw != PREV_LW )); then
            PREV_LW=$lw;
            FULL_CLEAR=1;
            LEFT_VALID=0;
            local k;
            for k in "${ORDER[@]}";
            do
                [[ -n $k ]] && LDIRTY[$k]=1;
            done;
        fi;
        if (( rw != PREV_RW )); then
            PREV_RW=$rw;
            RW_NOW=$rw;
            export LOG_COLUMNS=$rw;
            FULL_CLEAR=1;
            RCACHE_COMP="";
            RCACHE_N=-1;
            local k;
            for k in "${ORDER[@]}";
            do
                [[ -n $k ]] && WRAPW[$k]=-1;
            done;
        fi;
        local full=$(( rows - 3 ));
        (( full < 1 )) && full=1;
        local fh=$FAIL_H;
        (( fh > full - SPLIT_MIN )) && fh=$(( full - SPLIT_MIN ));
        (( fh < 0 )) && fh=0;
        if (( fh != PREV_FH )); then
            PREV_FH=$fh;
            LEFT_VALID=0;
        fi;
        local body=$(( full - fh ));
        local name src i j;
        local view=${FOCUS:-$CURRENT};
        local is_report=0;
        [[ -n $view && -n ${REPORT[$view]:-} ]] && is_report=1;
        local upper="" nfail=${#FAILED[@]};
        if [[ -n $FOCUS ]]; then
            upper=$FOCUS;
        else
            if (( REVIEW )) && (( nfail > 0 )); then
                upper=${FAILED[0]};
            else
                if (( is_report )); then
                    for ((j = ${#ORDER[@]} - 1; j >= 0; j-- ))
                    do
                        if [[ -z ${REPORT[${ORDER[j]}]:-} ]]; then
                            upper=${ORDER[j]};
                            break;
                        fi;
                    done;
                else
                    upper=$view;
                fi;
            fi;
        fi;
        if [[ $upper != "$SHOWN" ]]; then
            [[ -n $SHOWN ]] && LDIRTY[$SHOWN]=1;
            [[ -n $upper ]] && LDIRTY[$upper]=1;
            SHOWN=$upper;
            LEFT_VALID=0;
        fi;
        for name in "${ORDER[@]}";
        do
            [[ -z $name ]] && continue;
            [[ -n ${REPORT[$name]:-} ]] && continue;
            [[ -n ${LDIRTY[$name]:-} ]] && { 
                _build_block "$name" "$lw";
                LEFT_VALID=0
            };
        done;
        if (( ! LEFT_VALID )); then
            local -a blk=() blk_nm=();
            for name in "${ORDER[@]}";
            do
                [[ -z $name ]] && continue;
                [[ -n ${REPORT[$name]:-} ]] && continue;
                blk+=("${LBLK[$name]:-}");
                blk_nm+=("$name");
            done;
            local nl;
            LEFT_ROWS=();
            for ((j = 0; j < ${#blk[@]}; j++ ))
            do
                while IFS= read -r src; do
                    LEFT_ROWS+=("$src");
                done <<< "${blk[j]}";
            done;
            local nrows=${#LEFT_ROWS[@]};
            if (( nrows > body )); then
                local wstart=$(( nrows - body ));
                if (( REVIEW )) && (( ${#FAILED[@]} > 0 )) && [[ -n $SHOWN ]]; then
                    local off=0 hit=-1;
                    for ((j = 0; j < ${#blk[@]}; j++ ))
                    do
                        if [[ ${blk_nm[j]} == "$SHOWN" ]]; then
                            hit=$off;
                            break;
                        fi;
                        nl=${blk[j]//[!'
']/};
                        off=$(( off + ${#nl} + 1 ));
                    done;
                    if (( hit >= 0 )); then
                        wstart=$hit;
                        (( wstart > nrows - body )) && wstart=$(( nrows - body ));
                        (( wstart < 0 )) && wstart=0;
                    fi;
                fi;
                LEFT_ROWS=("${LEFT_ROWS[@]:wstart:body}");
            fi;
            LEFT_VALID=1;
        fi;
        local -a right=();
        local counter="";
        if (( REVIEW )) && (( nfail > 1 )); then
            if [[ -n $FOCUS ]]; then
                counter="  (pinned, ${nfail} failed)";
            else
                counter="  (+$(( nfail - 1 )) more failed)";
            fi;
        fi;
        local hcomp=${upper:-$view};
        if [[ -z $hcomp ]]; then
            _fit_v "$rw" "waiting..." 1;
            right+=("${C_DIM}${FITTED}${C_RESET}");
        else
            local tstr="";
            _sg "${STATUS[$hcomp]:-}";
            if [[ -z ${REPORT[$hcomp]:-} ]]; then
                _elapsed_ms "$hcomp";
                if (( REPLY > 0 )); then
                    _fmt_elapsed "$REPLY";
                    [[ -n $REPLY ]] && tstr=", ${REPLY}";
                fi;
            fi;
            _fit_v "$rw" "${SG_M} ${hcomp} [${SG_L}${tstr}]${counter}" 1;
            right+=("${SG_C}${FITTED}${C_RESET}");
            _hrule_v "$rw";
            right+=("${C_DIM}${HRULE}${C_RESET}");
        fi;
        local avail=$(( body - ${#right[@]} ));
        if (( avail > 0 )) && [[ -n $hcomp ]]; then
            if (( is_report )) && [[ -n $upper ]] && (( avail >= SPLIT_MIN * 2 + 1 )); then
                local rcap=$(( avail * REPORT_MAX_PCT / 100 ));
                (( rcap < SPLIT_MIN )) && rcap=$SPLIT_MIN;
                _load_rows "$view" "$rw";
                local -a rep=("${RCACHE_ROWS[@]:0:rcap}");
                local lo=${#rep[@]};
                (( lo < 1 )) && lo=1;
                local hi=$(( avail - lo - 1 ));
                (( hi < SPLIT_MIN )) && { 
                    hi=$SPLIT_MIN;
                    lo=$(( avail - hi - 1 ))
                };
                _load_rows "$upper" "$rw";
                local n=${#RCACHE_ROWS[@]} start=0;
                (( n > hi )) && start=$(( n - hi ));
                (( n > 0 )) && right+=("${RCACHE_ROWS[@]:start:hi}");
                while (( ${#right[@]} < body - lo - 1 )); do
                    right+=("");
                done;
                _fit_v "$rw" "${G_DN} ${view}" 1;
                right+=("${C_BOLD}${C_CYAN}${FITTED}${C_RESET}");
                (( lo > 0 )) && right+=("${rep[@]:0:lo}");
            else
                _load_rows "$hcomp" "$rw";
                local n=${#RCACHE_ROWS[@]} start=0;
                if (( n > 0 )); then
                    if (( is_report )); then
                        right+=("${RCACHE_ROWS[@]:0:avail}");
                    else
                        (( n > avail )) && start=$(( n - avail ));
                        right+=("${RCACHE_ROWS[@]:start:avail}");
                    fi;
                fi;
            fi;
        fi;
        local out="" l r rowstr;
        if (( FULL_CLEAR )); then
            PREV=();
            FULL_CLEAR=0;
        fi;
        _title_text "$REVIEW" "$TITLE_WORD";
        _title_row "$usable";
        rowstr=$TITLEROW;
        if [[ ${PREV[0]:-__} != "$rowstr" ]]; then
            out+='[1;1H'"$rowstr"'[K';
            PREV[0]=$rowstr;
        fi;
        _hrule_v "$usable";
        rowstr="${C_DIM}${HRULE}${C_RESET}";
        if [[ ${PREV[1]:-__} != "$rowstr" ]]; then
            out+='[2;1H'"$rowstr"'[K';
            PREV[1]=$rowstr;
        fi;
        for ((i = 0; i < body; i++ ))
        do
            l=${LEFT_ROWS[i]:-};
            if [[ $l != *''* ]]; then
                _fit_v "$lw" "$l" 1;
                l=$FITTED;
            fi;
            r=${right[i]:-};
            rowstr="${l} ${C_DIM}${BC_V}${C_RESET} ${r}";
            j=$(( i + 2 ));
            if [[ ${PREV[j]:-__} != "$rowstr" ]]; then
                printf -v out '%s\033[%d;1H%s\033[K' "$out" $(( i + 3 )) "$rowstr";
                PREV[j]=$rowstr;
            fi;
        done;
        if (( fh > 0 )); then
            local frule;
            _dwidth "$FAIL_TITLE";
            _hrule_v $(( usable - REPLY - 2 ));
            frule="${C_RED}${BC_H}${BC_H}${FAIL_TITLE}${HRULE}${C_RESET}";
            for ((i = 0; i < fh; i++ ))
            do
                if (( i == 0 )); then
                    rowstr=$frule;
                else
                    rowstr=${FAILROWS[i-1]:-};
                fi;
                j=$(( body + i + 2 ));
                if [[ ${PREV[j]:-__} != "$rowstr" ]]; then
                    printf -v out '%s\033[%d;1H%s\033[K' "$out" $(( body + i + 3 )) "$rowstr";
                    PREV[j]=$rowstr;
                fi;
            done;
        fi;
        [[ -n $out ]] && printf '%s' "$out";
        FRAMES=$(( FRAMES + 1 ));
        DRAW_MS=$(( DRAW_MS + $(_now_ms) - t0 ));
        DRAWING=0
    };
    function _stop_all_timers () 
    { 
        local c;
        (( ${#TSTART[@]} == 0 )) && return;
        for c in "${!TSTART[@]}";
        do
            [[ -n $c ]] && _timer_stop "$c";
        done
    };
    function _build_fail_rows () 
    { 
        local interrupted=${1:-0} w=$2 name src per extra=0;
        local -a names=("${FAILED[@]}") tailrows;
        if (( interrupted )) && [[ -n $CURRENT && -z ${REPORT[$CURRENT]:-} && ${STATUS[$CURRENT]:-} != ok && ${STATUS[$CURRENT]:-} != fail ]]; then
            names+=("$CURRENT");
        fi;
        FAILROWS=();
        (( ${#names[@]} == 0 || FAIL_ROWS <= 0 )) && return 1;
        [[ -n ${LOG_FILE:-} ]] && extra=1;
        per=$(( (FAIL_ROWS - ${#names[@]} - extra) / ${#names[@]} ));
        (( per < 3 )) && per=3;
        for name in "${names[@]}";
        do
            [[ -z $name ]] && continue;
            tailrows=();
            while IFS= read -r src; do
                WRAPPED=();
                _wrap_into "$w" "$src";
                (( ${#WRAPPED[@]} )) && tailrows+=("${WRAPPED[@]}");
            done < <(printf '%s' "${RBUF[$name]:-}" | tail -n "$per");
            (( ${#tailrows[@]} > per )) && tailrows=("${tailrows[@]: -per}");
            _fit_v "$w" "${G_FAIL} ${name}: last ${#tailrows[@]} lines" 1;
            FAILROWS+=("${C_RED}${FITTED}${C_RESET}");
            (( ${#tailrows[@]} )) && FAILROWS+=("${tailrows[@]}");
        done;
        if (( extra )); then
            _fit_v "$w" "Full log: $LOG_FILE" 1;
            FAILROWS+=("${C_DIM}${FITTED}${C_RESET}");
        fi;
        return 0
    };
    function _raise_fail_panel () 
    { 
        local interrupted=${1:-0} nf=${#FAILED[@]} h target cap d;
        (( GEOM_DIRTY )) && _read_geom;
        _build_fail_rows "$interrupted" "$TTY_COLS" || return 0;
        if (( nf == 0 )); then
            FAIL_TITLE=" interrupted - last log lines ";
        else
            FAIL_TITLE=" ${G_FAIL} ${nf} failed - error log ";
        fi;
        target=$(( ${#FAILROWS[@]} + 1 ));
        (( target > FAIL_ROWS + 1 )) && target=$(( FAIL_ROWS + 1 ));
        cap=$(( TTY_ROWS - 3 - SPLIT_MIN ));
        (( target > cap )) && target=$cap;
        (( target < 2 )) && return 0;
        printf -v d '%d.%03d' $(( RAISE_MS / 1000 )) $(( RAISE_MS % 1000 ));
        for ((h = 1; h <= target; h++ ))
        do
            FAIL_H=$h;
            _draw 1;
            (( RAISE_MS > 0 && h < target )) && sleep "$d";
        done;
        return 0
    };
    function _finish () 
    { 
        local rc=$?;
        DRAWING=0;
        _stop_all_timers;
        (( T_LAST == 0 )) && T_LAST=$(_now_ms);
        (( rc != 0 )) && { 
            REVIEW=1;
            TITLE_WORD=interrupted
        };
        FULL_CLEAR=1;
        LEFT_VALID=0;
        RCACHE_COMP="";
        RCACHE_N=-1;
        _draw 1;
        _raise_fail_panel $(( rc != 0 ));
        printf '\033[?7h';
        printf '\033[%d;1H\033[K' "$TTY_ROWS";
        printf '\033[?25h';
        (( TTY_FD >= 0 )) && { 
            stty echo <&"$TTY_FD" 2> /dev/null;
            exec {TTY_FD}>&-
        }
    };
    function _handle_line () 
    { 
        local line="$1" key rest target clean plainkey hpay;
        [ -z "$LOG_FILE" ] || printf "%s\n" "$line" >> "$LOG_FILE";
        if (( KEEP_COLOR )); then
            _sanitize_v "$line" 1;
            clean=$SGRTEXT;
        else
            _sanitize_v "$line" 0;
            clean=$PLAIN;
        fi;
        _plain_v "$line";
        plainkey=$PLAIN;
        plainkey=${plainkey#"${plainkey%%[![:space:]]*}"};
        [[ -z $plainkey ]] && return 0;
        key=${plainkey%%[[:space:]]*};
        rest=${plainkey#"$key"};
        rest=${rest#"${rest%%[![:space:]]*}"};
        case ${key^^} in 
            @@STEP)
                if [[ -z $rest ]]; then
                    _clear_step;
                else
                    if [[ $rest == '@@IF' ]]; then
                        _clear_step_rules;
                    else
                        if [[ $rest == '@@IF '*' @@THEN '* ]]; then
                            _add_step_rule "${rest#@@IF }" || _push_log "${CURRENT:-general}" "invalid @@STEP rule: $rest";
                            return;
                        else
                            _set_step "$rest";
                        fi;
                    fi;
                fi;
                _draw 1;
                return
            ;;
            @@COMP)
                [[ -z $rest ]] && return;
                _clear_step;
                _clear_step_rules;
                if [[ -n $CURRENT && $CURRENT != "$rest" && -z ${REPORT[$CURRENT]:-} ]]; then
                    _timer_stop "$CURRENT";
                fi;
                CURRENT=$rest;
                _touch_comp "$CURRENT";
                STATUS[$CURRENT]="${ACT_TEXT[1],,}";
                [[ -n ${TDONE[$CURRENT]:-} ]] && unset "TDONE[$CURRENT]";
                _timer_start "$CURRENT";
                _note_width "$CURRENT";
                LDIRTY[$CURRENT]=1;
                LEFT_VALID=0;
                REVIEW=0;
                _draw 1;
                return
            ;;
            @@REPORT)
                [[ -z $rest ]] && return;
                _clear_step;
                if [[ -n $CURRENT && -z ${REPORT[$CURRENT]:-} ]]; then
                    _timer_stop "$CURRENT";
                fi;
                T_LAST=$(_now_ms);
                CURRENT=$rest;
                _touch_comp "$CURRENT";
                REPORT[$CURRENT]=1;
                STATUS[$CURRENT]="ok";
                LEFT_VALID=0;
                REVIEW=1;
                _draw 1;
                return
            ;;
            @@FOCUS)
                if [[ -z $rest ]]; then
                    FOCUS="";
                else
                    _touch_comp "$rest";
                    FOCUS=$rest;
                fi;
                _draw 1;
                return
            ;;
            @@OK | @@FAIL)
                target=${rest:-$CURRENT};
                [[ -z $target ]] && return;
                _clear_step;
                _touch_comp "$target";
                if [[ ${key^^} == @@OK ]]; then
                    STATUS[$target]="ok";
                    _timer_stop "$target";
                    LDIRTY[$target]=1;
                    LEFT_VALID=0;
                else
                    _mark_fail "$target";
                fi;
                _note_width "$target";
                _draw 1;
                return
            ;;
            @@HIGHLIGHT)
                if [[ -z $CURRENT ]]; then
                    CURRENT="general";
                    _touch_comp "$CURRENT";
                    _timer_start "$CURRENT";
                fi;
                hpay=${clean#*"$key"};
                hpay=${hpay#"${hpay%%[![:space:]]*}"};
                if [[ -z $rest ]]; then
                    _clear_highlight "$CURRENT";
                else
                    _push_highlight "$CURRENT" "$hpay";
                fi;
                _draw 1;
                return
            ;;
        esac;
        if [[ -z $CURRENT ]]; then
            CURRENT="general";
            _touch_comp "$CURRENT";
            _timer_start "$CURRENT";
        fi;
        _apply_step_rules "$plainkey";
        _push_log "$CURRENT" "$clean";
        _draw
    };
    _open_tty;
    _read_geom;
    printf '\033[?25l';
    printf '\033[?7l';
    trap '_finish' EXIT;
    trap 'exit 130' INT;
    trap 'exit 143' TERM;
    trap 'GEOM_DIRTY=1; FULL_CLEAR=1' WINCH;
    printf '\033[2J\033[H';
    local line rc;
    while true; do
        line="";
        if IFS= read -r -t "$TICK_SEC" line; then
            _handle_line "$line";
        else
            rc=$?;
            if (( rc > 128 )); then
                _timer_tick && _draw 1;
                continue;
            fi;
            [[ -n $line ]] && _handle_line "$line";
            break;
        fi;
        _timer_tick && _draw;
    done;
    _stop_all_timers;
    (( T_LAST == 0 )) && T_LAST=$(_now_ms);
    LEFT_VALID=0;
    local c;
    for c in "${ORDER[@]}";
    do
        [[ -n $c ]] && LDIRTY[$c]=1;
    done;
    REVIEW=1;
    _clear_step;
    _draw 1 )
}
act_panelled_logs_askpass () 
{ 
    local askpass_helper="$1";
    local askpass_env="$2";
    ( umask 077;
    read -r -d '' template <<'EOF'
#!/bin/bash
if [ -n "$ASKPASS_ENV" ]; then
  printf '%s\n' "$ASKPASS_ENV"
else
  exec 8<>/dev/tty 2>/dev/null || exit 1
  # size and style
  rows=$(stty size <&8 | cut -d' ' -f1)
  saved=$(stty -g <&8) || exit 1
  # restore screen
  trap 'stty "$saved" <&8 2>/dev/null; printf "\033[%d;1H\033[K" "${rows:-1}" >&8' EXIT INT TERM HUP PIPE
  stty -echo <&8
  # last row: _draw only ever writes rows 1..rows-1, so this is never repainted
  printf '\033[%d;1H\033[K%s' "${rows:-1}" "$1" >&8
  IFS= read -r pw <&8
  printf '\033[%d;1H\033[K' "${rows:-1}" >&8
  printf '%s\n' "$pw"
fi
EOF

    printf '%s\n' "${template//ASKPASS_ENV/$askpass_env}" > "$askpass_helper" ) && chmod 700 "$askpass_helper"
}
act_resolve_args () 
{ 
