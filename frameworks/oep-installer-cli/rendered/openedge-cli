debian_30_install_docker_ce () 
{ 
    configure_docker_ce "$@";
    if docker version > /dev/null 2>&1 && docker buildx version > /dev/null 2>&1 && docker compose version > /dev/null 2>&1 && [[ " $* " != *" --reinstall "* ]]; then
        echo "docker is installed." 1>&2;
    else
        if ensure_apt_is_installed docker.io && [[ " $* " != *" --reinstall "* ]]; then
            ensure_apt update;
            ensure_apt install -y docker-buildx docker-compose-v2;
        else
            if ensure_apt_is_installed docker-ce && [[ " $* " != *" --reinstall "* ]]; then
                ensure_apt update;
                ensure_apt install -y docker-buildx-plugin docker-compose-plugin;
            else
                ensure_disk_size 800;
                ensure_prop set installed/docker_ce/owned true;
                ensure_prop remove installed/docker_io/owned;
                echo "Remove legacy installation";
                debian_30_remove_docker_ce "$@";
                ensure_sudo mkdir -p /etc/systemd/system/docker.service.d;
                ensure_sudo tee /etc/systemd/system/docker.service.d/10-socket.conf <<EOF
[Unit]
Requires=docker.socket
After=docker.socket
EOF

                ensure_sudo systemctl daemon-reload;
                ensure_sudo systemctl reset-failed docker.service docker.socket containerd.service 2> /dev/null || true;
                ensure_group_add docker:;
                ensure_apt_key $key_file $key_url;
                ensure_apt_source $apt_file "$apt_entry";
                ensure_apt update -y;
                ensure_apt install -y docker-ce docker-buildx-plugin docker-compose-plugin;
                ensure_sudo systemctl daemon-reload;
                ensure_sudo systemctl reset-failed docker.service docker.socket containerd.service 2> /dev/null || true;
                ensure_sudo systemctl enable --now containerd.service;
                ensure_sudo systemctl enable --now docker.socket;
                ensure_sudo systemctl start docker.service;
                local deadline=$((SECONDS+60));
                until ensure_sudo docker info > /dev/null 2>&1; do
                    [ $SECONDS -lt $deadline ] || { 
                        echo -e "${red}dockerd did not become ready${reset}" 1>&2;
                        ensure_sudo systemctl status docker.socket --no-pager 1>&2;
                        ensure_sudo systemctl status docker.service --no-pager 1>&2;
                        ensure_sudo journalctl -u docker.socket -u docker.service --since "-5 min" --no-pager 1>&2;
                        return 1
                    };
                    if ensure_sudo systemctl is-failed --quiet docker.service docker.socket; then
                        ensure_sudo systemctl reset-failed docker.service docker.socket 2> /dev/null || true;
                        ensure_sudo systemctl start docker.socket 2> /dev/null || true;
                        ensure_sudo systemctl start docker.service 2> /dev/null || true;
                    fi;
                    sleep 1;
                done;
            fi;
        fi;
    fi;
    configure_docker
}
