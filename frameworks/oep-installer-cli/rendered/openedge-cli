# perform sudo in automation or in tty
ensure_sudo () {
  if sudo -nv 2>/dev/null || sudo -n true 2>/dev/null; then
    # cached timestamp still valid or passwordless sudo: no password needed
    sudo "$@"
  elif [ -n "$SUDO_PASSWORD" ]; then
    # Non-interactive password. Feed it on the first stdin line via `sudo -S`
    # and never write it to disk. `cat` forwards any remaining piped stdin to
    # the invoked command so constructs like `curl ... | ensure_sudo tee file`
    # keep working.
    (echo "$SUDO_PASSWORD"; cat) | sudo -kS "$@"
  elif [ -t 0 ]; then
    # genuine interactive terminal: safe to prompt for a password
    sudo "$@"
  else
    # No password available and no usable TTY (e.g. under the panelled UI or a
    # pipe/background job). Avoid hanging forever on a hidden password prompt.
    echo "ensure_sudo: sudo requires a password but none is available; set SUDO_PASSWORD or run 'sudo -v' first" 1>&2
    return 1
  fi
}


# create/destroy a tmpdir with trap to delete the folder on ERR
ensure_tmpdir () {
  # $1: op
  # $2: varname in create or tmpdir in destroy
  # $3: prefix in create
  case "$1" in
  create)
    printf -v $2 "%s" $(mktemp -d /tmp/openedge-cli-${3:-}.XXXXXX)
    trap "ensure_sudo rm -rf ${!2}" ERR SIGINT EXIT
    ;;
  destroy)
    trap - ERR SIGINT EXIT
    rm -rf "$2"
    ;;
  esac
}


# apt with apt update executed only once
ensure_apt () {
  local no_proxy1=$(echo ${no_proxy:-$NO_PROXY} | tr ',' '\n' | grep -v -E '^[.]?intel.com$' | tr '\n' ',')
  case "$1" in
  update)
    # apt-get update got executed only once unless -y is specified
    [ ! -e /dev/shm/apt_update ] || [[ " $* " = *" -y "* ]] || return 0
    ensure_sudo env DEBIAN_FRONTEND=noninteractive no_proxy=${no_proxy1%%,} NO_PROXY=${no_proxy1%%,} apt-get "$@"
    touch /dev/shm/apt_update
    ;;
  autoremove|remove|purge)
    # make sure the package list exists
    local package_list=()
    local options=()
    for v in ${*:2}; do
      if [[ "$v" = -* ]]; then
        options+=($v)
      else
        package_list+=($v)
      fi
    done
    if [ ${#package_list[*]} -gt 0 ]; then
      local valid_packages=($(dpkg-query -W -f='${Status} ${Package}\n' ${package_list[*]} 2>/dev/null | awk '/installed/{print $4}'))
      if [ ${#valid_packages[*]} -gt 0 ]; then
        ensure_sudo env DEBIAN_FRONTEND=noninteractive no_proxy=${no_proxy1%%,} NO_PROXY=${no_proxy%%,} apt-get $1 -y ${options[*]} ${valid_packages[*]}
      fi
    fi
    ;;
  *)
    ensure_sudo env DEBIAN_FRONTEND=noninteractive no_proxy=${no_proxy1%%,} NO_PROXY=${no_proxy%%,} apt-get -y "$@"
    ;;
  esac
}


ensure_rm_apt_source () {
  local r e
  for r in "$@"; do
    [ -r /etc/apt/sources.list ] && sed -i "s|^\(deb.*$r\)|#\1|" /etc/apt/sources.list || true
    for e in /etc/apt/sources.list.d/*.list; do
      [ -r "$e" ] && grep -s -q -E "deb.*$r" "$e" && mv -f "$e" "$e".save || true
    done
  done
}


