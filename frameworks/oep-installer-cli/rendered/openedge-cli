  if verify_multimodal_weld_defect_detection && [[ " $* " != *" --reset-multimodal_weld_defect_detection "* ]]; then
    echo "Multimodal weld defect detection is already installed. Skipping"
  else
    local device
    device="$(ensure_select_device "$@")"

    ensure_disk_space 64000
    ensure_ram_size 16777216 # 16 GiB
    debian_90_stop_multimodal_weld_defect_detection "$@" || true
