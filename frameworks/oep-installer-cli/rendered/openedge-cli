verify_amr_apt_repo () {
  configure_amr_apt_repo
  [ -r "$amr_key_file" ] && [ -r "$amr_list" ] && [ -r "$oneapi_list" ]
}

debian_45_install_amr_apt_repo () {
  configure_amr_apt_repo

  if verify_amr_apt_repo && [[ " $* " != *" --reset-amr_apt_repo "* ]]; then
    echo "AMR apt repositories are already configured. Skipping..."
  else
    ensure_apt install -y software-properties-common curl gnupg wget

    # AMR archive key + sources + pin
    ensure_sudo mkdir -p "$(dirname "$amr_key_file")"
    no_proxy= NO_PROXY= curl -fsL "$amr_key_url" | ensure_sudo tee "$amr_key_file" > /dev/null
    printf 'deb [signed-by=%s] https://amrdocs.intel.com/repos/%s amr main\ndeb-src [signed-by=%s] https://amrdocs.intel.com/repos/%s amr main\n' \
      "$amr_key_file" "$VERSION_CODENAME" "$amr_key_file" "$VERSION_CODENAME" | ensure_sudo tee "$amr_list" > /dev/null
    printf 'Package: *\nPin: origin amrdocs.intel.com\nPin-Priority: 1001\n' | ensure_sudo tee "$amr_pref" > /dev/null

    # Intel oneAPI Base Toolkit key + source + pins
    no_proxy= NO_PROXY= curl -fsL "$oneapi_key_url" | gpg --dearmor | ensure_sudo tee "$oneapi_key_file" > /dev/null
    echo "deb [signed-by=$oneapi_key_file] https://apt.repos.intel.com/oneapi all main" | ensure_sudo tee "$oneapi_list" > /dev/null
    printf 'Package: intel-oneapi-runtime-*\nPin: version 2025.3.*\nPin-Priority: 1001\n\nPackage: intel-oneapi-compiler-*\nPin: version 2025.3.*\nPin-Priority: 1001\n\nPackage: intel-oneapi-mkl-*\nPin: version 2025.3.*\nPin-Priority: 1001\n' | ensure_sudo tee "$oneapi_pref" > /dev/null

    # Canonical kobuk PPA for latest Intel silicon support (best-effort)
    ensure_sudo add-apt-repository -y ppa:kobuk-team/intel-graphics || true

    ensure_apt update -y
  fi
}

debian_45_remove_amr_apt_repo () {
  configure_amr_apt_repo
  ensure_sudo rm -f "$amr_key_file" "$amr_list" "$amr_pref" \
    "$oneapi_key_file" "$oneapi_list" "$oneapi_pref"
}
main "$@"
