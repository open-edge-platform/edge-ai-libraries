
configure_nodejs () {
  version="$(ensure_parse_value_option version --version=22 "$@")"
  repo_script="https://deb.nodesource.com/setup_$version.x"

  nodejs_repo="deb.nodesource.com"
  nodejs_key_url="https://$nodejs_repo/gpgkey/nodesource-repo.gpg.key"
  nodejs_key_file=/etc/apt/keyrings/nodesource.gpg
  nodejs_source=(
    "deb [signed-by=$nodejs_key_file] https://$nodejs_repo/node_$version.x nodistro main"
  )
  nodejs_list_file=/etc/apt/sources.list.d/nodesource.list
}

debian_70_profile_nodejs () {
  echo "curl gnupg"
}

debian_70_install_nodejs () {
  configure_nodejs "$@"
  if ensure_apt_is_installed nodejs; then
    echo "nodejs is installed" >&2
  else
    ensure_prop set installed/nodejs/owned true
    ensure_apt_key "$nodejs_key_file" "$nodejs_key_url" --dearmor
    ensure_apt_source "$nodejs_list_file" "${nodejs_source[@]}"
    ensure_apt update -y
    ensure_apt install -y "nodejs=$version.*"
  fi
}

debian_70_remove_nodejs () {
  [ "$(ensure_prop get installed/nodejs/owned)" = "true" ] || return 0
  ensure_apt_remove_package nodejs
  ensure_rm "$nodejs_list_file" "$nodejs_key_file"
}

debian_70_sbom_nodejs () {
  configure_nodejs "$@"
  ensure_sbom_format repo-name "$nodejs_repo"
  ensure_sbom_format gpg-key "$nodejs_key_url"
  ensure_sbom_format key-file "$nodejs_key_file"
  ensure_sbom_format apt-source "${nodejs_source[@]}"
  ensure_sbom_format apt-list-file "$nodejs_list_file"
  ensure_sbom_format pkg-list "nodejs=$version.*"
}

