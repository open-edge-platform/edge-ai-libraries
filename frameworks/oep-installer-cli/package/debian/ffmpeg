configure_ffmpeg () {
  packages=(
    ffmpeg "$(apt-cache search libx264-16* | head -n1 | cut -f1 -d' ')"
  )
}

debian_70_install_ffmpeg () {
  configure_ffmpeg "$@"
  ensure_apt_install_package "${packages[@]}"
}

debian_70_remove_ffmpeg () {
  configure_ffmpeg "$@"
  ensure_apt_remove_package "${packages[@]}"
}

debian_70_sbom_ffmpeg () {
  configure_ffmpeg "$@"
  ensure_sbom_format pkg-list "${packages[@]}"
}
