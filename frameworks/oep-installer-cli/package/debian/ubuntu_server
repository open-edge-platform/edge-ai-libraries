
debian_45_install_ubuntu_server () {
  if ( ensure_apt_is_installed ubuntu-desktop || ensure_apt_is_installed ubuntu-desktop-minimal || ensure_apt_is_installed gdm3 ) && [[ " $* " != *" --reinstall "* ]]; then
    ensure_sudo systemctl set-default multi-user.target
    ensure_sudo systemctl disable --now gdm3 
    ensure_apt  update
    ensure_apt  install -y --no-install-recommends ubuntu-server
    ensure_apt  purge -y --auto-remove ubuntu-desktop ubuntu-desktop-minimal gdm3
  fi
}

debian_45_sbom_ubuntu_server () {
  ensure_sbom_format pkg-list ubuntu-server -ubuntu-desktop -ubuntu-desktop-minimal -gdm3
}

