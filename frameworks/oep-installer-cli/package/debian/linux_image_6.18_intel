
debian_25_profile_linux_image_6.18_intel () {
  [[ "$(uname -r)" = "6.18-intel" ]] || echo "reboot"
}

debian_25_install_linux_image_6.18_intel () {
  if [[ "$(uname -r)" = "6.18-intel" ]]; then
    echo "kernel 6.18-intel is installed" >&2
  else
    echo "@@STEP Installing linux-image-6.18-intel"
    ensure_apt install linux-image-6.18-intel
    ensure_grub_set_kernel_args GRUB_CMDLINE_LINUX xe.max_vfs=7 "xe.force_probe=*" modprobe.blacklist=i915 udmabuf.list_limit=8192
    ensure_grub_set_default_entry 6.18-intel
    configure_reboot
  fi
}

