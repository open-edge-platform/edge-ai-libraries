
configure_uv () {
  configure_pipx "$@"
}

fedora_50_profile_uv () {
  echo "pipx"
}

fedora_50_install_uv () {
  configure_uv "$@"
  if uv --version 2> /dev/null && [[ " $* " != *" --reinstall "* ]]; then
    echo "Uv is already installed. Skipping..."
  else
    pipx install uv
    ensure_prop set installed/uv/owned true
  fi
}

fedora_50_remove_uv () {
  configure_pipx "$@"
  # leave untouched if not installed by uv
  [ "$(ensure_prop get installed/uv/owned)" = "true" ] || return 0
  pipx uninstall uv
}

