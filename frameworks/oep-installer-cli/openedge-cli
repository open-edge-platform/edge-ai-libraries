#!/bin/bash

# common variable: ID_LIKE
. /etc/os-release
trap "main $*" EXIT

main () {
  trap - EXIT

  local args=() cmd=""
  for v in $*; do
    case $v in
    --help)
      local cmds=($(declare -F | grep " subcommand_" | cut -f2- -d_))
      echo "Usage: <$(IFS='|';echo "${cmds[*]}")> <subcommand> component [component...]"
      echo "common options:"
      echo "  --help          this help message" 
      echo
      for cmd in $(declare -F | grep -E " subcommand_" | cut -f3 -d' '); do
        $cmd --help
      done
      exit 0
      ;;
    --*)
      args+=($v)
      ;;
    *)
      if declare -F subcommand_$v > /dev/null; then
        cmd=$v
      else
        args+=($v)
      fi
      ;;
    esac
  done

  # show help if cmd is not specified
  [ -n "$cmd" ] || main --help

  # exec subcommand
  subcommand_$cmd ${args[*]}
}

subcommand_install () {
  if [[ "$*" = "--help" ]]; then
    echo "install options:"
    echo "  --dry-run       dry-run the installation sequence."
    echo
    local components=($(declare -F | grep -E " ${ID_LIKE}_[0-9]+_install_" | cut -f4- -d_))
    local profiles=($(declare -F | grep -E " ${ID_LIKE}_[0-9]+_profile_" | cut -f4- -d_))
    mapfile -t profiles < <(printf '%s\n' ${profiles[*]} | grep -Fxv -f <(printf '%s\n' ${components[*]}))
    if [ ${#profiles[*]} -gt 0 ]; then
      echo "  list of installable profiles:"
      echo "    ${profiles[*]}"
    fi
    if [ ${#components[*]} -gt 0 ]; then
      echo "  list of installable components:"
      echo "    ${components[*]}"
    fi
    return 0
  fi

  # scan for dependencies
  local modules=(${*//#--*/})
  local installers=() i=0 installer
  while [ $i -lt ${#modules[*]} ]; do
    local profiler=$(declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_profile_${modules[$i]}$" | cut -f3 -d' ')
    [ -z "$profiler" ] || modules+=($($profiler))
    installer=$(declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_install_${modules[$i]}$" | cut -f3 -d' ')
    if [ -n "$installer" ]; then
      installers+=($installer)
    else
      echo "Unknown component or profile: ${modules[$i]}"
      exit 3
    fi
    i=$((i+1))
  done

  # install in sequence
  if [ ${#installers[*]} -gt 0 ]; then
    logecho () {
      awk -v n="$1" '{print strftime("%s"),n,$0;fflush()}'
    }
    for installer in $(echo "${installers[*]}" | tr ' ' '\n' | sort | uniq); do
      local name=$(echo $installer | cut -f4- -d_)
      echo "==== installing $name ====" > >(logecho $name)
      [[ "$*" = *"--dry-run"* ]] || $installer ${*/#[!--]*/} > >(logecho $name) 2> >(logecho $name) || exit
    done
  else
    echo "No installer defined" 1>&2
    exit 3
  fi

  # wait for background processes
  wait
}

subcommand_bootstrap () {
  if [[ "$*" = "--help" ]]; then
    echo "bootstrap options:"
    echo "  --dry-run       dry-run the bootstrap sequence."
    echo
    return 0
  fi
  
  # scan for dependencies
  local mydir="$(dirname "$(readlink -f "$0")")"
  local modules=(${*//#--*/})
  local scripts=() i=0 script
  while [ $i -lt ${#modules[*]} ]; do
    local script="$mydir"/profile/${ID_LIKE}_${modules[$i]}
    [ -r "$script" ] || script="$mydir"/module/${ID_LIKE}_${modules[$i]}
    if [ -r "$script" ]; then
      scripts+=("$script")
      . "$script"
      local profiler=$(declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_profile_${modules[$i]}$" | cut -f3 -d' ')
      [ -z "$profiler" ] || modules+=($($profiler))
    else
      echo "Unknown component or profile: ${modules[$i]}" 1>&2
      exit 3
    fi
    i=$((i+1))
  done

  if [ ${#scripts[@]} -gt 0 ]; then
    sed -i "$0" '/^subcommand_bootstrap [(][)]/,$/{d}' "$0"
    for script in "${scripts[@]}"; do
      cat "$script" >> "$0"
    done
  else
    echo "No installer defined" 1>&2
    exit 3
  fi
}


