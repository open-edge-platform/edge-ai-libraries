#!/bin/bash

# common variable: ID_LIKE
. /etc/os-release
trap "main $*" EXIT

main () {
  trap - EXIT

  local args=() cmd=""
  for v in $*; do
    case $v in
    --help)
      local cmds=($(declare -F | grep " subcommand_" | cut -f2- -d_))
      echo "Usage: <$(IFS='|';echo "${cmds[*]}")> component [component...]"
      echo "common options:"
      echo "  --help          this help message" 
      echo
      for cmd in $(declare -F | grep -E " subcommand_" | cut -f3 -d' '); do
        $cmd --help
      done
      exit 0
      ;;
    *)
      if declare -F subcommand_$v > /dev/null; then
        cmd=$v
      else
        args+=($v)
      fi
      ;;
    esac
  done

  # show help if cmd is not specified
  [ -n "$cmd" ] || main --help

  # exec subcommand
  subcommand_$cmd ${args[*]}
}

act_extract_modules () {
  local act_name=$1
  local all_cmds=($(declare -F | grep -E " subcommand_" | cut -f2- -d_) profile)
  local all_modules=($(declare -F | grep -E " ${ID_LIKE}_[0-9]+_($(IFS='|';echo "${all_cmds[*]}"))_" | cut -f4- -d_))
  local all_module_args=" ${all_modules[*]/#/--} "
  local -A modules=()
  local v
  for v in ${*:2}; do
    [[ " ${all_module_args} " != *" $v "* ]] || break
    [[ " ${all_module_args} " != *" --$v "* ]] || modules[$v]=1
  done
  echo "${!modules[*]}"
}

act_extract_args () {
  local act_name=$1
  local module_name=$2
  local all_cmds=($(declare -F | grep -E " subcommand_" | cut -f2- -d_) profile)
  local all_modules=($(declare -F | grep -E " ${ID_LIKE}_[0-9]+_($(IFS='|';echo "${all_cmds[*]}"))_" | cut -f4- -d_))
  local all_module_args=" ${all_modules[*]/#/--} "
  local args1=() args2=() i j
  for ((i=3;i<=${#*};i++)); do
    if [[ " ${all_module_args} " = *" ${*:$i:1} "* ]]; then
      for ((j=++i;j<=${#*};j++)); do
        [[ " ${all_module_args} " != *" ${*:$j:1} "* ]] || break
      done
      [ "${*:$((i-1)):1}" != "--${module_name}" ] || args2+=(${*:$i:$((j-i))})
      i=$((j-1))
    elif [[ " ${all_module_args} " != *" --${*:$i:1} "* ]]; then
      args1+=(${*:$i:1})
    fi
  done
  echo "${args1[*]} -- ${args2[*]}"
}

act_find_deps () {
  local act_name=$1 i=0
  local modules=($(act_extract_modules $*))
  local -A handlers=()
  while [ $i -lt ${#modules[*]} ]; do
    local profiler=$(declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_profile_${modules[$i]}$" | cut -f3 -d' ')
    [ -z "$profiler" ] || modules+=($($profiler $act_name))
    local handler=$(declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_${act_name}_${modules[$i]}$" | cut -f3 -d' ')
    if [ -n "$handler" ]; then
      handlers[$handler]=1
    fi
    i=$((i+1))
  done
  echo "${!handlers[*]}"
}

act_helpper () {
  local act_name=$1
  local sort_options="$2"
  shift
  shift

  if [[ "$*" = *"--help"* ]]; then
    local components=($(declare -F | grep -E " ${ID_LIKE}_[0-9]+_${act_name}_" | cut -f4- -d_))
    if [ ${#components[*]} -gt 0 ]; then
      echo "${act_name} options:"
      echo "  --dry-run       dry-run the ${act_name} sequence."
      echo "  --continue      continue execution upon errors."
      if [ "${act_name}" = "install" ]; then
        echo "  --reset-<name>  force reinstallation of the component if exit."
      fi
      echo
    fi
    local profiles=()
    for profiler in $(declare -F | grep -E " ${ID_LIKE}_[0-9]+_profile_" | cut -f4- -d_); do
      local handles=($(act_find_deps $act_name $profiler 2> /dev/null))
      [ ${#handles[@]} -eq 0 ] || profiles+=($profiler)
    done
    mapfile -t profiles < <(printf '%s\n' ${profiles[*]} | grep -Fxv -f <(printf '%s\n' ${components[*]}))
    [ ${#profiles[*]} -eq 0 ] || echo "  list of profiles: ${profiles[*]}"
    [ ${#components[*]} -eq 0 ] || echo "  list of components: ${components[*]}"
    [ "${#profiles[*]}${#components[*]}" = "00" ] || echo
    return 0
  fi

  # scan for dependencies
  local handles=($(act_find_deps $act_name $*))

  # act in sequence
  if [ ${#handles[@]} -gt 0 ]; then
    logecho () {
      awk -v n=$1 '{print strftime("%s"),n,$0;fflush()}'
    }
    local start_t=$SECONDS reports=() rc=0
    for handler in $(echo "${handles[*]}" | tr ' ' '\n' | sort $sort_options); do
      name=$(echo $handler | cut -f4- -d_)
      if [[ " $* " = *" --dry-run "* ]]; then
        echo "Invoke $handler with $(act_extract_args $act_name $name $*)" > >(logecho $name)
      else
        local start_c=$SECONDS
        (
          set -e
          $handler $(act_extract_args $act_name $name $*)
        ) > >(logecho $name) 2> >(logecho $name)
        local rc1=$?
        reports+=("$name:rc=$rc1:$(( SECONDS - start_c )) seconds")
        if [ $rc1 -ne 0 ]; then
          rc=$rc1
          [[ " $* " = *" --continue "* ]] || break
        fi
      fi
    done
    # wait for background processes
    wait
    local end_t=$SECONDS

    if [ ${#reports[@]} -gt 0 ]; then
      echo
      echo "======== ${act_name^^} REPORT ========"
      for line in "${reports[@]}"; do
        if [[ "$line" = *":rc=0:"* ]]; then
          echo "$line"
        else
          echo -e "\033[31m$line\033[0m"
        fi
      done | column -s: -t
      echo "Total duration: $(( end_t - start_t )) seconds"
    fi
    return $rc
  else
    echo "Component not found" 1>&2
    exit 3
  fi
}

subcommand_install () {
  act_helpper install "" "$@"
}

subcommand_remove () {
  act_helpper remove "-r" "$@"
}

subcommand_start () {
  act_helpper start "" "$@"
}

subcommand_stop () {
  act_helpper stop "-r" "$@"
}

#### COLLECTION OF MODULES ####

# perform sudo in automation or in tty
ensure_sudo () {
  if [ -n "$SUDO_PASSWORD" ]; then
    echo "$SUDO_PASSWORD" | sudo -S "$@"
  else
    sudo "$@"
  fi
}

# create/destroy a tmpdir with trap to delete the folder on ERR
ensure_tmpdir () {
  # $1: op
  # $2: varname in create or tmpdir in destroy
  # $3: prefix in create
  case "$1" in
  create)
    printf -v $2 "%s" $(mktemp -d /tmp/openedge-cli-${3:-}.XXXXXX)
    trap "ensure_sudo rm -rf ${!2}" ERR SIGINT EXIT
    ;;
  destroy)
    trap - ERR SIGINT EXIT
    rm -rf "$2"
    ;;
  esac
}

# sparse or full git clone
ensure_git_clone () {
  local workspace="$1"
  local version="$2"
  local repository="$3"

  ensure_rmdir "$workspace"
  mkdir -p "$(dirname "$workspace")"
  if [ ${#@} -ge 4 ]; then
    # sparse checkout
    mkdir -p "$workspace"
    pushd "$workspace" > /dev/null
    git clone --filter=blob:none --no-checkout $repository .
    git sparse-checkout init --cone
    git sparse-checkout set "${@:4}"
    git checkout $version
    popd > /dev/null
  else
    # full checkout
    git clone -b $version --depth 1 $repository "$workspace"
    pushd "$workspace" > /dev/null
    [ ! -e .gitmodule ] || git submodule update --init --recurse
    popd > /dev/null
  fi
}

# return the current machine IP address
ensure_ip () {
  ip -4 addr show scope global | sed -n '/^[0-9]*:.*state UP/,/^[0-9]*:/{/^ *inet /{s|.*inet \([0-9.]*\).*|\1|;p}}' | head -n1
}

# completely remove dir
ensure_rmdir () {
  rm -rf "$1" 2> /dev/null || ensure_sudo rm -rf "$1"
}

# idempotently pull an image and (re)create a detached named container.
# generic helper for docker-image based ISV applications.
# $1: container name  $2: image reference  ${@:3}: extra "docker run" args
ensure_docker_container () {
  local name="$1"
  local image="$2"

  # already running or stopped-but-present: leave as-is
  if docker inspect "$name" > /dev/null 2>&1; then
    echo "Container $name already exists. Skipping create..."
    return 0
  fi

  echo "Pulling image $image (this may take several minutes for large images)..."
  docker pull "$image"
  docker run -dt --name "$name" "${@:3}" "$image"
}

# apt with apt update executed only once
ensure_apt () {
  case "$1" in
  update)
    # apt-get update got executed only once unless -y is specified
    [ ! -e /dev/shm/apt_update ] || [ "$*" != "-y" ] || return 0
    ensure_sudo DEBIAN_FRONTEND=noninteractive apt-get "$@"
    touch /dev/shm/apt_update
    ;;
  *)
    ensure_sudo DEBIAN_FRONTEND=noninteractive apt-get "$@"
    ;;
  esac
}


# ISV applications category. Groups third-party (independent software vendor)
# applications so they can be installed together with a single name:
#   ./openedge-cli install isv
# To add a new ISV application, create module/debian_<name> following the
# module/debian_unstructured example and append its <name> to the list below.
debian_95_profile_isv () {
  echo "unstructured"
}
# ISV application example: Unstructured (https://github.com/Unstructured-IO/unstructured)
# Open-source pre-processing tools for turning documents (PDF, HTML, DOCX, ...)
# into structured data. Shipped and run as the upstream docker image so that all
# system dependencies (poppler, tesseract, libreoffice, ...) are self-contained.
configure_unstructured () {
  container_name=unstructured
  image=downloads.unstructured.io/unstructured-io/unstructured:latest
  workspace="$(readlink -f ~)/openedge-catalog/unstructured"
}

debian_95_profile_unstructured () {
  echo "docker curl"
}

debian_95_install_unstructured () {
  configure_unstructured
  if docker inspect "$container_name" > /dev/null 2>&1 && [[ "$*" != *"--reset-unstructured"* ]]; then
    echo "Unstructured is already installed. Skipping..."
    return 0
  fi

  # drop any previous container when re-installing
  [[ "$*" != *"--reset-unstructured"* ]] || docker rm -f "$container_name" 2> /dev/null || true

  mkdir -p "$workspace"
  ensure_docker_container "$container_name" "$image" -v "$workspace":/data
}

debian_95_start_unstructured () {
  configure_unstructured
  docker start "$container_name" > /dev/null

  # prove the library works by partitioning one of the bundled example docs
  echo "Running Unstructured partition demo..."
  docker exec "$container_name" python3 -c '
from unstructured.partition.auto import partition
elements = partition(filename="example-docs/eml/fake-email.eml")
print("\n\n".join(str(el) for el in elements))
'
  echo
  echo "Unstructured is running in container \"$container_name\"."
  echo "Open a shell with: docker exec -it $container_name bash"
  echo "Host directory $workspace is mounted at /data inside the container."
}

debian_95_stop_unstructured () {
  configure_unstructured
  docker stop "$container_name" 2> /dev/null || true
}

debian_95_remove_unstructured () {
  configure_unstructured
  docker rm -f "$container_name" 2> /dev/null || true
  ensure_rmdir "$workspace"
}
debian_10_install_curl () {
  if dpkg-query -L curl > /dev/null 2>&1; then
    echo "Curl is already installed. Skipping..."
  else
    ensure_apt update
    ensure_apt install --no-install-recommends -y curl ca-certificates
  fi
}


configure_docker_proxies () {
  echo "Configure docker engine proxies..."
  [ -z "${http_proxy:-$HTTP_PROXY}${https_proxy:-$HTTPS_PROXY}" ] || \
    grep -q -E 'HTTPS*_PROXY=' /etc/systemd/system/docker.service.d/*.conf 2>/dev/null || (
      ensure_sudo mkdir -p /etc/systemd/system/docker.service.d
      cat | ensure_sudo tee /etc/systemd/system/docker.service.d/proxy.conf <<EOF
[Service]
Environment="HTTP_PROXY=${http_proxy:-$HTTP_PROXY}"
Environment="HTTPS_PROXY=${https_proxy:-$HTTPS_PROXY}"
Environment="NO_PROXY=${no_proxy:-$NO_PROXY}"
EOF
      ensure_sudo systemctl daemon-reload
      ensure_sudo systemctl restart docker
    )

  local CONFIG_JSON=~/.docker/config.json
  echo "Configure docker client proxies..."
  grep -q -F '"proxies"' $CONFIG_JSON 2> /dev/null || (
    mkdir -p "$(dirname $CONFIG_JSON)"
    python3 - "$CONFIG_JSON" <<'EOF'
import json, os, sys
p = sys.argv[1]
cfg = json.load(open(p)) if os.path.exists(p) else {}
cfg.setdefault("proxies", {})["default"] = {
    "httpProxy":  os.environ.get("http_proxy",  os.environ.get("HTTP_PROXY", "")),
    "httpsProxy": os.environ.get("https_proxy", os.environ.get("HTTPS_PROXY", "")),
    "noProxy":    os.environ.get("no_proxy",    os.environ.get("NO_PROXY", "")),
}
json.dump(cfg, open(p, "w"), indent=2)
EOF
  )
}

debian_20_install_docker () {
  if docker version > /dev/null 2>&1 && [[ "$*" != *"--reset-docker"* ]]; then
    echo "Docker is already installed. Skipping..."
  else
    echo "Remove legacy installation"
    ensure_apt remove -y docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc

    ensure_apt update
    ensure_apt install -y docker.io docker-buildx-plugin docker-compose-plugin

    DAEMON_JSON="/etc/docker/daemon.json"
    if [ ! -f "$DAEMON_JSON" ]; then
      ensure_sudo mkdir -p /etc/docker
      cat | ensure_sudo tee $DAEMON_JSON <<EOF
{
   "exec-opts": [
        "native.cgroupdriver=systemd"
    ]
}
EOF
    fi
    ensure_sudo systemctl daemon-reload
    ensure_sudo systemctl restart docker

    echo "Add $USER to the docker group"
    ensure_sudo usermod -aG docker $USER || true
    newgrp docker || true
  fi
  configure_docker_proxies
}

