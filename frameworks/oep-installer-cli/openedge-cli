#!/bin/bash

# common variable: ID_LIKE
. /etc/os-release
trap "main $*" EXIT
set -e

main () {
  trap - EXIT

  local args=() cmd=""
  for v in $*; do
    case $v in
    --help)
      local cmds=($(declare -F | grep " subcommand_" | cut -f2- -d_))
      echo "Usage: <$(IFS='|';echo "${cmds[*]}")> component [component...]"
      echo "common options:"
      echo "  --help          this help message" 
      echo
      for cmd in $(declare -F | grep -E " subcommand_" | cut -f3 -d' '); do
        $cmd --help
      done
      exit 0
      ;;
    --*)
      args+=($v)
      ;;
    *)
      if declare -F subcommand_$v > /dev/null; then
        cmd=$v
      else
        args+=($v)
      fi
      ;;
    esac
  done

  # show help if cmd is not specified
  [ -n "$cmd" ] || main --help

  # exec subcommand
  subcommand_$cmd ${args[*]}
}

subcommand_install () {
  if [[ "$*" = "--help" ]]; then
    local components=($(declare -F | grep -E " ${ID_LIKE}_[0-9]+_install_" | cut -f4- -d_))
    if [ ${#components[*]} -gt 0 ]; then
      echo "install options:"
      echo "  --dry-run       dry-run the installation sequence."
      echo "  --reset-<name>  force reinstallation of the component if exit."
      echo
    fi
    local profiles=($(declare -F | grep -E " ${ID_LIKE}_[0-9]+_profile_" | cut -f4- -d_))
    mapfile -t profiles < <(printf '%s\n' ${profiles[*]} | grep -Fxv -f <(printf '%s\n' ${components[*]}))
    if [ ${#profiles[*]} -gt 0 ]; then
      echo "  list of installable profiles:"
      echo "    ${profiles[*]}"
    fi
    if [ ${#components[*]} -gt 0 ]; then
      echo "  list of installable components:"
      echo "    ${components[*]}"
    fi
    echo
    return 0
  fi

  # scan for dependencies
  local modules=(${*##--*})
  local -A installers=()
  local i=0 installer
  while [ $i -lt ${#modules[*]} ]; do
    local profiler=$(declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_profile_${modules[$i]}$" | cut -f3 -d' ')
    [ -z "$profiler" ] || modules+=($($profiler))
    installer=$(declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_install_${modules[$i]}$" | cut -f3 -d' ')
    if [ -n "$installer" ]; then
      installers[$installer]=1
    elif [ -z "$profiler" ]; then
      echo "Unknown component or profile: ${modules[$i]}"
      exit 3
    fi
    i=$((i+1))
  done

  # install in sequence
  if [ ${#installers[@]} -gt 0 ]; then
    logecho () {
      awk -v n="$1" '{print strftime("%s"),n,$0;fflush()}'
    }

    local start_t=$SECONDS
    for installer in $(echo "${!installers[@]}" | tr ' ' '\n' | sort); do
      local name=$(echo $installer | cut -f4- -d_)
      echo "==== installing $name ====" > >(logecho $name)
      local start_c=$SECONDS
      [[ "$*" = *"--dry-run"* ]] || ($installer ${*/#[!--]*/}) > >(logecho $name) 2> >(logecho $name)
      local end_c=$SECONDS
      echo "==== installed $name, ellapsed $(( end_c - start_c )) seconds ====" > >(logecho $name)
    done
    # wait for background processes
    wait

    local end_t=$SECONDS
    echo "installation duration: $(( end_t - start_t )) seconds"
  else
    echo "No installable component" 1>&2
    exit 3
  fi
}

subcommand_bootstrap () {
  local mydir="$(dirname "$(readlink -f "$0")")"

  if [[ "$*" = "--help" ]]; then
    echo "bootstrap options:"
    echo "  --dry-run              dry-run the bootstrap sequence."
    echo "  --default=<component>  set default installation component."
    echo
    local profiles=($(ls -1 "$mydir/profile" | grep -E "^${ID_LIKE}_" | cut -f2- -d_))
    if [ ${#profiles[*]} -gt 0 ]; then
      echo "  list of bootstrap profiles:"
      echo "    ${profiles[*]}"
    fi
    local modules=($(ls -1 "$mydir/module" | grep -E "^${ID_LIKE}_" | cut -f2- -d_))
    if [ ${#modules[*]} -gt 0 ]; then
      echo "  list of bootstrap components:"
      echo "    ${modules[*]}"
    fi
    echo
    return 0
  fi
  
  # scan for dependencies
  local modules=(${*##--*})
  local -A scripts=()
  local i=0 script
  while [ $i -lt ${#modules[*]} ]; do
    local script="$mydir"/profile/${ID_LIKE}_${modules[$i]}
    [ -r "$script" ] || script="$mydir"/module/${ID_LIKE}_${modules[$i]}
    if [ -r "$script" ]; then
      scripts["$script"]=1
      . "$script"
      local profiler=$(declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_profile_${modules[$i]}$" | cut -f3 -d' ')
      [ -z "$profiler" ] || modules+=($($profiler))
    else
      echo "Unknown component or profile: ${modules[$i]}" 1>&2
      exit 3
    fi
    i=$((i+1))
  done

  # construct final installer
  if [ ${#scripts[@]} -gt 0 ]; then
    if [[ "$*" != *"--dry-run"* ]]; then
      sed -i '/^#### COLLECTION OF MODULES ####/q' "$0"
      local modules=(${*/#[!--default=]*/})
      if [ ${#modules[*]} -gt 0 ]; then
        sed -i "1a[ \${#@} -gt 1 ] || set -- install ${modules[*]##--default=}" "$0"
      fi
      if [ -r "$mydir"/common/${ID_LIKE} ]; then
        cat "$mydir"/common/${ID_LIKE} >> "$0"
      fi
    fi
    for script in "${!scripts[@]}"; do
      echo "==== bootstrapping ${script##*${ID_LIKE}_} ===="
      [[ "$*" = *"--dry-run"* ]] || cat "$script" >> "$0"
    done
  else
    echo "No bootstrap component" 1>&2
    exit 3
  fi
}

