#!/bin/bash

main () {
  . /etc/os-release
  red="\033[31m" green="\033[32m" yellow="\033[33m" reset="\033[0m"
  installer_name=openedge-cli
  installer_bin="$HOME/.local/bin/$installer_name"

  local _globals=() _cmds=() _args=() cur=-1 v
  for v in "$@"; do
    case $v in
    --help)
      _cmds=($(declare -F | grep " subcommand_" | cut -f2- -d_))
      echo "Usage: <$(IFS='|';echo "${_cmds[*]}")> component [component...]"
      echo "common options:"
      echo "  --help          this help message." 
      echo
      local cmd
      for cmd in $(declare -F | grep -E " subcommand_" | cut -f3 -d' '); do
        $cmd --help
      done
      return
      ;;
    --dry-run|--continue)
      _globals+=($v)
      ;;
    *)
      if declare -F subcommand_$v > /dev/null; then
        _cmds+=($v); _args+=(""); cur=$((cur+1))
      elif [ ${#_cmds[@]} -eq 0 ]; then
        echo "Unknown command: $v"
        exit 3
      elif [ $cur -ge 0 ]; then
        _args[$cur]="${_args[$cur]} $v"
      fi
      ;;
    esac
  done

  # --help if nothing specified
  if [ ${#_cmds[@]} -eq 0 ]; then
    main --help
    return
  fi

  # initialize act cache
  declare -F act_get > /dev/null && act_get init

  local _i _rc=0
  for ((_i=0;_i<${#_cmds[*]};_i++)); do
    case "${_cmds[$_i]}" in
    setup|list|bootstrap|sbom)
      subcommand_${_cmds[$_i]} ${_globals[*]} ${_args[$_i]}
      _rc=$?
      ;;
    *)
      if [[ " ${_globals[*]} " = *" --dry-run "* ]]; then
        subcommand_${_cmds[$_i]} ${_globals[*]} ${_args[$_i]}
        _rc=$?
      else
        # critical group permissions
        local -A _groups=()
        local _j _dep _rest_args=() _restart=0
        for ((_j=$_i;_j<${#_cmds[@]};_j++)); do
          _rest_args+=(${_cmds[$_j]} ${_args[$_j]})
          for _dep in $(act_find_deps install install $(act_resolve_args ${_cmds[$_j]} ${_globals[*]} ${_args[$_j]})); do
            { [[ "$_dep" = ${ID_LIKE}_*_install_gpu ]] || [[ "$_dep" = ${ID_LIKE}_*_install_npu ]]; } && _groups["render:992"]=1
            [[ "$_dep" = ${ID_LIKE}_*_install_gpu ]] && _groups["video:"]=1
            [[ "$_dep" = ${ID_LIKE}_*_install_docker ]] && _groups["docker:"]=1
          done
        done

        [ ${#_groups[*]} -eq 0 ] || ensure_group_add ${!_groups[*]} || {
          echo -e "${red}Failed to acquire required groups; aborting.${reset}" 1>&2
          echo "If '$(id -un)' is a directory (LDAP/AD) account, local group membership" 1>&2
          echo "may not apply. Ask your administrator to add: ${!_groups[*]}" 1>&2
          return 3
        }

        for _dep in ${!_groups[*]}; do
          [[ " $(id -nG) " == *" ${_dep%:*} "* ]] || { _restart=1; break; }
        done

        if [ $_restart -eq 0 ]; then
          subcommand_${_cmds[$_i]} ${_globals[*]} ${_args[$_i]}
          _rc=$?
        else
          if [ -n "${OEP_GROUP_REEXEC:-}" ]; then
            echo -e "${yellow}groups still not effective after re-exec${reset}" 1>&2
            return 1
          fi

          [[ " ${_cmds[*]:0:$_i} " = *" setup "* ]] || subcommand_setup "${_globals[@]}"

          [ -x "$installer_bin" ] || {
            echo -e "${red}$installer_bin not found; run 'setup' first${reset}" 1>&2
            return 3
          }

          local _sdir="" _sdir_secrets
          ensure_tmpdir create _sdir secrets /dev/shm
          local _sdir_secrets="$_sdir"/secrets
          (
            umask 077;
            for e in SUDO_PASSWORD TF_TOKEN HOME USER PATH LOGNAME XDG_RUNTIME_DIR $(compgen -e | grep -E ^OEP_); do
              printf "export %s=%q\n" "$e" "${!e}"
            done > "$_sdir_secrets"
          ) || { echo "Failed to write secrets" >&2; return 3; }
          ensure_sudo setpriv --reuid "$(id -u)" --regid "$(id -g)" --groups "$(id -G "$(id -un)" | tr ' ' ',')" \
            --inh-caps=-all bash -c '
secrets="$1"; installer_bin="$2"; shift 2
. "$secrets"; rm -f "$secrets"
export OEP_GROUP_REEXEC=1
exec "$installer_bin" "$@"
' bash "$_sdir_secrets" "$installer_bin" "${_rest_args[@]}" "${_globals[@]}"
          _rc=$?
          ensure_tmpdir destroy "$_sdir"
          return $_rc
        fi
      fi
      ;;
    esac
    [ $_rc -eq 0 ] || [[ " ${_globals[*]} " = *" --continue "* ]] || break
  done
  return $_rc
}

#### COLLECTION OF MODULES ####

subcommand_bootstrap () {
  local mydir="$(dirname "$(readlink -f "$0")")"

  if [[ " $* " = *" --help "* ]]; then
    echo "bootstrap options:"
    echo "  --install=<name>       set default installation component|profile."
    echo "  --start=<name>         set default start component|profile."
    echo "  --output/-o            specify the output filename [default: $installer_name]."
    echo
    local profiles=($(cd "$mydir";find profile -name "$ID_LIKE" | cut -f2 -d/))
    [ ${#profiles[*]} -eq 0 ] || (
      IFS=$'\n'
      echo "  list of bootstrap profiles:"
      echo "${profiles[*]/#/    }" | sort
    )
    local modules=($(cd "$mydir";find module -name "$ID_LIKE" | cut -f2 -d/))
    [ ${#modules[*]} -eq 0 ] || (
      IFS=$'\n'
      echo "  list of bootstrap components:"
      echo "${modules[*]/#/    }" | sort
    )
    [ "${#profiles[*]}${#modules[*]}" = "00" ] || echo
    return 0
  fi
  
  # parse args
  local install_modules=() start_modules=() modules=() v vlast=""
  local rendered="$mydir/rendered/$installer_name"
  for v in "${@}"; do
    case "$v" in
    --install=*)
      install_modules+=(${v#*=})
      ;;
    --start=*)
      start_modules+=(${v#*=})
      ;;
    --output|-o)
      ;;
    --output=*)
      rendered="${v#*=}"
      ;;
    *)
      case "$vlast" in
      --output|-o)
        rendered="$v"
        ;;
      *)
        [[ "$v" = -* ]] || modules+=("$v")
        ;;
      esac
    esac
    vlast="$v"
  done

  # scan for dependencies
  [ ${#modules[*]} -gt 0 ] || modules+=($(cd "$mydir";find profile module -name "$ID_LIKE" | cut -f2 -d/))
  modules=(${modules[*]##*/})
  local -A scripts=()
  local i=0 script license_common=0
  while [ $i -lt ${#modules[*]} ]; do
    local script="$mydir"/profile/${modules[$i]}/${ID_LIKE}
    [ -r "$script" ] || script="$mydir"/module/${modules[$i]}/${ID_LIKE}
    if [ ${scripts["$script"]:-0} -eq 1 ]; then
      :
    elif [ -r "$script" ]; then
      scripts["$script"]=1
      local script_nos="${script%/*}/linux"
      local profiler=$(
        [ ! -r "$script_nos" ] || . "$script_nos"
        . "$script"
        declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_profile_${modules[$i]}$" | cut -f3 -d' '
      )
      [ -z "$profiler" ] || modules+=($(
        [ ! -r "$script_nos" ] || . "$script_nos"
        . "$script"
        for cmd in $(declare -F | grep " subcommand_" | cut -f2- -d_); do 
          $profiler $cmd
        done
      ))
      local licenser=$(
        [ ! -r "$script_nos" ] || . "$script_nos"
        . "$script"
        declare -F | grep -E -m1 " ${ID_LIKE}_[0-9]+_license_${modules[$i]}$"
      )
      [ -z "$licenser" ] || license_common=1
    else
      echo "Unknown component or profile: ${modules[$i]}. Skipping" 1>&2
    fi
    i=$((i+1))
  done

  # construct final installer
  if [ ${#scripts[@]} -eq 0 ]; then
    echo "No bootstrap component" 1>&2
    exit 3
  fi

  if [[ " $* " != *" --dry-run "* ]]; then
    sed '/^#### COLLECTION OF MODULES ####/q' "$0" > "$rendered"
    cat "$mydir"/common/linux/* >> "$rendered"
    if [ -d "$mydir"/common/${ID_LIKE} ]; then
      cat "$mydir"/common/${ID_LIKE}/* >> "$rendered"
    fi
    [ $license_common -eq 0 ] || {
      cat "$mydir"/license/linux/license_* >> "$rendered" 2> /dev/null || true
      cat "$mydir"/license/${ID_LIKE}/license_* >> "$rendered" 2> /dev/null || true
    }
  fi

  local scripts_ordered
  mapfile -t scripts_ordered < <(printf '%s\n' "${!scripts[@]}" | sort)
  for script in "${scripts_ordered[@]}"; do
    echo "==== bootstrapping ${script#"$mydir/"} ===="
    [[ " $* " != *" --dry-run "* ]] || continue
    cat "$script" >> "$rendered" 2> /dev/null || true
    cat "${script%/*}/linux" 2> /dev/null >> "$rendered" || true
  done

  if [[ " $* " != *" --dry-run "* ]]; then
    local misc_funcs=($(
      local bfuncs=($(declare -F | cut -f3 -d' '))
      . "$rendered"
      for f in $(declare -F | grep -v -E " (${ID_LIKE}_[0-9]+|ensure_|act_|verify_|configure_|subcommand_|main)" | cut -f3 -d' '); do
        [[ " ${bfuncs[*]} " = *" $f "* ]] || printf "%s " $f
      done
    ))
    sed -i "/^subcommand_setup *[(][)] *[{]/,/^[}]/{s|local  *installer_misc_functions=.*|local installer_misc_functions=(${misc_funcs[*]})|}" "$rendered"
    [ ${#start_modules[*]} -eq 0 ] || echo "[ \"\$0\" != bash ] || set -- start ${start_modules[*]} \"\$@\"" >> "$rendered"
    [ ${#install_modules[*]} -eq 0 ] || echo "[ \"\$0\" != bash ] || set -- install ${install_modules[*]} \"\$@\"" >> "$rendered"
    echo "[ \"\$0\" != bash ] || set -- setup \"\$@\"" >> "$rendered"
    echo 'main "$@"' >> "$rendered"
    chmod a+rx "$rendered"
    echo "Rendered to $rendered"
  fi
}

main "$@"
