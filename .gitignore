.gradio/*
.idea/*
.vscode/

# Adding the go workspace files for handling the local path of go modules
go.work
go.work.sum

# For skills eval benchmark directories, we will include only two benchmark files and ignore rest.
**/.github/skills/*/benchmark/*
!**/.github/skills/*/benchmark/benchmark.md
!**/.github/skills/*/benchmark/benchmark.json

# Ignore benchmark audio inputs and generated results.
/benchmark/data/**/*.wav
/benchmark/data/**/*.mp3
/benchmark/data/**/*.m4a
/benchmark/data/**/*.flac
/benchmark/data/**/*.ogg
/benchmark/data/**/*.opus
/benchmark/data/**/*.aac
/benchmark/results/
