{
  "openapi": "3.1.0",
  "info": {
    "title": "Semantic Decoder Service",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/streams/{stream_id}": {
      "put": {
        "summary": "Put Stream",
        "operationId": "put_stream_v1_streams__stream_id__put",
        "parameters": [
          {
            "name": "stream_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
              "description": "StreamID to create, or fetch if it already exists.",
              "title": "Stream Id"
            },
            "description": "StreamID to create, or fetch if it already exists."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamCreatedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get Stream Stats",
        "operationId": "get_stream_stats_v1_streams__stream_id__get",
        "parameters": [
          {
            "name": "stream_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
              "description": "ID of the stream to fetch stats for.",
              "title": "Stream Id"
            },
            "description": "ID of the stream to fetch stats for."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamStatsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Stream",
        "operationId": "delete_stream_v1_streams__stream_id__delete",
        "parameters": [
          {
            "name": "stream_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
              "description": "ID of the stream to close.",
              "title": "Stream Id"
            },
            "description": "ID of the stream to close."
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/streams/{stream_id}/payloads": {
      "post": {
        "summary": "Post Payload",
        "operationId": "post_payload_v1_streams__stream_id__payloads_post",
        "parameters": [
          {
            "name": "stream_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
              "description": "ID of the stream to ingest the payload into; created automatically if it doesn't exist.",
              "title": "Stream Id"
            },
            "description": "ID of the stream to ingest the payload into; created automatically if it doesn't exist."
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameAcceptedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/streams/{stream_id}/frames/next": {
      "get": {
        "summary": "Get Next Frame",
        "operationId": "get_next_frame_v1_streams__stream_id__frames_next_get",
        "parameters": [
          {
            "name": "stream_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
              "description": "ID of the stream to poll.",
              "title": "Stream Id"
            },
            "description": "ID of the stream to poll."
          },
          {
            "name": "consumer_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Caller-chosen id identifying this consumer's own read cursor.",
              "title": "Consumer Id"
            },
            "description": "Caller-chosen id identifying this consumer's own read cursor."
          },
          {
            "name": "wait_ms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30000,
              "minimum": 0,
              "description": "Milliseconds to long-poll for a new frame before returning 204 if none is ready.",
              "default": 0,
              "title": "Wait Ms"
            },
            "description": "Milliseconds to long-poll for a new frame before returning 204 if none is ready."
          }
        ],
        "responses": {
          "200": {
            "description": "Decoded JPEG frame.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "image/jpeg": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/streams/{stream_id}/frames/{frame_seq}": {
      "get": {
        "summary": "Get Frame By Seq",
        "operationId": "get_frame_by_seq_v1_streams__stream_id__frames__frame_seq__get",
        "parameters": [
          {
            "name": "frame_seq",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Frame sequence number to fetch.",
              "title": "Frame Seq"
            },
            "description": "Frame sequence number to fetch."
          },
          {
            "name": "stream_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
              "description": "ID of the stream.",
              "title": "Stream Id"
            },
            "description": "ID of the stream."
          }
        ],
        "responses": {
          "200": {
            "description": "Decoded JPEG frame.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "image/jpeg": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FrameAcceptedResponse": {
        "properties": {
          "frame_seq": {
            "type": "integer",
            "title": "Frame Seq",
            "description": "Sequence number assigned to the decoded frame."
          },
          "img_idx": {
            "type": "integer",
            "title": "Img Idx",
            "description": "Per-stream image index reported by the encoder."
          }
        },
        "type": "object",
        "required": [
          "frame_seq",
          "img_idx"
        ],
        "title": "FrameAcceptedResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StreamCreatedResponse": {
        "properties": {
          "stream_id": {
            "type": "string",
            "title": "Stream Id",
            "description": "Id of the created (or already existing) stream."
          }
        },
        "type": "object",
        "required": [
          "stream_id"
        ],
        "title": "StreamCreatedResponse"
      },
      "StreamStatsResponse": {
        "properties": {
          "stream_id": {
            "type": "string",
            "title": "Stream Id",
            "description": "ID of the stream."
          },
          "frames_received": {
            "type": "integer",
            "title": "Frames Received",
            "description": "Sequence number of the most recently received frame."
          },
          "buffer_depth": {
            "type": "integer",
            "title": "Buffer Depth",
            "description": "Number of decoded frames currently held in the stream's ring buffer."
          },
          "consumer_cursors": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Consumer Cursors",
            "description": "Per-consumer_id next-frame-seq cursor position."
          }
        },
        "type": "object",
        "required": [
          "stream_id",
          "frames_received",
          "buffer_depth",
          "consumer_cursors"
        ],
        "title": "StreamStatsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
