{
    "openapi": "3.1.0",
    "info": {
        "title": "Semantic Encoder Service",
        "version": "0.1.0"
    },
    "paths": {
        "/healthz": {
            "get": {
                "summary": "Healthz",
                "operationId": "healthz_healthz_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/v1/streams/{stream_id}": {
            "put": {
                "summary": "Put Stream",
                "operationId": "put_stream_v1_streams__stream_id__put",
                "parameters": [
                    {
                        "name": "stream_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
                            "title": "Stream Id"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StreamCreateRequest",
                                "default": {
                                    "compression_level": 2
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StreamCreatedResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "summary": "Get Stream Stats",
                "operationId": "get_stream_stats_v1_streams__stream_id__get",
                "parameters": [
                    {
                        "name": "stream_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
                            "title": "Stream Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StreamStatsResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "summary": "Delete Stream",
                "operationId": "delete_stream_v1_streams__stream_id__delete",
                "parameters": [
                    {
                        "name": "stream_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
                            "title": "Stream Id"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Successful Response"
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/streams/{stream_id}/frames": {
            "post": {
                "summary": "Post Frame",
                "operationId": "post_frame_v1_streams__stream_id__frames_post",
                "parameters": [
                    {
                        "name": "stream_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_\\-]{1,128}$",
                            "title": "Stream Id"
                        }
                    },
                    {
                        "name": "img_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "Img Id"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FrameAcceptedResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "FrameAcceptedResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "stream_id": {
                        "type": "string",
                        "title": "Stream Id"
                    }
                },
                "type": "object",
                "required": [
                    "status",
                    "stream_id"
                ],
                "title": "FrameAcceptedResponse"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "StreamCreateRequest": {
                "properties": {
                    "compression_level": {
                        "type": "integer",
                        "maximum": 2.0,
                        "minimum": 1.0,
                        "title": "Compression Level",
                        "default": 2
                    },
                    "decoder_url": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 2048
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Decoder Url"
                    },
                    "decoder_stream_id": {
                        "anyOf": [
                            {
                                "type": "string",
                                "maxLength": 128,
                                "minLength": 1,
                                "pattern": "^[A-Za-z0-9_\\-]{1,128}$"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Decoder Stream Id"
                    }
                },
                "type": "object",
                "title": "StreamCreateRequest"
            },
            "StreamCreatedResponse": {
                "properties": {
                    "stream_id": {
                        "type": "string",
                        "title": "Stream Id"
                    },
                    "decoder_url": {
                        "type": "string",
                        "title": "Decoder Url"
                    },
                    "decoder_stream_id": {
                        "type": "string",
                        "title": "Decoder Stream Id"
                    },
                    "compression_level": {
                        "type": "integer",
                        "title": "Compression Level"
                    }
                },
                "type": "object",
                "required": [
                    "stream_id",
                    "decoder_url",
                    "decoder_stream_id",
                    "compression_level"
                ],
                "title": "StreamCreatedResponse"
            },
            "StreamStatsResponse": {
                "properties": {
                    "stream_id": {
                        "type": "string",
                        "title": "Stream Id"
                    },
                    "frames_processed": {
                        "type": "integer",
                        "title": "Frames Processed"
                    },
                    "decoder_url": {
                        "type": "string",
                        "title": "Decoder Url"
                    },
                    "decoder_stream_id": {
                        "type": "string",
                        "title": "Decoder Stream Id"
                    }
                },
                "type": "object",
                "required": [
                    "stream_id",
                    "frames_processed",
                    "decoder_url",
                    "decoder_stream_id"
                ],
                "title": "StreamStatsResponse"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
