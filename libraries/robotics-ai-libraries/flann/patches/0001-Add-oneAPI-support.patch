@@ -0,0 +1,227 @@
+#include "flann/flann.h"
+#include "flann/algorithms/dpcpp/kdtree_dpcpp_3d_index_params.h"
+
+#define IS_NAN(x) (((x) < 0) == ((x) >= 0))
+
+//3D point structure
+typedef struct PointFloat_3D
+{
+  float x;
+  float y;
+  float z;
+
+  PointFloat_3D()
+  {
+    x = 0.0;
+    y = 0.0;
+    z = 0.0;
+  }
+} PointFloat_3D;
+
+typedef std::vector<PointFloat_3D> PointCloud;
+
+PointCloud generateRandomPointCloud(size_t size)
+{
+  PointCloud cloud;
+  std::random_device rd;
+  std::mt19937 gen(rd());
+  std::uniform_real_distribution<float> distribution(-1000.0f, 1000.0f); // Adjust range as needed
+  for (size_t i = 0; i < size; i++) { // Assuming each point is represented by 3 floats (x, y, z)
+      PointFloat_3D p;
+      p.x = distribution(gen);
+      p.y = distribution(gen);
+      p.z = distribution(gen);
+      cloud.emplace_back(p);
+  }
+  return cloud;
+}
+
+
+//FLANN idx+distance structure
+typedef struct FlannIndexDis
+{
+  std::vector<std::vector<int>> indices;
+  std::vector<std::vector<float>> distance;
+} FlannIndexDis;
+
+
+flann::Matrix<float> Cloud2Matrix(PointCloud src)
+{
+  int dim = 3;
+  int N = src.size();
+  flann::Matrix<float> data(new float[N * dim], N, dim);
+
+  for (unsigned int i = 0; i < N; i++)
+  {
+    data[i][0] = src.at(i).x;
+    data[i][1] = src.at(i).y;
+    data[i][2] = src.at(i).z;
+  }
+  return data;
+}
+
+class FlannKdtree
+{
+private:
+  flann::Index<flann::L2<float>> TreeIndex; //kdtree
+
+public:
+  //create kdtree
+  FlannKdtree(flann::Matrix<float> dataset) : TreeIndex(dataset, flann::KDTreeSingleIndexParams(10))
+  {
+    TreeIndex.buildIndex();
+  }
+
+  // create kdtree dpcpp index
+  FlannKdtree(flann::Matrix<float> dataset, bool dpcpp) : TreeIndex(dataset, flann::KDTreeDpcpp3dIndexParams())
+  {
+    TreeIndex.buildIndex();
+  }
+
+  //kdtree search
+  void SearchKnn(const flann::Matrix<float> &target, int K, FlannIndexDis *dst)
+  {
+
+    TreeIndex.knnSearch(target, dst->indices, dst->distance, K, flann::SearchParams(-1));
+  }
+
+  void SearchR(flann::Matrix<float> &target, double R, FlannIndexDis &dst)
+  {
+    TreeIndex.radiusSearch(target, dst.indices, dst.distance, R, flann::SearchParams(true));
+  }
+};
+
+void knnTest(const int *random_input, std::size_t size)
+{
+  int num_of_neighbors = random_input[size-1] <= 0 ? 1 : random_input[size-1];
+  if ((num_of_neighbors == 0) || (num_of_neighbors > size))
+    return;
+
+  if (num_of_neighbors * 1.5 > size)
+    return;
+
+  PointCloud src = generateRandomPointCloud(size);
+  flann::Matrix<float> data = Cloud2Matrix(src);
+
+  PointCloud testpoint = generateRandomPointCloud(size*0.1f);
+  flann::Matrix<float> knnTarget = Cloud2Matrix(testpoint);
+
+  FlannKdtree tree(data);
+  FlannKdtree tree_dp(data, true);
+
+  FlannIndexDis IndexDistance;
+  FlannIndexDis IndexDistance_dp;
+
+  tree.SearchKnn(knnTarget, num_of_neighbors, &IndexDistance);
+  tree_dp.SearchKnn(knnTarget, num_of_neighbors, &IndexDistance_dp);
+
+  int mismatch_count = 0;
+
+  for (auto ss = 0; ss < testpoint.size(); ss++)
+  {
+    if (IndexDistance.indices.at(ss).size() != IndexDistance_dp.indices.at(ss).size())
+      throw std::runtime_error("CPU and GPU size mismatch for knnTest");
+
+    for (auto kk = 0; kk < num_of_neighbors; kk++)
+    {
+      /* Don't compare the indices as GPU sort is not stable sort, indices may swap for same
+       * distance
+       */
+     // if (IndexDistance.indices.at(ss)[kk] != IndexDistance_dp.indices.at(ss)[kk])
+     //   mismatch_count++;
+      if (abs(IndexDistance.distance.at(ss)[kk] - IndexDistance_dp.distance.at(ss)[kk]) > 1.0)
+        mismatch_count++;
+    }
+  }
+
+  if (mismatch_count)
+  {
+    std::cout << "Knn search k=" << num_of_neighbors << " size=" << size << " mismatch count=" << mismatch_count << "\n";
+    throw std::runtime_error("KnnTest Mismatch in distance for certain points");
+  }
+}
+
+void radiusTest(const float *random_input, std::size_t size)
+{
+  float radius = 1.0f;
+  for (int i = 0; i < size; i++)
+  {
+    if (!IS_NAN(random_input[i]))
+    {
+      if ((random_input[i] > -1000.0f) && (random_input[i] < 1000.f))
+      {
+        radius = random_input[i];
+        break;
+      }
+    }
+  }
+
+  PointCloud src = generateRandomPointCloud(size);
+  flann::Matrix<float> data = Cloud2Matrix(src);
+
+  PointCloud testpoint = generateRandomPointCloud(size);
+  flann::Matrix<float> radiusTarget = Cloud2Matrix(testpoint);
+
+  FlannKdtree tree(data);
+  FlannKdtree tree_dp(data, true);
+
+  FlannIndexDis IndexDistance;
+  FlannIndexDis IndexDistance_dp;
+
+
+  tree.SearchR(radiusTarget, radius, IndexDistance);
+  tree_dp.SearchR(radiusTarget, radius, IndexDistance_dp);
+
+  int mismatch_count = 0;
+  for (auto ss = 0; ss < testpoint.size(); ss++)
+  {
+    if (IndexDistance.indices.at(ss).size() != IndexDistance_dp.indices.at(ss).size())
+    {
+      std::stringstream msg;
+      msg << "CPU and GPU size mismatch for radius Test. Radius=" << radius;
+      msg << " Debug: cpu size=" << IndexDistance.indices.at(ss).size() << " gpu size=" << IndexDistance_dp.indices.at(ss).size() << "\n";
+      throw std::runtime_error(msg.str().c_str());
+
+    }
+
+    for (auto kk = 0; kk < IndexDistance.indices.at(ss).size(); kk++)
+    {
+
+      /* Don't compare the indices as GPU sort is not stable sort, indices may swap for same
+       * distance
+      EXPECT_TRUE(IndexDistance.indices.at(ss)[kk] == IndexDistance_dp.indices.at(ss)[kk]) <<
+        "CPU and GPU indices mismatch for radius="<< radius << " and point at " << ss <<
+            " vector index=" << kk << "CPU=" << IndexDistance.indices.at(ss)[kk] << " GPU=" <<
+            IndexDistance_dp.indices.at(ss)[kk] << " \n";
+            */
+      if (abs(IndexDistance.distance.at(ss)[kk] - IndexDistance_dp.distance.at(ss)[kk]) > 1.0)
+        mismatch_count++;
+
+    }
+  }
+
+  if (mismatch_count)
+  {
+    std::cout << "mismatch count=" << mismatch_count << "\n";
+    throw std::runtime_error("RadiusTest Mismatch in distance for certain points");
+  }
+}
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, std::size_t size)
+{
+  if (size > 100)
+  {
+    const float *random_input = reinterpret_cast<const float *>(data);
+    radiusTest(random_input, size);
+
+    const int *random_int = reinterpret_cast<const int *>(data);
+    knnTest(random_int, size);
+
+    return 0;
+  }
+  else
+  {
+    return -1;
+  }
+}
