+#define ONEDPL_USE_PREDEFINED_POLICIES 0
+#endif
+
+#include <CL/sycl.hpp>
+#include <dpct/dpct.hpp>
+#include "device_memory.h"
+#include "gpu_memory_manager.h"
+
+#include <cassert>
+
+////////////////////////    DeviceArray    /////////////////////////////
+
+GpuMemoryManager *memoryManagerShared = new GpuMemoryManager(true);
+GpuMemoryManager *memoryManagerDevice = new GpuMemoryManager(false);
+
+flann::DeviceMemory::DeviceMemory()
+: data_(nullptr), sizeBytes_(0), type_(SHARED_MEMORY),
+  refcount_(nullptr), q_(&dpct::get_default_queue())
+{}
+
+flann::DeviceMemory::DeviceMemory(void* ptr_arg, std::size_t sizeBytes_arg)
+: data_(ptr_arg), sizeBytes_(sizeBytes_arg), type_(SHARED_MEMORY),
+  refcount_(nullptr), q_(&dpct::get_default_queue())
+{}
+
+flann::DeviceMemory::DeviceMemory(std::size_t sizeBytes_arg)
+: data_(nullptr), sizeBytes_(0), type_(SHARED_MEMORY),
+  refcount_(nullptr), q_(&dpct::get_default_queue())
+{
+  create(sizeBytes_arg);
+}
+
+flann::DeviceMemory::DeviceMemory(std::size_t sizeBytes_arg, sycl::queue *q)
+: data_(nullptr), sizeBytes_(0), type_(SHARED_MEMORY),
+  refcount_(nullptr), q_(q)
+{
+  create(sizeBytes_arg);
+}
+
+flann::DeviceMemory::DeviceMemory(std::size_t sizeBtes_arg, MemoryType type)
+: data_(nullptr), sizeBytes_(0), type_(type), refcount_(nullptr), q_(&dpct::get_default_queue())
+{
+  create(sizeBtes_arg, type);
+}
+
+flann::DeviceMemory::~DeviceMemory() { release(); }
+
+flann::DeviceMemory::DeviceMemory(const DeviceMemory& other_arg)
+: data_(other_arg.data_),
+  sizeBytes_(other_arg.sizeBytes_),
+  type_(other_arg.type_),
+  refcount_(other_arg.refcount_),
+  q_(&dpct::get_default_queue())
+{
+  if (refcount_)
+    refcount_->fetch_add(1);
+}
+
+flann::DeviceMemory&
+flann::DeviceMemory::operator=(const flann::DeviceMemory& other_arg)
+{
+  if (this != &other_arg) {
+    if (other_arg.refcount_)
+      other_arg.refcount_->fetch_add(1);
+    release();
+
+    data_ = other_arg.data_;
+    sizeBytes_ = other_arg.sizeBytes_;
+    refcount_ = other_arg.refcount_;
+  }
+  return *this;
+}
+
+void
+flann::DeviceMemory::create_(std::size_t sizeBytes, MemoryType type)
+{
+   if (q_->get_device().is_gpu())
+   {
+     switch(type)
+     {
+     case DEVICE_MEMORY:
+       memoryManagerDevice->InitializeQueue(-1);
+       memoryManagerDevice->GetMemory((void **) &data_, sizeBytes);
+       refcount_ = new std::atomic<int>(1);
+       break;
+     case SHARED_MEMORY:
+       memoryManagerShared->InitializeQueue(-1);
+       memoryManagerShared->GetMemory((void **) &data_, sizeBytes);
+       refcount_ = new std::atomic<int>(1);
+       break;
+     case HOST_MEMORY:
+       data_ = (void*)sycl::malloc_host(sizeBytes, *q_);
+       refcount_ = new std::atomic<int>(1);
+       break;
+     default:
+       break;
+     }
+   }
+   else
+   {
+     switch(type)
+     {
+     case DEVICE_MEMORY:
+       data_ = (void*) sycl::malloc_device(sizeBytes, *q_);
+       refcount_ = new std::atomic<int>(1);
+       break;
+     case SHARED_MEMORY:
+       data_ = (void*) sycl::malloc_shared(sizeBytes, *q_);
+       refcount_ = new std::atomic<int>(1);
+       break;
+     case HOST_MEMORY:
+       data_ = (void*) sycl::malloc_host(sizeBytes, *q_);
+       refcount_ = new std::atomic<int>(1);
+       break;
+     default:
+       break;
+     }
+   }
+}
+
+void
+flann::DeviceMemory::create(std::size_t sizeBytes_arg)
+{
+  if (sizeBytes_arg == sizeBytes_)
+    return;
+
+  if (data_)
+    release();
+
+  sizeBytes_ = sizeBytes_arg;
+
+  create_(sizeBytes_, type_);
+}
+
+void
+flann::DeviceMemory::create(std::size_t sizeBytes_arg, sycl::queue* q)
+{
+  if (sizeBytes_arg == sizeBytes_)
+    return;
+
+  if (data_)
+    release();
+
+  sizeBytes_ = sizeBytes_arg;
+
+  q_ = q;
+
+  create_(sizeBytes_, type_);
+}
+
+void
+flann::DeviceMemory::create(std::size_t sizeBytes_arg, MemoryType type)
+{
+  if (sizeBytes_ == sizeBytes_arg)
+    return;
+
+  if (data_)
+    release();
+
+  sizeBytes_ = sizeBytes_arg;
+  type_ = type;
+
+  create_(sizeBytes_, type);
+}
+
+void
+flann::DeviceMemory::create(std::size_t sizeBytes_arg, MemoryType type, sycl::queue* q)
+{
+  if (sizeBytes_ == sizeBytes_arg)
+    return;
+
+  if (data_)
+    release();
+
+  sizeBytes_ = sizeBytes_arg;
+  type_ = type;
+  q_ = q;
+
+  create_(sizeBytes_, type);
+}
+
+void
+flann::DeviceMemory::resize(std::size_t sizeBytes_arg)
+{
+  if (sizeBytes_arg <= sizeBytes_) {
+    sizeBytes_ = sizeBytes_arg;
+  }
+  else {
+    create(sizeBytes_arg);
+  }
+}
+
+void
+flann::DeviceMemory::copyTo(DeviceMemory& other)
+{
+  if (empty())
+    other.release();
+  else {
+    other.create(sizeBytes_, type_);
+    q_->memcpy(other.data_, data_, sizeBytes_).wait_and_throw();
+  }
+}
+
+void
+flann::DeviceMemory::release()
+{
+  if (refcount_ && refcount_->fetch_sub(1) == 1) {
+    delete refcount_;
+
+    if (q_->get_device().is_gpu())
+    {
+      switch(type_)
+      {
+      case DEVICE_MEMORY:
+        memoryManagerDevice->ReleaseMemory(data_);
+        data_ = nullptr;
+        break;
+      case SHARED_MEMORY:
+        memoryManagerShared->ReleaseMemory(data_);
+        data_ = nullptr;
+        break;
+      case HOST_MEMORY:
+        sycl::free(data_, *q_);
+        data_ = nullptr;
+        break;
+      default:
+        break;
+      }
+    }
+    else
+    {
+      sycl::free(data_, *q_);
+      data_ = nullptr;
+    }
+  }
+  sizeBytes_ = 0;
+  refcount_ = nullptr;
+}
+
+void
+flann::DeviceMemory::clear()
+{
+  release();
+}
+
+void
+flann::DeviceMemory::upload(const void* host_ptr_arg, std::size_t sizeBytes_arg)
+{
+  create(sizeBytes_arg);
+
+   q_->memcpy(data_, host_ptr_arg, sizeBytes_).wait_and_throw();
+}
+
+bool
+flann::DeviceMemory::upload(const void* host_ptr_arg,
+                               std::size_t device_begin_byte_offset,
+                               std::size_t num_bytes)
+{
+  if (device_begin_byte_offset + num_bytes > sizeBytes_) {
+    return false;
+  }
+  void* begin = static_cast<char*>(data_) + device_begin_byte_offset;
+
+   q_->memcpy(begin, host_ptr_arg, num_bytes).wait_and_throw();
+
+  return true;
+}
+
+void
+flann::DeviceMemory::download(void* host_ptr_arg)
+{
+   q_->memcpy(host_ptr_arg, data_, sizeBytes_).wait_and_throw();
+}
+
+bool
+flann::DeviceMemory::download(void* host_ptr_arg,
+                                 std::size_t device_begin_byte_offset,
+                                 std::size_t num_bytes)
+{
+  if (device_begin_byte_offset + num_bytes > sizeBytes_) {
+    return false;
+  }
+  const void* begin = static_cast<char*>(data_) + device_begin_byte_offset;
+
+  q_->memcpy(host_ptr_arg, begin, num_bytes).wait_and_throw();
+
+  return true;
+}
+
+void
+flann::DeviceMemory::swap(DeviceMemory& other_arg)
+{
+  std::swap(data_, other_arg.data_);
+  std::swap(sizeBytes_, other_arg.sizeBytes_);
+  std::swap(refcount_, other_arg.refcount_);
+}
+
+bool
+flann::DeviceMemory::empty() const
+{
+  return !data_;
+}
+
+std::size_t
+flann::DeviceMemory::sizeBytes() const
+{
+  return sizeBytes_;
+}
+
+////////////////////////    DeviceArray2D    /////////////////////////////
+
+flann::DeviceMemory2D::DeviceMemory2D()
+: data_(nullptr), step_(0), colsBytes_(0), rows_(0), type_(SHARED_MEMORY),
+  refcount_(nullptr),  q_(&dpct::get_default_queue())
+{}
+
+flann::DeviceMemory2D::DeviceMemory2D(int rows_arg, int colsBytes_arg)
+: data_(nullptr), step_(0), colsBytes_(0), rows_(0), type_(SHARED_MEMORY),
+  refcount_(nullptr),  q_(&dpct::get_default_queue())
+{
+  create(rows_arg, colsBytes_arg);
+}
+
+flann::DeviceMemory2D::DeviceMemory2D(int rows_arg,
+                                         int colsBytes_arg,
+                                         void* data_arg,
+                                         std::size_t step_arg)
+: data_(data_arg),
+  step_(step_arg),
+  colsBytes_(colsBytes_arg),
+  rows_(rows_arg),
+  type_(SHARED_MEMORY),
+  refcount_(nullptr),
+  q_(&dpct::get_default_queue())
+{}
+
+flann::DeviceMemory2D::~DeviceMemory2D() { release(); }
+
+flann::DeviceMemory2D::DeviceMemory2D(const DeviceMemory2D& other_arg)
+: data_(other_arg.data_),
+  step_(other_arg.step_),
+  colsBytes_(other_arg.colsBytes_),
+  rows_(other_arg.rows_),
+  type_(other_arg.type_),
+  refcount_(other_arg.refcount_),
+  q_(&dpct::get_default_queue())
+{
+  if (refcount_)
+    refcount_->fetch_add(1);
+}
+
+flann::DeviceMemory2D&
+flann::DeviceMemory2D::operator=(const flann::DeviceMemory2D& other_arg)
+{
+  if (this != &other_arg) {
+    if (other_arg.refcount_)
+      other_arg.refcount_->fetch_add(1);
+    release();
+
+    colsBytes_ = other_arg.colsBytes_;
+    rows_ = other_arg.rows_;
+    data_ = other_arg.data_;
+    step_ = other_arg.step_;
+
+    refcount_ = other_arg.refcount_;
+  }
+  return *this;
+}
+
+#define STEP_DEFAULT_ALIGN(x) (((x) + 31) & ~(0x1F))
+void
+flann::DeviceMemory2D::create_(std::size_t& step, int cols, int rows,
+    MemoryType type)
+{
+  step = STEP_DEFAULT_ALIGN(cols);
+
+  auto size = rows * step;
+
+  switch(type)
+  {
+  case DEVICE_MEMORY:
+    data_ = (void*)sycl::malloc_device(size, *q_);
+    refcount_ = new std::atomic<int>(1);
+    break;
+  case SHARED_MEMORY:
+    data_ = (void*)sycl::malloc_shared(size, *q_);
+    refcount_ = new std::atomic<int>(1);
+    break;
+  case HOST_MEMORY:
+    data_ = (void*)sycl::malloc_host(size, *q_);
+    refcount_ = new std::atomic<int>(1);
+    break;
+  default:
+    break;
+  }
+}
+
+void
+flann::DeviceMemory2D::create(int rows_arg, int colsBytes_arg)
+{
+  if (colsBytes_ == colsBytes_arg && rows_ == rows_arg)
+    return;
+
+  if (rows_arg > 0 && colsBytes_arg > 0) {
+    if (data_)
+      release();
+
+    colsBytes_ = colsBytes_arg;
+    rows_ = rows_arg;
+
+    create_(step_, colsBytes_, rows_, type_);
+  }
+}
+
+void
+flann::DeviceMemory2D::create(int rows_arg, int colsBytes_arg, MemoryType type)
+{
+  if (colsBytes_ == colsBytes_arg && rows_ == rows_arg)
+    return;
+
+  if (rows_arg > 0 && colsBytes_arg > 0) {
+    if (data_)
+      release();
+
+    colsBytes_ = colsBytes_arg;
+    rows_ = rows_arg;
+
+    create_(step_, colsBytes_, rows_, type);
+  }
+}
+
+void
+flann::DeviceMemory2D::release()
+{
+  if (refcount_ && refcount_->fetch_sub(1) == 1) {
+    delete refcount_;
+
+    sycl::free(data_, *q_);
+  }
+
+  colsBytes_ = 0;
+  rows_ = 0;
+  data_ = nullptr;
+  step_ = 0;
+  refcount_ = nullptr;
+}
+
+void
+flann::DeviceMemory2D::copyTo(DeviceMemory2D& other)
+{
+  if (empty())
+    other.release();
+  else {
+    other.create(rows_, colsBytes_);
+
+    dpct::dpct_memcpy(other.data_,
+                      other.step_,
+                      data_,
+                      step_,
+                      colsBytes_,
+                      rows_,
+                      dpct::device_to_device);
+
+    dpct::get_current_device().queues_wait_and_throw();
+  }
+}
+
+void
+flann::DeviceMemory2D::upload(const void* host_ptr_arg,
+                                 std::size_t host_step_arg,
+                                 int rows_arg,
+                                 int colsBytes_arg)
+{
+  create(rows_arg, colsBytes_arg);
+
+  auto copy_size = host_step_arg * colsBytes_arg;
+
+  q_->memcpy(data_,
+            host_ptr_arg,
+            copy_size).wait_and_throw();
+
+}
+
+void
+flann::DeviceMemory2D::download(void* host_ptr_arg, std::size_t host_step_arg)
+{
+
+  auto copy_size = step_ * rows_;
+
+  q_->memcpy(host_ptr_arg,
+            data_,
+            copy_size).wait_and_throw();
+}
+void
+flann::DeviceMemory2D::swap(DeviceMemory2D& other_arg)
+{
+  std::swap(data_, other_arg.data_);
+  std::swap(step_, other_arg.step_);
+
+  std::swap(colsBytes_, other_arg.colsBytes_);
+  std::swap(rows_, other_arg.rows_);
+  std::swap(refcount_, other_arg.refcount_);
+}
+
+bool
+flann::DeviceMemory2D::empty() const
+{
+  return !data_;
+}
+
+int
+flann::DeviceMemory2D::colsBytes() const
+{
+  return colsBytes_;
+}
+
+int
+flann::DeviceMemory2D::rows() const
+{
+  return rows_;
+}
+
+std::size_t
+flann::DeviceMemory2D::step() const
+{
+  return step_;
+}
+
