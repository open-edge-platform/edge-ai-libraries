diff --git a/src/cpp/flann/algorithms/dpcpp/CMakeLists.txt b/src/cpp/flann/algorithms/dpcpp/CMakeLists.txt
new file mode 100644
index 0000000..f5fbe0e
--- /dev/null
+++ b/src/cpp/flann/algorithms/dpcpp/CMakeLists.txt
@@ -0,0 +1,141 @@
+set(SUBSYS_NAME flann_dp)
+
+if(NOT (BUILD_DPCPP_LIB))
+  return()
+endif()
+
+set(CMAKE_CXX_COMPILER "dpcpp")
+cmake_minimum_required (VERSION 2.8)
+set(CMAKE_CXX_STANDARD 17)
+
+if(CMAKE_SYSTEM_NAME MATCHES "Linux")
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
+endif()
+
+if (NOT CMAKE_BUILD_TYPE)
+    set(CMAKE_BUILD_TYPE RelWithDebInfo)
+endif()
+IF(CMAKE_BUILD_TYPE MATCHES "Release")
+  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -O2")
+ELSE()
+  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -g")
+ENDIF()
+
+if(CMAKE_SYSTEM_NAME MATCHES "Linux")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -I$ENV{ONEAPI_ROOT}/compiler/latest/linux/include/sycl -I$ENV{ONEAPI_ROOT}/dpcpp-ct/latest/include/ -I$ENV{ONEAPI_ROOT}/dpl/latest/linux/include/  -I$ENV{ONEAPI_ROOT}/tbb/latest/include/")
+set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -L$ENV{ONEAPI_ROOT}/compiler/latest/linux/lib -lsycl")
+else(CMAKE_SYSTEM_NAME MATCHES "Windows")
+include_directories(
+  $ENV{ONEAPI_ROOT}/dpcpp-ct/latest/include
+)
+link_directories(
+  $ENV{ONEAPI_ROOT}/tbb/latest/lib/intel64/vc14
+)
+endif()
+
+
+if (NOT DPCPP_COMPILE_TARGET)
+  set(DPCPP_COMPILE_TARGET "jit" CACHE STRING "Kernel compilation mode: {jit, cpu, fpga-emu, skl, kbl, cfl, icllp, tgllp, Gen9, Gen11, Gen12LP, ...}")
+endif()
+
+if (DPCPP_COMPILE_TARGET MATCHES jit)
+  # Do nothing.  We are already set.
+elseif (DPCPP_COMPILE_TARGET MATCHES cpu)
+  set (CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fsycl-targets=spir64_x86_64-unknown-linux-sycldevice")
+elseif (DPCPP_COMPILE_TARGET MATCHES fpga-emu)
+  set (CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fsycl-targets=spir64_fpga-unknown-linux-sycldevice")
+else ()
+  set (CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -fsycl-targets=spir64_gen-unknown-linux-sycldevice -Xs \"-device ${DPCPP_COMPILE_TARGET} -internal_options -cl-kernel-debug-enable -options -cl-opt-disable\"")
+  set (CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS}")
+endif ()
+message (STATUS "DPCPP_COMPILE_TARGET is '${DPCPP_COMPILE_TARGET}'")
+
+add_definitions("-DFLANN_USE_DPCPP")
+#add_definitions("-DDPCT_USM_LEVEL_NONE")
+#add_definitions("-DPSTL_USE_NONTEMPORAL_STORES")
+#add_definitions("-DONEDPL_ALLOW_DEFERRED_WAITING")
+include_directories(
+  ${CMAKE_CURRENT_SOURCE_DIR}/../../../
+)
+
+find_package(TBB REQUIRED)
+
+add_library(${SUBSYS_NAME} SHARED
+  kdtree_dpcpp_3d_index.dp.cpp
+  device_memory.cpp.dp.cpp
+  gpu_memory_manager.dp.cpp
+)
+
+target_link_libraries(${SUBSYS_NAME} TBB::tbb)
+
+set_target_properties(${SUBSYS_NAME} PROPERTIES
+   VERSION ${FLANN_VERSION}
+   SOVERSION ${FLANN_SOVERSION}
+   DEFINE_SYMBOL FLANN_DP_EXPORTS
+)
+
+if(WIN32)
+set_target_properties(${SUBSYS_NAME} PROPERTIES VS_PLATFORM_TOOLSET "Intel(R) oneAPI DPC++ Compiler 2023" )
+set_target_properties(${SUBSYS_NAME} PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS YES)
+else ()
+set(PKG_DPCPP_DESC "DPC++ Intel(R) oneapi enabled Fast Library for Approximate Nearest Neighbors")
+set(pkg_conf_file ${CMAKE_CURRENT_BINARY_DIR}/${SUBSYS_NAME}.pc)
+configure_file(${SUBSYS_NAME}.pc.in ${pkg_conf_file} @ONLY)
+install(FILES ${pkg_conf_file}
+    DESTINATION ${FLANN_LIB_INSTALL_DIR}/pkgconfig/ COMPONENT pkgconfig)
+endif (WIN32)
+
+add_custom_target(build
+  ALL
+  DEPENDS ${SUBSYS_NAME}
+  WORKING_DIRECTORY ${CMAKE_PROJECT_DIR}
+)
+
+add_custom_target(run
+  COMMAND ../${SUBSYS_NAME}
+  DEPENDS build
+  WORKING_DIRECTORY ${CMAKE_PROJECT_DIR}
+)
+if(WIN32)
+install (
+    TARGETS ${SUBSYS_NAME}
+    RUNTIME DESTINATION bin
+    LIBRARY DESTINATION ${FLANN_LIB_INSTALL_DIR}
+    ARCHIVE DESTINATION ${FLANN_LIB_INSTALL_DIR}
+)
+else()
+install (
+    TARGETS ${SUBSYS_NAME}
+    DESTINATION ${FLANN_LIB_INSTALL_DIR}
+)
+endif()
+
+if(WIN32)
+install (
+    DIRECTORY flann
+    DESTINATION include/flann/algorithms/dpcpp
+    FILES_MATCHING PATTERN "*.h" PATTERN "*.hpp"
+)
+else()
+install (
+    DIRECTORY ./
+    DESTINATION include/flann/algorithms/dpcpp
+    FILES_MATCHING PATTERN "*.h" PATTERN "*.hpp"
+)
+endif()
+
+add_library(${SUBSYS_NAME}_s
+  kdtree_dpcpp_3d_index.dp.cpp)
+
+if(WIN32)
+set_target_properties(${SUBSYS_NAME}_s PROPERTIES VS_PLATFORM_TOOLSET "Intel(R) oneAPI DPC++ Compiler 2023" )
+endif()
+set_property(TARGET ${SUBSYS_NAME}_s PROPERTY COMPILE_DEFINITIONS FLANN_DP_STATIC)
+install (
+    TARGETS ${SUBSYS_NAME}_s
+    RUNTIME DESTINATION bin
+    LIBRARY DESTINATION ${FLANN_LIB_INSTALL_DIR}
+    ARCHIVE DESTINATION ${FLANN_LIB_INSTALL_DIR}
+)
