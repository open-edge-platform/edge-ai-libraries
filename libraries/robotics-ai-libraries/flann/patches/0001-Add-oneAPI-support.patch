+    template <typename Distance>
+    int KDTreeDpcpp3dIndex<Distance>::radiusSearchGpu(const Matrix<ElementType>& queries, std::vector<std::vector<int>>& indices,
+                                                      std::vector<std::vector<DistanceType>>& dists, float radius, const SearchParams& params) const
+    {
+        sycl::queue q_ct1 = gpu_helper_->queue;
+        const int threadsPerBlock = q_ct1.get_device().is_cpu() ? 1 : 96;
+        int max_neighbors = params.max_neighbors;
+        bool sorted = params.sorted;
+        bool use_heap = FLANN_False;
+        if (indices.size() < queries.rows)
+            indices.resize(queries.rows);
+        if (dists.size() < queries.rows)
+            dists.resize(queries.rows);
+
+        int istride = queries.stride / sizeof(ElementType);
+
+        DeviceArray<float> queriesDev(istride * queries.rows);
+        std::copy( //oneapi::dpl::execution::make_device_policy(q_ct1),
+            queries.ptr(), queries.ptr() + istride * queries.rows, queriesDev.begin());
+        DeviceArray<int> countsDev(queries.rows, 0);
+        DeviceArray<int> tmpDev(queries.rows);
+
+        typename GpuDistance<Distance>::type distance;
+
+        int blocksPerGrid = (queries.rows + threadsPerBlock - 1) / threadsPerBlock;
+
+        q_ct1.submit([&](sycl::handler& cgh) {
+            auto gpu_splits_ct0 = gpu_helper_->gpu_splits_->ptr();
+            auto gpu_child1_ct1 = gpu_helper_->gpu_child1_->ptr();
+            auto gpu_parent_ct2 = gpu_helper_->gpu_parent_->ptr();
+            auto gpu_aabb_min_ct3 = gpu_helper_->gpu_aabb_min_->ptr();
+            auto gpu_aabb_max_ct4 = gpu_helper_->gpu_aabb_max_->ptr();
+            auto gpu_points_ct5 = gpu_helper_->gpu_points_->ptr();
+            auto queriesDev_ct6 = queriesDev.ptr();
+            auto countsDev_ct9 = countsDev.ptr();
+
+            cgh.parallel_for(sycl::nd_range<3>(sycl::range<3>(1, 1, blocksPerGrid) *
+                             sycl::range<3>(1, 1, threadsPerBlock),
+                             sycl::range<3>(1, 1, threadsPerBlock)),
+                [=](sycl::nd_item<3> item_ct1) {
+                  KdTreeCudaPrivate::nearestKernel(
+                      gpu_splits_ct0,
+                      gpu_child1_ct1,
+                      gpu_parent_ct2,
+                      gpu_aabb_min_ct3,
+                      gpu_aabb_max_ct4,
+                      gpu_points_ct5,
+                      queriesDev_ct6, istride, 1,
+                      countsDev_ct9, 0, queries.rows,
+                      flann::cuda::CountingRadiusResultSet<float>(radius, max_neighbors),
+                      item_ct1, distance);
+           });
+        }).wait();
+
+        int neighbors_last_elem = countsDev.back();
+        std::exclusive_scan(//oneapi::dpl::execution::make_device_policy(q_ct1),
+                            countsDev.begin(), countsDev.end(), countsDev.begin(),
+                            0);
+        size_t total_neighbors = neighbors_last_elem + countsDev.back();
+
+        if (max_neighbors == 0)
+            return total_neighbors;
+
+        DeviceArray<int> indicesDev(total_neighbors, -1);
+        DeviceArray<float> distsDev(total_neighbors, -1);
+
+        if (max_neighbors < 0)
+        {
+            q_ct1.submit([&](sycl::handler& cgh) {
+              auto gpu_splits_ct0 = gpu_helper_->gpu_splits_->ptr();
+              auto gpu_child1_ct1 = gpu_helper_->gpu_child1_->ptr();
+              auto gpu_parent_ct2 = gpu_helper_->gpu_parent_->ptr();
+              auto gpu_aabb_min_ct3 = gpu_helper_->gpu_aabb_min_->ptr();
+              auto gpu_aabb_max_ct4 = gpu_helper_->gpu_aabb_max_->ptr();
+              auto gpu_points_ct5 = gpu_helper_->gpu_points_->ptr();
+              auto queriesDev_ct6 = queriesDev.ptr();
+              auto indicesDev_ct9 = indicesDev.ptr();
+              auto distsDev_ct10 = distsDev.ptr();
+              auto countsDev_ct9 = countsDev.ptr();
+
+              cgh.parallel_for(sycl::nd_range<3>(sycl::range<3>(1, 1, blocksPerGrid) *
+                               sycl::range<3>(1, 1, threadsPerBlock),
+                               sycl::range<3>(1, 1, threadsPerBlock)),
+                  [=](sycl::nd_item<3> item_ct1) {
+                    KdTreeCudaPrivate::nearestKernel(
+                        gpu_splits_ct0,
+                        gpu_child1_ct1,
+                        gpu_parent_ct2,
+                        gpu_aabb_min_ct3,
+                        gpu_aabb_max_ct4,
+                        gpu_points_ct5,
+                        queriesDev_ct6, istride, 1,
+                        indicesDev_ct9,
+                        distsDev_ct10, queries.rows,
+                        flann::cuda::RadiusResultSet<float>(
+                          radius,
+                          countsDev_ct9,
+                          sorted),
+                        item_ct1, distance);
+                  });
+            }).wait();
+        }
+        else
+        {
+            if (use_heap)
+            {
+                q_ct1.submit([&](sycl::handler& cgh) {
+                    auto gpu_splits__ct0 = gpu_helper_->gpu_splits_->ptr();
+                    auto gpu_child1__ct1 = gpu_helper_->gpu_child1_->ptr();
+                    auto gpu_parent__ct2 = gpu_helper_->gpu_parent_->ptr();
+                    auto gpu_aabb_min__ct3 = gpu_helper_->gpu_aabb_min_->ptr();
+                    auto gpu_aabb_max__ct4 = gpu_helper_->gpu_aabb_max_->ptr();
+                    auto gpu_points__ct5 = gpu_helper_->gpu_points_->ptr();
+                    auto queriesDev_ct6 = queriesDev.ptr();
+                    auto indicesDev_ct9 = indicesDev.ptr();
+                    auto distsDev_ct10 = distsDev.ptr();
+                    auto countsDev_ct9 = countsDev.ptr();
+
+                    cgh.parallel_for(sycl::nd_range<3>(sycl::range<3>(1, 1, blocksPerGrid) *
+                                     sycl::range<3>(1, 1, threadsPerBlock),
+                                     sycl::range<3>(1, 1, threadsPerBlock)),
+                        [=](sycl::nd_item<3> item_ct1) {
+                          KdTreeCudaPrivate::nearestKernel(
+                              gpu_splits__ct0,
+                              gpu_child1__ct1,
+                              gpu_parent__ct2,
+                              gpu_aabb_min__ct3,
+                              gpu_aabb_max__ct4,
