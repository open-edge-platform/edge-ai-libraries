+template <class T>
+template <class A>
+inline void
+DeviceArray2D<T>::download(std::vector<T, A>& data, int& elem_step)
+{
+  elem_step = cols();
+  data.resize(cols() * rows());
+  if (!data.empty())
+    download(&data[0], colsBytes());
