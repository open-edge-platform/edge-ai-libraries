+        tbb::parallel_for(tbb::blocked_range<size_t>(0, indicesDev.size()),
+          [&](const tbb::blocked_range<size_t> &range) {
+          for (size_t i = range.begin(); i < range.end(); ++i) {
+            if (indicesDev.ptr()[i] >= 0)
