+    template <typename Distance>
+    struct KDTreeDpcpp3dIndex<Distance>::GpuHelper
+    {
+        DeviceArray<cuda::kd_tree_builder_detail::SplitInfo>* gpu_splits_;
+        DeviceArray<int>* gpu_parent_;
