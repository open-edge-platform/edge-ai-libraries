+//! normal node: contains the split dimension and value
+//! leaf node: left == index of first points, right==index of last point +1
+struct SplitInfo
+{
+    union
+    {
+        struct
+        {
+            // begin of child nodes
+            int left;
+            // end of child nodes
+            int right;
+    };
+    struct
+    {
+        int split_dim;
+        float split_val;
+    };
+};
+};
+
+struct IsEven
+{
+    typedef int result_type;
+
+    int operator()(int i)
+    {
+        return (i & 1) == 0;
+    }
+};
+
+struct SecondElementIsEven
+{
+
+    bool operator()(const std::tuple<int, int>& i)
+    {
+        return (std::get<1>(i) & 1) == 0;
+    }
+};
+
+//! just for convenience: access a float4 by an index in [0,1,2]
+//! (casting it to a float* and accessing it by the index is way slower...)
+
+float get_value_by_index(const sycl::float4& f, int i)
+{
+    switch (i)
+    {
+    case 0:
+        return f.x();
+    case 1:
+        return f.y();
+    default:
+        return f.z();
+    }
+}
+
+//! mark a point as belonging to the left or right child of its current parent
+//! called after parents are split
+struct MovePointsToChildNodes
+{
+    MovePointsToChildNodes(int* child1, SplitInfo* splits, float* x, float* y, float* z, int* ox, int* oy, int* oz, int* lrx, int* lry, int* lrz)
+        : child1_(child1), splits_(splits), x_(x), y_(y), z_(z), ox_(ox), oy_(oy), oz_(oz), lrx_(lrx), lry_(lry), lrz_(lrz) {}
+    //  int dim;
+    //  float threshold;
+    int* child1_;
+    SplitInfo* splits_;
+
+    // coordinate values
+    float* x_,* y_,* z_;
+    // owner indices -> which node does the point belong to?
+    int* ox_,* oy_,* oz_;
+    // temp info: will be set to 1 of a point is moved to the right child node, 0 otherwise
+    // (used later in the scan op to separate the points of the children into continuous ranges)
+    int* lrx_,* lry_,* lrz_;
+
+    void operator()(int index, int* ind1, int* ind2, int* ind3)//const std::tuple<int, int, int>& data)
+    {
+        int owner = ox_[index]; // before a split, all points at the same position in the index array have the same owner
+        int point_ind1 = ind1[index];
+        int point_ind2 = ind2[index];
+        int point_ind3 = ind3[index];
+        int leftChild = child1_[owner];
+        int split_dim;
+        float dim_val1, dim_val2, dim_val3;
+        SplitInfo split;
+        lrx_[index] = 0;
+        lry_[index] = 0;
+        lrz_[index] = 0;
+        // this element already belongs to a leaf node -> everything alright, no need to change anything
+        if (leftChild == -1)
+        {
+            return;
+        }
+        // otherwise: load split data, and assign this index to the new owner
+        split = splits_[owner];
+        split_dim = split.split_dim;
+        switch (split_dim)
+        {
+        case 0:
+            dim_val1 = x_[point_ind1];
+            dim_val2 = x_[point_ind2];
+            dim_val3 = x_[point_ind3];
+            break;
+        case 1:
+            dim_val1 = y_[point_ind1];
+            dim_val2 = y_[point_ind2];
+            dim_val3 = y_[point_ind3];
+            break;
+        default:
+            dim_val1 = z_[point_ind1];
+            dim_val2 = z_[point_ind2];
+            dim_val3 = z_[point_ind3];
+            break;
+        }
+
+        int r1 = leftChild + (dim_val1 > split.split_val);
+        ox_[index] = r1;
+        int r2 = leftChild + (dim_val2 > split.split_val);
+        oy_[index] = r2;
+        oz_[index] = leftChild + (dim_val3 > split.split_val);
+
+        lrx_[index] = (dim_val1 > split.split_val);
+        lry_[index] = (dim_val2 > split.split_val);
+        lrz_[index] = (dim_val3 > split.split_val);
+        //                      return thrust::make_tuple( r1, r2, leftChild+(dim_val > split.split_val) );
+    }
+};
+
+//! used to update the left/right pointers and aabb infos after the node splits
+struct SetLeftAndRightAndAABB
+{
+    int maxPoints;
+    int nElements;
+
+    SplitInfo* nodes;
+    int* counts;
+    int* labels;
+    sycl::float4* aabbMin;
+    sycl::float4* aabbMax;
+    const float* x,* y,* z;
+    const int* ix,* iy,* iz;
+
+    void operator()(int i)
+    {
+        if (i < 0 || i >= nElements) {
+            throw FLANNException("Array index out of bounds");
+        }
+
+        int index = labels[i];
+        int right = maxPoints;
+        int left = counts[i];
+        if (i < nElements - 1)
+        {
+            right = counts[i + 1];
+        }
+
+        if (index < 0 || index >= maxPoints) {
+            throw FLANNException("Array index out of bounds");
+        }
+
+        if (left < 0 || left >= maxPoints) {
+            throw FLANNException("Array index out of bounds");
+        }
+
+        if (right < 1 || right >= maxPoints + 1) {
+            throw FLANNException("Array index out of bounds");
+        }
+
+        //Fix the potential exploit of speculative execution by forcing the CPU 
+        //to wait until all the values requested from the next level caches 
+        //actually arrive in their registers. 
+        _mm_lfence();
+
+        nodes[index].left = left;
+        nodes[index].right = right;
+        aabbMin[index].x() = x[ix[left]];
+        aabbMin[index].y() = y[iy[left]];
+        aabbMin[index].z() = z[iz[left]];
+        aabbMax[index].x() = x[ix[right - 1]];
+        aabbMax[index].y() = y[iy[right - 1]];
+        aabbMax[index].z() = z[iz[right - 1]];
+    }
+};
+
+//! - decide whether a node has to be split
+//! if yes:
+//! - allocate child nodes
+//! - set split axis as axis of maximum aabb length
+struct SplitNodes
+{
+    int maxPointsPerNode;
+    int* node_count;
+    int* nodes_allocated;
+    int* out_of_space;
+    int* child1_;
+    int* parent_;
+    SplitInfo* splits;
+};
+static struct SplitNodes sn;
+static int block_nodes_to_allocate_;
+static int block_left_;
+static bool enough_space_;
+
+void split1(int idx, int* child1_,  SplitInfo* s_, sycl::float4 * aabbMin_,
+    sycl::float4 * aabbMax_ , int * offset_to_global_)
+{
+    int& child1 = child1_[idx];
+    SplitInfo& s = s_[idx];
+    const sycl::float4& aabbMin = aabbMin_[idx];
+    const sycl::float4& aabbMax = aabbMax_[idx];
+    int& offset_to_global = offset_to_global_[idx];
+    //bool split_node=false;
+    // first, each thread block counts the number of nodes that it needs to allocate...
+
+    //if (item_ct1.get_local_id(2) == 0) sn.block_nodes_to_allocate = 0;
+    //item_ct1.barrier();
+
+    // don't split if all points are equal
+    // (could lead to an infinite loop, and doesn't make any sense anyway)
+    bool all_points_in_node_are_equal = aabbMin.x() == aabbMax.x() &&
+                                        aabbMin.y() == aabbMax.y() &&
+                                        aabbMin.z() == aabbMax.z();
+
+    //int offset_to_global=0;
+    // maybe this could be replaced with a reduction...
+    if ((child1 == -1) && (s.right - s.left > sn.maxPointsPerNode) && !all_points_in_node_are_equal)
+    { // leaf node
+        //split_node=true;
+      offset_to_global = sycl::atomic_ref<int, sycl::memory_order::relaxed,
+            sycl::memory_scope::device,
+            sycl::access::address_space::global_space>(block_nodes_to_allocate_).fetch_add(2);
+    }
+    else
+    {
+        offset_to_global = -1;
+    }
+}
+
+void split2(int idx, SplitInfo* s_, sycl::float4 * aabbMin_,  sycl::float4 * aabbMax_ , int * offset_to_global_)
+{
+    SplitInfo& s = s_[idx];
+    const sycl::float4& aabbMin = aabbMin_[idx];
+    const sycl::float4& aabbMax = aabbMax_[idx];
+    int& offset_to_global = offset_to_global_[idx];
+    int my_index = idx;
+    // this thread needs to split it's node && there was enough space for all the nodes
+    // in this block.
+    //(The whole "allocate-per-block-thing" is much faster than letting each element allocate
+    // its space on its own, because shared memory atomics are A LOT faster than
+    // global mem atomics!)
+    //if (split_node && sn.enough_space) {
+    if (offset_to_global >= 0)
+    {
+        int left = 1 + offset_to_global; //block_left_ + offset_to_global;
+
+        sn.splits[left].left = s.left;
+        sn.splits[left].right = s.right;
+        sn.splits[left + 1].left = 0;
+        sn.splits[left + 1].right = 0;
+
+        // split axis/position: middle of longest aabb extent
+        sycl::float4 aabbDim = aabbMax - aabbMin;
+        int maxDim = 0;
+        float maxDimLength = aabbDim.x();
+        sycl::float4 splitVal = (aabbMax + aabbMin);
+        splitVal *= 0.5f;
+        for (int i = 1; i <= 2; i++)
+        {
+            float val = get_value_by_index(aabbDim, i);
+            if (val > maxDimLength)
+            {
+                maxDim = i;
+                maxDimLength = val;
+            }
+        }
+        s.split_dim = maxDim;
+        s.split_val = get_value_by_index(splitVal, maxDim);
+
+        sn.child1_[my_index] = left;
+        sn.splits[my_index] = s;
+        sn.parent_[left] = my_index;
+        sn.parent_[left + 1] = my_index;
+        sn.child1_[left] = -1;
+        sn.child1_[left + 1] = -1;
+    }
+}
+
+//! computes the scatter target address for the split operation, see Sengupta,Harris,Zhang,Owen: Scan Primitives for GPU Computing
+//! in my use case, this is about 2x as fast as thrust::partition
+struct set_addr3
+{
+    const int* val_,* f_;
+    int* out_;
+    int npoints_;
+    int nf;
+
+    set_addr3(const int* val, const int* f, int* out, int npoints) : val_(val), f_(f), out_(out), npoints_(npoints)
+    {
+        nf = f_[npoints_ - 1] + (val_[npoints_ - 1]);
+    }
+    void operator()(int id)
+    {
+        out_[id] = val_[id] ? f_[id] : (id - f_[id] + nf);
+    }
+};
+
+//! converts a float4 point (xyz) to a tuple of three float vals (used to separate the
+//! float4 input buffer into three arrays in the beginning of the tree build)
+struct pointxyz_to_px_py_pz
+{
+
+    std::tuple<float, float, float> operator()(const sycl::float4& val)
+    {
+        return std::make_tuple(val.x(), val.y(), val.z());
+    }
+};
+
+struct exclusive_scan_tbb
+{
+  const int* in_;
+  int* out_;
+  int sum;
+
+  exclusive_scan_tbb(const int* in, int* out, int out0) : in_(in), out_(out), sum(0)
+  {
+    out_[0] = out0;
+  }
+
+  template <class Tag>
+  void operator()(const tbb::blocked_range<int>&range, Tag  ) {
+    int temp = sum;
+    for (int i = range.begin(); i < range.end(); ++i) {
+      temp = temp + in_[i - 1];
+      if (Tag::is_final_scan())
+        out_[i] = temp;
+    }
+    sum = temp;
+   }
+
+  exclusive_scan_tbb(exclusive_scan_tbb& other, tbb::split) : in_(other.in_), out_(other.out_), sum(0) {}
+  void reverse_join(exclusive_scan_tbb& other) { sum = other.sum + sum; }
+  void assign (exclusive_scan_tbb& other) { sum = other.sum; }
+};
+
+bool comp(const std::tuple<float, int>& i, const std::tuple<float, int>& j)
+{
+    return (std::get<0>(i)) < (std::get<0>(j));
+}
+
+} // namespace kd_tree_builder_detail
+
+} // namespace cuda
+
+std::ostream& operator<<(std::ostream& stream, const cuda::kd_tree_builder_detail::SplitInfo& s)
+{
+    stream << "(split l/r: " << s.left << " " << s.right << "  split:" << s.split_dim << " " << s.split_val << ")";
+    return stream;
+}
+
+class CudaKdTreeBuilder
+{
+public:
+    CudaKdTreeBuilder(const DeviceArray<sycl::float4>& points,
+                        int max_leaf_size, sycl::queue& q)
+        : /*out_of_space_(1,0),node_count_(1,1),*/ max_leaf_size_(max_leaf_size)
+    {
+        points_ = &points;
+        int elements = points.size();
+        int prealloc = points.size() / max_leaf_size_ *  16;
+        prealloc = (prealloc > 0) ? prealloc : 1;
+        allocation_info_.resize(3);
+        allocation_info_[NodeCount] = 1;
+        allocation_info_[NodesAllocated] = prealloc;
+        allocation_info_[OutOfSpace] = 0;
+
+        cuda::kd_tree_builder_detail::SplitInfo s;
+        s.left = 0;
+        s.right = 0;
+        splits_ =  new DeviceArray<cuda::kd_tree_builder_detail::SplitInfo>(
+                        prealloc, &q, 0);
+        s.right = elements;
+        (*splits_)[0] = s;
+
+        child1_ = new DeviceArray<int>(prealloc, &q, -1, false);
+        parent_ = new DeviceArray<int>(prealloc, &q, -1, false);
+
+        aabb_min_ = new DeviceArray<sycl::float4>(prealloc, &q);
+        aabb_max_ = new DeviceArray<sycl::float4>(prealloc, &q);
+
+        index_x_ = new DeviceArray<int>(elements, &q);
+        index_y_ = new DeviceArray<int>(elements, &q);
+        index_z_ = new DeviceArray<int>(elements, &q);
+
+        owners_x_ = new DeviceArray<int>(elements, &q, 0, false);
+        owners_y_ = new DeviceArray<int>(elements, &q, 0, false);
+        owners_z_ = new DeviceArray<int>(elements, &q, 0, false);
+
+        leftright_x_ = new DeviceArray<int>(elements, &q, 0, false);
+        leftright_y_ = new DeviceArray<int>(elements, &q, 0, false);
+        leftright_z_ = new DeviceArray<int>(elements, &q, 0, false);
+
+        tmp_index_ = new DeviceArray<int>(elements, &q, 0, false);
+        tmp_owners_ = new DeviceArray<int>(elements , &q, 0, false);
+        tmp_misc_ = new DeviceArray<int>(elements, &q, 0, false);
+
+        points_x_ = new DeviceArray<float>(elements, &q);
+        points_y_ = new DeviceArray<float>(elements, &q);
+        points_z_ = new DeviceArray<float>(elements, &q);
+        delete_node_info_ = false;
+    }
+
+    ~CudaKdTreeBuilder()
+    {
+        if (delete_node_info_)
+        {
+            delete child1_;
+            delete parent_;
+            delete splits_;
+            delete aabb_min_;
+            delete aabb_max_;
+            delete index_x_;
+        }
+
+        delete index_y_;
+        delete index_z_;
+        delete owners_x_;
+        delete owners_y_;
+        delete owners_z_;
+        delete points_x_;
+        delete points_y_;
+        delete points_z_;
+        delete leftright_x_;
+        delete leftright_y_;
+        delete leftright_z_;
+        delete tmp_index_;
+        delete tmp_owners_;
+        delete tmp_misc_;
+    }
+
+    //! build the tree
+    //! general idea:
+    //! - build sorted lists of the points in x y and z order (to be able to compute tight AABBs in O(1) )
+    //! - while( nodes to split exist )
+    //!    - split non-child nodes along longest axis if the number of points is > max_points_per_node
+    //!    - for each point: determine whether it is in a node that was split. If yes, mark it as belonging to the left or right child node of its current parent node
+    //!    - reorder the points so that the points of a single node are continuous in the node array
+    //!    - update the left/right pointers and AABBs of all nodes
+    void buildTree(sycl::queue &q)
+    {
+        q.wait();
+
+        tbb::parallel_for(tbb::blocked_range<size_t>(0, points_->size()),
+          [&](const tbb::blocked_range<size_t> &range) {
+          for (size_t i = range.begin(); i < range.end(); ++i) {
+              points_x_->ptr()[i] = points_->ptr()[i].x();
+              points_y_->ptr()[i] = points_->ptr()[i].y();
+              points_z_->ptr()[i] = points_->ptr()[i].z();
+              index_x_->ptr()[i] = i;
+              index_y_->ptr()[i] = i;
+              index_z_->ptr()[i] = i;
+          }
+        });
+
+        DeviceArray<float> tmpv(points_->size(), &q);
+        auto comp = [](auto i, auto j)
+        { return std::get<0>(i) < std::get<0>(j); };
+        // create sorted index list -> can be used to compute AABBs in O(1)
+        float* d = tmpv.ptr(),* s = points_x_->ptr();
+        tbb::parallel_for(tbb::blocked_range<size_t>(0, tmpv.size()),
+          [&](const tbb::blocked_range<size_t> &range) {
+          for (size_t i = range.begin(); i < range.end(); ++i) {
+              d[i] = s[i];
+          }
+        });
+        auto zi = oneapi::dpl::make_zip_iterator(tmpv.begin(), index_x_->begin());
+        tbb::parallel_sort(zi, zi + tmpv.size(), comp);
+
+        s = points_y_->ptr();
+        tbb::parallel_for(tbb::blocked_range<size_t>(0, tmpv.size()),
+          [&](const tbb::blocked_range<size_t> &range) {
+          for (size_t i = range.begin(); i < range.end(); ++i) {
+              d[i] = s[i];
+          }
+        });
+        zi = oneapi::dpl::make_zip_iterator(tmpv.begin(), index_y_->begin());
+        tbb::parallel_sort(zi, zi + tmpv.size(), comp);
+
+        s = points_z_->ptr();
+        tbb::parallel_for(tbb::blocked_range<size_t>(0, tmpv.size()),
+          [&](const tbb::blocked_range<size_t> &range) {
+          for (size_t i = range.begin(); i < range.end(); ++i) {
+              d[i] = s[i];
+          }
+        });
+        zi = oneapi::dpl::make_zip_iterator(tmpv.begin(), index_z_->begin());
+        tbb::parallel_sort(zi, zi + tmpv.size(), comp);
+
+
+        (*aabb_min_)[0] = sycl::float4((*points_x_)[(*index_x_)[0]],
+                                        (*points_y_)[(*index_y_)[0]],
+                                        (*points_z_)[(*index_z_)[0]], 0);
+
+        (*aabb_max_)[0] = sycl::float4((*points_x_)[(*index_x_)[points_->size() - 1]],
+                                        (*points_y_)[(*index_y_)[points_->size() - 1]],
+                                        (*points_z_)[(*index_z_)[points_->size() - 1]], 0);
+
+#ifdef PRINT_DEBUG_TIMING
+        cudaDeviceSynchronize();
+        std::cout << " initial stuff:" << stepTimer.elapsed() << std::endl;
+        stepTimer.restart();
+#endif
+        int last_node_count = 0;
+        DeviceArray<int>* offset_to_global = new DeviceArray<int>(allocation_info_[NodesAllocated], &q, -1);
+        cuda::kd_tree_builder_detail::block_nodes_to_allocate_ = 0;
+        cuda::kd_tree_builder_detail::block_left_ = 0;
+        cuda::kd_tree_builder_detail::enough_space_ = true;
+
+        while (1)
+        {
+            cuda::kd_tree_builder_detail::SplitNodes& sn_ = cuda::kd_tree_builder_detail::sn;
+            sn_.maxPointsPerNode = max_leaf_size_;
+            sn_.node_count = &allocation_info_[NodeCount];
+            sn_.nodes_allocated = &allocation_info_[NodesAllocated];
+            sn_.out_of_space = &allocation_info_[OutOfSpace];
+            sn_.child1_ = child1_->ptr();
+            sn_.parent_ = parent_->ptr();
+            sn_.splits = splits_->ptr();
+
+            tbb::parallel_for(tbb::blocked_range<size_t>(0, last_node_count),
+                [&](const tbb::blocked_range<size_t> &range) {
+                for (size_t i = range.begin(); i < range.end(); ++i) {
+                  split1(i, child1_->ptr(), splits_->ptr(), aabb_min_->ptr(),
+                      aabb_max_->ptr(), offset_to_global->ptr());
+                }
+            });
+
+           cuda::kd_tree_builder_detail::block_left_ = sycl::atomic_ref<int, sycl::memory_order::relaxed,
+                                                        sycl::memory_scope::device,
+                                                        sycl::access::address_space::global_space>(*sn_.node_count)
+                                                          .fetch_add(cuda::kd_tree_builder_detail::block_nodes_to_allocate_);
+            cuda::kd_tree_builder_detail::enough_space_ = cuda::kd_tree_builder_detail::block_left_ + cuda::kd_tree_builder_detail::block_nodes_to_allocate_ < *sn_.nodes_allocated;
+            // if it doesn't succeed, no nodes will be created by this block
+            if (!(cuda::kd_tree_builder_detail::enough_space_))
+            {
+                  sycl::atomic_ref<int, sycl::memory_order::relaxed, sycl::memory_scope::device,
+                    sycl::access::address_space::global_space>(*sn_.node_count)
+                      .fetch_add(0 - cuda::kd_tree_builder_detail::block_nodes_to_allocate_);
+               *sn_.out_of_space = 1;
+            }
+
+            if (cuda::kd_tree_builder_detail::enough_space_)
+            {
+                tbb::parallel_for(tbb::blocked_range<size_t>(0, last_node_count),
+                    [&](const tbb::blocked_range<size_t> &range) {
+                    for (size_t i = range.begin(); i < range.end(); ++i) {
+                      split2(i, splits_->ptr(), aabb_min_->ptr(), aabb_max_->ptr(), offset_to_global->ptr());
+                    }
+                 });
+            }
+
+            // copy allocation info to host
+            std::vector<int> alloc_info = allocation_info_;
+            if (last_node_count == alloc_info[NodeCount])
+            { // no more nodes were split -> done
+                break;
+            }
+            last_node_count = alloc_info[NodeCount];
+
+            // a node was un-splittable due to a lack of space
+            if (alloc_info[OutOfSpace] == 1)
+            {
+                resize_node_vectors(alloc_info[NodesAllocated] *  2);
+                alloc_info[OutOfSpace] = 0;
+                alloc_info[NodesAllocated] *= 2;
+                allocation_info_ = alloc_info;
+            }
+#ifdef PRINT_DEBUG_TIMING
+            cudaDeviceSynchronize();
+            std::cout << " node split:" << stepTimer.elapsed() << std::endl;
+            stepTimer.restart();
+#endif
+
+            // foreach point: point was in node that was split?move it to child (leaf) node : do nothing
+            cuda::kd_tree_builder_detail::MovePointsToChildNodes sno(
+                child1_->ptr(),
+                splits_->ptr(),
+                points_x_->ptr(),
+                points_y_->ptr(),
+                points_z_->ptr(),
+                owners_x_->ptr(),
+                owners_y_->ptr(),
+                owners_z_->ptr(),
+                leftright_x_->ptr(),
+                leftright_y_->ptr(),
+                leftright_z_->ptr());
+
+            tbb::parallel_for(tbb::blocked_range<int>(0, points_->size()),
+                [&](const tbb::blocked_range<int> &range) {
+                for (int i = range.begin(); i < range.end(); ++i)
+                {
+                  sno(i, index_x_->ptr(), index_y_->ptr(), index_z_->ptr());
+                }
+             });
+
+#ifdef PRINT_DEBUG_TIMING
+            cudaDeviceSynchronize();
+            std::cout << " set new owners:" << stepTimer.elapsed() << std::endl;
+            stepTimer.restart();
+#endif
+
+            // move points around so that each leaf node's points are continuous
+            separate_left_and_right_children(*index_x_,* owners_x_,* tmp_index_,* tmp_owners_,* leftright_x_);
+            std::swap(tmp_index_, index_x_);
+            std::swap(tmp_owners_, owners_x_);
+            separate_left_and_right_children(*index_y_,* owners_y_,* tmp_index_,* tmp_owners_,* leftright_y_, false);
+            std::swap(tmp_index_, index_y_);
+            separate_left_and_right_children(*index_z_,* owners_z_,* tmp_index_,* tmp_owners_,* leftright_z_, false);
+            std::swap(tmp_index_, index_z_);
+
+            // calculate new AABB etc
+            update_leftright_and_aabb(
+                *points_x_, *points_y_, *points_z_,
+                *index_x_, *index_y_, *index_z_,
+                *owners_x_, *splits_, *aabb_min_, *aabb_max_);
+        }
+    }
+
+    template <class Distance>
+    friend class KDTreeDpcpp3dIndex;
+
+protected:
+    //! takes the partitioned nodes, and sets the left-/right info of leaf nodes, as well as the AABBs
+    void update_leftright_and_aabb(
+        const DeviceArray<float>& x,
+        const DeviceArray<float>& y,
+        const DeviceArray<float>& z, const DeviceArray<int>& ix,
+        const DeviceArray<int>& iy, const DeviceArray<int>& iz,
+        const DeviceArray<int>& owners,
+        DeviceArray<cuda::kd_tree_builder_detail::SplitInfo>& splits,
+        DeviceArray<sycl::float4>& aabbMin,
+        DeviceArray<sycl::float4>& aabbMax)
+    {
+        DeviceArray<int>* labelsUnique = tmp_owners_;
+        DeviceArray<int>* countsUnique = tmp_index_;
+        // assume: points of each node are continuous in the array
+
+        // find which nodes are here, and where each node's points begin and end
+        int unique_labels = 0;
+        unique_key_copy kcopy(owners.size(), labelsUnique->ptr(), countsUnique->ptr(), owners.ptr(),& unique_labels);
+        std::for_each(it, it + owners.size(), kcopy);
+        /*
+        tbb::parallel_for(tbb::blocked_range<int>(0, owners.size()),
+           [&](const tbb::blocked_range<int> &range) {
+             for (int i = range.begin(); i < range.end(); ++i)
+                kcopy(i);
+        });
+        */
+        // update the info
+        cuda::kd_tree_builder_detail::SetLeftAndRightAndAABB s;
+        s.maxPoints = x.size();
+        s.nElements = unique_labels;
+        s.nodes = splits.ptr();
+        s.counts = countsUnique->ptr();
+        s.labels = labelsUnique->ptr();
+        s.x = x.ptr();
+        s.y = y.ptr();
+        s.z = z.ptr();
+        s.ix = ix.ptr();
+        s.iy = iy.ptr();
+        s.iz = iz.ptr();
+        s.aabbMin = aabbMin.ptr();
+        s.aabbMax = aabbMax.ptr();
+
+        tbb::parallel_for(tbb::blocked_range<int>(0, unique_labels),
+           [&](const tbb::blocked_range<int> &range) {
+             for (int i = range.begin(); i < range.end(); ++i)
+                s(i);
+        });
+    }
+
+    //! Separates the left and right children of each node into continuous parts of the array.
+    //! More specifically, it seperates children with even and odd node indices because nodes are always
+    //! allocated in pairs -> child1==child2+1 -> child1 even and child2 odd, or vice-versa.
+    //! Since the split operation is stable, this results in continuous partitions
+    //! for all the single nodes.
+    //! (basically the split primitive according to sengupta et al)
+    //! about twice as fast as thrust::partition
+    void separate_left_and_right_children(
+        DeviceArray<int>& key_in, DeviceArray<int>& val_in,
+        DeviceArray<int>& key_out, DeviceArray<int>& val_out,
+        DeviceArray<int>& left_right_marks, bool scatter_val_out = true)
+    {
+        DeviceArray<int>* f_tmp = &val_out;
+        DeviceArray<int>* addr_tmp = tmp_misc_;
+
+        cuda::kd_tree_builder_detail::exclusive_scan_tbb es(left_right_marks.ptr(), f_tmp->ptr(), 0);
+        tbb::parallel_scan(tbb::blocked_range<int>(1, left_right_marks.size()), es); 
+
+        cuda::kd_tree_builder_detail::set_addr3 sa(left_right_marks.ptr(), f_tmp->ptr(), addr_tmp->ptr(), key_in.size());
+        tbb::parallel_for(tbb::blocked_range<size_t>(0, val_in.size()),
+            [&](const tbb::blocked_range<size_t>&range) {
+            for (size_t i = range.begin(); i < range.end(); ++i)
+               sa(i);
+        });
+
+        // scatter
+        scatter keys(key_in.ptr(), key_out.ptr(), addr_tmp->ptr());
+        tbb::parallel_for(tbb::blocked_range<size_t>(0, key_out.size()),
+            [&](const tbb::blocked_range<size_t>&range) {
+            for (size_t i = range.begin(); i < range.end(); ++i)
+               keys(i);
+        });
+
+        if (scatter_val_out)
+        {
+            scatter vals(val_in.ptr(), val_out.ptr(), addr_tmp->ptr());
+            tbb::parallel_for(tbb::blocked_range<size_t>(0, val_out.size()),
+              [&](const tbb::blocked_range<size_t>&range) {
+                for (size_t i = range.begin(); i < range.end(); ++i)
+                vals(i);
+            });
+        }
+    }
+
+    //! allocates additional space in all the node-related vectors.
+    //! new_size elements will be added to all vectors.
+    void resize_node_vectors(size_t new_size)
+    {
+        size_t add = new_size - child1_->size();
+        child1_->insert(child1_->end(), add, -1);
+        parent_->insert(parent_->end(), add, -1);
+        cuda::kd_tree_builder_detail::SplitInfo s;
+        s.left = 0;
+        s.right = 0;
+        splits_->insert(splits_->end(), add, s);
+        sycl::float4 f(0, 0, 0, 0);
+        aabb_min_->insert(aabb_min_->end(), add, f);
+        aabb_max_->insert(aabb_max_->end(), add, f);
+    }
+
+    const DeviceArray<sycl::float4>* points_;
+
+    // tree data, those are stored per-node
+
+    //! left child of each node. (right child==left child + 1, due to the alloc mechanism)
+    //! child1_[node]==-1 if node is a leaf node
+    DeviceArray<int>* child1_;
+    //! parent node of each node
+    DeviceArray<int>* parent_;
+    //! split info (dim/value or left/right pointers)
+    DeviceArray<cuda::kd_tree_builder_detail::SplitInfo>* splits_;
+    //! min aabb value of each node
+    DeviceArray<sycl::float4>* aabb_min_;
+    //! max aab b value of each node
+    DeviceArray<sycl::float4>* aabb_max_;
+
+    enum AllocationInfo
+    {
+        NodeCount = 0,
+        NodesAllocated = 1,
+        OutOfSpace = 2
+    };
+    // those were put into a single vector of 3 elements so that only one mem transfer will be needed for all three of them
+    //  thrust::device_vector<int> out_of_space_;
+    //  thrust::device_vector<int> node_count_;
+    //  thrust::device_vector<int> nodes_allocated_;
+    std::vector<int> allocation_info_;
+
+    int max_leaf_size_;
+
+    // coordinate values of the points
+    DeviceArray<float>* points_x_,* points_y_,* points_z_;
+    // indices
+    DeviceArray<int>* index_x_,* index_y_,* index_z_;
+    // owner node
+    DeviceArray<int>* owners_x_,* owners_y_,* owners_z_;
+    // contains info about whether a point was partitioned to the left or right child after a split
+    DeviceArray<int>* leftright_x_,* leftright_y_,* leftright_z_;
+    DeviceArray<int>* tmp_index_,* tmp_owners_,* tmp_misc_;
+    bool delete_node_info_;
+};
+
+} // namespace flann
+#endif // FLANN_KDTREE_DPCPP_BUILDER_H_
