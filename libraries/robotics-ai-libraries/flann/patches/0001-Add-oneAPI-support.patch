new file mode 100644
index 0000000..02a0939
--- /dev/null
+++ b/src/flanntest.cpp
@@ -0,0 +1,389 @@
+#include "flann/flann.h"
+#include "flann/algorithms/dpcpp/kdtree_dpcpp_3d_index_params.h"
+#include <gtest/gtest.h>
+#include <fstream>
+#include <time.h>
+#include <chrono>
+
+inline double getTimeStamp()
+{
+  namespace sc = std::chrono;
+  sc::system_clock::duration d = sc::system_clock::now().time_since_epoch();
+  sc::seconds s = sc::duration_cast<sc::seconds>(d);
+  return s.count() + (sc::duration_cast<sc::microseconds>(d - s).count()) / 1e6;
+}
+
+int global_argc;
+char **global_argv;
+
+//3D point structure
+typedef struct PointFloat_3D
+{
+  float x;
+  float y;
+  float z;
+  int mask;
+  int index;
+
+  PointFloat_3D()
+  {
+    x = 0.0;
+    y = 0.0;
+    z = 0.0;
+    mask = 0;
+    index = 0;
+  }
+} PointFloat_3D;
+
+//FLANN idx+distance structure
+typedef struct FlannIndexDis
+{
+  std::vector<std::vector<int>> indices;
+  std::vector<std::vector<float>> distance;
+} FlannIndexDis;
+
+typedef std::vector<PointFloat_3D> PointCloud;
+
+flann::Matrix<float> Cloud2Matrix(PointCloud src)
+{
+  int dim = 3;
+  int N = src.size();
+  flann::Matrix<float> data(new float[N * dim], N, dim);
+
+  for (unsigned int i = 0; i < N; i++)
+  {
+    data[i][0] = src.at(i).x;
+    data[i][1] = src.at(i).y;
+    data[i][2] = src.at(i).z;
+  }
+  return data;
+}
+
+class FlannKdtree
+{
+private:
+  flann::Index<flann::L2<float>> TreeIndex; //kdtree
+
+public:
+  //create kdtree
+  FlannKdtree(flann::Matrix<float> dataset) : TreeIndex(dataset, flann::KDTreeSingleIndexParams(10))
+  {
+    TreeIndex.buildIndex();
+  }
+
+  // create kdtree dpcpp index
+  FlannKdtree(flann::Matrix<float> dataset, bool dpcpp) : TreeIndex(dataset, flann::KDTreeDpcpp3dIndexParams())
+  {
+    TreeIndex.buildIndex();
+  }
+
+  //kdtree search
+  void SearchKnn(const flann::Matrix<float> &target, int K, FlannIndexDis *dst)
+  {
+
+    TreeIndex.knnSearch(target, dst->indices, dst->distance, K, flann::SearchParams(-1));
+  }
+
+  void SearchR(flann::Matrix<float> &target, double R, FlannIndexDis &dst)
+  {
+    TreeIndex.radiusSearch(target, dst.indices, dst.distance, R, flann::SearchParams(true));
+  }
+};
+
+//read data
+void ReadPointCloud(std::string path, PointCloud &dst, int testIndex = 0)
+{
+  dst.clear();
+  std::ifstream file;
+  file.open(path);
+
+  if (!file.is_open())
+  {
+    std::cout << "open test data file failed! Please make sure the following path to point cloud file is correct: " << path << std::endl;
+    exit(1);
+  }
+
+  PointFloat_3D p;
+  int index = 0;
+  while (file >> p.x >> p.y >> p.z >> p.mask)
+  {
+    p.index = index;
+    index++;
+    if (p.mask == testIndex)
+    {
+      dst.push_back(p);
+    }
+    else if (p.mask)
+    {
+      ;
+    }
+  }
+  std::cout << "data size is " << dst.size() << std::endl;
+}
+
+void ReadPointCloud2(std::string path, PointCloud &dst)
+{
+  dst.clear();
+  std::ifstream file;
+  file.open(path);
+
+  if (!file.is_open())
+  {
+    std::cout << "open test data file failed!" << std::endl;
+    //system("pause");
+    return;
+  }
+
+  PointFloat_3D p;
+  int index = 0;
+  while (file >> p.x >> p.y >> p.z)
+  {
+    p.index = index;
+    index++;
+    dst.push_back(p);
+  }
+  std::cout << "data size is " << dst.size() << std::endl;
+}
+
+void knnTest()
+{
+  std::string inFile1 = "../data/test_P.txt";
+  std::string inFile2 = "../data/test_Q.txt";
+
+  PointCloud src;
+  ReadPointCloud2(inFile1, src);
+  flann::Matrix<float> data = Cloud2Matrix(src);
+
+  PointCloud testpoint;
+  ReadPointCloud2(inFile2, testpoint);
+  flann::Matrix<float> knnTarget = Cloud2Matrix(testpoint);
+
+  FlannKdtree tree(data);
+  FlannKdtree tree_dp(data, true);
+
+  constexpr int kIters = 15;
+
+  FlannIndexDis IndexDistance;
+  FlannIndexDis IndexDistance_dp;
+  for (auto i = 0; i < kIters; i++)
+  {
+    int k = i * 5 + 1;
+    tree.SearchKnn(knnTarget, k, &IndexDistance);
+    tree_dp.SearchKnn(knnTarget, k, &IndexDistance_dp);
+
+    for (auto ss = 0; ss < src.size(); ss++)
+    {
+      EXPECT_TRUE(IndexDistance.indices.at(ss).size() == IndexDistance_dp.indices.at(ss).size()) <<
+        "CPU and GPU size mismatch for k=" << k << "\n";
+      for (auto kk = 0; kk < k; kk++)
+      {
+        EXPECT_TRUE(IndexDistance.indices.at(ss)[kk] == IndexDistance_dp.indices.at(ss)[kk]) <<
+          "CPU and GPU indices mismatch for k="<< k << " and point at " << ss << "\n";
+        EXPECT_NEAR(IndexDistance.distance.at(ss)[kk], IndexDistance_dp.distance.at(ss)[kk], 1e-03) <<
+          "CPU and GPU distances mismatch for k="<< k << " and point at " << ss << "\n";
+      }
+    }
+  }
+}
+
+void radiusTest()
+{
+  std::string inFile = "../data/test_P.txt";
+
+  PointCloud src;
+  ReadPointCloud2(inFile, src);
+  flann::Matrix<float> data = Cloud2Matrix(src);
+
+  PointCloud testpoint;
+  ReadPointCloud2(inFile, testpoint);
+  flann::Matrix<float> radiusTarget = Cloud2Matrix(testpoint);
+
+  FlannKdtree tree(data);
+  FlannKdtree tree_dp(data, true);
+
+  constexpr int kIters = 15;
+
+  FlannIndexDis IndexDistance;
+  FlannIndexDis IndexDistance_dp;
+  for (auto i = 1; i < kIters; i++)
+  {
+    int k = i * 5 + 1;
+    float radius = k / 20.0;
+    tree.SearchR(radiusTarget, radius, IndexDistance);
+    tree_dp.SearchR(radiusTarget, radius, IndexDistance_dp);
+
+    for (auto ss = 0; ss < src.size(); ss++)
+    {
+      EXPECT_TRUE(IndexDistance.indices.at(ss).size() == IndexDistance_dp.indices.at(ss).size()) <<
+        "CPU and GPU size mismatch for radius=" << radius << "\n";
+      for (auto kk = 0; kk < IndexDistance.indices.at(ss).size(); kk++)
+      {
+
+        /* Don't compare the indices as GPU sort is not stable sort, indices may swap for same
+         * distance
+        EXPECT_TRUE(IndexDistance.indices.at(ss)[kk] == IndexDistance_dp.indices.at(ss)[kk]) <<
+          "CPU and GPU indices mismatch for radius="<< radius << " and point at " << ss <<
+              " vector index=" << kk << "CPU=" << IndexDistance.indices.at(ss)[kk] << " GPU=" <<
+              IndexDistance_dp.indices.at(ss)[kk] << " \n";
+              */
+        EXPECT_NEAR(IndexDistance.distance.at(ss)[kk], IndexDistance_dp.distance.at(ss)[kk], 1e-03) <<
+          "CPU and GPU distances mismatch for radius="<< radius << " and point at " << ss <<
+              " vector index=" << kk <<"\n";
+      }
+    }
+  }
+}
+
+int knnPerformanceTest(int argc, char *argv[])
+{
+  PointCloud src;
+  std::string pcDataFile = "../data/data_.txt";
+  if (argc > 1)
+  {
+    pcDataFile = argv[1];
+  }
+  ReadPointCloud(pcDataFile, src, 8);
+
+  int k;
+  double t1, t2;
+  flann::Matrix<float> data = Cloud2Matrix(src);
+  PointCloud testpoint;
+  ReadPointCloud(pcDataFile, testpoint);
+  flann::Matrix<float> knnTarget = Cloud2Matrix(testpoint);
+
+  int len = 50;
+  flann::Matrix<float> radiusTarget(new float[len * 3], len, 3);
+  std::memcpy(radiusTarget.ptr(), data.ptr(), len * 3 * sizeof(float));
+
+  constexpr int kIters = 15;
+  std::cout << "====kdtree dpcpp index=======================" << std::endl;
+  t1 = getTimeStamp();
+  FlannKdtree tree_dp(data, true);
+  t2 = getTimeStamp();
+  std::cout << "create kdtree dpcpp: " << (t2 - t1) * 1000 << " ms" << std::endl;
+
+  for (auto i = 0; i < kIters; i++)
+  {
+    k = i * 5 + 1;
+    FlannIndexDis IndexDistance;
+
+    t1 = getTimeStamp();
+    tree_dp.SearchKnn(knnTarget, k, &IndexDistance);
+    //tree_dp.SearchR(radiusTarget, radius, IndexDistance);
+    t2 = getTimeStamp();
+
+    std::cout << "k=" << k + 1 << " search kdtree: " << (t2 - t1) * 1000 << " ms" << std::endl;
+  }
+
+  std::cout << "====kdtree single index=======================" << std::endl;
+
+  t1 = getTimeStamp();
+  FlannKdtree tree(data);
+  t2 = getTimeStamp();
+  std::cout << "create kdtree: " << (t2 - t1) * 1000 << " ms" << std::endl;
+
+  for (auto i = 0; i < kIters; i++)
+  {
+    k = i * 5 + 1;
+    FlannIndexDis IndexDistance;
+
+    t1 = getTimeStamp();
+    tree.SearchKnn(knnTarget, k, &IndexDistance);
+    //tree.SearchR(radisuTarget, radius, IndexDistance);
+    t2 = getTimeStamp();
+
+    std::cout << "k=" << k + 1 << " search kdtree: " << (t2 - t1) * 1000 << " ms" << std::endl;
+  }
+
+  return 0;
+}
+
+int radiusPerformanceTest(int argc, char *argv[])
+{
+  PointCloud src;
+  std::string pcDataFile = "../data/data_.txt";
+  if (argc > 1)
+  {
+    pcDataFile = argv[1];
+  }
+  ReadPointCloud(pcDataFile, src, 8);
+
+  int k;
+  double t1, t2;
+  flann::Matrix<float> data = Cloud2Matrix(src);
+  PointCloud testpoint;
+  ReadPointCloud(pcDataFile, testpoint, 8);
+  flann::Matrix<float> radiusTarget = Cloud2Matrix(testpoint);
+
+  constexpr int kIters = 15;
+  std::cout << "====kdtree dpcpp index=======================" << std::endl;
+  t1 = getTimeStamp();
+  FlannKdtree tree_dp(data, true);
+  t2 = getTimeStamp();
+  std::cout << "create kdtree dpcpp: " << (t2 - t1) * 1000 << " ms" << std::endl;
+
+  for (auto i = 0; i < kIters; i++)
+  {
+    k = i * 5 + 1;
+    float radius = k / 100.0;
+    FlannIndexDis IndexDistance;
+
+    t1 = getTimeStamp();
+    tree_dp.SearchR(radiusTarget, radius, IndexDistance);
+    t2 = getTimeStamp();
+
+    std::cout << "radius=" << radius << " search kdtree: " << (t2 - t1)*1000 << " ms" << std::endl;
+  }
+
+  std::cout << "====kdtree single index=======================" << std::endl;
+
+  t1 = getTimeStamp();
+  FlannKdtree tree(data);
+  t2 = getTimeStamp();
+  std::cout << "create kdtree: " << (t2 - t1) * 1000 << " ms" << std::endl;
+
+  for (auto i = 0; i < kIters; i++)
+  {
+    k = i * 5 + 1;
+    float radius = k / 100.0;
+    FlannIndexDis IndexDistance;
+
+    t1 = getTimeStamp();
+    tree.SearchR(radiusTarget, radius, IndexDistance);
+    t2 = getTimeStamp();
+
+    std::cout << "radius=" << radius << " search kdtree: " << (t2 - t1)*1000 << " ms" << std::endl;
+  }
+
+  return 0;
+}
+
+int main(int argc, char *argv[])
+{
+  ::testing::InitGoogleTest(&argc, argv);
+  global_argc = argc;
+  global_argv = argv;
+
+  return RUN_ALL_TESTS();
+}
+
+
+TEST(oneapi_flann_knn_test, Positive)
+{
+  knnTest();
+}
+
+TEST(oneapi_flann_radius_test, Positive)
+{
+  radiusTest();
+}
+
+TEST(oneapi_flann_knn_performance_test, Positive)
+{
+  knnPerformanceTest(global_argc, global_argv);
+}
+
+TEST(oneapi_flann_radius_performance_test, Positive)
+{
+  radiusPerformanceTest(global_argc, global_argv);
+}
