+#define BUSY_WAIT_ITERATIONS 16
+#define HIGH_LOAD_MAGNITUDE 10
+
+/* Time in term of microseconds */
+static double minimal_sleep_precision = 0.0;
+static unsigned int high_load = 0;
+static bool busy_wait = true;
+static char passive_policy[] = "PASSIVE";
+
+namespace flann
+{
+    extern dpct::device_ext *dev_ct1;
+    oneapi::dpl::counting_iterator<int> it(0);
+
+    template <class T>
+    void std_cit(sycl::queue &q_ct1, T* dst, size_t size)
+    {
+        q_ct1.submit([&](sycl::handler& cgh)
+                     { cgh.parallel_for<class std_cit>(sycl::range<1>(size), [=](sycl::id<1> i)
+                                                       { dst[i] = i; }); })
+            .wait();
+    }
+
+    template <class T>
+    void std_fill(sycl::queue &q_ct1, void* dst, size_t size, const T& val)
+    {
+        q_ct1.submit([&](sycl::handler& cgh)
+                     { cgh.parallel_for<class std_fill>(sycl::range<1>(size), [=](sycl::id<1> i)
+                                                        { ((T* )dst)[i] = val; }); })
+            .wait();
+    }
+
+    template <class T>
+    void std_copy(sycl::queue &q_ct1, T* dst, const T* src, size_t size)
+    {
+        q_ct1.submit([&](sycl::handler& cgh)
+                     { cgh.parallel_for<class std_copy>(sycl::range<1>(size), [=](sycl::id<1> i)
+                                                        { dst[i] = src[i]; }); })
+            .wait();
+    }
+
+    template <class T>
+    void par_scatter(sycl::queue &q_ct1, const T* in, T* out, const int* addr, size_t size)
+    {
+        q_ct1.submit([&](sycl::handler& cgh)
+                     { cgh.parallel_for<class par_scatter>(sycl::range<1>(size), [=](sycl::id<1> i)
+                                                           { out[addr[i]] = in[i]; }); })
+            .wait();
+    }
+
+    void par_indices(int* ind, const int* v, size_t size, sycl::handler& cgh)
+    {
+        cgh.parallel_for<class par_indices>(sycl::range<1>(size), [=](sycl::id<1> i)
+                                            { ind[i] = (ind[i] >= 0) ? v[ind[i]] : ind[i]; });
+    }
+
+    void wait_for(sycl::event& event, size_t sleep_time = 1) {
+        using namespace std;
+        using namespace std::chrono;
+
+        if (!minimal_sleep_precision) {
+            auto start = high_resolution_clock::now();
+            this_thread::sleep_for(microseconds(1));
+            auto end = high_resolution_clock::now();
+
+            /* Measure minimal granularity of sleep time for the system */
+            minimal_sleep_precision = (end - start).count() / 1e3;
+
+            const char* wait_policy = std::getenv("PCL_ONEAPI_WAIT_POLICY");
+
+            const int passive_name_len = sizeof(passive_policy);
+
+            if (wait_policy &&  (sizeof(wait_policy) == passive_name_len)
+                && (strncmp(wait_policy, passive_policy, passive_name_len) == 0))
+              busy_wait = false;
+        }
+
+        while (event.get_info<sycl::info::event::command_execution_status>() ==
+            sycl::info::event_command_status::running) {
+
+            if (high_load > 0) {
+              continue;
+            } else {
+                auto start = high_resolution_clock::now();
+                this_thread::sleep_for(microseconds(sleep_time));
+                auto end = high_resolution_clock::now();
+
+                double observed_sleep = (end - start).count() / 1e3;
+                if (observed_sleep/(sleep_time + minimal_sleep_precision) > HIGH_LOAD_MAGNITUDE) {
+                    high_load = BUSY_WAIT_ITERATIONS;
+                }
+            }
+        }
+
+        if (high_load > 0)
+            high_load--;
+    }
+
+    void wait_for(std::vector<sycl::event>& event_list, size_t sleep_time = 1) {
+        for (auto &event : event_list) {
+            wait_for(event, sleep_time);
+        }
+    }
+
+    template <class T>
+    struct std_copy2
+    {
+        T* dst_;
+        const T* src_;
+
+        std_copy2(T* dst, const T* src) : dst_(dst), src_(src) {}
+
+        void operator()(int id)
+        {
+            dst_[id] = src_[id];
+        }
+    };
+
+    template <class T>
+    struct to_sycl_float4
+    {
+        const flann::Matrix<T> src_;
+        sycl::float4* dst_;
+
+        to_sycl_float4(const flann::Matrix<T>& src, sycl::float4* dst) : src_(src), dst_(dst) {}
+
+        void operator()(int id)
+        {
+            dst_[id] = sycl::float4(src_[id][0], src_[id][1], src_[id][2], 0);
+        }
+    };
+
+    struct map_index
+    {
+        const int* v_;
+        int* ind_;
+
+        map_index(int* ind, const int* v) : v_(v), ind_(ind)
+        {
+        }
+
+        void operator()(int id) const
+        {
+            ind_[id] = (ind_[id] >= 0) ? v_[ind_[id]] : ind_[id];
+        }
+    };
+
+    // thrust::scatter
+    struct scatter
+    {
+        int* in_;
+        int* out_;
+        int* addr_;
+
+        scatter(int* in, int* out, int* addr) : in_(in), out_(out), addr_(addr)
+        {
+        }
+
+        void operator()(int id)
+        {
+            out_[addr_[id]] = in_[id];
+        }
+    };
+
+    // thrust::gather()
+    struct gather
+    {
+        sycl::float4* in_;
+        sycl::float4* out_;
+        int* addr_;
+
+        gather(sycl::float4* in, sycl::float4* out, int* addr) : in_(in), out_(out), addr_(addr)
+        {
+        }
+
+        void operator()(int id)
+        {
+            out_[id] = in_[addr_[id]];
+        }
+    };
+
+    // thrust::unique_by_key_copy()
+    struct unique_key_copy
+    {
+        int* idx_;
+        int* labels_;
+        int* counts_;
+        const int* owners_;
+
+        unique_key_copy(int len, int* labels, int* counts, const int* owners, int* idx) : idx_(idx), labels_(labels), counts_(counts), owners_(owners)
+        {
+            if (len > 0)
+            {
+                labels_[0] = owners_[0];
+                counts_[0] = 0;
+               * idx_ = 1;
+            }
+        }
+
+        void operator()(int id)
+        {
+            if (!(owners_[id] == labels_[*idx_ - 1]))
+            {
+                labels_[*idx_] = owners_[id];
+                counts_[*idx_] = id;
+               * idx_ =* idx_ + 1;
+            }
+        }
+    };
+
+    // thrust::exclusive_scan
+    struct exclusive_scan
+    {
+        int* in_;
+        int* out_;
+
+        exclusive_scan(int* in, int* out, int out0) : in_(in), out_(out)
+        {
+            out_[0] = out0;
+        }
+
+        void operator()(int id)
+        {
+            out_[id] = out_[id - 1] + in_[id - 1];
+        }
+    };
+} // namespace flann
+#endif //FLANN_KDTREE_DPCPP_3D_INDEX_INTERNAL_H_
