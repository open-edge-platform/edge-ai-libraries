+
+        GpuHelper() : gpu_splits_(0), gpu_parent_(0), gpu_child1_(0), gpu_aabb_min_(0), gpu_aabb_max_(0), gpu_points_(0), gpu_vind_(0)
+        {
+        }
+
+        ~GpuHelper()
+        {
+            delete gpu_splits_;
