+# SPDX-License-Identifier: Apache-2.0
+
+"""Tests for Mamba conv/ssm chunk splitting and 4-bit quantization."""
+
+# Standard
+import threading
+
+# Third Party
+import pytest
+import torch
+
+# First Party
+from lmcache.v1.multiprocess.group_view import MambaSubStateWireLayout
+from lmcache.v1.multiprocess.transfer_context.mamba_quant import (
+    MambaChunkSplit,
+    _allocate_scale_id,
+    merge_mamba_chunk,
+    pack_mamba_payloads,
+    split_mamba_chunk,
+    unpack_mamba_payloads,
+)
+
+try:
+    # Third Party
+    from kvweave import kvweave_quant  # noqa: F401
+
+    _has_kvweave_quant = True
+except ImportError:
+    _has_kvweave_quant = False
+
+native_only = pytest.mark.skipif(
+    not _has_kvweave_quant, reason="requires the kvweave_quant native extension"
+)
+
+if _has_kvweave_quant:
+    # First Party
+    from lmcache.v1.multiprocess.transfer_context.mamba_quant import (
+        dequantize_mamba_substate_4bit,
+        quantize_mamba_substate_4bit,
+    )
+
+_NUM_KV = 2
+_NUM_LAYERS = 3
+_CHUNK_TOKENS = 8
+_HIDDEN_DIM = 4
+_BLOCK_SIZE = 2
+# conv's real per-block shape is 2D, matching vLLM's own
+# (state_len, conv_dim) -- no separate head axis, but not flat either.
+_CONV_STATE_LEN = 2
+_CONV_DIM = 3
+_CONV_HEAD_DIM = _CONV_DIM  # true last dim, per _mamba_quant_layout's contract
+_SSM_HEAD_NUM = 2
+_SSM_HEAD_DIM = 5
+_CONV_ELEMS = _CONV_STATE_LEN * _CONV_DIM
+_SSM_ELEMS = _SSM_HEAD_NUM * _SSM_HEAD_DIM
+
+
+def _make_layout() -> tuple[MambaSubStateWireLayout, MambaSubStateWireLayout]:
+    """Build a ``(conv, ssm)`` layout pair covering one full synthetic page.
+
+    Returns:
+        A layout pair whose combined byte length exactly equals
+        ``2 * _BLOCK_SIZE * _HIDDEN_DIM`` float32 elements (no padding), so
+        every byte in a reassembled page belongs to either sub-state. conv's
+        real per-block shape is 2D (``shape=(_CONV_STATE_LEN, _CONV_DIM)``,
+        matching vLLM's ``(state_len, conv_dim)``); ssm's is 3D in
+        production (``(num_heads, head_v_dim, head_k_dim)``) but this
+        fixture uses a 2D ``(_SSM_HEAD_NUM, _SSM_HEAD_DIM)`` tail, which
+        already exercises the "fold everything but the last dim into
+        head_num" path.
+    """
+    return (
+        MambaSubStateWireLayout(
+            byte_offset=0,
+            byte_length=_CONV_ELEMS * 4,
+            dtype_str="torch.float32",
+            shape=(_CONV_STATE_LEN, _CONV_DIM),
+        ),
+        MambaSubStateWireLayout(
+            byte_offset=_CONV_ELEMS * 4,
+            byte_length=_SSM_ELEMS * 4,
+            dtype_str="torch.float32",
+            shape=(_SSM_HEAD_NUM, _SSM_HEAD_DIM),
+        ),
+    )
+
+
+class TestSplitMambaChunk:
+    """Tests for :func:`split_mamba_chunk`."""
+
+    def test_splits_into_expected_shapes_and_dtypes(self) -> None:
+        """conv/ssm must come back with their own real per-head shape and
+        dtype, independent of the page's addressing dtype."""
+        conv_layout, ssm_layout = _make_layout()
+        raw_chunk = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS, _HIDDEN_DIM)
+        num_blocks = _CHUNK_TOKENS // _BLOCK_SIZE
+
+        split = split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+
+        assert split.conv.shape == (
+            _NUM_LAYERS,
+            num_blocks,
+            _CONV_STATE_LEN,
+            _CONV_DIM,
+        )
+        assert split.ssm.shape == (
+            _NUM_LAYERS,
+            num_blocks,
+            _SSM_HEAD_NUM,
+            _SSM_HEAD_DIM,
+        )
+        assert split.conv.dtype == torch.float32
+        assert split.ssm.dtype == torch.float32
+
+    def test_splits_noncontiguous_input(self) -> None:
+        """A non-contiguous ``raw_chunk`` (as ``gather_paged_kv_to_cpu`` may
+        produce via slicing) must still split without error or shape drift."""
+        conv_layout, ssm_layout = _make_layout()
+        base = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS * 2, _HIDDEN_DIM)
+        raw_chunk = base[:, :, ::2, :]
+        assert not raw_chunk.is_contiguous()
+        num_blocks = _CHUNK_TOKENS // _BLOCK_SIZE
+
+        split = split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+
+        assert split.conv.shape == (
+            _NUM_LAYERS,
+            num_blocks,
+            _CONV_STATE_LEN,
+            _CONV_DIM,
+        )
+        assert split.ssm.shape == (
+            _NUM_LAYERS,
+            num_blocks,
+            _SSM_HEAD_NUM,
+            _SSM_HEAD_DIM,
+        )
+
+    def test_rejects_chunk_tokens_not_multiple_of_block_size(self) -> None:
+        """A ``chunk_tokens`` not divisible by ``block_size`` must raise."""
+        conv_layout, ssm_layout = _make_layout()
+        raw_chunk = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS + 1, _HIDDEN_DIM)
+        with pytest.raises(ValueError, match="chunk_tokens"):
+            split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+
+
+class TestMergeMambaChunk:
+    """Tests for :func:`merge_mamba_chunk`, the inverse of
+    :func:`split_mamba_chunk`."""
+
+    def test_round_trip_preserves_conv_and_ssm_bytes(self) -> None:
+        """``split(merge(split(raw)))`` must reproduce the same conv/ssm
+        tensors as the initial ``split(raw)``, since conv/ssm fully cover the
+        synthetic page and no bytes are lost to padding."""
+        conv_layout, ssm_layout = _make_layout()
+        raw_chunk = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS, _HIDDEN_DIM)
+
+        split = split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+        merged = merge_mamba_chunk(
+            split, (conv_layout, ssm_layout), _BLOCK_SIZE, _HIDDEN_DIM
+        )
+        assert merged.shape == raw_chunk.shape
+
+        split_again = split_mamba_chunk(
+            merged, (conv_layout, ssm_layout), _BLOCK_SIZE
+        )
+        assert torch.equal(split.conv, split_again.conv)
+        assert torch.equal(split.ssm, split_again.ssm)
+
+
+class TestAllocateScaleId:
+    """Tests for the lock-free :func:`_allocate_scale_id`."""
+
+    def test_returns_unique_ids_sequentially(self) -> None:
+        """Sequential calls must never repeat within a small run."""
+        ids = [_allocate_scale_id() for _ in range(100)]
+        assert len(set(ids)) == len(ids)
+
+    def test_returns_unique_ids_across_threads(self) -> None:
+        """Concurrent callers from multiple threads must never collide,
+        verifying the counter needs no explicit lock under the GIL."""
+        allocated: list[int] = []
+        lock = threading.Lock()
+
+        def _worker() -> None:
+            local_ids = [_allocate_scale_id() for _ in range(200)]
+            with lock:
+                allocated.extend(local_ids)
+
+        threads = [threading.Thread(target=_worker) for _ in range(8)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        assert len(set(allocated)) == len(allocated)
+
+
+class TestPackMambaPayloads:
+    """Tests for :func:`pack_mamba_payloads`/:func:`unpack_mamba_payloads`."""
+
+    def test_round_trip(self) -> None:
+        """Packing then unpacking must return the original payload bytes."""
+        conv_payload = b"conv-bytes-123"
+        ssm_payload = b"ssm-bytes-4567"
+        blob = pack_mamba_payloads(conv_payload, ssm_payload)
+        unpacked_conv, unpacked_ssm = unpack_mamba_payloads(blob)
+        assert unpacked_conv == conv_payload
+        assert unpacked_ssm == ssm_payload
+
+    def test_round_trip_with_empty_payloads(self) -> None:
+        """Empty payloads must round-trip without corrupting framing."""
+        blob = pack_mamba_payloads(b"", b"")
+        unpacked_conv, unpacked_ssm = unpack_mamba_payloads(blob)
+        assert unpacked_conv == b""
+        assert unpacked_ssm == b""
+
+
+@native_only
+class TestQuantizeMambaSubstate4Bit:
+    """Tests for :func:`quantize_mamba_substate_4bit`/
+    :func:`dequantize_mamba_substate_4bit`."""
+
+    @pytest.mark.parametrize("dtype", [torch.float16, torch.float32, torch.bfloat16])
+    def test_round_trip_preserves_shape_and_dtype(self, dtype: torch.dtype) -> None:
+        """Dequantizing a quantized tensor must recover its shape and dtype."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=dtype)
+        payload = quantize_mamba_substate_4bit(tensor, substate="conv")
+        restored = dequantize_mamba_substate_4bit(payload)
+        assert restored.shape == tensor.shape
+        assert restored.dtype == tensor.dtype
+
+    def test_round_trip_is_approximately_lossless(self) -> None:
+        """4-bit quantization is lossy; error must stay within a loose bound
+        rather than exploding (e.g. from a scale/shape mismatch bug)."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        payload = quantize_mamba_substate_4bit(tensor, substate="conv")
+        restored = dequantize_mamba_substate_4bit(payload)
+        assert (restored - tensor).abs().max().item() < 1.0
+
+    def test_rejects_unsupported_dtype(self) -> None:
+        """A tensor dtype outside the supported set must raise."""
+        tensor = torch.randn(4, 4, dtype=torch.float64)
+        with pytest.raises(ValueError, match="unsupported dtype"):
+            quantize_mamba_substate_4bit(tensor, substate="conv")
+
+    def test_rejects_unsupported_substate(self) -> None:
+        """An unrecognized substate must raise."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="substate"):
+            quantize_mamba_substate_4bit(tensor, substate="qkv")
+
+    def test_rejects_unsupported_scaling_method(self) -> None:
+        """An unrecognized scaling method must raise."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="scaling_method"):
+            quantize_mamba_substate_4bit(
+                tensor, substate="conv", scaling_method="per_head"
+            )
+
+    def test_rejects_1d_tensor(self) -> None:
+        """Mamba sub-state tensors need a (layer, block, ...) shape; a 1D
+        tensor has no separate layer/block axes."""
+        tensor = torch.randn(_CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="at least 2 dimensions"):
+            quantize_mamba_substate_4bit(tensor, substate="conv")
+
+    def test_conv_rejects_rh_with_per_tensor(self) -> None:
+        """rh is not supported for conv combined with per_tensor -- a
+        caller-imposed restriction since conv has no real head axis."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="rh is not supported"):
+            quantize_mamba_substate_4bit(
+                tensor, substate="conv", scaling_method="per_tensor", rh=True
+            )
+
+    def test_conv_rejects_rh_with_per_channel(self) -> None:
+        """rh is not supported for conv combined with per_channel."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="rh is not supported"):
+            quantize_mamba_substate_4bit(
+                tensor, substate="conv", scaling_method="per_channel", rh=True
+            )
+
+    def test_rejects_unrecognized_payload_magic(self) -> None:
+        """A payload with a corrupted magic prefix must raise."""
+        with pytest.raises(ValueError, match="magic"):
+            dequantize_mamba_substate_4bit(b"XXXXgarbage")
+
+    @pytest.mark.parametrize("scaling_method", ["per_tensor", "per_channel", "per_token"])
+    @pytest.mark.parametrize("asym", [False, True])
+    def test_full_conv_ssm_pipeline_round_trip(
+        self, scaling_method: str, asym: bool
+    ) -> None:
+        """The full store/retrieve path -- split, quantize, pack, unpack,
+        dequantize, merge -- must reproduce the original conv/ssm bytes,
+        across all scaling methods and symmetric/asymmetric quantization."""
+        conv_layout, ssm_layout = _make_layout()
+        raw_chunk = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS, _HIDDEN_DIM)
+
+        split = split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+        blob = pack_mamba_payloads(
+            quantize_mamba_substate_4bit(
+                split.conv,
+                substate="conv",
+                scaling_method=scaling_method,
+                asym=asym,
+            ),
+            quantize_mamba_substate_4bit(
+                split.ssm,
+                substate="ssm",
+                scaling_method=scaling_method,
+                asym=asym,
+            ),
+        )
+        conv_payload, ssm_payload = unpack_mamba_payloads(blob)
+        restored = MambaChunkSplit(
+            conv=dequantize_mamba_substate_4bit(conv_payload),
+            ssm=dequantize_mamba_substate_4bit(ssm_payload),
+        )
+
+        assert restored.conv.shape == split.conv.shape
+        assert restored.ssm.shape == split.ssm.shape
+        assert (restored.conv - split.conv).abs().max().item() < 1.0
+        assert (restored.ssm - split.ssm).abs().max().item() < 1.0
+
+    def test_per_channel_uses_last_dim_as_head_dim(self) -> None:
+        """per_channel must scale independently per position along the last
+        dimension: a tensor whose channels have wildly different magnitudes
+        must still dequantize accurately for every channel, which a single
+        per_tensor scale would blur."""
+        num_blocks, num_channels = 4, 8
+        tensor = torch.zeros(_NUM_LAYERS, num_blocks, num_channels)
+        # Each channel spans a different magnitude: channel c ~ N(0, 10^c).
+        for c in range(num_channels):
+            tensor[:, :, c] = torch.randn(_NUM_LAYERS, num_blocks) * (10.0**c)
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="conv", scaling_method="per_channel"
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        for c in range(num_channels):
+            channel_scale = max(tensor[:, :, c].abs().max().item(), 1e-6)
+            rel_err = (
+                (restored[:, :, c] - tensor[:, :, c]).abs().max().item()
+                / channel_scale
+            )
+            assert rel_err < 0.2, f"channel {c} relative error {rel_err} too large"
+
+    def test_per_token_scales_independently_per_layer_block(self) -> None:
+        """per_token must scale independently per (layer, block) position: a
+        tensor whose token positions have wildly different magnitudes must
+        still dequantize accurately for every position, which a single
+        per_tensor scale would blur."""
+        num_blocks, num_channels = 4, 8
+        tensor = torch.zeros(_NUM_LAYERS, num_blocks, num_channels)
+        # Each block spans a different magnitude: block b ~ N(0, 10^b).
+        for b in range(num_blocks):
+            tensor[:, b, :] = torch.randn(_NUM_LAYERS, num_channels) * (10.0**b)
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="conv", scaling_method="per_token"
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        for b in range(num_blocks):
+            block_scale = max(tensor[:, b, :].abs().max().item(), 1e-6)
+            rel_err = (
+                (restored[:, b, :] - tensor[:, b, :]).abs().max().item()
+                / block_scale
+            )
+            assert rel_err < 0.2, f"block {b} relative error {rel_err} too large"
+
+    def test_rh_requires_power_of_two_transform_length(self) -> None:
+        """rh with a per_token transform length that is not a power of 2
+        must raise instead of silently corrupting data or crashing in C++."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        assert (_CONV_HEAD_DIM & (_CONV_HEAD_DIM - 1)) != 0, (
+            "fixture must be non-power-of-2"
+        )
+        with pytest.raises(ValueError, match="power-of-2"):
+            quantize_mamba_substate_4bit(
+                tensor, substate="conv", scaling_method="per_token", rh=True
+            )
+
+    @pytest.mark.parametrize("scaling_method", ["per_tensor", "per_channel", "per_token"])
+    def test_ssm_rh_round_trip_with_power_of_two_length(
+        self, scaling_method: str
+    ) -> None:
+        """With a power-of-2 transform length, rh must round-trip correctly
+        for ssm (all three scaling methods support rh for ssm).
+
+        Shape (2, 2, 4, 4) makes every method's transform length a power of
+        2: per_tensor over head_num*head_dim=16, per_channel over
+        head_num*head_dim=16, per_token over head_num*head_dim=16.
+        """
+        num_layers, num_blocks, head_num, head_dim = 2, 2, 4, 4
+        tensor = torch.randn(
+            num_layers, num_blocks, head_num, head_dim, dtype=torch.float32
+        )
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="ssm", scaling_method=scaling_method, rh=True
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        assert restored.shape == tensor.shape
+        assert (restored - tensor).abs().max().item() < 1.0
+
+    def test_conv_rh_round_trip_with_per_token(self) -> None:
+        """conv supports rh only with per_token scaling; with a power-of-2
+        head_dim it must round-trip correctly."""
+        num_layers, num_blocks, head_dim = 2, 2, 16
+        tensor = torch.randn(num_layers, num_blocks, head_dim, dtype=torch.float32)
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="conv", scaling_method="per_token", rh=True
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        assert restored.shape == tensor.shape
+        assert (restored - tensor).abs().max().item() < 1.0
+
+    def test_conv_per_token_treats_state_len_as_token_like(self) -> None:
+        """conv's real shape has an extra ``state_len`` dim beyond
+        ``num_blocks`` (matching vLLM's ``(state_len, conv_dim)`` per-block
+        shape). Under per_token, each ``(block, state_len-position)`` pair
+        must get its own independent scale -- not one scale shared across
+        the whole block's state_len positions -- so wildly different
+        magnitudes across state_len positions within the same block must
+        still dequantize accurately."""
+        num_layers, num_blocks, state_len, conv_dim = 2, 2, 4, 8
+        tensor = torch.zeros(num_layers, num_blocks, state_len, conv_dim)
+        # Each state_len position spans a different magnitude within the
+        # same block: position s ~ N(0, 10^s).
+        for s in range(state_len):
+            tensor[:, :, s, :] = torch.randn(num_layers, num_blocks, conv_dim) * (
+                10.0**s
+            )
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="conv", scaling_method="per_token"
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        assert restored.shape == tensor.shape
+        for s in range(state_len):
+            position_scale = max(tensor[:, :, s, :].abs().max().item(), 1e-6)
+            rel_err = (
+                (restored[:, :, s, :] - tensor[:, :, s, :]).abs().max().item()
+                / position_scale
+            )
+            assert rel_err < 0.2, f"state_len position {s} relative error {rel_err} too large"
+
+    def test_conv_per_token_rh_round_trip_with_state_len(self) -> None:
+        """per_token+rh for conv must fold state_len into blocks_num (each
+        (block, state_len-position) is its own token), so the transform
+        length is conv_dim alone -- must round-trip when conv_dim is a
+        power of 2, even though num_blocks * state_len * conv_dim is not."""
+        num_layers, num_blocks, state_len, conv_dim = 2, 3, 3, 16
+        numel = num_layers * num_blocks * state_len * conv_dim
+        assert (numel & (numel - 1)) != 0, (
+            "fixture must make the whole per-layer size non-power-of-2, so "
+            "this only passes if state_len folds into blocks_num, not head_dim"
+        )
+        tensor = torch.randn(
+            num_layers, num_blocks, state_len, conv_dim, dtype=torch.float32
+        )
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="conv", scaling_method="per_token", rh=True
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        assert restored.shape == tensor.shape
+        assert (restored - tensor).abs().max().item() < 1.0
