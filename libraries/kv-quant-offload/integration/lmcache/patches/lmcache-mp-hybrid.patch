+def _expand_prefetch_obj_keys(
+    key: IPCCacheEngineKey,
+    chunk_hashes: list[bytes],
+    num_object_groups: int,
+) -> list[ObjectKey]:
+    """Build the prefetch/lock key list covering every object group.
+
+    Hybrid models have more than one KV-cache (object) group; store and
+    retrieve operate on all of them, so the prefetch must read-lock all of
+    them too (otherwise retrieve finds the non-prefetched groups
+    ``KEY_NOT_READABLE`` and the whole retrieve fails).
+
+    Keys are ordered chunk-major so the prefix-hit counter in
+    ``submit_prefetch_task`` still breaks at the first missing chunk: for
+    each chunk, all ``(object_group, kv_rank)`` keys are emitted
+    contiguously. The hit count is recovered by dividing the raw
+    leading-ones count by ``world_size * num_object_groups`` (mirroring the
+    existing ``world_size`` expand-then-divide scheme). With
+    ``num_object_groups == 1`` this returns exactly the previous
+    single-group ordering, so behavior is unchanged for non-hybrid models.
+
+    Args:
+        key: The lookup cache key (provides model_name, world_size,
+            worker_id, cache_salt).
+        chunk_hashes: Per-chunk content hashes.
+        num_object_groups: Number of object groups to cover (>= 1).
+
+    Returns:
+        Flat, chunk-major list of ObjectKeys across all object groups.
+    """
+    num_chunks = len(chunk_hashes)
+    if num_chunks == 0:
+        return []
+    group_ids = list(range(max(1, num_object_groups)))
+    per_group = ipc_key_to_object_keys(key, chunk_hashes, group_ids)
+    # Each per_group[g] is ordered [chunk-major, kv_rank-inner].
+    num_ranks = len(per_group[0]) // num_chunks
+    obj_keys: list[ObjectKey] = []
+    for chunk_idx in range(num_chunks):
+        base = chunk_idx * num_ranks
+        for group_keys in per_group:
+            obj_keys.extend(group_keys[base : base + num_ranks])
+    return obj_keys
+
