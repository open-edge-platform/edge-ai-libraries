+        "mamba_type",
+        "mamba_cache_mode",
+        "num_speculative_blocks",
+    ):
+        if hasattr(spec, attr):
+            fields.append(f"{attr}={getattr(spec, attr)}")
+    return "{" + ", ".join(fields) + "}"
