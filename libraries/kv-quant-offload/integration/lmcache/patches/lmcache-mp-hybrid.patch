+def _format_cache_tensor(cache: Any) -> str:
+    if isinstance(cache, torch.Tensor):
+        return (
+            f"Tensor(shape={tuple(cache.shape)}, dtype={cache.dtype}, "
+            f"device={cache.device}, stride={tuple(cache.stride())})"
+        )
+    if isinstance(cache, (list, tuple)):
+        return type(cache).__name__ + "(" + ", ".join(
+            _format_cache_tensor(item) for item in cache
+        ) + ")"
+    return type(cache).__name__
