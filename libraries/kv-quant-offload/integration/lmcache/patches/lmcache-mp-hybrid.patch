+                # Value encodes which group this object key belongs to, so
+                # the merged order can be verified.
+                memory_obj.tensor = torch.full(
+                    (2, 2, 8, 16), float(obj_key.object_group_id)
+                )
+                memory_objs.append(memory_obj)
