+            chunk_shape=torch.Size([1]),
+            engine_kv_format=None,
+        )
+        transfer_groups = [(plan, {}, [1, 2, 3, 4])]
+
+        assert null_chunk_mask_from_groups(transfer_groups) == ((False, False),)
