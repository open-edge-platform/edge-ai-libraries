+# SPDX-License-Identifier: Apache-2.0
+
+# Standard
+import importlib.util
+import sys
+import types
+from pathlib import Path
+
+# Third Party
+import pytest
+
+
+ROOT_DIR = Path(__file__).resolve().parents[1]
+
+
+def _load_setup_module() -> types.ModuleType:
+    module_name = "lmcache_setup_test_module"
+    spec = importlib.util.spec_from_file_location(module_name, ROOT_DIR / "setup.py")
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _fake_torch(*, xpu_available: bool, cuda_available: bool) -> types.ModuleType:
+    torch_module = types.ModuleType("torch")
+    torch_module.version = types.SimpleNamespace(hip=None)
+    torch_module.xpu = types.SimpleNamespace(is_available=lambda: xpu_available)
+    torch_module.cuda = types.SimpleNamespace(is_available=lambda: cuda_available)
+    return torch_module
+
+
+@pytest.mark.parametrize("env_name", ["BUILD_WITH_HIP", "BUILD_WITH_SYCL", "BUILD_WITH_MUSA"])
+def test_select_gpu_backend_prefers_explicit_env(monkeypatch, env_name: str) -> None:
+    for name in ("BUILD_WITH_HIP", "BUILD_WITH_SYCL", "BUILD_WITH_MUSA"):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv(env_name, "1")
+    monkeypatch.setitem(sys.modules, "torch", _fake_torch(xpu_available=False, cuda_available=True))
+
+    setup_module = _load_setup_module()
+
+    expected_backend = {
+        "BUILD_WITH_HIP": "hip",
+        "BUILD_WITH_SYCL": "sycl",
+        "BUILD_WITH_MUSA": "musa",
+    }[env_name]
+    assert setup_module._select_gpu_backend() == expected_backend
+
