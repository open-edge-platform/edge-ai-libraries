# Lingua server — OpenVINO image. Does NOT install adaptive-token-compressor.
# Container only carries the standalone server file (`app.py`) + LLMLingua patch.
# Library clients reach the running container over HTTP via LinguaHTTPBackend.

# Build context is the repo root (set in deployment/lingua/docker-compose.yaml
# as `build.context: ../..`), so `COPY src/.../app.py` resolves correctly.
#
# Defaults: --backend ov, --device xpu, --port 8001.

FROM python:3.13-slim

WORKDIR /app

# Intel GPU runtime (Level-Zero loader + neo .deb bundle).
# Required for OpenVINO to access GPU devices. Harmless if container is run
# without `/dev/dri` devices passed in (CPU users) — OpenVINO simply won't use XPU.
# `patch` is required for the LLMLingua-2 source patch step below; python:slim
# images don't ship it by default.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ocl-icd-libopencl1 libze1 patch \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir neo && cd neo \
    && curl -LO https://github.com/intel/intel-graphics-compiler/releases/download/v2.30.1/intel-igc-core-2_2.30.1+20950_amd64.deb \
    && curl -LO https://github.com/intel/intel-graphics-compiler/releases/download/v2.30.1/intel-igc-opencl-2_2.30.1+20950_amd64.deb \
    && curl -LO https://github.com/intel/compute-runtime/releases/download/26.09.37435.1/intel-ocloc-dbgsym_26.09.37435.1-0_amd64.ddeb \
    && curl -LO https://github.com/intel/compute-runtime/releases/download/26.09.37435.1/intel-ocloc_26.09.37435.1-0_amd64.deb \
    && curl -LO https://github.com/intel/compute-runtime/releases/download/26.09.37435.1/intel-opencl-icd-dbgsym_26.09.37435.1-0_amd64.ddeb \
    && curl -LO https://github.com/intel/compute-runtime/releases/download/26.09.37435.1/intel-opencl-icd_26.09.37435.1-0_amd64.deb \
    && curl -LO https://github.com/intel/compute-runtime/releases/download/26.09.37435.1/libigdgmm12_22.9.0_amd64.deb \
    && curl -LO https://github.com/intel/compute-runtime/releases/download/26.09.37435.1/libze-intel-gpu1-dbgsym_26.09.37435.1-0_amd64.ddeb \
    && curl -LO https://github.com/intel/compute-runtime/releases/download/26.09.37435.1/libze-intel-gpu1_26.09.37435.1-0_amd64.deb \
    && dpkg -i *.deb \
    && cd .. && rm -rf neo

# CPU torch is enough for OpenVINO-backed execution paths (OV drives the GPU via
# its own runtime; torch never leaves the CPU here). Install from the CPU wheel
# index to get the lean CPU-only build and avoid the heavy accelerator runtime
# packages the default PyPI torch wheel pulls in on Linux (unused here, ~GBs).
RUN pip install --no-cache-dir \
        torch==2.8.0 \
        --index-url https://download.pytorch.org/whl/cpu

# Lingua server's own runtime deps (NOT adaptive-token-compressor).
RUN pip install --no-cache-dir \
        "llmlingua>=0.2" \
        "fastapi>=0.110" \
        "uvicorn[standard]>=0.27" \
        "huggingface-hub>=0.20" \
        pydantic

# OpenVINO backend deps used by `--backend ov`.
RUN pip install --no-cache-dir \
        "openvino>=2024.0" \
        "optimum[openvino]>=1.24.0"

# Apply LLMLingua-2 patch (digit_neighbor_radius). Same patch file used by
# bare-metal `python -m ...apply_patch`. See plan §6.5.1.5.
COPY src/adaptive_token_compressor/model_servers/lingua/patches/0001-digit-neighbor-radius.patch /tmp/
RUN cd "$(python -c 'import llmlingua, os; print(os.path.dirname(llmlingua.__file__))')" \
    && patch -p1 < /tmp/0001-digit-neighbor-radius.patch \
    && rm /tmp/0001-digit-neighbor-radius.patch

# Server entry — copied as a renamed standalone script (plan §17.A:
# app.py runs both `python -m ...lingua` and `python lingua_server.py`).
COPY src/adaptive_token_compressor/model_servers/lingua/app.py /app/lingua_server.py

# HuggingFace model cache (mounted as a named volume in compose).
RUN mkdir -p /root/.cache/huggingface

ENV LINGUA_PORT=8001
ENV LINGUA_BACKEND=ov
ENV LINGUA_DEVICE=xpu
ENV LINGUA_MODE=llmlingua2
ENV LINGUA_MODEL_NAME_ID=""

EXPOSE 8001

# Shell form so env vars expand. --mode is always explicit; model_name_id remains optional.
CMD python lingua_server.py --backend ${LINGUA_BACKEND} --device ${LINGUA_DEVICE} --port ${LINGUA_PORT} --host 0.0.0.0 --mode ${LINGUA_MODE} ${LINGUA_MODEL_NAME_ID:+--model_name_id $LINGUA_MODEL_NAME_ID}