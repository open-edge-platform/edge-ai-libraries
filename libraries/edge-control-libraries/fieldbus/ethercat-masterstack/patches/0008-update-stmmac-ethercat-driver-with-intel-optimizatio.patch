diff --git a/devices/stmmac/stmmac_selftests-5.10-orig.c b/devices/stmmac/stmmac_selftests-5.10-orig.c
new file mode 100644
index 00000000..0462dcc9
--- /dev/null
+++ b/devices/stmmac/stmmac_selftests-5.10-orig.c
@@ -0,0 +1,2046 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2019 Synopsys, Inc. and/or its affiliates.
+ * stmmac Selftests Support
+ *
+ * Author: Jose Abreu <joabreu@synopsys.com>
