+static inline int stmmac_rx_threshold_count(struct stmmac_rx_queue *rx_q)
+{
+	if (rx_q->rx_zeroc_thresh < STMMAC_RX_THRESH(rx_q->priv_data))
+		return 0;
+
+	return 1;
+}
