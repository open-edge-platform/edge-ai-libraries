+
+/* Proxy mode register in GBE MISC for enter Proxy Mode */
+#define GBE_PROXYMODE_REG		0x10600
+#define GBE_PROXYMODE_ENTER		BIT(0)
+
+/* Proxy mode exit interrupt register. */
+#define GBE_PROXYMODE_EXIT_STS_REG	0x10604
