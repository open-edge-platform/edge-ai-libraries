new file mode 100644
index 00000000..687f43cd
--- /dev/null
+++ b/devices/stmmac/stmmac_selftests-6.1-orig.c
@@ -0,0 +1,2049 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
