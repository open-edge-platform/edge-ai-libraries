+			     struct stmmac_tx_queue *xdp_q);
+void stmmac_xdp_queue_update_tail(struct stmmac_tx_queue *xdp_q);
+
+void stmmac_finalize_xdp_rx(struct stmmac_rx_queue *rx_q, unsigned int xdp_res);
