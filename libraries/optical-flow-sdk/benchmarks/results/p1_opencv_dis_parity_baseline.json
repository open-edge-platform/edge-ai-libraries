  "agent_instructions": {
    "when_executing_p2": [
      "Treat this file as the frozen P1 classical-DIS quality baseline.",
      "Re-run parity_opencv_datasets after any DIS refinement / Farneback / PyrLK / SEA-RAFT change and compare against these numbers.",
      "§8 pairwise EPE <= max(0.05px, 2% of OpenCV GT-EPE) and KITTI Fl-all delta <= 0.5pp remain the classical-equivalence bars.",
      "P2 quality gate for SEA-RAFT is separate: <= NVOFA Medium Fl-all on KITTI train at a measured Series 2 iGPU FPS.",
      "Closest classical path to improve first: OpenCL Fast (best EPE among measured DIS-lite configs).",
      "CPU/OpenCL Medium blow up on large-motion Sintel Final — fix or document before claiming Medium quality."
    ],
    "reproduce": [
      "./scripts/fetch_datasets.sh ~/datasets/optical-flow",
      "cmake --build build --target parity_opencv_datasets",
      "./build/parity_opencv_datasets --kitti ~/datasets/optical-flow --backend opencl --preset fast",
      "./build/parity_opencv_datasets --sintel ~/datasets/optical-flow --backend opencl --preset fast --max-pairs 69"
    ]
  },
  "host": {
    "ssh_alias": "labrat@10.91.82.130",
