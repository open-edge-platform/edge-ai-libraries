  "methodology": {
    "pairwise_mask": "GT-valid pixels only (KITTI invalid / Sintel finite GT)",
    "sintel_sampling": "round-robin across sorted sequences; Clean and Final each get max_pairs",
    "sintel_max_pairs_per_pass": 69,
    "kitti_pairs": 200,
    "kitti_split": "training image_2 *_10.png -> *_11.png with flow_occ",
    "opencv_preset_map": {
      "fast": "PRESET_FAST",
      "medium": "PRESET_MEDIUM",
      "slow": "PRESET_MEDIUM"
    },
    "gates": {
      "pairwise_epe": "mean pairwise EPE <= max(0.05px, 0.02 * opencv_gt_epe)",
      "kitti_fl_all_pp": "abs(sdk_fl_all - opencv_fl_all) <= 0.5"
    }
  },
  "summary": {
    "all_configs_section8_pass": false,
    "best_classical_path": "opencl/fast",
    "p2_focus": [
      "variational refinement or stronger classical DIS",
      "Farneback/PyrLK GPU + OpenCV parity",
      "SEA-RAFT-S OpenVINO under Slow (KITTI Fl-all vs NVOFA Medium)"
    ]
  },
