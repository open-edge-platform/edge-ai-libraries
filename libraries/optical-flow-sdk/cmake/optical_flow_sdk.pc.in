prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: optical_flow_sdk
Description: Intel Optical Flow SDK (SYCL/OpenCL/CPU dense optical flow)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -loptical_flow_sdk
Cflags: -I${includedir}
