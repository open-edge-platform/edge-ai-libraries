prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: sift_extractor
Description: Intel SIFT extractor (OpenCL/SYCL dual-backend dispatch)
Version: @PROJECT_VERSION@
Libs: -L${libdir} @SIFT_PKGCONFIG_LIBS@
Cflags: -I${includedir} @SIFT_PKGCONFIG_CFLAGS@
